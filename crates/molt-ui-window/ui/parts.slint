// SPDX-License-Identifier: GPL-3.0-or-later
//
// Reusable screen parts: everything here depends only on the Theme /
// Strings globals and its own properties — no AppWindow state. The window
// (app.slint) composes these into the actual screens.

import { Theme, Strings, SurfaceTab, ViewItem, LogLine, ReactionItem, ReceiptItem, MemberSync, ProposalRow, HintTip, PatchView } from "theme.slint";
import { AppButton, AppField, ScrollHint, HoverTip } from "components.slint";

// A large clickable option card used on the first-run choice screen. The
// title is split into its hotkey letter (rendered underlined; the window
// activates the card when it is typed) and the rest; `marked` mirrors the
// hover look for the arrow-key selection.
export component ChoiceCard inherits Rectangle {
    // text before the hotkey letter, unmarked (empty on the plain cards)
    in property <string> lead: "";
    in property <string> key;
    in property <string> rest;
    in property <string> sub;
    in property <image> icon;
    in property <bool> marked: false;
    callback chosen();
    height: 88px;
    border-radius: Theme.radius;
    background: ta.has-hover || root.marked ? Theme.raised : Theme.panel-2;
    border-width: Theme.border-w;
    border-color: ta.has-hover || root.marked ? Theme.accent : Theme.line;
    animate background, border-color { duration: 110ms; }

    Rectangle {
        x: 16px;
        y: (parent.height - 56px) / 2;
        width: 56px;
        height: 56px;
        border-radius: Theme.win95 ? 0px : 10px;
        background: Theme.accent-soft;
        border-width: Theme.border-w;
        border-color: Theme.accent;
        Image {
            source: root.icon;
            colorize: Theme.accent;
            width: 28px;
            height: 28px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    VerticalLayout {
        x: 88px;
        width: parent.width - 104px;
        height: 100%;
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: 0;
            // an optional prefix that is NOT the hotkey: a title like
            // "(Re)Join / Recovery" has its hotkey letter in the middle, and
            // underlining the bracket instead would be a lie about the key
            if root.lead != "": Text {
                text: root.lead;
                color: Theme.text;
                font-size: Theme.fs-h2;
                font-weight: 700;
            }
            Rectangle {
                width: keyt.preferred-width;
                height: keyt.preferred-height;
                keyt := Text {
                    text: root.key;
                    color: Theme.text;
                    font-size: Theme.fs-h2;
                    font-weight: 700;
                }
                // the hotkey underline, sitting just under the glyph
                Rectangle {
                    y: keyt.preferred-height - 3px;
                    height: 1.5px;
                    width: keyt.preferred-width;
                    background: Theme.text;
                }
            }
            Text {
                text: root.rest;
                color: Theme.text;
                font-size: Theme.fs-h2;
                font-weight: 700;
            }
        }
        if root.sub != "": Text {
            text: root.sub;
            color: Theme.dim;
            font-size: Theme.fs-body;
        }
    }
    ta := TouchArea {
        clicked => {
            root.chosen();
        }
    }
}

// A small warn-coloured count pill: open proposals awaiting a decision.
export component PendingBadge inherits Rectangle {
    in property <int> count;
    // optional override: a preformatted label (e.g. "1/4") instead of the
    // bare count
    in property <string> label: "";
    width: max(18px, cnt.preferred-width + 11px);
    height: 17px;
    border-radius: Theme.win95 ? 0px : 8.5px;
    background: Theme.warn;
    cnt := Text {
        text: root.label == "" ? "\{root.count}" : root.label;
        color: Theme.panel;
        font-size: 11px;
        font-weight: 700;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One top-level surface entry in the sidebar: icon + name, a pending-
// proposals badge when decisions await, and a chevron (the selected
// surface's group is the expanded one). In compact mode (collapsed icon
// rail) only the icon shows — pending proposals then become a warn-
// coloured corner dot, so the hint survives the collapse.
export component SurfaceRow inherits Rectangle {
    in property <SurfaceTab> s;
    in property <bool> selected;
    in property <bool> compact: false;
    // staged-out surfaces render greyed and ignore clicks
    in property <bool> enabled: true;
    callback chosen();
    height: 46px;
    border-radius: Theme.win95 ? 0px : 8px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.selected ? Theme.raised : (root.enabled && ta.has-hover ? Theme.panel-2 : transparent);
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: root.selected ? Theme.accent : transparent;
    }
    // roomy icon box with an ultra-thin, quiet outline — chrome must not
    // distract from the icon itself
    Rectangle {
        width: 38px;
        height: 38px;
        x: root.compact ? (parent.width - self.width) / 2 : 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 9px;
        // no chrome around the icon in light/dark; brutalism keeps its frame
        border-width: Theme.win95 ? 1px : 0px;
        border-color: Theme.line;
        Image {
            source: root.s.key == "organization" ? @image-url("assets/republic.svg")
                : root.s.key == "chat" ? @image-url("assets/chat.svg")
                : root.s.key == "memory" ? @image-url("assets/memory.svg")
                : root.s.key == "quests" ? @image-url("assets/board.svg")
                : root.s.key == "vault" ? @image-url("assets/vault.svg")
                : @image-url("assets/treasury.svg");
            colorize: Theme.accent;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if root.compact && root.s.pending-count > 0: Rectangle {
            x: parent.width - 6px;
            y: -3px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.warn;
            border-width: 1px;
            border-color: Theme.panel;
        }
    }
    if !root.compact: HorizontalLayout {
        x: 52px;
        width: parent.width - 60px;
        height: 100%;
        spacing: 7px;
        Text {
            text: root.s.name;
            color: Theme.text;
            font-weight: 600;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            // a cut label (big fonts) shows its full name beside the row,
            // through the window-topmost HintTip overlay — a local bubble
            // would paint under the main pane
            property <bool> tip-on: ta.has-hover && self.width < self.preferred-width;
            changed tip-on => {
                if (self.tip-on) {
                    HintTip.label = root.s.name;
                    HintTip.ax = root.absolute-position.x + root.width + 8px;
                    HintTip.ay = root.absolute-position.y + (root.height - 23px) / 2;
                } else if (HintTip.ax == root.absolute-position.x + root.width + 8px
                    && HintTip.ay == root.absolute-position.y + (root.height - 23px) / 2) {
                    HintTip.label = "";
                }
            }
        }
        if root.s.pending-count > 0: PendingBadge {
            count: root.s.pending-count;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.selected ? "▾" : "▸";
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.chosen();
        }
        // collapsed icon rail: every row names itself beside the rail
        // (same overlay — the old local HoverTip painted under the pane)
        changed has-hover => {
            if (root.compact) {
                if (self.has-hover) {
                    HintTip.label = root.s.pending-count > 0 ? "\{root.s.name} · \{root.s.pending-count}" : root.s.name;
                    HintTip.ax = root.absolute-position.x + root.width + 8px;
                    HintTip.ay = root.absolute-position.y + (root.height - 23px) / 2;
                } else if (HintTip.ax == root.absolute-position.x + root.width + 8px
                    && HintTip.ay == root.absolute-position.y + (root.height - 23px) / 2) {
                    HintTip.label = "";
                }
            }
        }
    }
}

// One sub-view entry under an expanded surface: a colorful Twemoji icon +
// label; the Proposals view carries the pending-count badge.
export component ViewRow inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    in property <int> pending: 0;
    // decisions still waiting on THIS node's vote: rendered as a warning
    // (⚠ + "mine/total") instead of the neutral pending pill
    in property <int> alert: 0;
    // the total the alert is part of (pending count) — "1/4" reads "my vote
    // is missing on 1 of 4 open decisions"
    in property <int> alert-total: 0;
    // extra indent for a row nested one level deeper (the pending decisions
    // under Organization → Pending); 0 = a normal view row
    in property <length> indent: 0px;
    // a decision row's standing, right-aligned and quiet ("1/3" = one of
    // three needed approvals). Deliberately NOT the warn badge: that one
    // means "something is waiting for you", and a tally is just a fact.
    in property <string> quorum: "";
    callback chosen();
    height: 30px;
    border-radius: Theme.win95 ? 0px : 6px;
    background: root.selected ? Theme.raised : (ta.has-hover ? Theme.panel-2 : transparent);
    HorizontalLayout {
        padding-left: 26px + root.indent;
        padding-right: 10px;
        spacing: 8px;
        // fixed clip box: an oversized emoji glyph must never bleed into
        // the neighbouring rows
        Rectangle {
            width: 20px;
            height: 20px;
            clip: true;
            y: (parent.height - self.height) / 2;
            opacity: root.selected ? 1.0 : 0.75;
            Text {
                text: root.icon;
                font-family: "Twemoji Mozilla";
                font-size: 13px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.dim;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            // a cut label (long decision titles, big fonts) shows in full
            // beside the row via the window-topmost HintTip overlay
            property <bool> tip-on: ta.has-hover && self.width < self.preferred-width;
            changed tip-on => {
                if (self.tip-on) {
                    HintTip.label = root.label;
                    HintTip.ax = root.absolute-position.x + root.width + 8px;
                    HintTip.ay = root.absolute-position.y + (root.height - 23px) / 2;
                } else if (HintTip.ax == root.absolute-position.x + root.width + 8px
                    && HintTip.ay == root.absolute-position.y + (root.height - 23px) / 2) {
                    HintTip.label = "";
                }
            }
        }
        if root.quorum != "": Text {
            text: root.quorum;
            color: Theme.faint;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.alert > 0: Text {
            text: "⚠️";
            font-family: "Twemoji Mozilla";
            font-size: 17px;
            vertical-alignment: center;
        }
        if root.alert > 0: PendingBadge {
            count: root.alert;
            label: root.alert-total > 0 ? "\{root.alert}/\{root.alert-total}" : "";
            y: (parent.height - self.height) / 2;
        }
        if root.alert == 0 && root.pending > 0: PendingBadge {
            count: root.pending;
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        clicked => {
            root.chosen();
        }
    }
}

// The emoji palette (borrowed from konkinwallet): a fixed 8-glyph row in a
// PopupWindow, rendered in the colorful Twemoji font.
export component EmojiGrid inherits Rectangle {
    callback emoji-picked(string);
    background: Theme.panel;
    border-width: Theme.border-w;
    border-color: Theme.line;
    border-radius: Theme.win95 ? 0px : 6px;
    width: 8 * 34px + 7 * 4px + 16px;
    height: 46px;
    HorizontalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;
        for emoji in ["👍", "👎", "🎉", "✅", "❤️", "🙏", "🤔", "🔥"]: Rectangle {
            width: 34px;
            background: e-ta.has-hover ? Theme.raised : transparent;
            border-radius: Theme.win95 ? 0px : 4px;
            clip: true;
            Text {
                text: emoji;
                font-family: "Twemoji Mozilla";
                font-size: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            e-ta := TouchArea {
                clicked => {
                    root.emoji-picked(emoji);
                }
            }
        }
    }
}

// One emoji-reaction pill on a chat message (the count hides at 1); the
// local member's own pick gets the accent highlight, clicking toggles.
export component ReactionPill inherits Rectangle {
    in property <ReactionItem> r;
    callback clicked();
    width: prow.preferred-width + (root.r.count > 1 ? 12px : 6px);
    height: 22px;
    // no chrome at all: the emoji just stands there — a whisper of hover
    // feedback, and the count carries the "mine" accent
    background: pta.has-hover ? Theme.raised : transparent;
    border-radius: Theme.win95 ? 0px : 11px;
    prow := HorizontalLayout {
        x: 5px;
        height: 100%;
        spacing: 3px;
        alignment: start;
        // fixed clip box: an oversized emoji glyph must stay inside the
        // pill instead of painting into (and under) the next chat row;
        // nudged 1px up so the glyph sits optically centred
        Rectangle {
            width: 18px;
            height: 18px;
            clip: true;
            y: (parent.height - self.height) / 2 - 1px;
            Text {
                text: root.r.emoji;
                font-family: "Twemoji Mozilla";
                font-size: 15px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.r.count > 1: Text {
            text: root.r.count;
            color: root.r.mine ? Theme.accent : Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    pta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One chat message row, konkinwallet-style: author + grey timestamp once
// per author block, a selectable body, the reaction pills underneath, and
// a quiet copy affordance at the right edge on hover. The "+" opens the
// emoji palette and only shows while the member hasn't reacted yet.
export component ChatRow inherits Rectangle {
    in property <LogLine> line;
    in property <int> index;
    // mirror of the window's one-shot scroll request; when it names this
    // row, the row asks its host (which can reach the Flickable) to scroll
    in property <int> scroll-request: -1;
    callback toggle-reaction(string);
    callback copy-requested();
    callback quote-requested();
    callback delete-requested();
    callback quote-jump();
    callback bring-into-view();
    // shared-file card: click = download (host decides / toasts),
    // trash on own live shares = delete the local file
    callback file-clicked();
    callback file-remove-requested();
    // the local read-receipts switch: when off, the per-member receipt row is
    // hidden entirely (symmetric — this node also sends no receipts).
    in property <bool> receipts-on: true;
    property <bool> is-target: root.scroll-request == root.index;
    changed is-target => {
        if (self.is-target) {
            root.bring-into-view();
        }
    }
    // an indent WRAPPER layout must not carry the card: a HorizontalLayout
    // between the repeater and the card loses the card's preferred height,
    // the card comes up short and the next one paints over the pills. So
    // the row is a transparent container and indents its card itself.
    // Depth 0 = no quote; 1 and 2 alternate between neighboring quote
    // groups of different targets (LogLine.quote-indent), so stacked
    // replies to different questions stop lining up as one thread.
    in property <int> indent-level: 0;
    // the card's height comes from a real padded layout (not from a
    // manually anchored crow + offset): preferred-height of an anchored,
    // width-bound layout mis-measures wrapped content by a few pixels —
    // exactly the pixels the pills kept drowning under the card edge by
    height: card.preferred-height;
    background: transparent;
    // every message is its own card; the tone still alternates per author
    // block (same member in a row = same tone), in a grey of its own —
    // NOT the panel tone the chat sits on
    card := Rectangle {
    x: root.indent-level * 22px;
    width: parent.width - root.indent-level * 22px;
    height: parent.height;
    // a system line (UI-synthesized governance note in a patch channel)
    // renders quiet: no card chrome, no author, no actions
    background: root.line.system ? transparent : (root.line.alt ? Theme.zebra : Theme.panel-2);
    border-width: root.line.system ? 0px : 1px;
    border-color: Theme.line;
    border-radius: Theme.win95 ? 0px : 8px;
    crow := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 6px;
        spacing: 0px;
        // quoted message teaser, messenger-style: an accent bar plus the
        // teaser at body size on a soft accent field — the reply target is
        // unmissable. Clickable — jumps to the original when it is in view
        // (a cross-channel quote has a teaser but no in-view row to jump to)
        if root.line.quote-label != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                border-radius: Theme.win95 ? 0px : 6px;
                background: qt-ta.has-hover ? Theme.raised : Theme.accent-soft;
                clip: true;
                HorizontalLayout {
                    padding-right: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 7px;
                    Rectangle {
                        width: 3px;
                        background: Theme.accent;
                    }
                    Text {
                        text: "↳";
                        color: Theme.accent;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.line.quote-label;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                qt-ta := TouchArea {
                    mouse-cursor: root.line.quote >= 0 ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        if (root.line.quote >= 0) {
                            root.quote-jump();
                        }
                    }
                }
            }
        }
        if root.line.quote-label != "": Rectangle {
            height: 4px;
        }
        // the author is named once per block (with the grey timestamp) —
        // consecutive messages of the same member just append below it
        if root.line.first: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.line.lead;
                color: root.line.own ? Theme.accent : Theme.text;
                font-size: Theme.fs-cap;
                font-weight: 700;
            }
            Text {
                text: root.line.when;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        if root.line.first: Rectangle {
            height: 3px;
        }
        // a read-only TextInput instead of Text: the body is selectable,
        // Ctrl+C copies the selection. Twemoji leads the font chain so
        // emojis render in full colour; everything the emoji font lacks
        // falls back to the regular text font per glyph. A pure file share
        // has no body — the card below is the whole message.
        if root.line.deleted-by == "" && !(root.line.has-file && root.line.text == ""): TextInput {
            text: root.line.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: root.line.system ? Theme.dim : Theme.text;
            font-size: root.line.system ? Theme.fs-cap : Theme.fs-body;
            font-italic: root.line.system;
            font-family: "Twemoji Mozilla";
        }
        // the shared-file card: metadata only (name, size · type · date).
        // Clicking downloads from the sharer's disk while the file exists;
        // a removed file stays visible but grey — the history is honest.
        if root.line.deleted-by == "" && root.line.has-file: Rectangle {
            height: 46px;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: 1px;
            border-color: Theme.line;
            background: file-ta.has-hover && root.line.file-available ? Theme.raised : Theme.zebra;
            // card-wide touch area first, so the remove button (later in
            // the tree) sits above it
            file-ta := TouchArea {
                mouse-cursor: root.line.file-available ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.file-clicked();
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;
                Text {
                    text: root.line.file-available ? "📄" : "🚫";
                    font-family: "Twemoji Mozilla";
                    font-size: 19px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.line.file-name;
                        color: root.line.file-available ? Theme.text : Theme.faint;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.line.file-available ? root.line.file-meta : Strings.mv-file-gone;
                        color: Theme.faint;
                        font-size: Theme.fs-cap;
                        overflow: elide;
                    }
                }
            }
        }
        if root.line.deleted-by == "" && root.line.has-file: Rectangle {
            height: 3px;
        }
        // deleted: the text is gone, only the tombstone remains
        if root.line.deleted-by != "": Text {
            text: "⌫ \{Strings.mv-deleted-by} \{root.line.deleted-by}";
            color: Theme.faint;
            font-size: Theme.fs-body;
            font-italic: true;
        }
        // the reaction row hangs directly off the text. Its height is
        // EXPLICIT: repeated fixed-height pills don't reliably feed the
        // layout's preferred height, and a short row let the next card
        // paint over the pills. Rows without a real id (legacy entries,
        // system lines) never offer the "+" — reacting addresses by id and
        // the UI must not fake success (existing pills still display).
        // The read receipts share this band's RIGHT edge: on their own row
        // below they changed the "+"'s distance to the card edge between
        // own and foreign messages (the band is the card's LAST line, so
        // the "+" hangs at a constant offset from the bottom everywhere).
        if root.line.deleted-by == "" && !root.line.system && (root.line.reactions.length > 0 || (root.line.mine-emoji == "" && root.line.id != "")): HorizontalLayout {
            height: 26px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 4px;
            for r in root.line.reactions: ReactionPill {
                r: r;
                clicked => {
                    root.toggle-reaction(r.emoji);
                }
            }
            if root.line.mine-emoji == "" && root.line.id != "": Rectangle {
                width: 26px;
                height: 22px;
                background: plus-ta.has-hover ? Theme.raised : transparent;
                border-radius: Theme.win95 ? 0px : 11px;
                border-width: Theme.win95 ? Theme.border-w : 0px;
                border-color: Theme.line;
                Text {
                    text: "+";
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                plus-ta := TouchArea {
                    clicked => {
                        react-pop.show();
                    }
                }
                react-pop := PopupWindow {
                    x: 0;
                    y: -52px;
                    EmojiGrid {
                        emoji-picked(emoji) => {
                            root.toggle-reaction(emoji);
                            react-pop.close();
                        }
                    }
                }
            }
            // the surplus width sits between pills and receipts, so the
            // pills stay left and the receipts right (no alignment: the
            // spacer is what pins both sides)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            // read receipts (Lesebestätigung): one dot per member except the
            // author, green once they read it (in read_by), yellow until
            // then — right edge of the band, vertically centred. Hidden when
            // the local read-receipts switch is off and on legacy rows
            // without an id (system lines and tombstones never reach here —
            // the band's own condition excludes them). A receipts row can
            // never appear without this band: receipts imply a real id, and
            // either nobody reacted yet (the "+" shows) or a reaction pill
            // exists.
            if root.receipts-on && root.line.receipts.length > 0 && root.line.id != "": HorizontalLayout {
                spacing: 3px;
                for rc in root.line.receipts: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        // green = read, yellow/amber = not yet (the
                        // presence-dot idiom)
                        background: rc.read ? Theme.good : Theme.warn;
                        dot-ta := TouchArea {
                            // the member name goes through the window-topmost
                            // HintTip overlay (never clipped, grabs no input,
                            // so no strobe)
                            changed has-hover => {
                                if (self.has-hover) {
                                    HintTip.label = rc.name;
                                    HintTip.ax = self.absolute-position.x;
                                    HintTip.ay = self.absolute-position.y + self.height + 6px;
                                } else if (HintTip.ax == self.absolute-position.x
                                    && HintTip.ay == self.absolute-position.y + self.height + 6px) {
                                    HintTip.label = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // quiet affordances, always visible top-right: delete (reddish, kept
    // away from the outer edge), copy, and quote at the very edge — only
    // their shading reacts to hovering; tombstones offer none of them.
    // An own LIVE file share swaps this message-delete for the local-file
    // delete IN THE SAME SLOT (below) — one trash per entry, always in the
    // same place, so chat lines look uniform. Once the file is removed
    // (card grey), deleting the message becomes available again.
    // every affordance below requires the row's stable id (delete, quote,
    // file verbs address by id) — a legacy row without one offers none of
    // them, so the UI can never fake a success the engine would ignore
    if root.line.deleted-by == "" && root.line.id != "" && root.line.has-file && root.line.own && root.line.file-available: Rectangle {
        x: parent.width - 82px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: Theme.win95 ? 0px : 5px;
        background: frm-ta.has-hover ? Theme.raised : transparent;
        Image {
            source: @image-url("assets/trash.svg");
            colorize: frm-ta.has-hover ? Theme.bad : Theme.bad.transparentize(0.45);
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        frm-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.file-remove-requested();
            }
        }
    }
    // deleting a message is the AUTHOR'S verb only (the engine rejects a
    // foreign delete — there is no moderation concept), so the trash is
    // offered solely on OWN rows: an affordance that can only ever produce
    // an error toast would be a lie
    if root.line.deleted-by == "" && root.line.id != "" && root.line.own && !(root.line.has-file && root.line.file-available): Rectangle {
        x: parent.width - 82px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: Theme.win95 ? 0px : 5px;
        background: dt-ta.has-hover ? Theme.raised : transparent;
        Image {
            source: @image-url("assets/trash.svg");
            colorize: dt-ta.has-hover ? Theme.bad : Theme.bad.transparentize(0.45);
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        dt-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.delete-requested();
            }
        }
    }
    // copy needs no id (it is a local clipboard verb) but stays off the
    // synthesized system lines
    if root.line.deleted-by == "" && !root.line.system: Rectangle {
        x: parent.width - 56px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: Theme.win95 ? 0px : 5px;
        background: cp-ta.has-hover ? Theme.raised : transparent;
        Image {
            source: @image-url("assets/copy.svg");
            colorize: cp-ta.has-hover ? Theme.text : Theme.faint;
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        cp-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.copy-requested();
            }
        }
    }
    if root.line.deleted-by == "" && root.line.id != "": Rectangle {
        x: parent.width - 30px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: Theme.win95 ? 0px : 5px;
        background: qb-ta.has-hover ? Theme.raised : transparent;
        Image {
            source: @image-url("assets/quote-arrow.svg");
            colorize: qb-ta.has-hover ? Theme.text : Theme.faint;
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        qb-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.quote-requested();
            }
        }
    }
    } // end card
}

// A small header status pill: coloured dot + label (daemon / chat / sync).
export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> tone;
    // Optional hover hint (e.g. the transport-health reason on the "chat"
    // pill). Empty = no tooltip and the hover area stays pass-through.
    in property <string> tooltip;
    height: 24px;
    width: sp-row.preferred-width + 18px;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 12px;
    border-width: Theme.win95 ? 1px : 0px;
    border-color: Theme.line;
    sp-row := HorizontalLayout {
        x: 9px;
        height: 100%;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            y: (parent.height - self.height) / 2;
            background: root.tone;
        }
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // disabled (pass-through) when there is no tooltip, so pills without one
    // never intercept hover/scroll on the surfaces they sit in
    sp-ta := TouchArea {
        enabled: root.tooltip != "";
    }
    if root.tooltip != "": HoverTip {
        label: root.tooltip;
        shown: sp-ta.has-hover;
        x: (parent.width - self.width) / 2;
        y: parent.height + 6px;
    }
}

// One member in the chat's presence strip (konkinwallet's members strip):
// presence dot + name + last-seen label. Fixed width so the strip can wrap
// the pills into a grid; clicking jumps to Organization → Members.
export component MemberPill inherits Rectangle {
    in property <MemberSync> m;
    callback clicked();
    height: 28px;
    background: mp-ta.has-hover ? Theme.raised : Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 6px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            y: (parent.height - self.height) / 2;
            background: root.m.state == 0 ? Theme.good : (root.m.state == 1 ? Theme.warn : Theme.faint);
        }
        Text {
            text: root.m.name;
            color: Theme.text;
            font-size: Theme.fs-cap;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.m.last;
            color: Theme.faint;
            font-size: Theme.fs-cap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    mp-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A small captioned group box for the Open screen's details panel: caption on
// top, content below, so status lines and their actions read as one theme.
// A small indeterminate spinner: a faint ring with one accent dot orbiting
// it (driven by animation-tick, so it spins as long as it is visible). Used
// wherever the engine is doing off-screen network work the user must see
// as "in progress" rather than a silently empty panel.
export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> tone: Theme.accent;
    width: root.size;
    height: root.size;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.line;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        transform-rotation: Math.mod(animation-tick() / 1200ms, 1.0) * 360deg;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.tone;
        }
    }
}

export component DetailGroup inherits Rectangle {
    in property <string> title;
    // pack: content hugs the top instead of spreading over the panel's
    // height — for form panels that may be granted more height than their
    // content needs (the settings form panels). Default keeps the historic
    // stretch for list-bearing groups.
    in property <bool> pack: false;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    background: Theme.panel-2;
    VerticalLayout {
        alignment: root.pack ? LayoutAlignment.start : LayoutAlignment.stretch;
        padding: 10px;
        spacing: 7px;
        Text {
            text: root.title;
            color: Theme.faint;
            font-size: Theme.fs-cap;
            font-weight: 700;
        }
        @children
    }
}

// One way in on the Restore screen: an icon badge, a bold title, a one-line
// hint and a content row below — visually set apart on a raised surface.
export component RestoreWay inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <image> icon;
    // the screen's one main panel: its title carries the instruction, so it
    // renders headline-sized instead of row-sized
    in property <bool> hero: false;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    background: Theme.panel-2;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Rectangle {
            width: 42px;
            height: 42px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.win95 ? 0px : 10px;
            background: Theme.accent-soft;
            border-width: Theme.border-w;
            border-color: Theme.accent;
            Image {
                source: root.icon;
                colorize: Theme.accent;
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: root.hero ? Theme.fs-h2 : Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                overflow: elide;
            }
            @children
        }
    }
}

// A labeled long-text state row of a proposal card (charter Ist/Soll):
// the text sits in its own bordered panel, capped at roughly five lines —
// anything longer scrolls inside the panel instead of flooding the card.
component CappedStateRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> emphasized: false;
    // raw machine text (a git patch): monospace, and a taller cap — the
    // patch IS the proposal's content, not a footnote
    in property <bool> mono: false;
    in property <length> cap: 96px;
    spacing: 8px;
    Text {
        text: root.label;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        width: 76px;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: min(cs-txt.preferred-height + 12px, root.cap);
        background: Theme.panel;
        border-radius: Theme.win95 ? 0px : 6px;
        border-width: Theme.border-w;
        border-color: Theme.line;
        clip: true;
        cs-fl := Flickable {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            viewport-height: cs-txt.preferred-height + 12px;
            cs-txt := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 24px;
                text: root.value;
                color: root.emphasized ? Theme.text : Theme.dim;
                font-size: Theme.fs-cap;
                font-family: root.mono ? "monospace" : "";
                wrap: word-wrap;
            }
        }
        ScrollHint {
            x: parent.width - 7px;
            view-h: cs-fl.height;
            content-h: cs-fl.viewport-height;
            scroll-y: cs-fl.viewport-y;
        }
    }
}

// One pending proposal: human title ("Vorschlag: …" — the op codes stay
// wire-side), the Ist/Soll pair, the voting row (one pill per roster
// member: ? open · 👍 approved · 👎 declined) and the operator's approve /
// decline decision. Shared by the generic gated panes and Organization →
// Pending. Image changes render the current image and link the proposed
// one like a chat file share: the image bytes rode the proposal payload
// (sign-what-you-see), so a click decodes and shows them locally.
// The decided-votes table (Accepted/Declined overviews, story 2026-08-09):
// one row per decision — its localized title, the decided value, one stance
// dot per member (an accepted row's voters are the sealed block's), the
// decline stamp (Declined only) and the discussion jump. Replaced the gray
// prose list: a decided vote is a record, and records read as rows.
export component DecisionTable inherits Rectangle {
    in property <[ProposalRow]> rows;
    // Declined shows the veto stamp column; Accepted hides it
    in property <bool> with-when: false;
    callback discuss(int);
    // Denied only: pull a patch row's changeset back into the local
    // working set (rescue — shared_memory_real.md §4)
    callback rescue(string);
    // column geometry, shared by header and rows so the cells align; the
    // value column takes the surplus and elides — the window never has to
    // scroll horizontally
    property <length> col-title: max(120px, self.width * 0.24);
    property <length> col-votes: 110px;
    property <length> col-when: 108px;
    // emoji-only jump button (a localized label overflowed the cell);
    // the Denied table fits a second one (the patch rescue)
    property <length> col-jump: root.with-when ? 88px : 48px;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    // EXPLICIT height: repeated fixed-height rows don't reliably feed a
    // layout's preferred height (the ChatRow lesson)
    height: 34px + rows.length * 40px;
    VerticalLayout {
        Rectangle {
            height: 34px;
            background: Theme.raised;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: Strings.dt-col-decision;
                    width: root.col-title;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: Strings.dt-col-value;
                    horizontal-stretch: 1;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: Strings.dt-col-votes;
                    width: root.col-votes;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.with-when: Text {
                    text: Strings.dt-col-when;
                    width: root.col-when;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: root.col-jump;
                }
            }
        }
        for r[i] in root.rows: Rectangle {
            height: 40px;
            background: Math.mod(i, 2) == 1 ? Theme.zebra : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: r.text;
                    width: root.col-title;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    // a patch's value IS a multi-line git patch and a
                    // charter is a whole document — as an index cell both
                    // are unreadable noise. The title names the decision
                    // (a patch title carries its count summary); the
                    // content lives behind the discussion jump. A
                    // superseded patch says so here (the base moved).
                    text: r.superseded ? Strings.pc-superseded
                        : (r.patch-op || r.charter-op ? "" : (r.proposed != "" ? r.proposed : r.current));
                    horizontal-stretch: 1;
                    color: r.superseded ? Theme.moved : Theme.dim;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: root.col-votes;
                    clip: true;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for v in r.votes: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                // green = approved, red = declined, hollow =
                                // open (the vote-pill palette, dot-compact)
                                background: v.vote == 1 ? Theme.good
                                    : (v.vote == 2 ? Theme.bad : Theme.panel);
                                border-width: 1px;
                                border-color: v.vote == 1 ? Theme.good
                                    : (v.vote == 2 ? Theme.bad : Theme.line);
                                vd-ta := TouchArea {
                                    // the member name goes through the
                                    // window-topmost HintTip overlay (never
                                    // clipped, grabs no input, so no strobe)
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            HintTip.label = v.member;
                                            HintTip.ax = self.absolute-position.x;
                                            HintTip.ay = self.absolute-position.y + self.height + 6px;
                                        } else if (HintTip.ax == self.absolute-position.x
                                            && HintTip.ay == self.absolute-position.y + self.height + 6px) {
                                            HintTip.label = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.with-when: Text {
                    text: r.declined-when;
                    width: root.col-when;
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: root.col-jump;
                    // emoji-only: any localized label is wider than a table
                    // cell wants to be — the hover tip names the action
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        if r.id >= 0: AppButton {
                            height: 28px;
                            y: 6px;
                            pad: 8px;
                            emoji: "💬";
                            tooltip: Strings.pc-discuss;
                            tooltip-left: true;
                            clicked => {
                                root.discuss(r.id);
                            }
                        }
                        // rescue: the patch comes back as local drafts
                        if root.with-when && r.patch-op && r.proposed != "": AppButton {
                            height: 28px;
                            y: 6px;
                            pad: 8px;
                            emoji: "⤵️";
                            tooltip: Strings.mem-rescue;
                            tooltip-left: true;
                            clicked => {
                                root.rescue(r.proposed);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ProposalCard inherits Rectangle {
    in property <ProposalRow> p;
    // the republic's CURRENT image, when one is set and locally loadable —
    // the image ops' Ist-Stand renders it (loaded by the Rust side)
    in property <image> org-img;
    in property <bool> org-img-set;
    // Declined view: the decision already fell — no approve/decline
    // buttons, a "declined by … ·  when" line instead. The discussion
    // link stays (the channel is re-openable, read-only).
    in property <bool> read-only: false;
    // COMPACT: the same card sitting above a decision's own chat, as the
    // orientation header for it. Drops the two things that make no sense
    // there — the 240px inline image viewer (this is a header, not a
    // gallery) and the "discuss" button (we ARE in the discussion).
    // Everything that identifies the decision stays.
    in property <bool> compact: false;
    callback approve();
    callback decline();
    // jump into the proposal's discussion — its patch channel on the chat
    // bus (channels are views over the ONE log, chat_bus.md)
    callback discuss();
    // image op only: decode the proposed image from the proposal payload
    // (the bytes crossed the wire with it) and toggle it INLINE below the
    // share card; `inline-open`/`inline-img` echo the window's one-at-a-
    // time viewer state back into this card
    callback view-image();
    in property <bool> inline-open: false;
    in property <image> inline-img;
    // save the proposed image's original bytes to disk (save dialog)
    callback save-image();
    // wiki_patch only: open the raw-patch modal (read-only, copyable)
    callback view-patch();
    // wiki_patch only, retired cards: pull the changeset back into the
    // local working set (rescue — shared_memory_real.md §4)
    callback rescue-patch();
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    // lift the card off the pane background (the bevel theme keeps its
    // flat look — shadows are foreign there)
    drop-shadow-blur: Theme.win95 ? 0px : 12px;
    drop-shadow-offset-y: Theme.win95 ? 0px : 2px;
    drop-shadow-color: #00000026;
    // the whole card opens its discussion — the same thing the 💬 button
    // does. FIRST child on purpose: everything below renders on top of it,
    // so the approve/decline buttons, the image controls and the vote strip
    // keep their own clicks. A compact card is already the header OF that
    // discussion, so it stays inert.
    if !root.compact: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.discuss();
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        // title row: "Vorschlag: <human title>", the raw-patch button and
        // the id tucked at the end (wiki_patch: the diff viewer is the
        // readable form, the raw patch hides behind this one button — a
        // read-only modal, like the charter view)
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: Strings.pc-proposal;
                color: Theme.accent;
                font-size: Theme.fs-body;
                font-weight: 700;
            }
            Text {
                text: root.p.text;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.p.patch-op && root.p.proposed != "": AppButton {
                height: 26px;
                y: 0px;
                pad: 8px;
                emoji: "👁️";
                label: Strings.pc-show-patch;
                clicked => {
                    root.view-patch();
                }
            }
            Text {
                text: "#\{root.p.id}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
            }
        }
        // the verdict line of a retired proposal: a decline names its
        // vetoer; a SUPERSEDE is mechanical — the base moved, nobody voted
        if root.p.declined-by != "" || root.p.superseded: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.p.superseded: Text {
                text: "👎";
                font-family: "Twemoji Mozilla";
                font-size: 22px;
                vertical-alignment: center;
            }
            Text {
                text: root.p.superseded ? Strings.pc-superseded
                    : (root.p.declined-when == ""
                        ? "\{Strings.pc-declined-by} \{root.p.declined-by}"
                        : "\{Strings.pc-declined-by} \{root.p.declined-by} · \{root.p.declined-when}");
                color: root.p.superseded ? Theme.moved : Theme.bad;
                font-size: Theme.fs-body;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        // Ist-Stand / Soll-Stand, when the engine knows them (the
        // Organization edit ops fill both; a plain proposal shows neither).
        // Short values sit inline; the charter pair is capped + scrollable;
        // an image change renders the Ist image and links the Soll file.
        if root.p.current != "" && !root.p.charter-op && !root.p.patch-op && !root.p.image-op && !root.p.relay-op: HorizontalLayout {
            spacing: 8px;
            Text {
                text: Strings.pc-current;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                width: 76px;
            }
            Text {
                text: root.p.current;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.p.proposed != "" && !root.p.charter-op && !root.p.patch-op && !root.p.image-op && !root.p.relay-op: HorizontalLayout {
            spacing: 8px;
            Text {
                text: Strings.pc-proposed;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                width: 76px;
            }
            Text {
                text: root.p.proposed;
                color: Theme.text;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        // set_relays / set_features: the set diff — one row per element of
        // the union, + added (good) / - removed (bad) / kept unmarked
        // (a feature diff can only ever show + and kept: enable-only)
        if root.p.relay-op: VerticalLayout {
            spacing: 3px;
            for c in root.p.relay-changes: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: c.sign == 1 ? "+" : c.sign == 2 ? "-" : "";
                    color: c.sign == 1 ? Theme.good : Theme.bad;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    width: 76px;
                    horizontal-alignment: right;
                }
                Text {
                    text: c.url;
                    color: c.sign == 2 ? Theme.faint : Theme.text;
                    font-size: Theme.fs-cap;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        if root.p.charter-op && root.p.current != "": CappedStateRow {
            label: Strings.pc-current;
            value: root.p.current;
        }
        if root.p.charter-op && root.p.proposed != "": CappedStateRow {
            label: Strings.pc-proposed;
            value: root.p.proposed;
            emphasized: true;
        }
        if root.p.image-op && root.p.current != "": HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: Strings.pc-current;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                width: 76px;
            }
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                if root.org-img-set: Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: Theme.win95 ? 0px : 6px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    clip: true;
                    Image {
                        source: root.org-img;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                Text {
                    text: root.p.current;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    overflow: elide;
                }
            }
        }
        if root.p.image-op && root.p.proposed != "": VerticalLayout {
            spacing: 8px;
            pi-line := HorizontalLayout {
                // NO alignment:start here: it would size the card to its
                // preferred width, which is 0 (the explicitly-positioned
                // pi-row is excluded from it) — a 0-wide card means an
                // invisible, unclickable TouchArea. The card takes an
                // EXPLICIT content-derived width instead (capped so a long
                // file name elides), and the trailing filler absorbs the
                // remaining stretch.
                spacing: 8px;
                Text {
                    text: Strings.pc-proposed;
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    width: 76px;
                }
                // the proposed image, as a chat-style share card: the bytes
                // travel with the proposal (sign-what-you-see) — clicking
                // decodes them locally and toggles the picture below
                Rectangle {
                    // content-sized with two caps: 320px, and the row space
                    // left of the 76px label, the save button and the three
                    // 8px gaps (narrow panes must elide, never overflow)
                    width: min(min(320px, max(0px, pi-line.width - 76px - 34px - 24px)), pi-row.preferred-width + 20px);
                    height: pi-row.preferred-height + 16px;
                    border-radius: Theme.win95 ? 0px : 6px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    background: pi-ta.has-hover ? Theme.raised : Theme.zebra;
                    pi-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.view-image();
                        }
                    }
                    pi-row := HorizontalLayout {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: root.p.proposed;
                                color: Theme.text;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: Strings.pc-img-hint;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                            }
                        }
                    }
                }
                // save the original image bytes to disk, right of the card
                AppButton {
                    width: 34px;
                    pad: 0px;
                    emoji: "💾";
                    tooltip: Strings.pc-img-save;
                    clicked => {
                        root.save-image();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // the inline viewer: the decoded picture inside the panel —
            // no modal; clicking it (or the share card again) closes it
            if root.inline-open && !root.compact: Rectangle {
                height: 240px;
                border-radius: Theme.win95 ? 0px : 6px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                background: Theme.zebra;
                clip: true;
                Image {
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    x: 6px;
                    y: 6px;
                    source: root.inline-img;
                    image-fit: contain;
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.view-image();
                    }
                }
            }
        }
        // the voting row: one pill per roster member with their stance —
        // a big ? while open, 👍 approved (green), 👎 declined (red); the
        // tally caption keeps the threshold visible
        if root.p.votes.length > 0: HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                height: 44px;
                clip: true;
                vp-fl := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: max(self.width, vp-row.preferred-width);
                    viewport-height: self.height;
                    vp-row := HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for v in root.p.votes: Rectangle {
                            height: 40px;
                            y: 1px;
                            width: vp-pill.preferred-width + 24px;
                            border-radius: Theme.win95 ? 0px : 20px;
                            border-width: 1px;
                            border-color: v.vote == 1 ? Theme.good.transparentize(0.45)
                                : (v.vote == 2 ? Theme.bad.transparentize(0.45) : Theme.line);
                            background: v.vote == 1 ? Theme.good.transparentize(0.86)
                                : (v.vote == 2 ? Theme.bad.transparentize(0.86) : Theme.panel);
                            vp-pill := HorizontalLayout {
                                x: 12px;
                                height: 100%;
                                spacing: 7px;
                                alignment: start;
                                // thumbs render in the colorful Twemoji font
                                // (a plain-text glyph falls back to a thin
                                // monochrome outline); the open "?" is a
                                // deliberate TEXT glyph, bold and warn-tinted
                                if v.vote == 0: Text {
                                    text: "?";
                                    color: Theme.warn;
                                    font-size: 26px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                                if v.vote != 0: Text {
                                    text: v.vote == 1 ? "👍" : "👎";
                                    font-family: "Twemoji Mozilla";
                                    font-size: 24px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: v.member;
                                    color: Theme.dim;
                                    font-size: Theme.fs-cap;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            Text {
                text: "\{root.p.approvals}/\{root.p.threshold}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        // approve/decline only while the vote is open (`read-only` gates
        // them), and each GRAYED exactly where the engine would refuse the
        // click (clickable OR grayed, never click-then-refusal — story
        // 2026-08-09): a cast stance disables approve; a standing decline
        // disables both; decline stays live after the own approval, which
        // is the proposer's withdrawal path. The discussion link ALWAYS
        // shows: a decided vote's discussion stays linked and re-openable
        // (read-only, the engine refuses new writes there)
        HorizontalLayout {
            spacing: 8px;
            if !root.read-only: AppButton {
                emoji: "👍";
                label: Strings.mv-approve;
                primary: true;
                enabled: root.p.my-vote == 0;
                clicked => {
                    root.approve();
                }
            }
            if !root.read-only: AppButton {
                emoji: "👎";
                label: Strings.mv-decline;
                enabled: root.p.my-vote != 2;
                clicked => {
                    root.decline();
                }
            }
            // a retired patch's way back: its changeset returns as
            // LOCAL drafts (best-effort, honest toast)
            if root.p.patch-op && root.p.proposed != "" && !root.p.applied
                && (root.read-only || root.p.superseded): AppButton {
                emoji: "⤵️";
                label: Strings.mem-rescue;
                clicked => {
                    root.rescue-patch();
                }
            }
            // pull back — the proposer's first-class exit, own proposals
            // only (`p.mine`). NOT armed yet: the engine withdraw (wire
            // event + convergence) is designed in molt-engine
            // proposals.rs at cmd_decline — until it lands, the honest
            // state is a grayed button, not a fake one.
            if !root.read-only && root.p.mine: AppButton {
                emoji: "↩️";
                label: Strings.pc-withdraw;
                enabled: false;
                tooltip: Strings.not-implemented-yet;
                clicked => { }
            }
            if !root.compact: AppButton {
                emoji: "💬";
                label: Strings.pc-discuss;
                clicked => {
                    root.discuss();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// A subordinate row on the Restore screen: indents its content behind a
// tree rail (vertical guide line + a stub into the panel), making visually
// clear that the ways in depend on the recovery phrase above. While no
// phrase is set (`armed: false`) the branch is dimmed.
export component WayBranch inherits Rectangle {
    in property <bool> armed: true;
    in property <bool> last: false;
    opacity: root.armed ? 1.0 : 0.55;
    animate opacity {
        duration: 150ms;
    }
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 30px;
            // vertical guide: bridges the row gap above; the last branch
            // stops at its own stub (L shape)
            Rectangle {
                x: 13px;
                y: -12px;
                width: 2px;
                height: root.last ? parent.height / 2 + 13px : parent.height + 24px;
                background: Theme.line;
            }
            // stub into the panel
            Rectangle {
                x: 13px;
                y: parent.height / 2 - 1px;
                width: 17px;
                height: 2px;
                background: Theme.line;
            }
        }
        @children
    }
}

// The recovery-phrase panel: masked by default, hold the eye button to peek
// at the real phrase, Copy puts it on the clipboard (via `copy-requested`).
// Used by the Open screen's details and the founding result.
export component SeedPanel inherits Rectangle {
    in property <string> seed;
    callback copy-requested();
    // all mock seeds are 12 words, so the masked form is a constant
    property <string> mask: "***  ***  ***  ***  ***  ***  ***  ***  ***  ***  ***  ***";
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        // warning stripe
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: Theme.bad;
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: hold-ta.pressed ? root.seed : root.mask;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // hold-to-peek: shows the seed only while the mouse button
                // is held down
                Rectangle {
                    width: 38px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius;
                    border-width: Theme.border-w;
                    border-color: hold-ta.pressed ? Theme.accent : Theme.line;
                    background: hold-ta.pressed ? Theme.accent-soft : (hold-ta.has-hover ? Theme.raised : Theme.panel);
                    Image {
                        source: @image-url("assets/eye.svg");
                        colorize: Theme.text;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    hold-ta := TouchArea { }
                    HoverTip {
                        label: Strings.ow-hold-tip;
                        shown: hold-ta.has-hover && !hold-ta.pressed;
                        x: (parent.width - self.width) / 2;
                        y: -(self.height + 7px);
                    }
                }
                AppButton {
                    height: 30px;
                    pad: 10px;
                    y: (parent.height - self.height) / 2;
                    label: Strings.ow-copy;
                    clicked => {
                        root.copy-requested();
                    }
                }
            }
            Text {
                text: Strings.ow-seed-note;
                color: Theme.bad;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
            }
        }
    }
}

// The wizards' shared last step (create + join): the freshly minted recovery
// phrase, and the re-typed proof it was backed up — `enter` fires only while
// `armed` (the caller's engine-side phrase match), and entering IS the backup
// confirmation.
export component SeedConfirmStep inherits VerticalLayout {
    in property <string> seed;
    in property <image> icon;
    // the re-typed phrase matches — computed by the caller (engine rule)
    in property <bool> armed;
    // the action button's label: "Enter republic" post-seal (legacy),
    // "Confirm backup" during the ❻½ ritual round
    in property <string> action-label: Strings.enter-republic;
    in-out property <string> check;
    callback enter();
    callback copy-requested();
    vertical-stretch: 1;
    spacing: 12px;
    alignment: start;
    Text {
        text: Strings.cw-seed-confirm-title;
        color: Theme.text;
        font-size: Theme.fs-h2;
        font-weight: 700;
        wrap: word-wrap;
    }
    SeedPanel {
        seed: root.seed;
        copy-requested => {
            root.copy-requested();
        }
    }
    Text {
        text: Strings.cw-seed-confirm-hint;
        color: Theme.dim;
        font-size: Theme.fs-body;
        wrap: word-wrap;
    }
    AppField {
        text <=> root.check;
        placeholder: Strings.cw-seed-confirm-ph;
        // Enter confirms, exactly like the button — behind the SAME gate
        accepted => {
            if (root.armed) {
                root.enter();
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            horizontal-stretch: 1;
        }
        AppButton {
            height: 38px;
            primary: true;
            icon: root.icon;
            icon-set: true;
            label: root.action-label;
            enabled: root.armed;
            clicked => {
                root.enter();
            }
        }
    }
}

// The shared run view for the engine-ticked mock runs (restore / found /
// join): the way panel with a progress bar and phase line, an optional
// success slot (`@children`, used for the founding result), the live detail
// log, and an outcome-gated Back/Finish footer. The engine owns progress,
// log and outcome — this component only renders and reports clicks.
export component RunView inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <image> icon;
    in property <float> progress;
    // 0 = running, 1 = succeeded, 2 = failed
    in property <int> outcome;
    in property <string> ph1;
    in property <string> ph2;
    in property <string> ph3;
    // optional extra phase for the 30–50% window (the join's "accepted,
    // waiting for the founder's charter" stage); "" = fall through to ph2
    in property <string> ph-founder: "";
    in property <string> failed-label;
    // the ONE thing that went wrong, in a few words — rendered large and in
    // the signal colour. The log below keeps the detail; a failure an
    // operator must act on cannot live at the end of a small technical line.
    in property <string> headline;
    in property <[string]> log;
    // per-line tone (0 neutral, 1 good, 2 bad), computed Rust-side from the
    // ✓/✗ prefix; an empty model keeps every line neutral
    in property <[int]> tones;
    // the founding hides the log on success to make room for its result
    in property <bool> show-log: true;
    // the founding cannot fail, so it hides the (never armed) back button
    in property <bool> back-shown: true;
    in property <bool> back-enabled: false;
    in property <bool> finish-enabled: false;
    in property <string> finish-label;
    callback back();
    callback finish();
    callback copy-log-clicked();
    spacing: 12px;

    RestoreWay {
        title: root.title;
        hint: root.hint;
        icon: root.icon;
        VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 10px;
                border-radius: Theme.win95 ? 0px : 5px;
                background: Theme.panel;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * root.progress;
                    height: parent.height;
                    background: root.outcome == 2 ? Theme.bad : Theme.accent;
                }
            }
            if root.outcome == 2 && root.headline != "": Text {
                text: root.headline;
                color: Theme.bad;
                font-size: Theme.fs-h1;
                font-weight: 700;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    // the headline already named the cause — repeating a
                    // generic "failed" under it is the second statement the
                    // eye has to reconcile, and for a relay-gate refusal the
                    // old label ("invite rejected") contradicted it outright
                    text: root.outcome == 2
                        ? (root.headline == "" ? root.failed-label : "")
                        : (root.progress < 0.3 ? root.ph1
                            : (root.progress < 0.5 && root.ph-founder != "" ? root.ph-founder
                            : (root.progress < 0.75 ? root.ph2 : root.ph3)));
                    color: root.outcome == 2 ? Theme.bad : Theme.dim;
                    font-size: Theme.fs-cap;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "\{Math.round(root.progress * 100)} %";
                    color: Theme.text;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                }
            }
        }
    }

    @children

    // live details: what is fetched, derived and copied where —
    // auto-scrolls to each new line; fills the remaining height
    if root.show-log: Rectangle {
        vertical-stretch: 1;
        background: Theme.panel-2;
        border-radius: Theme.win95 ? 0px : 8px;
        border-width: Theme.border-w;
        border-color: Theme.line;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Strings.rw-log-title;
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                AppButton {
                    height: 26px;
                    pad: 9px;
                    label: Strings.ow-copy;
                    clicked => {
                        root.copy-log-clicked();
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                logfl := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    viewport-height: loglines.preferred-height;
                    // pinned to the bottom: auto-scrolls on every new
                    // line (a manual drag detaches the pin)
                    viewport-y: min(0px, self.height - self.viewport-height);
                    loglines := VerticalLayout {
                        spacing: 3px;
                        alignment: start;
                        for line[i] in root.log: Text {
                            text: line;
                            // terminal ✓/✗ lines stand out of the gray flow
                            color: i < root.tones.length
                                ? (root.tones[i] == 2 ? Theme.bad
                                    : root.tones[i] == 1 ? Theme.good : Theme.dim)
                                : Theme.dim;
                            font-size: Theme.fs-cap;
                            // WRAP, never elide: a failure line's tail is the
                            // part that says what to DO about it — eliding it
                            // is how "the invitation was refused" reached the
                            // operator with no reason at all (2026-08-01)
                            wrap: word-wrap;
                        }
                    }
                }
                ScrollHint {
                    x: parent.width - 7px;
                    view-h: logfl.height;
                    content-h: logfl.viewport-height;
                    scroll-y: logfl.viewport-y;
                }
            }
        }
    }

    // back arms only after a failure; finish arms only after success and
    // jumps straight into the workspace
    HorizontalLayout {
        spacing: 10px;
        if root.back-shown: AppButton {
            label: Strings.nav-back;
            enabled: root.back-enabled;
            clicked => {
                root.back();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // no label = no button: a caller without a finish action must not
        // render an empty, permanently-dead primary button
        if root.finish-label != "": AppButton {
            primary: true;
            label: root.finish-label;
            enabled: root.finish-enabled;
            clicked => {
                root.finish();
            }
        }
    }
}

/// A blocking "this is running" overlay: the screen behind is dimmed, a
/// spinner says the work is alive even while the progress bar is still at
/// zero, and ONE button gets the operator back out.
///
/// The spinner and the bar answer different questions and neither replaces
/// the other — the bar says how far, the spinner says whether anything is
/// happening at all, which is the question during the first seconds when the
/// bar has not moved yet.
export component BusyModal inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <float> progress;
    in property <string> cancel-label;
    in property <length> dialog-width: 420px;
    callback cancelled();
    width: 100%;
    height: 100%;
    background: #0000008c;
    // swallow clicks so the dimmed screen behind really is inert
    TouchArea {}
    Rectangle {
        width: root.dialog-width;
        height: card.preferred-height;
        background: Theme.panel;
        border-radius: Theme.win95 ? 0px : 12px;
        border-width: Theme.border-w;
        border-color: Theme.line;
        card := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Spinner {
                    size: 18px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.fs-h2;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
            }
            Rectangle {
                height: 10px;
                border-radius: Theme.win95 ? 0px : 5px;
                background: Theme.panel-2;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * root.progress;
                    height: parent.height;
                    background: Theme.accent;
                }
            }
            HorizontalLayout {
                alignment: end;
                AppButton {
                    label: root.cancel-label;
                    clicked => {
                        root.cancelled();
                    }
                }
            }
        }
    }
}

// The wiki-patch diff viewer heading a patch decision's discussion: left
// the patch's files (moved/deleted marked as such), right the selected
// file's rendered diff — added characters green, removed characters red,
// each on a soft tint so whitespace changes stay visible. Read-only by
// design: browsing a vote's content never edits anything; the raw patch
// sits behind the proposal card's own button.
export component DiffViewer inherits Rectangle {
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    height: 320px;
    clip: true;
    // ONE tone vocabulary with the wiki, plus the viewer's own move tone:
    // added good · modified warn · deleted bad · moved purple; segments
    // plain/green/red/faint-meta
    pure function file-color(status: int) -> color {
        return status == 1 ? Theme.good
            : status == 3 ? Theme.bad
            : status == 4 ? Theme.moved
            : Theme.warn;
    }
    pure function seg-color(tone: int) -> color {
        return tone == 1 ? Theme.good
            : tone == 2 ? Theme.bad
            : tone == 3 ? Theme.faint
            : Theme.text;
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        // ---- left: the patch's files, wiki-navigator look ----
        Rectangle {
            width: 220px;
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            clip: true;
            nav-fl := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: max(self.height, PatchView.nav-rows.length * 28px + 8px);
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;
                    for r[idx] in PatchView.nav-rows: Rectangle {
                        height: 26px;
                        border-radius: Theme.win95 ? 0px : 5px;
                        background: r.selected ? Theme.accent-soft
                            : (nta.has-hover ? Theme.zebra : transparent);
                        if r.selected: Rectangle {
                            x: 0;
                            y: 0;
                            width: 3px;
                            height: parent.height;
                            background: Theme.accent;
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 6px;
                            Rectangle {
                                width: 16px;
                                height: 100%;
                                clip: true;
                                Text {
                                    text: "📄";
                                    font-family: "Twemoji Mozilla";
                                    font-size: 11px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    opacity: r.status == 3 ? 0.5 : 1.0;
                                }
                            }
                            Text {
                                text: r.label;
                                color: root.file-color(r.status);
                                font-size: Theme.fs-nav;
                                font-weight: r.selected ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if r.marker != "": Text {
                                text: r.marker;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                font-italic: true;
                                vertical-alignment: center;
                            }
                        }
                        nta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                PatchView.select(idx);
                            }
                        }
                    }
                }
            }
            ScrollHint {
                x: parent.width - 5px;
                view-h: nav-fl.height;
                content-h: nav-fl.viewport-height;
                scroll-y: nav-fl.viewport-y;
            }
        }
        // ---- right: the selected file's diff, headed by its path ----
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            clip: true;
            VerticalLayout {
                // the breadcrumb strip: which file, in its change tone
                Rectangle {
                    height: 30px;
                    background: Theme.panel-2;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: PatchView.sel-label;
                            color: root.file-color(PatchView.sel-status);
                            font-size: Theme.fs-cap;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if PatchView.sel-marker != "": Text {
                            text: PatchView.sel-marker;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            font-italic: true;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle {
                        x: 0;
                        y: parent.height - Theme.border-w;
                        width: parent.width;
                        height: Theme.border-w;
                        background: Theme.line;
                    }
                }
                // the diff rows (scrolls both ways: char-level rows must
                // not wrap, a wrapped diff line reads as two)
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    df := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: max(self.width, dcol.preferred-width + 20px);
                        viewport-height: max(self.height, dcol.preferred-height + 16px);
                        dcol := VerticalLayout {
                            x: 10px;
                            y: 8px;
                            width: max(df.width, self.preferred-width) - 20px;
                            alignment: start;
                            for r in PatchView.rows: HorizontalLayout {
                                alignment: start;
                                height: 20px;
                                for s in r.segs: Rectangle {
                                    width: st.preferred-width;
                                    border-radius: Theme.win95 ? 0px : 3px;
                                    background: s.tone == 1 ? Theme.good.transparentize(0.82)
                                        : s.tone == 2 ? Theme.bad.transparentize(0.82)
                                        : transparent;
                                    st := Text {
                                        text: s.text;
                                        color: root.seg-color(s.tone);
                                        font-family: "monospace";
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                        height: 100%;
                                    }
                                }
                            }
                        }
                    }
                    ScrollHint {
                        x: parent.width - 5px;
                        view-h: df.height;
                        content-h: df.viewport-height;
                        scroll-y: df.viewport-y;
                    }
                }
            }
        }
    }
}
