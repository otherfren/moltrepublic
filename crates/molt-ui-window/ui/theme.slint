// SPDX-License-Identifier: GPL-3.0-or-later
//
// Design tokens, the screen-router enum, and the localized string table.
// `Strings` is populated from Rust (`apply_strings`) per language, so switching
// languages at runtime is just re-setting these properties.

// The multi-stage flow, modelled after konkinwallet's AppScreen state machine.
export enum AppScreen {
    choice,    // first-run: create / open / join / restore
    create,    // create-workspace wizard
    open,      // open a local workspace (real disk scan)
    join,      // join via invite (real join ritual)
    restore,   // restore from backup / seed (file/S3 restore + recovery)
    settings,  // config.toml editor (persists to disk)
    main,      // placeholder main view (surfaces land in Phase B)
}

// One emoji reaction tally on a chat message; `mine` marks the emoji the
// local member picked (accent-highlighted pill, click to un-react).
export struct ReactionItem {
    emoji: string,
    count: int,
    mine: bool,
}

// One per-member read receipt on a chat message (Lesebestätigung): a dot per
// member EXCEPT the author — green once `read`, yellow until then.
export struct ReceiptItem {
    name: string, // the member this dot represents (hover shows it)
    read: bool, // true = they have confirmed reading (green); false = not yet (yellow)
}

// One line in a surface's log: for chat, `lead` is the sender and `text` the
// body; for gated surfaces `lead` is empty and `text` is the proposal summary.
export struct LogLine {
    id: string, // stable message id (32-char hex; "" on legacy entries — such rows offer NO id-requiring actions)
    lead: string,
    text: string,
    when: string, // "2026-06-02 13:37 (~20 minutes ago)", grey in the header
    quote: int, // quoted row in the DISPLAYED log (-1 = none/out of view)
    system: bool, // a UI-synthesized governance line (patch channels): quiet, no author, no actions
    quote-label: string, // "author: body" teaser of the quoted message ("" = no quote; may be set with quote == -1 for a cross-channel quote)
    quote-indent: int, // reply-indent depth: 0 = none, 1/2 alternate between neighboring quote groups of different targets
    deleted-by: string, // who deleted the message ("" = live)
    first: bool, // starts a new author block (shows the name + time header)
    own: bool, // the local member wrote it
    alt: bool, // author-block zebra stripe (flips when the author changes)
    mine-emoji: string, // the local member's reaction ("" = none yet)
    reactions: [ReactionItem],
    receipts: [ReceiptItem], // per-member read receipts (every member but the author); shown only when the local read-receipts switch is on
    has-file: bool, // the message carries a shared file's metadata
    file-name: string,
    file-meta: string, // rendered "1.2 MiB · PDF · 2026-07-01"
    file-available: bool, // still on the sharer's disk (false = removed)
    patch-id: int, // the proposal an applied row came from (-1 = unknown origin: chat rows, legacy dumps) — gates the 💬 jump into its discussion
}

// One row of the Chain-History settings panel: a committed block of the
// open republic (WP4b read_chain — the MCP tool serves the same view).
export struct ChainRow {
    height: string, // block number ("-" for pre-cut entries a pruned holder rebuilds from its blob)
    kind: string, // localized kind label (founding/membership/checkpoint) or "" for applied
    surface: string, // localized surface name for applied blocks ("" otherwise)
    title: string, // display title (op-placeholder translated, or the membership/checkpoint text)
    signers: string, // "petra, walter" ("" on pre-cut entries — signatures dropped with the history)
}

// One row of the create wizard's relay picker: a relay this node can dial,
// and whether the founder chose it for the republic. The pick becomes the
// invites' list and (R3) the pool every member signs into the genesis, so it
// must be a deliberate set — not whatever the settings page held.
export struct RelayPick {
    url: string,
    picked: bool,
}

// One relay of the Nostr relay pool, as Settings → Nostr relays renders it: the
// stored facts (url, confirmed) plus what the ENGINE derived from them. The
// GUI never re-decides the dial policy — `kind` and `blocked` arrive
// decided (`docs_archive/transport/relay_pool.md`), the panel only labels them.
export struct RelayItem {
    url: string,
    kind: int, // 0 = onion · 1 = clearnet · 2 = local — derived from the URL, never stored
    confirmed: bool, // the user's persisted "yes, use this relay"
    blocked: int, // 0 = in use right now · 1 = unconfirmed · 2 = outside Tor, not activated this session
    pos: int, // 1-based priority position (the list ORDER is the priority)
    first: bool, // at the top — the "higher priority" control is dead
    last: bool, // at the bottom — the "lower priority" control is dead
}

// One chat channel in the sidebar (chat bus): a VIEW over the one log,
// never a boundary. Built Rust-side from the engine's channel enumeration.
export struct ChannelItem {
    key: string, // "group" | "patch:<id>" | "topic:<name>" — the select-channel address
    label: string, // display label ("" for group: the UI substitutes Strings.ch-group)
    icon: string, // Twemoji glyph per kind
    unread: int, // messages since last seen (0 = caught up)
}

// One member's stance on a pending proposal (the voting row's pills).
export struct MemberVoteMark {
    member: string,
    vote: int, // 0 = not voted yet, 1 = approved, 2 = declined
}

// One row of a set_relays vote card's pool diff (the union of current and
// proposed pool, each member marked).
export struct RelayChange {
    sign: int, // 0 = kept, 1 = added, 2 = removed
    url: string,
}

// A pending proposal on a gated surface, with its approval progress.
export struct ProposalRow {
    id: int,
    text: string, // human title (the op codes stay wire-side)
    approvals: int,
    threshold: int,
    current: string, // Ist-Stand ("" = unknown → line hidden)
    proposed: string, // Soll-Stand ("" = no value → line hidden)
    image-op: bool, // set_image / remove_image → picture + preview link
    img-b64: string, // a pending set_image's embedded bytes (base64; "" else)
    charter-op: bool, // set_charter → long text, capped + scrollable
    patch-op: bool, // wiki_patch → the raw git patch, monospace + scrollable
    relay-op: bool, // set_relays → the card renders the pool diff rows
    relay-changes: [RelayChange], // union of current+proposed pool, marked
    votes: [MemberVoteMark], // per-member stance, roster order
    declined-by: string, // "" = not declined (the Declined view fills it)
    declined-when: string, // human "when" label of the decline
    // the READING member's own stance (0 open · 1 approved · 2 declined):
    // a cast stance grays the vote buttons (clickable OR grayed, never
    // click-then-refusal)
    my-vote: int,
    // the READING member proposed it — shows the "pull back" button
    mine: bool,
    // the supersede walk retired it (base moved) — "superseded", never
    // "declined by"
    superseded: bool,
    // the vote ended by APPLYING — its changes live in the base, so the
    // card never offers the rescue
    applied: bool,
    // the proposer pulled it back — "pulled back", never "declined by"
    withdrawn: bool,
    // unread entries in the vote's discussion channel (💬 badge; 0 = none)
    unread: int,
}

// One member of a republic with its last-sync info (mock data).
export struct MemberSync {
    name: string,
    last: string, // human "last synced" label, e.g. "2 min ago"
    state: int, // 0 = synced, 1 = syncing, 2 = offline
}

// One row of the Organization → Members table (engine ReadMembers — the
// same projection the MCP read_members tool serves).
export struct MemberRow {
    name: string,
    id: string, // identity-key fingerprint ("" on demo/unanchored workspaces)
    pk: string, // full anchored identity key, lowercase hex ("" unanchored)
    last: string, // human "last seen" label (mock)
    state: int, // 0 = synced, 1 = syncing, 2 = offline (mock presence)
    uploads: int, // files this member shared into the chat
    split: string, // R4 relay-split marker, pre-built by the engine ("" = none)
    // the seat's own vote-gated profile (member_profiles_plan.md §5)
    avatar: image, // the decoded picture (empty while none is applied)
    avatar-set: bool, // whether `avatar` really carries one
    avatar-path: string, // the local file the engine materialized ("" = none)
    desc: string, // the seat's description ("" = none)
}

// One row of the Organization → Uploads table (engine ReadUploads — the
// same projection the MCP read_uploads tool serves). Labels arrive
// pre-rendered from Rust.
export struct UploadRow {
    id: string, // the carrying chat message id (what download-file takes)
    user: string,
    date: string,
    name: string,
    kind: string,
    size: string,
    available: bool,
    online: bool, // sharer reachable (user-to-user transfer needs them)
    checksum: string, // shortened real sha256 (full value via MCP)
    expires: string, // "in 13 days" · "expired" · "-" (unavailable)
    status: string, // live download status ("" idle · "42 %" · check/warn)
    status-kind: int, // 0 idle · 1 running · 2 done · 3 failed
    // §5.5: the relay plane's raw availability word — "relay-held" (the
    // relays serve it, no live sharer needed) · "sharer-only" · "gone"
    availability: string,
}

// One row of the founding-ritual member list: the founder plus one per
// seat. `detail` is the invite link while waiting, else the join status.
export struct RitualSeat {
    member: string, // display name, or "Invite k" while unactivated
    detail: string, // the molt:// link, or the join/seal status
    state: int, // 0 = waiting, 1 = key received, 2 = sealed (green)
}

// A local workspace/republic shown in the Open screen list.
export struct WorkspaceItem {
    id: string, // the workspace id — the sole address of workspace verbs
    name: string,
    detail: string,
    status: string,
    synced: bool,
    state: int, // 0 = synced, 1 = syncing, 2 = offline
    last-sync-min: int, // minutes since the last completed sync (sort key)
    s3: bool, // automatic S3 backup configured
    backup: string, // human "last backup" label, e.g. "30 min ago" / "never"
    encrypted: bool, // at-rest sealed (S6, real): open refuses until unsealed
    seed: string, // recovery seed all secret keys derive from (real entropy, device-sealed)
    net: string, // effective global anonymity network at founding/join ("tor" | "none"; demo entries may carry legacy values)
    members: [MemberSync], // who is in the DAO + when they last synced
}

// One row of the settings backup table: a local workspace, its backup in
// the S3 bucket, or both. Built Rust-side from the session's workspaces +
// the bucket-only orphans; prose cells (size/last) are rendered there too.
export struct BackupRow {
    id: string, // workspace id: the local id, or a bucket-only row's id pseudonym ("" = foreign key)
    local: string, // local workspace name ("" = bucket-only)
    remote: string, // backup name in the bucket ("" = not backed up)
    has-local: bool, // false = orphan row, auto-backup not toggleable
    auto: bool, // automatic backup on
    size: string, // human size, e.g. "1.8 MiB"
    last: string, // human last-backup, e.g. "30 min ago" / "never"
    size-kib: int, // machine sort key for the size column
    last-min: int, // machine sort key for the last-backup column (max = never)
}

// The parsed preview of an invite link on the Join screen. Filled by Rust via
// the pure `parse-invite` callback (the same molt-engine parser the join run
// uses, so the preview and the run can never disagree).
export struct InvitePreview {
    valid: bool,
    republic: string,
    rule: string, // "m-of-n"
    inviter: string,
    // the republic's relays, as the invite names them, and how many of them
    // this node is still missing — the join gate refuses on exactly that
    missing-relays: int,
}

// What the Restore wizard's ONE link field is holding. Filled by Rust via
// the pure `classify-link` callback (`molt_ui::link_kind`), which asks the
// engine's own two parsers - so the panel and the flow it starts can never
// disagree about what the link is.
export struct LinkPreview {
    // 0 = nothing usable (empty, junk, or a preview link with no transport
    // handover), 1 = a founding invite (join), 2 = a recovery link
    kind: int,
    republic: string,
    // invite: who minted it · recovery: the seat coming back
    who: string,
    // how many of the link's relays this node does NOT have, and the first
    // such URL — a pool deviation is a hard blocker (relays do not
    // federate), so the panel shows it loudly before the run can fail
    missing: int,
    missing-first: string,
}

// One sub-view of a surface (nav entry), from molt-core's shared view list.
// `icon` is a Twemoji glyph (colorful emoji font), picked in Rust per key.
export struct ViewItem {
    key: string,
    name: string,
    icon: string,
}

// One of the five surfaces, with live counts and its log + pending proposals.
export struct SurfaceTab {
    key: string,
    name: string,
    gated: bool,
    applied-count: int,
    pending-count: int,
    // the approvals table splits pending by the reader's own vote
    // (engine-derived: ProposalView.approved_by_me / snapshot.denied)
    pending-voted-count: int,
    pending-my-vote-count: int,
    denied-count: int, // ALL declines (status strip)
    declined-count: int, // declines inside the display-retention window
    // the paged outcome lists' echo (page size 15, Rust-side slice):
    // 1-based current page + page count for the "page x of y" pager row.
    // `log`/`declined` below hold ONLY the current page; the counts above
    // stay full-list.
    applied-page: int,
    applied-pages: int,
    declined-page: int,
    declined-pages: int,
    pending-page: int,
    pending-pages: int,
    log: [LogLine],
    pending: [ProposalRow],
    declined: [ProposalRow], // the retained declines (Declined view)
    // the applied history as decision rows, newest first (Accepted table):
    // proposal-backed rows carry their sealed block's voters, legacy rows
    // (id -1) only their title — paged in lockstep with `log`
    accepted: [ProposalRow],
    views: [ViewItem], // its nav sub-views, default first
}

// ---- the Multisig-Wiki mock's model face --------------------------------
// Flat rows built by the Rust state machine (crates/molt-ui/src/wiki.rs);
// the pane renders them and routes every action back through WikiState.

// One navigator row, in display order.
export struct WikiNavRow {
    is-folder: bool,
    id: int, // file rows only; 0 for folders
    label: string, // last path segment (display)
    path: string, // folder rows: the FULL folder path (the verbs' identity)
    depth: int, // tree depth, 0 = root level (drives the indent)
    open: bool, // folder fold state
    marked: bool,
    status: int, // 0 unchanged · 1 added · 2 modified · 3 deleted
    renaming: bool,
}

// One tab-strip row, in OPEN order (close-right/left and ⬅️/➡️ walk this).
export struct WikiTabRow {
    id: int,
    label: string,
    active: bool,
    status: int,
}

// One pseudo-rendered block of the active doc, with its diff verdict.
// One inline run of a block: `link` is empty for plain text, else the
// .md target the run points at (clickable in the preview).
export struct WikiSpan {
    text: string,
    link: string,
}

export struct WikiBlock {
    kind: int, // 0 h1 · 1 h2 · 2 paragraph · 3 bullet · 4 code
    text: string,
    status: int, // 0 same · 1 added · 2 changed · 3 removed ghost
    spans: [WikiSpan],
}

// One changeset-panel stack row: the action log, oldest first.
export struct WikiChangeRow {
    kind: int, // 0 created · 1 folder · 2 renamed · 3 moved · 4 deleted · 5 edited
    label: string,
}

// ---- the wiki-patch diff viewer's model face ----------------------------
// A wiki_patch proposal's parsed patch (crates/molt-ui/src/patchview.rs):
// left the changed files, right the selected file's rendered diff.

// One file of the patch in the viewer's navigator.
export struct PatchNavRow {
    label: string,
    marker: string, // "<moved>" / "<deleted>" / ""
    status: int, // 1 added · 2 modified · 3 deleted (the wiki tones)
    selected: bool,
}

// One colored run of a diff row.
export struct DiffSeg {
    text: string,
    tone: int, // 0 plain · 1 added (green) · 2 removed (red) · 3 meta
}

// One display row of the details pane.
export struct DiffRow {
    segs: [DiffSeg],
}

// The diff viewer's shared state: filled by the Rust bridge whenever a
// wiki_patch decision is selected; `select` re-fills `rows` for a file.
export global PatchView {
    // which proposal id the parse belongs to (0 = none) — the pending
    // list renders its inline viewer only under exactly that card
    in-out property <int> for-id;
    in-out property <[PatchNavRow]> nav-rows;
    in-out property <[DiffRow]> rows;
    // the selected file, for the details pane's header strip
    in-out property <string> sel-label;
    in-out property <string> sel-marker;
    in-out property <int> sel-status;
    callback select(int); // navigator row index
}

// The wiki pane's shared state + action bus: properties are pushed by the
// Rust bridge after every mutation, callbacks are implemented there. The
// app root also drives it (Ctrl+W / Del / Enter routing).
// One doc of the folded engine base (the shared wiki's truth).
export struct WikiBase {
    path: string,
    content: string,
}

export global WikiState {
    in-out property <[WikiNavRow]> nav-rows;
    // the engine-folded BASE + its revision, written by the surfaces
    // mirror; base-arrived hands them to the Rust wiki model (the
    // Send-bound bundle closure cannot hold the model directly)
    in-out property <[WikiBase]> base-docs;
    in-out property <int> base-rev;
    callback base-arrived();
    // the ACTIVE workspace id (drafts are per workspace): a change resets
    // the model and loads that workspace's stored draft (WP-D)
    in-out property <string> ws-id;
    callback workspace-changed();
    callback draft-loaded(string);
    in-out property <[WikiTabRow]> tabs;
    // the active doc (empty state when doc-open is false)
    in-out property <bool> doc-open;
    in-out property <string> doc-path;
    in-out property <string> doc-meta;
    in-out property <int> doc-status;
    in-out property <[WikiBlock]> blocks;
    in-out property <[string]> links;
    in-out property <string> raw; // the raw editor's buffer (two-way)
    in-out property <bool> editing;
    in-out property <bool> can-reveal;
    in-out property <bool> has-marked;
    // the changeset panel: NET counts + the action stack. The panel is
    // visible while the stack is non-empty.
    in-out property <int> cs-added;
    in-out property <int> cs-deleted;
    in-out property <int> cs-moved;
    in-out property <int> cs-lines;
    in-out property <[WikiChangeRow]> cs-rows;
    // The export gate, in ONE place: an export writes the APPROVED base
    // tree, so an empty base means there is nothing to export - the local
    // stack is a separate question the dialog answers with draft-count().
    public pure function has-base() -> bool {
        return root.base-docs.length > 0;
    }
    public pure function draft-count() -> int {
        return root.cs-rows.length;
    }
    callback nav-mark(int);
    callback nav-open(int);
    callback nav-toggle-folder(string);
    callback nav-rename-start(int);
    callback nav-rename-commit(int, string);
    callback nav-rename-cancel();
    callback nav-delete(int);
    callback nav-drop(int, int); // dragged doc id, target row index
    // folder verbs (folders have no DocId — they go by name)
    callback nav-folder-rename-start(string);
    callback nav-folder-rename-commit(string, string); // old, typed name
    callback nav-folder-delete(string);
    callback nav-folder-drop(string, int); // dragged folder, target row index
    callback new-file-in(string); // folder menu: create inside
    callback nav-move-root(int); // file menu: out of its folder
    callback new-folder-in(string); // folder menu: subfolder inside
    callback nav-folder-move-root(string); // folder menu: back to root
    callback nav-mark-folder(string); // folder click: mark (keyboard target)
    callback rename-marked(); // F2 on the marked file or folder
    callback tab-focus(int);
    callback tab-close(int);
    callback tab-close-all();
    callback tab-close-right(int);
    callback tab-close-left(int);
    callback tab-step(int); // ±1 over the OPEN tabs
    callback close-active(); // Ctrl+W
    callback new-file();
    callback new-folder();
    callback fold-all(bool);
    callback edit-toggle();
    callback edited(string);
    callback reveal();
    callback open-marked(); // Enter on the marked row
    callback delete-marked(); // Del on the marked row
    callback cs-undo(); // take back the latest action
    callback cs-revert(); // discard ALL local changes (pane confirms first)
    callback cs-vote(); // bundle the net changes into a patch proposal
    callback nav-revert(int); // context menu: discard one file's changes
    callback copy-link(int); // context menu: link markup to the clipboard
    callback revert-active(); // editor header: discard the open file's changes
    callback open-link(string); // a preview link's .md target
}

// A full theme palette. Three are defined in `Palettes`; `Theme.active` picks one.
export struct Palette {
    bg-base: color,
    bg-surface: color,
    bg-elevated: color,
    raised: color,
    text-primary: color,
    text-secondary: color,
    text-faint: color,
    border-subtle: color,
    accent-primary: color,
    accent-foreground: color,
    accent-good: color,
    accent-warn: color,
    accent-bad: color,
    // the diff viewer's move tone (a renamed file is neither an edit
    // nor a delete)
    accent-moved: color,
}

// Window-topmost hover-hint channel: a hovered control writes its label and
// its absolute (window) anchor here; the app root renders ONE overlay bubble
// from it, above everything and outside any clipped panel. This replaces
// PopupWindow tooltips — an open popup grabs the pointer, so a hover-driven
// popup closes itself the instant it opens and the control strobes.
export global HintTip {
    in-out property <string> label;
    // anchor in window coordinates (from the control's absolute-position)
    in-out property <length> ax;
    in-out property <length> ay;
}

// Poking is one cross-cutting affordance: every site that renders a member
// name offers "Poke member" on right-click. The gate lives HERE, once - a
// prop chain through ChatRow/ProposalCard/DecisionTable would let the nine
// sites drift apart. `on` is the APPLIED switch (never the settings draft),
// so a menu and the engine can never disagree.
export global Poke {
    in property <bool> on: false;
    in property <string> me; // the own seat (never pokable)
    callback go(string);
    // Whether a name gets the menu AT ALL. The switch is deliberately NOT
    // part of this: an operator who has poking off must still SEE the entry
    // (greyed) - a feature that leaves no trace when it is off cannot be
    // found, and reads as a dead right-click.
    public pure function shows(who: string) -> bool {
        return who != "" && who != root.me;
    }
    // Whether the entry can be activated - the applied switch on top.
    public pure function can(who: string) -> bool {
        return root.on && root.shows(who);
    }
}

export global Palettes {
    // Classic — clean Office-style layout in the moltrepublic.ai brand orange
    // (#e65515): off-white surfaces, charcoal text, a teal-green "good" that
    // nods to the brand teal so the logo sits naturally on it.
    out property <Palette> light: {
        bg-base: #f4f1ee,
        bg-surface: #ffffff,
        bg-elevated: #faf7f4,
        raised: #efe9e3,
        text-primary: #2b2b2b,
        text-secondary: #5c5651,
        text-faint: #9a948c,
        border-subtle: #e4ded6,
        accent-primary: #e65515,
        accent-foreground: #ffffff,
        accent-good: #1f9e73,
        accent-warn: #d99400,
        accent-bad: #cf4433,
        accent-moved: #7048c8,
    };
    // Dark — neutral graphite surfaces with the brand teal as the only hue
    // (reworked 2026-07-18: the old teal-on-teal near-black scheme blurred).
    // Built on proven dark-mode practice (Material dark / GitHub Primer):
    // no pure black, a clear four-step elevation ladder, off-white (not
    // white) primary text, and a 13:1 / 7:1 / 4.7:1 WCAG-checked text
    // ladder on bg-surface. Semantic green/amber/red are Primer-dark
    // values — desaturated enough for dark, distinct from the teal accent.
    // The lockup's light teal (#6fc7d0 in app.slint) stays the brand mark.
    out property <Palette> dark: {
        bg-base: #16181d,
        bg-surface: #1e2126,
        bg-elevated: #262a31,
        raised: #323843,
        text-primary: #e8eaed,
        text-secondary: #a9b1b8,
        text-faint: #838b94,
        border-subtle: #3a4047,
        accent-primary: #53c6d0,
        accent-foreground: #0c2226,
        accent-good: #3fb950,
        accent-warn: #d29922,
        accent-bad: #f85149,
        accent-moved: #b197fc,
    };
    // Brutalism — an earnest, slightly-clumsy homemade theme ("gewollt aber nicht
    // gekonnt"): a light warm-concrete desktop, off-white beveled chrome, and a
    // sincere muted teal-green accent. The desktop is kept light on purpose so
    // the dark text stays readable everywhere (≈8:1) — the brutalism comes from
    // the bevels and the slightly-off warm harmony, not from low contrast.
    out property <Palette> win95: {
        bg-base: #c2bba9,
        bg-surface: #ebe8e0,
        bg-elevated: #f4f1ea,
        raised: #dcd8cd,
        text-primary: #1c1a17,
        text-secondary: #514c43,
        text-faint: #5f5a4e,
        border-subtle: #a39c8c,
        accent-primary: #0a4f5b,
        accent-foreground: #ffffff,
        accent-good: #2f7a5f,
        accent-warn: #b7830f,
        accent-bad: #b0402f,
        accent-moved: #6d4d94,
    };
}

export global Theme {
    // 0 = Light (Office), 1 = Dark (neutral graphite), 2 = Win95 (brutalist).
    in-out property <int> theme-index: 0;
    // Fired when the in-app ThemeSwitch picks a theme; Rust binds this to a
    // SetTheme command so the change round-trips through the engine (co-equal).
    callback picked(int);
    out property <Palette> active: theme-index == 0
        ? Palettes.light
        : (theme-index == 2 ? Palettes.win95 : Palettes.dark);
    out property <bool> win95: theme-index == 2;

    // Convenience tokens (used across the app), derived from the active palette.
    out property <color> bg: active.bg-base;
    out property <color> panel: active.bg-surface;
    out property <color> panel-2: active.bg-elevated;
    out property <color> raised: active.raised;
    out property <color> line: active.border-subtle;
    out property <color> text: active.text-primary;
    out property <color> dim: active.text-secondary;
    out property <color> faint: active.text-faint;
    out property <color> accent: active.accent-primary;
    out property <color> accent-soft: active.accent-primary.transparentize(0.84);
    // chat zebra stripe — deliberately NOT panel-2, so author blocks read
    // against the chat panel they sit on
    out property <color> zebra: active.text-primary.transparentize(0.94);
    out property <color> accent-ink: active.accent-foreground;
    out property <color> good: active.accent-good;
    out property <color> warn: active.accent-warn;
    out property <color> bad: active.accent-bad;
    out property <color> moved: active.accent-moved;

    // Win95 chrome bevel (3D raised look); neutral on the other themes.
    out property <color> bevel-light: win95 ? #ffffff : active.border-subtle;
    out property <color> bevel-dark: win95 ? #000000 : active.border-subtle;

    out property <length> radius: theme-index == 0 ? 4px : (win95 ? 0px : 8px);
    out property <length> border-w: win95 ? 2px : 1px;
    out property <length> pad: 18px;
    // the chat presence strip: the pill lays itself out from these, and the
    // strip measures its column width from the same numbers (MemberPill and
    // `pmeas` in app.slint) - drifting them apart cuts names off
    out property <length> pill-pad: 9px;
    out property <length> pill-gap: 6px;
    out property <length> pill-dot: 8px;
    // GUI font sizes in px, set from the session (config.toml `[ui]`,
    // the set_fonts command): the app size drives the shared tokens
    // below (defaults keep the historical 26/18/14/12 ladder), nav and
    // editor size the wiki navigator and the document area.
    in-out property <length> fs-app: 14px;
    in-out property <length> fs-nav: 13px;
    in-out property <length> fs-editor: 14px;
    out property <length> fs-h1: self.fs-app + 12px;
    out property <length> fs-h2: self.fs-app + 4px;
    out property <length> fs-body: self.fs-app;
    out property <length> fs-cap: self.fs-app - 2px;
}

