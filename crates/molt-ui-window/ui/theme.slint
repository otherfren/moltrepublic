// SPDX-License-Identifier: GPL-3.0-or-later
//
// Design tokens, the screen-router enum, and the localized string table.
// `Strings` is populated from Rust (`apply_strings`) per language, so switching
// languages at runtime is just re-setting these properties.

// The multi-stage flow, modelled after konkinwallet's AppScreen state machine.
export enum AppScreen {
    choice,    // first-run: create / open / join / restore
    create,    // create-workspace wizard
    open,      // open a local workspace (mock list)
    join,      // join via invite (mock)
    restore,   // restore from backup / seed (mock)
    settings,  // config.toml editor (mock — no disk write)
    main,      // placeholder main view (surfaces land in Phase B)
}

// One emoji reaction tally on a chat message; `mine` marks the emoji the
// local member picked (accent-highlighted pill, click to un-react).
export struct ReactionItem {
    emoji: string,
    count: int,
    mine: bool,
}

// One line in a surface's log: for chat, `lead` is the sender and `text` the
// body; for gated surfaces `lead` is empty and `text` is the proposal summary.
export struct LogLine {
    id: string, // stable message id (32-char hex; "" on legacy entries — such rows offer NO id-requiring actions)
    lead: string,
    text: string,
    when: string, // "2026-06-02 13:37 (~20 minutes ago)", grey in the header
    quote: int, // quoted row in the DISPLAYED log (-1 = none/out of view)
    system: bool, // a UI-synthesized governance line (patch channels): quiet, no author, no actions
    quote-label: string, // "author: body" teaser of the quoted message ("" = no quote; may be set with quote == -1 for a cross-channel quote)
    deleted-by: string, // who deleted the message ("" = live)
    first: bool, // starts a new author block (shows the name + time header)
    own: bool, // the local member wrote it
    alt: bool, // author-block zebra stripe (flips when the author changes)
    mine-emoji: string, // the local member's reaction ("" = none yet)
    reactions: [ReactionItem],
    has-file: bool, // the message carries a shared file's metadata
    file-name: string,
    file-meta: string, // rendered "1.2 MiB · PDF · 2026-07-01"
    file-available: bool, // still on the sharer's disk (false = removed)
}

// One chat channel in the sidebar (chat bus): a VIEW over the one log,
// never a boundary. Built Rust-side from the engine's channel enumeration.
export struct ChannelItem {
    key: string, // "group" | "patch:<id>" | "topic:<name>" — the select-channel address
    label: string, // display label ("" for group: the UI substitutes Strings.ch-group)
    icon: string, // Twemoji glyph per kind
    unread: int, // messages since last seen (0 = caught up)
}

// One member's stance on a pending proposal (the voting row's pills).
export struct MemberVoteMark {
    member: string,
    vote: int, // 0 = not voted yet, 1 = approved, 2 = declined
}

// A pending proposal on a gated surface, with its approval progress.
export struct ProposalRow {
    id: int,
    text: string, // human title (the op codes stay wire-side)
    approvals: int,
    threshold: int,
    current: string, // Ist-Stand ("" = unknown → line hidden)
    proposed: string, // Soll-Stand ("" = no value → line hidden)
    image-op: bool, // set_image / remove_image → picture + preview link
    img-b64: string, // a pending set_image's embedded bytes (base64; "" else)
    charter-op: bool, // set_charter → long text, capped + scrollable
    votes: [MemberVoteMark], // per-member stance, roster order
    declined-by: string, // "" = not declined (the Declined view fills it)
    declined-when: string, // human "when" label of the decline
}

// One member of a republic with its last-sync info (mock data).
export struct MemberSync {
    name: string,
    last: string, // human "last synced" label, e.g. "2 min ago"
    state: int, // 0 = synced, 1 = syncing, 2 = offline
}

// One row of the Organization → Members table (engine ReadMembers — the
// same projection the MCP read_members tool serves).
export struct MemberRow {
    name: string,
    id: string, // identity-key fingerprint ("" on demo/unanchored workspaces)
    pk: string, // full anchored identity key, lowercase hex ("" unanchored)
    last: string, // human "last seen" label (mock)
    state: int, // 0 = synced, 1 = syncing, 2 = offline (mock presence)
    uploads: int, // files this member shared into the chat
}

// One row of the Organization → Uploads table (engine ReadUploads — the
// same projection the MCP read_uploads tool serves). Labels arrive
// pre-rendered from Rust.
export struct UploadRow {
    id: string, // the carrying chat message id (what download-file takes)
    user: string,
    date: string,
    name: string,
    kind: string,
    size: string,
    available: bool,
    online: bool, // sharer reachable (user-to-user transfer needs them)
    checksum: string, // shortened real sha256 (full value via MCP)
    expires: string, // "in 13 days" · "expired" · "—" (unavailable)
    status: string, // live download status ("" idle · "42 %" · check/warn)
    status-kind: int, // 0 idle · 1 running · 2 done · 3 failed
}

// One row of the founding-ritual member list: the founder plus one per
// seat. `detail` is the invite link while waiting, else the join status.
export struct RitualSeat {
    member: string, // display name, or "Invite k" while unactivated
    detail: string, // the molt:// link, or the join/seal status
    state: int, // 0 = waiting, 1 = key received, 2 = sealed (green)
}

// A local workspace/republic shown in the Open screen list.
export struct WorkspaceItem {
    id: string, // the workspace id — the sole address of workspace verbs
    name: string,
    detail: string,
    status: string,
    synced: bool,
    state: int, // 0 = synced, 1 = syncing, 2 = offline
    last-sync-min: int, // minutes since the last completed sync (sort key)
    s3: bool, // automatic S3 backup configured
    backup: string, // human "last backup" label, e.g. "30 min ago" / "never"
    encrypted: bool, // at-rest encrypted (mock): inactive until decrypted
    seed: string, // recovery seed all secret keys derive from (mock)
    net: string, // transport: "tor" | "nym" | "clearnet"
    members: [MemberSync], // who is in the DAO + when they last synced
}

// One row of the settings backup table: a local workspace, its backup in
// the S3 bucket, or both. Built Rust-side from the session's workspaces +
// the bucket-only orphans; prose cells (size/last) are rendered there too.
export struct BackupRow {
    id: string, // local workspace id ("" = bucket-only orphan)
    local: string, // local workspace name ("" = bucket-only)
    remote: string, // backup name in the bucket ("" = not backed up)
    has-local: bool, // false = orphan row, auto-backup not toggleable
    auto: bool, // automatic backup on
    size: string, // human size, e.g. "1.8 MiB"
    last: string, // human last-backup, e.g. "30 min ago" / "never"
    size-kib: int, // machine sort key for the size column
    last-min: int, // machine sort key for the last-backup column (max = never)
}

// The parsed preview of an invite link on the Join screen. Filled by Rust via
// the pure `parse-invite` callback (the same molt-core parser the engine's
// join run uses, so the preview and the run can never disagree).
export struct InvitePreview {
    valid: bool,
    republic: string,
    rule: string, // "m-of-n"
    inviter: string,
}

// One sub-view of a surface (nav entry), from molt-core's shared view list.
// `icon` is a Twemoji glyph (colorful emoji font), picked in Rust per key.
export struct ViewItem {
    key: string,
    name: string,
    icon: string,
}

// One of the five surfaces, with live counts and its log + pending proposals.
export struct SurfaceTab {
    key: string,
    name: string,
    gated: bool,
    applied-count: int,
    pending-count: int,
    // the approvals table splits pending by the reader's own vote
    // (engine-derived: ProposalView.approved_by_me / snapshot.denied)
    pending-voted-count: int,
    pending-my-vote-count: int,
    denied-count: int, // ALL declines (status strip)
    declined-count: int, // declines inside the display-retention window
    log: [LogLine],
    pending: [ProposalRow],
    declined: [ProposalRow], // the retained declines (Declined view)
    views: [ViewItem], // its nav sub-views, default first
}

// A full theme palette. Three are defined in `Palettes`; `Theme.active` picks one.
export struct Palette {
    bg-base: color,
    bg-surface: color,
    bg-elevated: color,
    raised: color,
    text-primary: color,
    text-secondary: color,
    text-faint: color,
    border-subtle: color,
    accent-primary: color,
    accent-foreground: color,
    accent-good: color,
    accent-warn: color,
    accent-bad: color,
}

export global Palettes {
    // Classic — clean Office-style layout in the moltrepublic.ai brand orange
    // (#e65515): off-white surfaces, charcoal text, a teal-green "good" that
    // nods to the brand teal so the logo sits naturally on it.
    out property <Palette> light: {
        bg-base: #f4f1ee,
        bg-surface: #ffffff,
        bg-elevated: #faf7f4,
        raised: #efe9e3,
        text-primary: #2b2b2b,
        text-secondary: #5c5651,
        text-faint: #9a948c,
        border-subtle: #e4ded6,
        accent-primary: #e65515,
        accent-foreground: #ffffff,
        accent-good: #1f9e73,
        accent-warn: #d99400,
        accent-bad: #cf4433,
    };
    // Dark — near-black with a teal undertone; the accent is tuned to the
    // brand teal (matching the light-teal "republic" the logo uses on dark),
    // so the moltrepublic.ai lockup and the UI share one teal.
    out property <Palette> dark: {
        bg-base: #05100f,
        bg-surface: #0a1c1b,
        bg-elevated: #0f2a28,
        raised: #143432,
        text-primary: #d8e8e2,
        text-secondary: #82b2b5,
        text-faint: #466f6b,
        border-subtle: #17403c,
        accent-primary: #45c8d0,
        accent-foreground: #04211f,
        accent-good: #2fd0a6,
        accent-warn: #f2c94c,
        accent-bad: #ff5d70,
    };
    // Brutalism — an earnest, slightly-clumsy homemade theme ("gewollt aber nicht
    // gekonnt"): a light warm-concrete desktop, off-white beveled chrome, and a
    // sincere muted teal-green accent. The desktop is kept light on purpose so
    // the dark text stays readable everywhere (≈8:1) — the brutalism comes from
    // the bevels and the slightly-off warm harmony, not from low contrast.
    out property <Palette> win95: {
        bg-base: #c2bba9,
        bg-surface: #ebe8e0,
        bg-elevated: #f4f1ea,
        raised: #dcd8cd,
        text-primary: #1c1a17,
        text-secondary: #514c43,
        text-faint: #5f5a4e,
        border-subtle: #a39c8c,
        accent-primary: #0a4f5b,
        accent-foreground: #ffffff,
        accent-good: #2f7a5f,
        accent-warn: #b7830f,
        accent-bad: #b0402f,
    };
}

export global Theme {
    // 0 = Light (Office), 1 = Dark (cypherpunk), 2 = Win95 (brutalist).
    in-out property <int> theme-index: 0;
    // Fired when the in-app ThemeSwitch picks a theme; Rust binds this to a
    // SetTheme command so the change round-trips through the engine (co-equal).
    callback picked(int);
    out property <Palette> active: theme-index == 0
        ? Palettes.light
        : (theme-index == 2 ? Palettes.win95 : Palettes.dark);
    out property <bool> win95: theme-index == 2;

    // Convenience tokens (used across the app), derived from the active palette.
    out property <color> bg: active.bg-base;
    out property <color> panel: active.bg-surface;
    out property <color> panel-2: active.bg-elevated;
    out property <color> raised: active.raised;
    out property <color> line: active.border-subtle;
    out property <color> text: active.text-primary;
    out property <color> dim: active.text-secondary;
    out property <color> faint: active.text-faint;
    out property <color> accent: active.accent-primary;
    out property <color> accent-soft: active.accent-primary.transparentize(0.84);
    // chat zebra stripe — deliberately NOT panel-2, so author blocks read
    // against the chat panel they sit on
    out property <color> zebra: active.text-primary.transparentize(0.94);
    out property <color> accent-ink: active.accent-foreground;
    out property <color> good: active.accent-good;
    out property <color> warn: active.accent-warn;
    out property <color> bad: active.accent-bad;

    // Win95 chrome bevel (3D raised look); neutral on the other themes.
    out property <color> bevel-light: win95 ? #ffffff : active.border-subtle;
    out property <color> bevel-dark: win95 ? #000000 : active.border-subtle;

    out property <length> radius: theme-index == 0 ? 4px : (win95 ? 0px : 8px);
    out property <length> border-w: win95 ? 2px : 1px;
    out property <length> pad: 18px;
    out property <length> fs-h1: 26px;
    out property <length> fs-h2: 18px;
    out property <length> fs-body: 14px;
    out property <length> fs-cap: 12px;
}

