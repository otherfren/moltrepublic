            }
        }
        PanePanel {
            for r in root.releases: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 10px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: r.secret;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "\{Strings.vt-requested-by} \{r.by}";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: r.reason;
                        color: Theme.dim;
