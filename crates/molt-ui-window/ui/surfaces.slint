// SPDX-License-Identifier: GPL-3.0-or-later
//
// DESIGN MOCKS for the four staged surfaces: Memory (shared brain), Quests
// (quest board), Vault (sealed secrets) and Wallet (Monero multisig).
//
// These panes are badged UX drafts to iterate on look & feel — every dataset
// below is .slint-side sample data, never engine state. Actions either work
// as pure view-state mocks (the Multisig-Wiki's create/delete/edit/link) or
// render DISABLED (with the "not yet" tooltip, the same idiom as the greyed
// network options). The REAL threshold governance
// for these surfaces (pending proposals / applied log / propose) stays in
// app.slint and routes to the "proposals" (resp. wallet "status") sub-views.
//
// Each pane is one component taking only the selected sub-view key, so the
// panes stay independently editable under scripts/dev-ui.sh hot-reload.

import { Theme, Strings, HintTip } from "theme.slint";
import { AppButton, AppField, AppArea, ScrollHint, DotLabel } from "components.slint";

// ---------------------------------------------------------------------------
// shared chrome
// ---------------------------------------------------------------------------

// The small-but-unmissable badge every mock pane carries: warn-coloured like
// the founding ritual's SIMULATION badge, with an honesty tooltip.
export component MockBadge inherits Rectangle {
    background: Theme.warn;
    border-radius: Theme.win95 ? 0px : 4px;
    width: bt.preferred-width + 12px;
    height: bt.preferred-height + 5px;
    bt := Text {
        x: 6px;
        y: 2.5px;
        text: Strings.mock-badge;
        color: #1a1200;
        font-size: Theme.fs-cap;
        font-weight: 700;
    }
    // the hint goes through the window-topmost HintTip overlay (renders
    // above everything, never clipped, and — unlike a PopupWindow — grabs
    // no input, so the hover cannot strobe)
    ta := TouchArea {
        changed has-hover => {
            if (self.has-hover) {
                HintTip.label = Strings.mock-tip;
                HintTip.ax = root.absolute-position.x;
                HintTip.ay = root.absolute-position.y + root.height + 6px;
            } else if (HintTip.ax == root.absolute-position.x
                && HintTip.ay == root.absolute-position.y + root.height + 6px) {
                // only clear our own hint — hovering straight onto another
                // control may already have replaced it
                HintTip.label = "";
            }
        }
    }
}

// One pane/view header: Twemoji glyph + title + the mock badge, and an
// optional one-line hint underneath (the honest "what this will be" line).
component PaneHeader inherits VerticalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint: "";
    spacing: 5px;
    HorizontalLayout {
        spacing: 10px;
        // fixed clip box, like the nav rows: an oversized emoji glyph must
        // never bleed into the neighbours
        Rectangle {
            width: 22px;
            height: 24px;
            clip: true;
            Text {
                text: root.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 16px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-h2;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            MockBadge { }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
    }
}

// The standard content panel every pane's body sits on (chat's message list
// idiom): a themed surface with a Flickable + scroll hint.
component PanePanel inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    out property <length> inner-width: fl.width;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height + 24px;
        body := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 7px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// A tiny accent-tinted chip: tags, rewards, badges, signer marks. The
// optional leading glyph renders in the Twemoji font (never plain-text
// emoji in labels); `muted` turns it into a quiet outline (e.g. a signer
// who has not signed yet).
component TagChip inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> muted: false;
    background: root.muted ? transparent : Theme.accent-soft;
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.muted ? 1px : 0px;
    border-color: Theme.line;
    width: row.preferred-width + 12px;
    height: 20px;
    // full-height row + centered texts: an offset row sized off the text's
    // preferred height sat the label visibly at the chip's bottom edge
    row := HorizontalLayout {
        x: 6px;
        y: 0;
        height: parent.height;
        spacing: 4px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            height: 100%;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.muted ? Theme.faint : (Theme.win95 ? Theme.text : Theme.accent);
            font-size: 11px;
            font-weight: root.muted ? 400 : 600;
            height: 100%;
            vertical-alignment: center;
        }
    }
}

// The signature-collection meter (the pending-proposal progress idiom):
// a thin track with an accent fill plus the "x/y signed" caption.
component SigMeter inherits HorizontalLayout {
    in property <int> signed;
    in property <int> need;
    spacing: 10px;
    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 3px;
        background: Theme.line;
        horizontal-stretch: 1;
        Rectangle {
            x: 0;
            height: parent.height;
            border-radius: parent.border-radius;
            width: parent.width * min(1.0, root.signed * 1.0 / max(root.need, 1));
            background: Theme.accent;
        }
    }
    Text {
        text: "\{root.signed}/\{root.need} \{Strings.vt-signed-word}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

// A quiet "glyph + text" caption row (authors, dates, rewards …).
component GlyphCaption inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <color> tone: Theme.faint;
    spacing: 5px;
    Rectangle {
        width: 16px;
        height: 16px;
        clip: true;
        y: (parent.height - self.height) / 2;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        color: root.tone;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// Memory — the Multisig-Wiki (the shared brain)
// ---------------------------------------------------------------------------

// A retired note in the Archive sub-view's list.
struct MockNote {
    title: string,
    author: string,
    ver: string,
    when: string,
}

// One rendered-ish block of a brain document (design mock — no real
// markdown engine): 0 = h1, 1 = h2, 2 = paragraph, 3 = bullet, 4 = code.
struct BrainBlock {
    kind: int,
    text: string,
}

// One .md file of the wiki tree, with its pseudo-rendered content, its
// markdown source (the ✏️ raw-edit mode) and the cross-links that make
// the tree a wiki rather than a folder.
struct BrainDoc {
    path: string,
    author: string,
    ver: string,
    when: string,
    blocks: [BrainBlock],
    links: [string],
    raw: string,
}

// The slim toolbar strip on top of the navigator / content panes.
component ToolStrip inherits Rectangle {
    height: 34px;
    background: Theme.panel-2;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 4px;
        padding-bottom: 5px;
        spacing: 3px;
        @children
    }
    // bottom hairline separating the strip from the pane body
    Rectangle {
        x: 0;
        y: parent.height - Theme.border-w;
        width: parent.width;
        height: Theme.border-w;
        background: Theme.line;
    }
}

// A compact square toolbar button: Twemoji glyph, named tooltip below.
// Disabled by default — the pane idiom: an action that would change shared
// state renders greyed with the honest "not yet" suffix; wired actions
// pass `enabled: true` and really work. The tooltip is a PopupWindow, not
// an in-tree bubble: popups render above and outside the panel's clipped
// bounds, so a hint near a panel edge is never cut off.
component ToolBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <bool> enabled: false;
    callback clicked();
    width: 30px;
    border-radius: Theme.win95 ? 0px : 5px;
    background: root.enabled && ta.has-hover ? Theme.raised : transparent;
    Rectangle {
        width: 18px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 13px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.4;
        }
    }
    // the TouchArea stays enabled either way — a disabled button still
    // owes its hover the honest "not yet" hint; only clicked() gates.
    // The hint renders through the window-topmost HintTip overlay (never
    // clipped, grabs no input — a PopupWindow here strobed the hover).
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        changed has-hover => {
            if (self.has-hover) {
                HintTip.label = root.enabled ? root.name : "\{root.name} — \{Strings.not-implemented-yet}";
                HintTip.ax = root.absolute-position.x;
                HintTip.ay = root.absolute-position.y + root.height + 6px;
            } else if (HintTip.ax == root.absolute-position.x
                && HintTip.ay == root.absolute-position.y + root.height + 6px) {
                // only clear our own hint — hovering straight onto another
                // button may already have replaced it
                HintTip.label = "";
            }
        }
        clicked => {
            HintTip.label = "";
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The scrolling body under a ToolStrip (PanePanel's padless cousin for
// panes that carry their own chrome): Flickable + scroll hint, with the
// caller's padding/spacing.
component ScrollBody inherits Rectangle {
    in property <length> pad: 8px;
    in property <length> gap: 2px;
    vertical-stretch: 1;
    clip: true;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height;
        body := VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 5px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// A folder row of the brain tree: click folds/unfolds (pure view state).
component BrainFolderRow inherits Rectangle {
    in property <string> name;
    in-out property <bool> open: true;
    height: 26px;
    border-radius: Theme.win95 ? 0px : 5px;
    background: ta.has-hover ? Theme.zebra : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            width: 18px;
            height: 100%;
            clip: true;
            Text {
                text: root.open ? "📂" : "📁";
                font-family: "Twemoji Mozilla";
                font-size: 12px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.name + "/";
            color: Theme.dim;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.open = !root.open;
        }
    }
}

// A file row of the brain tree; the selected one carries the accent rim
// (the selected-nav-row idiom).
component BrainFileRow inherits Rectangle {
    in property <string> name;
    in property <bool> nested: false;
    in property <bool> selected: false;
    callback pick();
    height: 26px;
    border-radius: Theme.win95 ? 0px : 5px;
    background: root.selected ? Theme.accent-soft : (ta.has-hover ? Theme.zebra : transparent);
    clip: true;
    if root.selected: Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: root.nested ? 24px : 8px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            width: 16px;
            height: 100%;
            clip: true;
            Text {
                text: "📄";
                font-family: "Twemoji Mozilla";
                font-size: 11px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.name;
            color: root.selected ? Theme.text : Theme.dim;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.pick();
        }
    }
}

// One pseudo-rendered markdown block of the content pane.
component BrainBlockView inherits VerticalLayout {
    in property <BrainBlock> b;
    // an h2 gets extra air above — the one spacing exception a doc needs
    padding-top: root.b.kind == 1 ? 6px : 0px;
    if root.b.kind == 0: Text {
        text: root.b.text;
        color: Theme.text;
        font-size: Theme.fs-h2;
        font-weight: 800;
        wrap: word-wrap;
    }
    if root.b.kind == 1: Text {
        text: root.b.text;
        color: Theme.text;
        font-size: Theme.fs-body;
        font-weight: 700;
        wrap: word-wrap;
    }
    if root.b.kind == 2: Text {
        text: root.b.text;
        color: Theme.text;
        font-size: Theme.fs-body;
        wrap: word-wrap;
    }
    if root.b.kind == 3: HorizontalLayout {
        spacing: 7px;
        Text {
            text: "•";
            color: Theme.accent;
            font-size: Theme.fs-body;
            vertical-alignment: top;
        }
        Text {
            text: root.b.text;
            color: Theme.text;
            font-size: Theme.fs-body;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    if root.b.kind == 4: Rectangle {
        background: Theme.bg;
        border-radius: Theme.win95 ? 0px : 6px;
        border-width: Theme.border-w;
        border-color: Theme.line;
        height: ct.preferred-height + 16px;
        ct := Text {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: root.b.text;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
    }
}

export component MemoryPane inherits VerticalLayout {
    in property <string> view;
    // the 🔗 button's URI travels up to the app root — the real clipboard
    // write and the toast live there, the pane stays a pure view
    callback copy-link(string /* uri */);
    spacing: 8px;

    // wiki-view state — pure view state (selection, folds, splitter, the
    // mock's create/delete flags), kept on the pane root so it survives
    // sub-view switches
    property <int> sel: 0;
    property <float> split: 0.32;
    property <bool> open-decisions: true;
    property <bool> open-quests: true;
    property <bool> open-runbooks: true;
    property <bool> open-newa: true;
    property <bool> open-newb: true;
    // mock create/delete — view state only, the design-mock stand-in for
    // the future gated wiki changes: docs 6-8 are pre-seeded "untitled"
    // pages revealed one per New-file click (the button greys out when
    // the seeds run dry), deadN hides a deleted row.
    property <int> made-files: 0;
    property <int> made-folders: 0;
    property <bool> dead0: false;
    property <bool> dead1: false;
    property <bool> dead2: false;
    property <bool> dead3: false;
    property <bool> dead4: false;
    property <bool> dead5: false;
    property <bool> dead6: false;
    property <bool> dead7: false;
    property <bool> dead8: false;
    // raw-markdown edit mode (the ✏️ toggle); every document switch drops
    // back to the pretty preview and discards the mock buffer
    property <bool> editing: false;
    // which docs are open as content TABS (fixed per-doc slots — pure
    // .slint mock arrays are static, same technique as the deadN flags);
    // the tab strip lists them in tree order. The charter starts open.
    property <bool> tabbed0: true;
    property <bool> tabbed1: false;
    property <bool> tabbed2: false;
    property <bool> tabbed3: false;
    property <bool> tabbed4: false;
    property <bool> tabbed5: false;
    property <bool> tabbed6: false;
    property <bool> tabbed7: false;
    property <bool> tabbed8: false;
    // the navigator's MARKED row: set by tree clicks, deliberately NOT
    // moved by tab switches or ⬅️/➡️ browsing — 🎯 arms exactly while the
    // active tab and the marked row diverge, and clicking it re-aligns
    property <int> nav-marked: 0;
    // the open document (single source for breadcrumb, body and links)
    property <BrainDoc> cur: root.docs[root.sel];
    // shown = the active tab exists AND is still open as a tab
    property <bool> cur-alive: root.alive(root.sel) && root.tabbed(root.sel);

    // the navigator's display order of doc indices — ⬅️/➡️ walk it
    property <[int]> nav-order: [1, 2, 3, 4, 0, 5, 6, 7, 8];

    // whether doc `d` currently exists in the mock tree
    pure function alive(d: int) -> bool {
        if (d == 0) { return !root.dead0; }
        if (d == 1) { return !root.dead1; }
        if (d == 2) { return !root.dead2; }
        if (d == 3) { return !root.dead3; }
        if (d == 4) { return !root.dead4; }
        if (d == 5) { return !root.dead5; }
        if (d == 6) { return root.made-files >= 1 && !root.dead6; }
        if (d == 7) { return root.made-files >= 2 && !root.dead7; }
        if (d == 8) { return root.made-files >= 3 && !root.dead8; }
        return false;
    }
    // doc index at (wrapped) tree position p
    pure function at(p: int) -> int {
        return root.nav-order[Math.mod(p + 18, 9)];
    }
    // tree position of doc d (inverse of `at`)
    pure function pos-of(d: int) -> int {
        if (d == 1) { return 0; }
        if (d == 2) { return 1; }
        if (d == 3) { return 2; }
        if (d == 4) { return 3; }
        if (d == 0) { return 4; }
        if (d == 5) { return 5; }
        if (d == 6) { return 6; }
        if (d == 7) { return 7; }
        return 8;
    }
    // the first existing document in direction `delta` (±1) in tree
    // order, wrapping; falls back to `d` when nothing else is left
    pure function step(d: int, delta: int) -> int {
        if (root.alive(root.at(root.pos-of(d) + 1 * delta))) { return root.at(root.pos-of(d) + 1 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 2 * delta))) { return root.at(root.pos-of(d) + 2 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 3 * delta))) { return root.at(root.pos-of(d) + 3 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 4 * delta))) { return root.at(root.pos-of(d) + 4 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 5 * delta))) { return root.at(root.pos-of(d) + 5 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 6 * delta))) { return root.at(root.pos-of(d) + 6 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 7 * delta))) { return root.at(root.pos-of(d) + 7 * delta); }
        if (root.alive(root.at(root.pos-of(d) + 8 * delta))) { return root.at(root.pos-of(d) + 8 * delta); }
        return d;
    }
    // whether doc `d` is open as a content tab
    pure function tabbed(d: int) -> bool {
        if (d == 0) { return root.tabbed0; }
        if (d == 1) { return root.tabbed1; }
        if (d == 2) { return root.tabbed2; }
        if (d == 3) { return root.tabbed3; }
        if (d == 4) { return root.tabbed4; }
        if (d == 5) { return root.tabbed5; }
        if (d == 6) { return root.tabbed6; }
        if (d == 7) { return root.tabbed7; }
        if (d == 8) { return root.tabbed8; }
        return false;
    }
    function set-tab(d: int, on: bool) {
        if (d == 0) { root.tabbed0 = on; }
        if (d == 1) { root.tabbed1 = on; }
        if (d == 2) { root.tabbed2 = on; }
        if (d == 3) { root.tabbed3 = on; }
        if (d == 4) { root.tabbed4 = on; }
        if (d == 5) { root.tabbed5 = on; }
        if (d == 6) { root.tabbed6 = on; }
        if (d == 7) { root.tabbed7 = on; }
        if (d == 8) { root.tabbed8 = on; }
    }
    // the tab label = the tree row's file name
    pure function doc-name(d: int) -> string {
        if (d == 0) { return "charter.md"; }
        if (d == 1) { return "2026-06-14-relay.md"; }
        if (d == 2) { return "2026-07-02-treasury.md"; }
        if (d == 3) { return "onboarding-guide.md"; }
        if (d == 4) { return "node-recovery.md"; }
        if (d == 5) { return "glossary.md"; }
        if (d == 6) { return "untitled-1.md"; }
        if (d == 7) { return "untitled-2.md"; }
        if (d == 8) { return "untitled-3.md"; }
        return "";
    }
    // focus a document (every route also leaves raw-edit mode)
    function goto(d: int) {
        root.editing = false;
        root.sel = d;
    }
    // navigator route: mark the row, open (or refocus) its tab
    function open-doc(d: int) {
        root.nav-marked = d;
        root.set-tab(d, true);
        root.goto(d);
    }
    // ⬅️/➡️ browsing route: open as a tab and focus, but leave the
    // navigator mark where it is (that is what arms 🎯)
    function browse-to(d: int) {
        root.set-tab(d, true);
        root.goto(d);
    }
    // close a tab; when it was the active one, focus the nearest other
    // open tab (tree order) — none left = the honest empty state
    function close-tab(d: int) {
        root.set-tab(d, false);
        if (root.sel == d) {
            root.goto(root.next-tab(d));
        }
    }
    // the nearest OTHER open+alive tab in tree order (wrapping); `d`
    // itself when none is left
    pure function next-tab(d: int) -> int {
        if (root.alive(root.at(root.pos-of(d) + 1)) && root.tabbed(root.at(root.pos-of(d) + 1))) { return root.at(root.pos-of(d) + 1); }
        if (root.alive(root.at(root.pos-of(d) + 2)) && root.tabbed(root.at(root.pos-of(d) + 2))) { return root.at(root.pos-of(d) + 2); }
        if (root.alive(root.at(root.pos-of(d) + 3)) && root.tabbed(root.at(root.pos-of(d) + 3))) { return root.at(root.pos-of(d) + 3); }
        if (root.alive(root.at(root.pos-of(d) + 4)) && root.tabbed(root.at(root.pos-of(d) + 4))) { return root.at(root.pos-of(d) + 4); }
        if (root.alive(root.at(root.pos-of(d) + 5)) && root.tabbed(root.at(root.pos-of(d) + 5))) { return root.at(root.pos-of(d) + 5); }
        if (root.alive(root.at(root.pos-of(d) + 6)) && root.tabbed(root.at(root.pos-of(d) + 6))) { return root.at(root.pos-of(d) + 6); }
        if (root.alive(root.at(root.pos-of(d) + 7)) && root.tabbed(root.at(root.pos-of(d) + 7))) { return root.at(root.pos-of(d) + 7); }
        if (root.alive(root.at(root.pos-of(d) + 8)) && root.tabbed(root.at(root.pos-of(d) + 8))) { return root.at(root.pos-of(d) + 8); }
        return d;
    }
    // hide doc `d` from the mock tree
    function kill(d: int) {
        if (d == 0) { root.dead0 = true; }
        if (d == 1) { root.dead1 = true; }
        if (d == 2) { root.dead2 = true; }
        if (d == 3) { root.dead3 = true; }
        if (d == 4) { root.dead4 = true; }
        if (d == 5) { root.dead5 = true; }
        if (d == 6) { root.dead6 = true; }
        if (d == 7) { root.dead7 = true; }
        if (d == 8) { root.dead8 = true; }
    }
    // 🎯: re-align the navigator with the ACTIVE tab — unfold its tree
    // path and move the mark onto it. Armed only while tab and mark
    // diverge (tab switches / ⬅️➡️ browsing leave the mark behind).
    function reveal() {
        if (root.sel == 1 || root.sel == 2) { root.open-decisions = true; }
        if (root.sel == 3) { root.open-quests = true; }
        if (root.sel == 4) { root.open-runbooks = true; }
        root.nav-marked = root.sel;
    }

    // sample data — design mock only, never engine state. Indices into
    // `docs` are the tree rows' hand-written doc numbers below; `raw` is
    // the same document as markdown source for the ✏️ edit mode.
    property <[BrainDoc]> docs: [
        { path: "charter.md", author: "petra", ver: "v12", when: "3 d", links: ["decisions/2026-07-02-treasury.md", "glossary.md"],
            raw: "# Charter\n\nWhat we agreed to at the founding — the purpose, the rule, and the habits that keep four people one republic.\n\n## Purpose\n\nPool funds, share knowledge and act as one signer where a single person would be a single point of failure.\n\n## Consensus\n\n- Every gated change needs 3 of 4 signatures — no exceptions, not even for the founder.\n- Proposals live in chat until sealed; only sealed changes are canon.\n\n## Habits\n\n- Quarterly recovery drill (see runbooks/node-recovery.md).\n- Decisions get a dated file under decisions/ — if it is not written down, it was not decided.",
            blocks: [
            { kind: 0, text: "Charter" },
            { kind: 2, text: "What we agreed to at the founding — the purpose, the rule, and the habits that keep four people one republic." },
            { kind: 1, text: "Purpose" },
            { kind: 2, text: "Pool funds, share knowledge and act as one signer where a single person would be a single point of failure." },
            { kind: 1, text: "Consensus" },
            { kind: 3, text: "Every gated change needs 3 of 4 signatures — no exceptions, not even for the founder." },
            { kind: 3, text: "Proposals live in chat until sealed; only sealed changes are canon." },
            { kind: 1, text: "Habits" },
            { kind: 3, text: "Quarterly recovery drill (see runbooks/node-recovery.md)." },
            { kind: 3, text: "Decisions get a dated file under decisions/ — if it is not written down, it was not decided." }] },
        { path: "decisions/2026-06-14-relay.md", author: "walter", ver: "v4", when: "1 m", links: ["runbooks/node-recovery.md"],
            raw: "# Decision: paid SMP relay\n\nFree relays kept dropping our queues under load. We now rent a dedicated relay and pin its certificate.\n\n## Options weighed\n\n- Stay on public relays — free, but no uptime promise.\n- Self-host — full control, but one member becomes ops.\n- Rent + cert-pin — chosen: predictable, and no single admin.\n\n```\nrelay = \"smp://u2Fq…@relay.example:5223\"  # pinned, see vault\n```\n\nRevisit when the second-relay quest lands.",
            blocks: [
            { kind: 0, text: "Decision: paid SMP relay" },
            { kind: 2, text: "Free relays kept dropping our queues under load. We now rent a dedicated relay and pin its certificate." },
            { kind: 1, text: "Options weighed" },
            { kind: 3, text: "Stay on public relays — free, but no uptime promise." },
            { kind: 3, text: "Self-host — full control, but one member becomes ops." },
            { kind: 3, text: "Rent + cert-pin — chosen: predictable, and no single admin." },
            { kind: 4, text: "relay = \"smp://u2Fq…@relay.example:5223\"  # pinned, see vault" },
            { kind: 2, text: "Revisit when the second-relay quest lands." }] },
        { path: "decisions/2026-07-02-treasury.md", author: "mara", ver: "v3", when: "2 w", links: ["charter.md"],
            raw: "# Decision: treasury policy\n\nRules for spending from the shared wallet, sealed 3-of-4 on 2026-07-02.\n\n- Transfers above 5 XMR need a written purpose in the proposal text.\n- Recurring costs (relay, domain) are pre-approved up to 3 XMR per quarter.\n- Quest rewards are paid out only after the claim is marked done.",
            blocks: [
            { kind: 0, text: "Decision: treasury policy" },
            { kind: 2, text: "Rules for spending from the shared wallet, sealed 3-of-4 on 2026-07-02." },
            { kind: 3, text: "Transfers above 5 XMR need a written purpose in the proposal text." },
            { kind: 3, text: "Recurring costs (relay, domain) are pre-approved up to 3 XMR per quarter." },
            { kind: 3, text: "Quest rewards are paid out only after the claim is marked done." }] },
        { path: "quests/onboarding-guide.md", author: "petra", ver: "v9", when: "5 d", links: ["glossary.md", "runbooks/node-recovery.md"],
            raw: "# Onboarding guide\n\nThe path from invite link to first signed proposal, for the next member.\n\n- Read charter.md first — it is short on purpose.\n- Work through the MLS & SMP reading list, messaging layer first.\n- Run the recovery drill once with a buddy before you hold real shares.",
            blocks: [
            { kind: 0, text: "Onboarding guide" },
            { kind: 2, text: "The path from invite link to first signed proposal, for the next member." },
            { kind: 3, text: "Read charter.md first — it is short on purpose." },
            { kind: 3, text: "Work through the MLS & SMP reading list, messaging layer first." },
            { kind: 3, text: "Run the recovery drill once with a buddy before you hold real shares." }] },
        { path: "runbooks/node-recovery.md", author: "walter", ver: "v6", when: "1 w", links: ["charter.md"],
            raw: "# Node recovery\n\nTotal-loss restore, tested at every quarterly drill. Budget an hour.\n\n- Restore from your seed phrase — it derives every key you had.\n- Re-adopt the queue credentials from the last clean-close backup.\n- Verify the chain before your first send; a red check means stop.\n\n```\ndrill log 2026-06: petra 41 min · jonas 58 min (stuck at re-adopt)\n```",
            blocks: [
            { kind: 0, text: "Node recovery" },
            { kind: 2, text: "Total-loss restore, tested at every quarterly drill. Budget an hour." },
            { kind: 3, text: "Restore from your seed phrase — it derives every key you had." },
            { kind: 3, text: "Re-adopt the queue credentials from the last clean-close backup." },
            { kind: 3, text: "Verify the chain before your first send; a red check means stop." },
            { kind: 4, text: "drill log 2026-06: petra 41 min · jonas 58 min (stuck at re-adopt)" }] },
        { path: "glossary.md", author: "mara", ver: "v17", when: "1 d", links: ["charter.md"],
            raw: "# Glossary\n\nThe words we keep using, pinned down once.\n\n- Ritual — the founding ceremony that seals the roster; nothing touches disk before the seal.\n- Seal — the moment a proposal reaches the threshold and becomes canon.\n- Threshold — our 3-of-4 rule: three signatures make a change real.\n- Patch — one gated change on the chain, like a commit.",
            blocks: [
            { kind: 0, text: "Glossary" },
            { kind: 2, text: "The words we keep using, pinned down once." },
            { kind: 3, text: "Ritual — the founding ceremony that seals the roster; nothing touches disk before the seal." },
            { kind: 3, text: "Seal — the moment a proposal reaches the threshold and becomes canon." },
            { kind: 3, text: "Threshold — our 3-of-4 rule: three signatures make a change real." },
            { kind: 3, text: "Patch — one gated change on the chain, like a commit." }] },
        { path: "untitled-1.md", author: "petra", ver: "v1", when: "now", links: [],
            raw: "# Untitled 1\n\nA fresh page. Use Edit to replace this draft.",
            blocks: [
            { kind: 0, text: "Untitled 1" },
            { kind: 2, text: "A fresh page. Use Edit to replace this draft." }] },
        { path: "untitled-2.md", author: "petra", ver: "v1", when: "now", links: [],
            raw: "# Untitled 2\n\nA fresh page. Use Edit to replace this draft.",
            blocks: [
            { kind: 0, text: "Untitled 2" },
            { kind: 2, text: "A fresh page. Use Edit to replace this draft." }] },
        { path: "untitled-3.md", author: "petra", ver: "v1", when: "now", links: [],
            raw: "# Untitled 3\n\nA fresh page. Use Edit to replace this draft.",
            blocks: [
            { kind: 0, text: "Untitled 3" },
            { kind: 2, text: "A fresh page. Use Edit to replace this draft." }] },
    ];
    property <[MockNote]> archived: [
        { title: "Old relay migration plan", author: "walter", ver: "v4", when: "Mar 2026" },
        { title: "Logo drafts, round 1", author: "mara", ver: "v2", when: "Feb 2026" },
        { title: "Bootstrapping diary", author: "petra", ver: "v8", when: "Jan 2026" },
    ];

    if root.view == "brain": VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        // no PaneHeader here: the Multisig-Wiki title (with the mock
        // badge) sits in the app's top bar, left of the republic name —
        // the full pane height belongs to navigator + document.
        // The two-pane split: file navigator | draggable splitter |
        // content. The navigator width is a stored FRACTION of the row,
        // so a window resize keeps the proportion; both sides keep a
        // hard minimum.
        srow := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            property <length> avail: self.width - 8px;
            // ONE clamp for layout and drag: navigator ≥ 180px (the
            // five-button toolbar's floor), content ≥ 300px (below their
            // sum the navigator floor wins — the window is far below any
            // usable width there anyway)
            pure function clamp-nav(w: length) -> length {
                return max(180px, min(self.avail - 300px, w));
            }
            property <length> nav-w: self.clamp-nav(root.split * self.avail);

            // ---- navigator: browse the wiki tree ----
            Rectangle {
                width: srow.nav-w;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                VerticalLayout {
                    ToolStrip {
                        ToolBtn {
                            glyph: "📁";
                            name: Strings.mem-tb-new-folder;
                            enabled: root.made-folders < 2;
                            clicked => {
                                root.made-folders += 1;
                            }
                        }
                        ToolBtn {
                            glyph: "📝";
                            name: Strings.mem-tb-new-file;
                            enabled: root.made-files < 3;
                            clicked => {
                                root.made-files += 1;
                                root.open-doc(5 + root.made-files);
                            }
                        }
                        ToolBtn {
                            glyph: "🗑️";
                            name: Strings.mem-tb-delete;
                            // deletion acts on the navigator's MARKED row
                            // (the tab strip has its own × per tab)
                            enabled: root.alive(root.nav-marked);
                            clicked => {
                                root.close-tab(root.nav-marked);
                                root.kill(root.nav-marked);
                                root.nav-marked = root.step(root.nav-marked, 1);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        ToolBtn {
                            glyph: "🔼";
                            name: Strings.mem-tb-collapse;
                            enabled: true;
                            clicked => {
                                root.open-decisions = false;
                                root.open-quests = false;
                                root.open-runbooks = false;
                                root.open-newa = false;
                                root.open-newb = false;
                            }
                        }
                        ToolBtn {
                            glyph: "🔽";
                            name: Strings.mem-tb-open-all;
                            enabled: true;
                            clicked => {
                                root.open-decisions = true;
                                root.open-quests = true;
                                root.open-runbooks = true;
                                root.open-newa = true;
                                root.open-newb = true;
                            }
                        }
                    }
                    ScrollBody {
                        pad: 6px;
                        gap: 2px;
                        BrainFolderRow {
                            name: "decisions";
                            open <=> root.open-decisions;
                        }
                        if root.open-decisions && !root.dead1: BrainFileRow {
                            name: "2026-06-14-relay.md";
                            nested: true;
                            selected: root.nav-marked == 1;
                            pick => {
                                root.open-doc(1);
                            }
                        }
                        if root.open-decisions && !root.dead2: BrainFileRow {
                            name: "2026-07-02-treasury.md";
                            nested: true;
                            selected: root.nav-marked == 2;
                            pick => {
                                root.open-doc(2);
                            }
                        }
                        BrainFolderRow {
                            name: "quests";
                            open <=> root.open-quests;
                        }
                        if root.open-quests && !root.dead3: BrainFileRow {
                            name: "onboarding-guide.md";
                            nested: true;
                            selected: root.nav-marked == 3;
                            pick => {
                                root.open-doc(3);
                            }
                        }
                        BrainFolderRow {
                            name: "runbooks";
                            open <=> root.open-runbooks;
                        }
                        if root.open-runbooks && !root.dead4: BrainFileRow {
                            name: "node-recovery.md";
                            nested: true;
                            selected: root.nav-marked == 4;
                            pick => {
                                root.open-doc(4);
                            }
                        }
                        // folders created in the mock — empty for now:
                        // creating INTO a folder is not part of this draft
                        if root.made-folders >= 1: BrainFolderRow {
                            name: "new-folder-1";
                            open <=> root.open-newa;
                        }
                        if root.made-folders >= 1 && root.open-newa: HorizontalLayout {
                            padding-left: 24px;
                            height: 20px;
                            Text {
                                text: Strings.mem-empty-folder;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                vertical-alignment: center;
                            }
                        }
                        if root.made-folders >= 2: BrainFolderRow {
                            name: "new-folder-2";
                            open <=> root.open-newb;
                        }
                        if root.made-folders >= 2 && root.open-newb: HorizontalLayout {
                            padding-left: 24px;
                            height: 20px;
                            Text {
                                text: Strings.mem-empty-folder;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                vertical-alignment: center;
                            }
                        }
                        if !root.dead0: BrainFileRow {
                            name: "charter.md";
                            selected: root.nav-marked == 0;
                            pick => {
                                root.open-doc(0);
                            }
                        }
                        if !root.dead5: BrainFileRow {
                            name: "glossary.md";
                            selected: root.nav-marked == 5;
                            pick => {
                                root.open-doc(5);
                            }
                        }
                        // the mock's created files (one per 📝 click)
                        if root.alive(6): BrainFileRow {
                            name: "untitled-1.md";
                            selected: root.nav-marked == 6;
                            pick => {
                                root.open-doc(6);
                            }
                        }
                        if root.alive(7): BrainFileRow {
                            name: "untitled-2.md";
                            selected: root.nav-marked == 7;
                            pick => {
                                root.open-doc(7);
                            }
                        }
                        if root.alive(8): BrainFileRow {
                            name: "untitled-3.md";
                            selected: root.nav-marked == 8;
                            pick => {
                                root.open-doc(8);
                            }
                        }
                    }
                }
            }

            // ---- the draggable splitter (Slint has no built-in one) ----
            Rectangle {
                width: 8px;
                // center line, accent-lit under hover/drag
                Rectangle {
                    x: 3px;
                    width: 2px;
                    height: 100%;
                    background: sta.pressed || sta.has-hover ? Theme.accent : transparent;
                }
                // the grip pill
                Rectangle {
                    x: 2px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 30px;
                    border-radius: Theme.win95 ? 0px : 2px;
                    background: sta.pressed || sta.has-hover ? Theme.accent : Theme.line;
                }
                sta := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    moved => {
                        // mouse-x and pressed-x are both in THIS element's
                        // current frame, so their difference is exactly how
                        // far the press point drifted from the pointer —
                        // adding it to the current width re-centers the
                        // grip under the pointer and converges in one step.
                        // (A width frozen at press time double-corrects:
                        // every event undershoots by the already-applied
                        // delta and the splitter oscillates.)
                        root.split = srow.clamp-nav(srow.nav-w + (self.mouse-x - self.pressed-x)) / max(srow.avail, 1px);
                    }
                }
            }

            // ---- content: the selected file, pseudo-rendered ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                VerticalLayout {
                    // ---- the open documents as TABS: several .md files
                    // can be open at once; clicking focuses, × closes.
                    // Listed in tree order (the mock's fixed per-doc
                    // slots), the active tab carries the accent. ----
                    Rectangle {
                        height: 32px;
                        background: Theme.panel-2;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;
                            alignment: start;
                            for p in 9: HorizontalLayout {
                                if root.tabbed(root.at(p)) && root.alive(root.at(p)): tab := Rectangle {
                                    property <int> d: root.at(p);
                                    property <bool> active: root.sel == self.d;
                                    width: tabrow.preferred-width + 14px;
                                    border-radius: Theme.win95 ? 0px : 5px;
                                    background: tab.active ? Theme.panel
                                        : (tab-ta.has-hover ? Theme.raised : transparent);
                                    border-width: tab.active ? Theme.border-w : 0px;
                                    border-color: Theme.accent;
                                    tab-ta := TouchArea {
                                        clicked => {
                                            root.goto(tab.d);
                                        }
                                    }
                                    tabrow := HorizontalLayout {
                                        x: 7px;
                                        spacing: 5px;
                                        Text {
                                            text: root.doc-name(tab.d);
                                            color: tab.active ? Theme.text : Theme.dim;
                                            font-size: Theme.fs-cap;
                                            font-weight: tab.active ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 14px;
                                            Text {
                                                text: "×";
                                                color: close-ta.has-hover ? Theme.bad : Theme.faint;
                                                font-size: Theme.fs-body;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            close-ta := TouchArea {
                                                clicked => {
                                                    root.close-tab(tab.d);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height - Theme.border-w;
                            width: parent.width;
                            height: Theme.border-w;
                            background: Theme.line;
                        }
                    }
                    ToolStrip {
                        // ⬅️/➡️ — sequential browse through the documents
                        // in tree order (opens them as tabs); deliberately
                        // leaves the navigator mark behind, which arms 🎯
                        ToolBtn {
                            glyph: "⬅️";
                            name: Strings.mem-tb-prev;
                            enabled: root.cur-alive;
                            clicked => {
                                root.browse-to(root.step(root.sel, -1));
                            }
                        }
                        ToolBtn {
                            glyph: "➡️";
                            name: Strings.mem-tb-next;
                            enabled: root.cur-alive;
                            clicked => {
                                root.browse-to(root.step(root.sel, 1));
                            }
                        }
                        Rectangle {
                            width: 4px;
                        }
                        // the open file's path is the strip's breadcrumb
                        Text {
                            text: root.cur-alive ? root.cur.path : "";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // ✏️/👁️ — pretty preview ⇄ raw .md source, right
                        // beside the title
                        ToolBtn {
                            glyph: root.editing ? "👁️" : "✏️";
                            name: root.editing ? Strings.mem-tb-preview : Strings.mem-tb-edit;
                            enabled: root.cur-alive;
                            clicked => {
                                root.editing = !root.editing;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // 🎯 — re-align the navigator with the active tab;
                        // armed only while they diverge
                        ToolBtn {
                            glyph: "🎯";
                            name: Strings.mem-tb-locate;
                            enabled: root.cur-alive && root.nav-marked != root.sel;
                            clicked => {
                                root.reveal();
                            }
                        }
                        // 🔗 — copy a molt:// URI for chat / cross-notes
                        ToolBtn {
                            glyph: "🔗";
                            name: Strings.mem-tb-link;
                            enabled: root.cur-alive;
                            clicked => {
                                root.copy-link("molt://memory/" + root.cur.path);
                            }
                        }
                    }
                    if root.cur-alive && !root.editing: ScrollBody {
                        pad: 16px;
                        gap: 8px;
                        // author · version · age — the note-footer idiom
                        Text {
                            text: "\{root.cur.author} · \{root.cur.ver} · \{root.cur.when}";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        for b in root.cur.blocks: BrainBlockView {
                            b: b;
                        }
                        // cross-links — what makes the tree a wiki. One
                        // chip per line: paths are long and the chips
                        // neither wrap nor elide, so a row would clip at
                        // the content pane's minimum width.
                        if root.cur.links.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 6px;
                            Rectangle {
                                height: Theme.border-w;
                                background: Theme.line;
                            }
                            Text {
                                text: Strings.mem-linked;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            for l in root.cur.links: HorizontalLayout {
                                alignment: start;
                                TagChip {
                                    glyph: "🔗";
                                    label: l;
                                }
                            }
                        }
                    }
                    // raw-markdown mode: the same document as editable .md
                    // source. Mock: the buffer is view-local — toggling
                    // back discards it, nothing is stored or sent.
                    if root.cur-alive && root.editing: Rectangle {
                        vertical-stretch: 1;
                        AppArea {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            text: root.cur.raw;
                        }
                    }
                    // everything deleted — the mock's honest empty state
                    if !root.cur-alive: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: Strings.mem-empty;
                            color: Theme.faint;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.view == "archive": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🗄️";
            title: Strings.mem-title-archive;
            hint: Strings.mem-hint-archive;
        }
        PanePanel {
            for n in root.archived: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                height: 44px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Text {
                        text: n.title;
                        color: Theme.dim;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "\{n.author} · \{n.ver} · \{n.when}";
                        color: Theme.faint;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Quests — the quest board
// ---------------------------------------------------------------------------

struct MockQuest {
    title: string,
    detail: string,
    reward: string, // "5 XMR" ("" = none)
    who: string, // open: put forward by; claimed/done: the claimant
    when: string,
    done: bool,
}

component QuestCard inherits Rectangle {
    in property <MockQuest> q;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    opacity: root.q.done ? 0.62 : 1.0;
    VerticalLayout {
        padding: 11px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.q.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.q.done: Rectangle {
                width: 18px;
                height: 20px;
                clip: true;
                Text {
                    text: "✅";
                    font-family: "Twemoji Mozilla";
                    font-size: 13px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.q.detail != "": Text {
            text: root.q.detail;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.q.reward != "": TagChip {
                glyph: "🪙";
                label: root.q.reward;
                y: (parent.height - self.height) / 2;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            GlyphCaption {
                glyph: "👤";
                label: "\{root.q.who} · \{root.q.when}";
            }
        }
    }
}

component QuestColumn inherits Rectangle {
    in property <string> title;
    in property <color> tone;
    in property <[MockQuest]> quests;
    horizontal-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            DotLabel {
                tone: root.tone;
                label: root.title;
                label-size: Theme.fs-cap;
                label-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "\{root.quests.length}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            cfl := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: clist.preferred-height;
                clist := VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for q in root.quests: QuestCard {
                        q: q;
                    }
                }
            }
            ScrollHint {
                x: parent.width - 5px;
                view-h: cfl.height;
                content-h: cfl.viewport-height;
                scroll-y: cfl.viewport-y;
            }
        }
    }
}

