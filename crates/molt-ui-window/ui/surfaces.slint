// ---------------------------------------------------------------------------
// Vault — sealed secrets
// ---------------------------------------------------------------------------

struct MockSecret {
    name: string,
    glyph: string, // 🔑 credential · 📄 document
    by: string,
    when: string,
    need: int, // released at `need` of `total` signatures
    total: int,
}

struct MockSigner {
    name: string,
    signed: bool,
}

struct MockRelease {
    secret: string,
    by: string,
    reason: string,
    signers: [MockSigner],
    signed: int, // collected signatures (matches the signers marked true)
    need: int,
}

struct MockExposed {
    name: string,
    content: string,
    by: string,
    when: string,
}

component SecretCard inherits Rectangle {
    in property <MockSecret> s;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        // the seal medallion — the vault's signature element
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.win95 ? 0px : 22px;
            background: Theme.accent-soft;
            border-width: Theme.border-w;
            border-color: Theme.accent;
            clip: true;
            Text {
                text: root.s.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 17px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 16px;
                y: parent.height - 16px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: Theme.panel;
                Text {
                    text: "🔒";
                    font-family: "Twemoji Mozilla";
                    font-size: 9px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.s.name;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: "\{Strings.vt-sealed-by} \{root.s.by} · \{root.s.when}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                overflow: elide;
            }
            // the release threshold as share dots: `need` filled of `total`
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for i in root.s.total: Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    y: (parent.height - self.height) / 2;
                    background: i < root.s.need ? Theme.accent : transparent;
                    border-width: 1px;
                    border-color: i < root.s.need ? Theme.accent : Theme.faint;
                }
                Text {
                    text: "  \{Strings.vt-opens-at} \{root.s.need} \{Strings.cw-rule-b} \{root.s.total}";
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
            }
        }
    }
}

