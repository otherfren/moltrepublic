    if root.view == "exposed": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🔓";
            title: Strings.vt-title-exposed;
            hint: Strings.vt-hint-exposed;
        }
        PanePanel {
            for e in root.exposed: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 10px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: e.name;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "\{Strings.vt-released-word} · \{Strings.vt-requested-by} \{e.by} · \{e.when}";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                        }
                    }
                    // the revealed content on an inset well
                    Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.win95 ? 0px : 6px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        height: ct.preferred-height + 16px;
                        ct := Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: e.content;
                            color: Theme.text;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Wallet — Monero multisig
// ---------------------------------------------------------------------------

struct MockTransfer {
    incoming: bool,
    amount: string, // "12.0000"
    label: string,
    when: string,
    conf: int, // confirmations, capped at 10
    txid: string,
}

struct MockPendingTx {
    label: string,
    amount: string,
    signed: int,
    need: int,
    signers: [MockSigner],
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    height: 44px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component WalletPane inherits VerticalLayout {
    in property <string> view;
    spacing: 8px;

    // sample data — design mock only, never engine state
    property <[MockTransfer]> transfers: [
        { incoming: true, amount: "0.5028", label: "Donation (anonymous)", when: "5 h", conf: 3, txid: "b41c…9e" },
        { incoming: true, amount: "12.0000", label: "Member top-up — mara", when: "2 d", conf: 10, txid: "9f3c…a1" },
        { incoming: false, amount: "4.0000", label: "Quest reward — multisig setup", when: "1 w", conf: 10, txid: "77ab…04" },
        { incoming: true, amount: "25.0000", label: "Member top-up — petra", when: "2 w", conf: 10, txid: "c2d8…5f" },
        { incoming: false, amount: "2.4000", label: "Relay hosting Q2", when: "1 m", conf: 10, txid: "e901…bc" },
        { incoming: false, amount: "0.8000", label: "Domain renewal", when: "1 m", conf: 10, txid: "12fe…77" },
        { incoming: true, amount: "100.0000", label: "Founding treasury", when: "4 m", conf: 10, txid: "a0b1…c2" },
    ];
    property <[MockPendingTx]> pending-tx: [
        { label: "Quest reward — recovery drill → jonas", amount: "5.0000", signed: 1, need: 3, signers: [
            { name: "petra", signed: true }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
        { label: "Relay hosting Q3", amount: "2.4000", signed: 0, need: 3, signers: [
            { name: "petra", signed: false }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
    ];
    // send form: pure pane state for design iteration (priority chip row)
    property <int> prio: 1;

    // the receive card's decorative pseudo-QR: a deterministic 17×17
    // module pattern with the three finder squares — design chrome only,
    // NOT an encoding of the (equally fictional) address below it
    pure function qr-cell(row: int, col: int) -> bool {
        if (row <= 6 && col <= 6) {
            return row == 0 || row == 6 || col == 0 || col == 6 || (row >= 2 && row <= 4 && col >= 2 && col <= 4);
        }
        if (row <= 6 && col >= 10) {
            return row == 0 || row == 6 || col == 10 || col == 16 || (row >= 2 && row <= 4 && col >= 12 && col <= 14);
        }
        if (row >= 10 && col <= 6) {
            return row == 10 || row == 16 || col == 0 || col == 6 || (row >= 12 && row <= 14 && col >= 2 && col <= 4);
        }
        return Math.mod(row * 17 + col * 31 + row * col * 7, 11) < 5;
    }

    if root.view == "balance": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "💰";
            title: Strings.wl-title-balance;
            hint: Strings.wl-hint-balance;
        }
        // the balance figure — the wallet's signature moment
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            height: bal.preferred-height + 36px;
            bal := VerticalLayout {
                x: 18px;
                y: 18px;
                width: parent.width - 36px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "128.4062";
                        color: Theme.text;
                        font-size: 34px;
                        font-weight: 800;
                    }
                    Text {
                        text: "XMR";
                        color: Theme.faint;
                        font-size: Theme.fs-h2;
                        font-weight: 700;
                        vertical-alignment: bottom;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        TagChip {
                            label: "3 \{Strings.cw-rule-b} 4 \{Strings.wl-multisig-word}";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    GlyphCaption {
                        glyph: "🔓";
                        label: "121.9034 XMR \{Strings.wl-unlocked}";
                        tone: Theme.dim;
                    }
                    GlyphCaption {
                        glyph: "⏳";
                        label: "6.5028 XMR \{Strings.wl-locked}";
                        tone: Theme.dim;
                    }
                }
            }
        }
        // transfers awaiting the threshold's signatures
        Text {
            text: Strings.wl-pending-sigs;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 600;
        }
        PanePanel {
            for t in root.pending-tx: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 11px;
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "− \{t.amount} XMR";
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    SigMeter {
                        signed: t.signed;
                        need: t.need;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for m in t.signers: TagChip {
                            glyph: m.signed ? "✍️" : "";
                            label: m.name;
                            muted: !m.signed;
                        }
                    }
                }
            }
        }
    }

    if root.view == "history": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📜";
            title: Strings.wl-title-history;
            hint: Strings.wl-hint-history;
        }
        PanePanel {
            for t in root.transfers: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                height: 52px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 20px;
                        height: 100%;
                        clip: true;
                        Text {
                            text: t.incoming ? "📥" : "📤";
                            font-family: "Twemoji Mozilla";
                            font-size: 14px;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: "\{t.when} · \{t.txid}";
                            color: Theme.faint;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: t.conf >= 10 ? "10/10 ✓" : "\{t.conf}/10";
                        color: t.conf >= 10 ? Theme.good : Theme.warn;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                    Text {
                        text: t.incoming ? "+ \{t.amount}" : "− \{t.amount}";
                        color: t.incoming ? Theme.good : Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                    }
                }
            }
        }
    }

    if root.view == "send": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📤";
            title: Strings.wl-title-send;
            hint: Strings.wl-hint-send;
        }
        PanePanel {
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-to-address;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "4…";
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-amount;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "0.0000";
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-priority;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    AppButton {
                        label: Strings.wl-prio-low;
                        primary: root.prio == 0;
                        clicked => {
                            root.prio = 0;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-normal;
                        primary: root.prio == 1;
                        clicked => {
                            root.prio = 1;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-high;
                        primary: root.prio == 2;
                        clicked => {
                            root.prio = 2;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                AppButton {
                    emoji: "🗳️";
                    label: Strings.wl-propose-transfer;
                    primary: true;
                    enabled: false;
                    tooltip: Strings.not-implemented-yet;
                    tooltip-below: true;
                }
                Text {
                    text: "\{Strings.wl-fee} ≈ 0.000021 XMR";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }

    if root.view == "receive": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📥";
            title: Strings.wl-title-receive;
            hint: Strings.wl-hint-receive;
        }
        PanePanel {
            HorizontalLayout {
                spacing: 16px;
                alignment: start;
                // decorative pseudo-QR on a light well (QR needs light
                // ground on every theme)
                Rectangle {
                    width: 17 * 6px + 24px;
                    height: 17 * 6px + 24px;
                    background: #ffffff;
                    border-radius: Theme.win95 ? 0px : 8px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    for i in 289: Rectangle {
                        x: 12px + Math.mod(i, 17) * 6px;
                        y: 12px + Math.floor(i / 17) * 6px;
                        width: 6px;
                        height: 6px;
                        background: root.qr-cell(Math.floor(i / 17), Math.mod(i, 17)) ? #1a1d21 : transparent;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Strings.wl-subaddress;
                        color: Theme.dim;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                    }
                    Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.win95 ? 0px : 6px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        height: addr.preferred-height + 16px;
                        // deliberately mid-truncated: a design-mock address
                        // must never be transcribable into a send field
                        addr := Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: "8BdKQ9wJ3mPZxVtF7nRqYcLhG2sD4eTv … PxQbUcFgAt2iE9oRk4";
                            color: Theme.text;
                            font-size: Theme.fs-cap;
                            wrap: char-wrap;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        AppButton {
                            label: Strings.ow-copy;
                            enabled: false;
                            tooltip: Strings.not-implemented-yet;
                            tooltip-below: true;
                        }
                    }
                }
            }
        }
    }

    if root.view == "settings": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "⚙️";
            title: Strings.wl-title-settings;
            hint: Strings.wl-hint-settings;
        }
        PanePanel {
            SettingRow {
                label: Strings.wl-node;
                value: "node.example.org:18081 · Tor";
            }
            SettingRow {
                label: Strings.wl-sync;
                value: "3 214 502 ✓";
            }
            SettingRow {
                label: Strings.wl-signer-set;
                value: "3 \{Strings.cw-rule-b} 4 — petra, walter, mara, jonas";
            }
        }
    }
}
