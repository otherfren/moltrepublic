// SPDX-License-Identifier: GPL-3.0-or-later
//
// DESIGN MOCKS for the four staged surfaces: Memory (shared brain), Quests
// (quest board), Vault (sealed secrets) and Wallet (Monero multisig).
//
// These panes are badged UX drafts to iterate on look & feel — every dataset
// below is .slint-side sample data, never engine state. Actions either work
// as pure view-state mocks or render DISABLED (with the "not yet" tooltip,
// the same idiom as the greyed network options). The REAL threshold
// governance for these surfaces (pending proposals / applied log / propose)
// stays in app.slint and routes to the "proposals" (resp. wallet "status")
// sub-views.
//
// EXCEPTION: the Multisig-Wiki's state (doc tree, tabs, edit buffers, the
// pending-change set) lives in the Rust model `crates/molt-ui/src/wiki.rs`
// and reaches this pane through the `WikiState` global — still a badged
// mock (nothing is stored or sent), but the client state machine is real
// and unit-tested. This pane only renders rows and routes actions.
//
// Each pane is one component taking only the selected sub-view key, so the
// panes stay independently editable under scripts/dev-ui.sh hot-reload.

import { Theme, Strings, HintTip, WikiState, WikiNavRow, WikiTabRow, WikiBlock, WikiSpan } from "theme.slint";
import { AppButton, AppField, AppArea, ScrollHint, DotLabel } from "components.slint";

// ---------------------------------------------------------------------------
// shared chrome
// ---------------------------------------------------------------------------

// The small-but-unmissable badge every mock pane carries: warn-coloured like
// the founding ritual's SIMULATION badge, with an honesty tooltip.
export component MockBadge inherits Rectangle {
    background: Theme.warn;
    border-radius: Theme.win95 ? 0px : 4px;
    width: bt.preferred-width + 12px;
    height: bt.preferred-height + 5px;
    bt := Text {
        x: 6px;
        y: 2.5px;
        text: Strings.mock-badge;
        color: #1a1200;
        font-size: Theme.fs-cap;
        font-weight: 700;
    }
    // the hint goes through the window-topmost HintTip overlay (renders
    // above everything, never clipped, and — unlike a PopupWindow — grabs
    // no input, so the hover cannot strobe)
    ta := TouchArea {
        changed has-hover => {
            if (self.has-hover) {
                HintTip.label = Strings.mock-tip;
                HintTip.ax = root.absolute-position.x;
                HintTip.ay = root.absolute-position.y + root.height + 6px;
            } else if (HintTip.ax == root.absolute-position.x
                && HintTip.ay == root.absolute-position.y + root.height + 6px) {
                // only clear our own hint — hovering straight onto another
                // control may already have replaced it
                HintTip.label = "";
            }
        }
    }
}

// One pane/view header: Twemoji glyph + title + the mock badge, and an
// optional one-line hint underneath (the honest "what this will be" line).
component PaneHeader inherits VerticalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint: "";
    spacing: 5px;
    HorizontalLayout {
        spacing: 10px;
        // fixed clip box, like the nav rows: an oversized emoji glyph must
        // never bleed into the neighbours
        Rectangle {
            width: 22px;
            height: 24px;
            clip: true;
            Text {
                text: root.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 16px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-h2;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            MockBadge { }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
    }
}

// The standard content panel every pane's body sits on (chat's message list
// idiom): a themed surface with a Flickable + scroll hint.
component PanePanel inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    out property <length> inner-width: fl.width;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height + 24px;
        body := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 7px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// A tiny accent-tinted chip: tags, rewards, badges, signer marks. The
// optional leading glyph renders in the Twemoji font (never plain-text
// emoji in labels); `muted` turns it into a quiet outline (e.g. a signer
// who has not signed yet).
component TagChip inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> muted: false;
    background: root.muted ? transparent : Theme.accent-soft;
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.muted ? 1px : 0px;
    border-color: Theme.line;
    width: row.preferred-width + 12px;
    height: 20px;
    // full-height row + centered texts: an offset row sized off the text's
    // preferred height sat the label visibly at the chip's bottom edge
    row := HorizontalLayout {
        x: 6px;
        y: 0;
        height: parent.height;
        spacing: 4px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            height: 100%;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.muted ? Theme.faint : (Theme.win95 ? Theme.text : Theme.accent);
            font-size: 11px;
            font-weight: root.muted ? 400 : 600;
            height: 100%;
            vertical-alignment: center;
        }
    }
}

// The signature-collection meter (the pending-proposal progress idiom):
// a thin track with an accent fill plus the "x/y signed" caption.
component SigMeter inherits HorizontalLayout {
    in property <int> signed;
    in property <int> need;
    spacing: 10px;
    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 3px;
        background: Theme.line;
        horizontal-stretch: 1;
        Rectangle {
            x: 0;
            height: parent.height;
            border-radius: parent.border-radius;
            width: parent.width * min(1.0, root.signed * 1.0 / max(root.need, 1));
            background: Theme.accent;
        }
    }
    Text {
        text: "\{root.signed}/\{root.need} \{Strings.vt-signed-word}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

// A quiet "glyph + text" caption row (authors, dates, rewards …).
component GlyphCaption inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <color> tone: Theme.faint;
    spacing: 5px;
    Rectangle {
        width: 16px;
        height: 16px;
        clip: true;
        y: (parent.height - self.height) / 2;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        color: root.tone;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// Memory — the Multisig-Wiki (the shared brain)
// ---------------------------------------------------------------------------



// The slim toolbar strip on top of the navigator / content panes.
component ToolStrip inherits Rectangle {
    height: 34px;
    background: Theme.panel-2;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 4px;
        padding-bottom: 5px;
        spacing: 3px;
        @children
    }
    // bottom hairline separating the strip from the pane body
    Rectangle {
        x: 0;
        y: parent.height - Theme.border-w;
        width: parent.width;
        height: Theme.border-w;
        background: Theme.line;
    }
}

// A compact square toolbar button: Twemoji glyph, named tooltip below.
// Disabled by default — the pane idiom: an action that would change shared
// state renders greyed with the honest "not yet" suffix; wired actions
// pass `enabled: true` and really work. The tooltip is a PopupWindow, not
// an in-tree bubble: popups render above and outside the panel's clipped
// bounds, so a hint near a panel edge is never cut off.
component ToolBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <bool> enabled: false;
    callback clicked();
    width: 30px;
    border-radius: Theme.win95 ? 0px : 5px;
    background: root.enabled && ta.has-hover ? Theme.raised : transparent;
    Rectangle {
        width: 18px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 13px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.4;
        }
    }
    // the TouchArea stays enabled either way — a disabled button still
    // names itself on hover; only clicked() gates. Every disabled ToolBtn
    // today is STATE-disabled (no tab, nothing to act on), so the hint is
    // the plain name — the dimmed glyph already says "inactive", and a
    // "not yet" suffix here would wrongly claim the feature is unbuilt.
    // The hint renders through the window-topmost HintTip overlay (never
    // clipped, grabs no input — a PopupWindow here strobed the hover).
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        changed has-hover => {
            if (self.has-hover) {
                HintTip.label = root.name;
                HintTip.ax = root.absolute-position.x;
                HintTip.ay = root.absolute-position.y + root.height + 6px;
            } else if (HintTip.ax == root.absolute-position.x
                && HintTip.ay == root.absolute-position.y + root.height + 6px) {
                // only clear our own hint — hovering straight onto another
                // button may already have replaced it
                HintTip.label = "";
            }
        }
        clicked => {
            HintTip.label = "";
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The scrolling body under a ToolStrip (PanePanel's padless cousin for
// panes that carry their own chrome): Flickable + scroll hint, with the
// caller's padding/spacing.
component ScrollBody inherits Rectangle {
    in property <length> pad: 8px;
    in property <length> gap: 2px;
    vertical-stretch: 1;
    clip: true;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height;
        body := VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 5px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// One pseudo-rendered markdown block of the content pane, with its diff
// verdict: a colored bar marks added (good) / changed (warn) / removed
// (bad) blocks; a removed GHOST keeps the dropped base content visible,
// dimmed in the bad tone (Slint Text has no strikethrough).
// One clickable .md-link run in the preview: accent + underline, a soft
// pill while hovered; a click navigates to the linked document.
component LinkRun inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <length> fsize: Theme.fs-editor;
    width: lt.preferred-width + 4px;
    height: lt.preferred-height;
    border-radius: 3px;
    background: lta.has-hover ? Theme.accent-soft : transparent;
    lt := Text {
        x: 2px;
        text: root.label;
        color: Theme.accent;
        font-size: root.fsize;
    }
    // Text has no underline — the link affordance is drawn
    Rectangle {
        x: 2px;
        y: parent.height - 1px;
        width: parent.width - 4px;
        height: 1px;
        background: Theme.accent;
    }
    lta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            WikiState.open-link(root.target);
        }
    }
}

// A block's inline runs with clickable .md links. While the whole line
// fits unwrapped it renders as a true inline row; a longer link-bearing
// block falls back to stacked runs (Slint has no wrapping rich text) —
// plain runs wrap there and each link sits on its own line.
component SpanFlow inherits Rectangle {
    in property <[WikiSpan]> spans;
    in property <string> flat; // the flattened text — the fits-measure
    in property <color> ink;
    in property <length> fsize: Theme.fs-editor;
    property <bool> fits: m.preferred-width <= root.width - 8px;
    height: root.fits ? one.preferred-height : many.preferred-height;
    m := Text {
        text: root.flat;
        font-size: root.fsize;
        visible: false;
    }
    one := HorizontalLayout {
        visible: root.fits;
        alignment: start;
        spacing: 0;
        for sp in root.spans: HorizontalLayout {
            if sp.link == "": Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
            }
            if sp.link != "": LinkRun {
                label: sp.text;
                target: sp.link;
                fsize: root.fsize;
            }
        }
    }
    many := VerticalLayout {
        visible: !root.fits;
        spacing: 2px;
        for sp in root.spans: VerticalLayout {
            // a plain run fills the width and wraps; a link keeps its
            // natural width (alignment: start) so the pill hugs the text
            if sp.link == "": Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
                wrap: word-wrap;
            }
            if sp.link != "": HorizontalLayout {
                alignment: start;
                LinkRun {
                    label: sp.text;
                    target: sp.link;
                    fsize: root.fsize;
                }
            }
        }
    }
}

component BrainBlockView inherits HorizontalLayout {
    in property <WikiBlock> b;
    // an h2 gets extra air above — the one spacing exception a doc needs
    padding-top: root.b.kind == 1 ? 6px : 0px;
    spacing: 8px;
    property <bool> ghost: root.b.status == 3;
    property <color> ink: root.ghost ? Theme.bad.mix(Theme.dim, 0.6) : Theme.text;
    // link-bearing paragraphs/bullets render their spans (clickable);
    // ghosts stay flat text — a removed block is history, not navigation
    property <bool> linked: !root.ghost
        && (root.b.spans.length > 1
            || (root.b.spans.length == 1 && root.b.spans[0].link != ""));
    Rectangle {
        width: 3px;
        border-radius: 1.5px;
        background: root.b.status == 1 ? Theme.good
            : root.b.status == 2 ? Theme.warn
            : root.b.status == 3 ? Theme.bad
            : transparent;
    }
    VerticalLayout {
        if root.b.kind == 0: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor + 4px;
            font-weight: 800;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 1: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-weight: 700;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && !root.linked: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && root.linked: SpanFlow {
            spans: root.b.spans;
            flat: root.b.text;
            ink: root.ink;
        }
        if root.b.kind == 3: HorizontalLayout {
            spacing: 7px;
            Text {
                text: "•";
                color: root.ghost ? Theme.bad : Theme.accent;
                font-size: Theme.fs-editor;
                vertical-alignment: top;
            }
            if !root.linked: Text {
                text: root.b.text;
                color: root.ink;
                font-size: Theme.fs-editor;
                font-italic: root.ghost;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.linked: SpanFlow {
                spans: root.b.spans;
                flat: root.b.text;
                ink: root.ink;
                horizontal-stretch: 1;
            }
        }
        if root.b.kind == 4: Rectangle {
            background: Theme.bg;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            height: ct.preferred-height + 16px;
            ct := Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: root.b.text;
                color: root.ghost ? root.ink : Theme.dim;
                font-size: Theme.fs-editor - 2px;
                font-italic: root.ghost;
                wrap: word-wrap;
            }
        }
    }
}

export component MemoryPane inherits VerticalLayout {
    in property <string> view;
    // the 📋 button's path travels up to the app root — the real clipboard
    // write and the toast live there, the pane stays a pure view
    callback copy-path(string);
    // the ⚙️ gear routes to the app-level settings screen
    callback open-settings();
    // "discard all" asks first — the modal lives at the app root (a
    // layout child here could not overlay the pane)
    callback confirm-revert();
    spacing: 8px;

    // Everything the wiki KNOWS lives in the Rust model behind WikiState
    // (tree, tabs, buffers, pending changes). What stays here is view
    // state that belongs to the pane: the splitter fraction and the
    // in-flight drag gesture.
    property <float> split: 0.32;
    // drag-move: a file row arms it once the press moves past a small
    // threshold; the drop target is a ROW INDEX computed from pointer
    // geometry (uniform 26px rows + 2px gap = 28px pitch), and the
    // folder-vs-file-vs-past-the-end semantics resolve in the model.
    // (Slint 1.17's native DragArea needs a host-built data-transfer
    // payload, which only exists behind private_unstable_api — hence
    // this small pane-local gesture instead.)
    property <int> drag-id: -1;
    property <int> drag-to: -1;
    property <bool> drag-live: false;
    // swallows the click that ends a drag (clicked fires after the
    // pointer-up that commits the drop)
    property <bool> drag-was: false;

    // status → tone, ONE mapping for nav rows, tabs and the breadcrumb:
    // 1 added (good) · 2 modified (warn) · 3 deleted (bad)
    pure function tone(status: int, idle: color) -> color {
        return status == 1 ? Theme.good
            : status == 2 ? Theme.warn
            : status == 3 ? Theme.bad
            : idle;
    }

    // changeset stack rows: kind → glyph / tone
    // (0 created · 1 folder · 2 renamed · 3 moved · 4 deleted · 5 edited)
    pure function cs-glyph(kind: int) -> string {
        return kind == 0 ? "➕"
            : kind == 1 ? "📁"
            : kind == 2 ? "🏷️"
            : kind == 3 ? "➡️"
            : kind == 4 ? "🗑️"
            : "✏️";
    }
    pure function cs-tone(kind: int) -> color {
        return kind == 4 ? Theme.bad
            : (kind == 0 || kind == 1) ? Theme.good
            : Theme.warn;
    }

    if root.view == "brain": VerticalLayout {
        spacing: 8px;

        // ---- the changeset panel: every local action, and what the
        // next vote would bundle. Visible only while changes exist. ----
        if WikiState.cs-rows.length > 0: Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            property <length> list-h: min(WikiState.cs-rows.length, 4) * 24px;
            height: 18px + 28px + 6px + self.list-h;
            VerticalLayout {
                padding: 9px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 10px;
                    Text {
                        text: Strings.mem-cs-title;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    // the NET summary: only non-zero parts speak
                    if WikiState.cs-added > 0: Text {
                        text: "+\{WikiState.cs-added} \{Strings.mem-cs-new}";
                        color: Theme.good;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-deleted > 0: Text {
                        text: "-\{WikiState.cs-deleted} \{Strings.mem-cs-deleted}";
                        color: Theme.bad;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-moved > 0: Text {
                        text: "→\{WikiState.cs-moved} \{Strings.mem-cs-moved}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-lines > 0: Text {
                        text: "~\{WikiState.cs-lines} \{Strings.mem-cs-lines}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    AppButton {
                        height: 28px;
                        pad: 10px;
                        label: Strings.mem-cs-undo;
                        clicked => {
                            WikiState.cs-undo();
                        }
                    }
                    AppButton {
                        height: 28px;
                        pad: 10px;
                        label: Strings.mem-cs-revert;
                        clicked => {
                            root.confirm-revert();
                        }
                    }
                    AppButton {
                        height: 28px;
                        pad: 10px;
                        label: Strings.mem-cs-vote;
                        emoji: "🗳️";
                        primary: true;
                        clicked => {
                            WikiState.cs-vote();
                        }
                    }
                }
                // the action stack, oldest first (capped, scrolls)
                Rectangle {
                    clip: true;
                    csl := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: self.width;
                        viewport-height: WikiState.cs-rows.length * 24px;
                        VerticalLayout {
                            alignment: start;
                            for r in WikiState.cs-rows: HorizontalLayout {
                                height: 24px;
                                spacing: 6px;
                                Rectangle {
                                    width: 16px;
                                    height: 100%;
                                    clip: true;
                                    Text {
                                        text: root.cs-glyph(r.kind);
                                        font-family: "Twemoji Mozilla";
                                        font-size: 11px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: r.label;
                                    color: root.cs-tone(r.kind);
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    ScrollHint {
                        x: parent.width - 5px;
                        view-h: csl.height;
                        content-h: csl.viewport-height;
                        scroll-y: csl.viewport-y;
                    }
                }
            }
        }
        // no PaneHeader here: the Multisig-Wiki title (with the mock
        // badge) sits in the app's top bar, left of the republic name —
        // the full pane height belongs to navigator + document.
        // The two-pane split: file navigator | draggable splitter |
        // content. The navigator width is a stored FRACTION of the row,
        // so a window resize keeps the proportion; both sides keep a
        // hard minimum.
        srow := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            property <length> avail: self.width - 8px;
            // ONE clamp for layout and drag: navigator ≥ 180px (the
            // five-button toolbar's floor), content ≥ 300px (below their
            // sum the navigator floor wins — the window is far below any
            // usable width there anyway)
            pure function clamp-nav(w: length) -> length {
                return max(180px, min(self.avail - 300px, w));
            }
            property <length> nav-w: self.clamp-nav(root.split * self.avail);

            // ---- navigator: browse the wiki tree ----
            Rectangle {
                width: srow.nav-w;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                // Enter opens / Del deletes the MARKED row as soon as the
                // navigator was clicked (the row click below hands this
                // scope the focus); anything else bubbles to the window
                // handler, which carries the same routes as a fallback
                nav-scope := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.Return && WikiState.has-marked) {
                            WikiState.open-marked();
                            return accept;
                        }
                        if (event.text == Key.Delete && WikiState.has-marked) {
                            WikiState.delete-marked();
                            return accept;
                        }
                        reject
                    }
                VerticalLayout {
                    ToolStrip {
                        ToolBtn {
                            glyph: "📁";
                            name: Strings.mem-tb-new-folder;
                            enabled: true;
                            clicked => {
                                WikiState.new-folder();
                            }
                        }
                        ToolBtn {
                            glyph: "📝";
                            name: Strings.mem-tb-new-file;
                            enabled: true;
                            clicked => {
                                WikiState.new-file();
                            }
                        }
                        ToolBtn {
                            glyph: "🗑️";
                            name: Strings.mem-tb-delete;
                            // deletion acts on the navigator's MARKED row
                            // (the tab strip has its own × per tab)
                            enabled: WikiState.has-marked;
                            clicked => {
                                WikiState.delete-marked();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        ToolBtn {
                            glyph: "🔽";
                            name: Strings.mem-tb-collapse;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(false);
                            }
                        }
                        ToolBtn {
                            glyph: "🔼";
                            name: Strings.mem-tb-open-all;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(true);
                            }
                        }
                    }
                    ScrollBody {
                        pad: 6px;
                        gap: 2px;
                        for r[idx] in WikiState.nav-rows: Rectangle {
                            height: 26px;
                            border-radius: Theme.win95 ? 0px : 5px;
                            // the drop-target rim while a drag hovers this row
                            // (drawn by the inner variant rects — children
                            // would paint over a border set out here)
                            property <bool> drop-target: root.drag-live && root.drag-to == idx;

                            // ---- a folder row: click folds/unfolds ----
                            if r.is-folder: frow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: fta.has-hover ? Theme.zebra : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 18px;
                                        height: 100%;
                                        clip: true;
                                        Text {
                                            text: r.open ? "📂" : "📁";
                                            font-family: "Twemoji Mozilla";
                                            font-size: 12px;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: r.label + "/";
                                        color: root.tone(r.status, Theme.dim);
                                        font-size: Theme.fs-nav;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        // a cut name shows in full beside the
                                        // row (window-topmost HintTip overlay)
                                        property <bool> tip-on: fta.has-hover && self.width < self.preferred-width;
                                        changed tip-on => {
                                            if (self.tip-on) {
                                                HintTip.label = r.label + "/";
                                                HintTip.ax = frow.absolute-position.x + frow.width + 8px;
                                                HintTip.ay = frow.absolute-position.y + (frow.height - 23px) / 2;
                                            } else if (HintTip.ax == frow.absolute-position.x + frow.width + 8px
                                                && HintTip.ay == frow.absolute-position.y + (frow.height - 23px) / 2) {
                                                HintTip.label = "";
                                            }
                                        }
                                    }
                                }
                                fta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        nav-scope.focus();
                                        WikiState.nav-toggle-folder(r.label);
                                    }
                                }
                            }

                            // ---- a file row: mark on click, open on
                            // double-click / Enter / menu, right-click menu,
                            // drag to move ----
                            if !r.is-folder: filerow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: r.marked ? Theme.accent-soft : (ta.has-hover ? Theme.zebra : transparent);
                                clip: true;
                                if r.marked: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }
                                fmenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-menu-open;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.nav-open(r.id);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-rename;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.nav-rename-start(r.id);
                                            }
                                        }
                                        // pending rename/edit (2) or pending
                                        // deletion (3): back to the base state
                                        MenuItem {
                                            title: Strings.mem-menu-revert;
                                            enabled: r.status == 2 || r.status == 3;
                                            activated => {
                                                WikiState.nav-revert(r.id);
                                            }
                                        }
                                        // link markup to the clipboard, ready
                                        // to paste into any open editor
                                        MenuItem {
                                            title: Strings.mem-menu-copy-link;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.copy-link(r.id);
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Strings.mem-menu-delete;
                                            activated => {
                                                WikiState.nav-delete(r.id);
                                            }
                                        }
                                    }
                                    ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            // marking only — opening needs the
                                            // double-click / Enter / menu route.
                                            // A click that ended a drag is the
                                            // drop, not a mark.
                                            nav-scope.focus();
                                            if (!root.drag-was) {
                                                WikiState.nav-mark(r.id);
                                            }
                                            root.drag-was = false;
                                        }
                                        double-clicked => {
                                            WikiState.nav-open(r.id);
                                        }
                                        moved => {
                                            if (self.pressed && (root.drag-live || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                                                root.drag-live = true;
                                                root.drag-was = true;
                                                root.drag-id = r.id;
                                                root.drag-to = max(0, idx + Math.floor(self.mouse-y / 28px));
                                            }
                                        }
                                        pointer-event(ev) => {
                                            // the row's TouchArea sits ABOVE the
                                            // ContextMenuArea and eats the right
                                            // click - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !root.drag-live) {
                                                fmenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                            if (ev.kind == PointerEventKind.up && root.drag-live && root.drag-id == r.id) {
                                                WikiState.nav-drop(root.drag-id, root.drag-to);
                                                root.drag-live = false;
                                                root.drag-id = -1;
                                                root.drag-to = -1;
                                            }
                                            if (ev.kind == PointerEventKind.cancel) {
                                                root.drag-live = false;
                                                root.drag-id = -1;
                                                root.drag-to = -1;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: r.nested ? 24px : 8px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 16px;
                                            height: 100%;
                                            clip: true;
                                            Text {
                                                text: "📄";
                                                font-family: "Twemoji Mozilla";
                                                font-size: 11px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                opacity: r.status == 3 ? 0.5 : 1.0;
                                            }
                                        }
                                        if !r.renaming: Rectangle {
                                            horizontal-stretch: 1;
                                            nlabel := Text {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label;
                                                color: root.tone(r.status, r.marked ? Theme.text : Theme.dim);
                                                font-size: Theme.fs-nav;
                                                font-weight: r.marked ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                // a cut name shows in full
                                                // beside the row — but never
                                                // while a drag is live
                                                property <bool> tip-on: ta.has-hover && !root.drag-live && self.width < self.preferred-width;
                                                changed tip-on => {
                                                    if (self.tip-on) {
                                                        HintTip.label = r.label;
                                                        HintTip.ax = filerow.absolute-position.x + filerow.width + 8px;
                                                        HintTip.ay = filerow.absolute-position.y + (filerow.height - 23px) / 2;
                                                    } else if (HintTip.ax == filerow.absolute-position.x + filerow.width + 8px
                                                        && HintTip.ay == filerow.absolute-position.y + (filerow.height - 23px) / 2) {
                                                        HintTip.label = "";
                                                    }
                                                }
                                            }
                                            // a deleted file stays visible as a
                                            // pending change: struck in the bad
                                            // tone until the future patch seals
                                            if r.status == 3: Rectangle {
                                                x: 0;
                                                y: parent.height / 2;
                                                width: min(nlabel.preferred-width, parent.width);
                                                height: 1px;
                                                background: Theme.bad;
                                            }
                                        }
                                        // inline rename: Enter commits, Escape
                                        // cancels, focus is taken on creation
                                        if r.renaming: FocusScope {
                                            horizontal-stretch: 1;
                                            key-pressed(event) => {
                                                if (event.text == Key.Escape) {
                                                    WikiState.nav-rename-cancel();
                                                    return accept;
                                                }
                                                reject
                                            }
                                            rin := TextInput {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label;
                                                color: Theme.text;
                                                font-size: Theme.fs-nav;
                                                single-line: true;
                                                vertical-alignment: center;
                                                accepted => {
                                                    WikiState.nav-rename-commit(r.id, self.text);
                                                }
                                                init => {
                                                    self.focus();
                                                    self.select-all();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            // ---- the draggable splitter (Slint has no built-in one) ----
            Rectangle {
                width: 8px;
                // center line, accent-lit under hover/drag
                Rectangle {
                    x: 3px;
                    width: 2px;
                    height: 100%;
                    background: sta.pressed || sta.has-hover ? Theme.accent : transparent;
                }
                // the grip pill
                Rectangle {
                    x: 2px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 30px;
                    border-radius: Theme.win95 ? 0px : 2px;
                    background: sta.pressed || sta.has-hover ? Theme.accent : Theme.line;
                }
                sta := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    moved => {
                        // mouse-x and pressed-x are both in THIS element's
                        // current frame, so their difference is exactly how
                        // far the press point drifted from the pointer —
                        // adding it to the current width re-centers the
                        // grip under the pointer and converges in one step.
                        // (A width frozen at press time double-corrects:
                        // every event undershoots by the already-applied
                        // delta and the splitter oscillates.)
                        root.split = srow.clamp-nav(srow.nav-w + (self.mouse-x - self.pressed-x)) / max(srow.avail, 1px);
                    }
                }
            }

            // ---- content: tabs, toolbar, document ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                VerticalLayout {
                    // ---- the open documents as TABS, in OPEN order:
                    // clicking focuses, × closes, right-click offers the
                    // close-all/right/left sweeps. ----
                    Rectangle {
                        height: 32px;
                        background: Theme.panel-2;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;
                            alignment: start;
                            for t in WikiState.tabs: Rectangle {
                                border-radius: Theme.win95 ? 0px : 5px;
                                background: t.active ? Theme.panel
                                    : (tab-ta.has-hover ? Theme.raised : transparent);
                                border-width: t.active ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                tmenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-menu-close-all;
                                            activated => {
                                                WikiState.tab-close-all();
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-right;
                                            activated => {
                                                WikiState.tab-close-right(t.id);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-left;
                                            activated => {
                                                WikiState.tab-close-left(t.id);
                                            }
                                        }
                                    }
                                    tab-ta := TouchArea {
                                        clicked => {
                                            WikiState.tab-focus(t.id);
                                        }
                                        pointer-event(ev) => {
                                            // same right-click starvation as the
                                            // nav rows - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                tmenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                    }
                                    // padding-based row (no x-anchored child):
                                    // the layout's preferred width IS the tab
                                    // width, so the × always sits inside
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 3px;
                                        spacing: 4px;
                                        Text {
                                            text: t.label;
                                            color: root.tone(t.status, t.active ? Theme.text : Theme.dim);
                                            font-size: Theme.fs-cap;
                                            font-weight: t.active ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 16px;
                                            Text {
                                                text: "×";
                                                color: close-ta.has-hover ? Theme.bad : Theme.faint;
                                                font-size: Theme.fs-body;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            close-ta := TouchArea {
                                                clicked => {
                                                    WikiState.tab-close(t.id);
                                                }
                                                pointer-event(ev) => {
                                                    // the x is inside the menu
                                                    // area too - map into its
                                                    // coordinates via absolute
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        tmenu.show({
                                                            x: self.absolute-position.x - tmenu.absolute-position.x + self.mouse-x,
                                                            y: self.absolute-position.y - tmenu.absolute-position.y + self.mouse-y,
                                                        });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height - Theme.border-w;
                            width: parent.width;
                            height: Theme.border-w;
                            background: Theme.line;
                        }
                    }
                    ToolStrip {
                        // ⬅️/➡️ — walk the OPEN TABS in strip order,
                        // wrapping; deliberately leaves the navigator mark
                        // behind, which arms 🎯
                        ToolBtn {
                            glyph: "⬅️";
                            name: Strings.mem-tb-prev;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(-1);
                            }
                        }
                        ToolBtn {
                            glyph: "➡️";
                            name: Strings.mem-tb-next;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(1);
                            }
                        }
                        Rectangle {
                            width: 4px;
                        }
                        // the open file's path is the strip's breadcrumb;
                        // its tone mirrors the pending-change state
                        Text {
                            text: WikiState.doc-open ? WikiState.doc-path : "";
                            color: root.tone(WikiState.doc-status, Theme.faint);
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // ✏️/👁️ — pretty preview ⇄ raw .md source
                        ToolBtn {
                            glyph: WikiState.editing ? "👁️" : "✏️";
                            name: WikiState.editing ? Strings.mem-tb-preview : Strings.mem-tb-edit;
                            enabled: WikiState.doc-open;
                            clicked => {
                                WikiState.edit-toggle();
                            }
                        }
                        // the open file changed vs base: a plain hint plus
                        // its own revert — the numeric summary lives in the
                        // changeset panel, not here
                        if WikiState.doc-status == 2: Text {
                            text: Strings.mem-changed-hint;
                            color: Theme.warn;
                            font-size: Theme.fs-cap;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if WikiState.doc-status == 2: ToolBtn {
                            glyph: "↩️";
                            name: Strings.mem-tb-revert-doc;
                            enabled: true;
                            clicked => {
                                WikiState.revert-active();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // 🎯 — re-align the navigator with the active tab;
                        // armed only while they diverge
                        ToolBtn {
                            glyph: "🎯";
                            name: Strings.mem-tb-locate;
                            enabled: WikiState.can-reveal;
                            clicked => {
                                WikiState.reveal();
                            }
                        }
                        // 📋 — copy the document's path
                        ToolBtn {
                            glyph: "📋";
                            name: Strings.mem-tb-link;
                            enabled: WikiState.doc-open;
                            clicked => {
                                root.copy-path(WikiState.doc-path);
                            }
                        }
                        // ⚙️ — the app settings (font sizes live there)
                        ToolBtn {
                            glyph: "⚙️";
                            name: Strings.tip-settings;
                            enabled: true;
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                    if WikiState.doc-open && !WikiState.editing: ScrollBody {
                        pad: 16px;
                        gap: 8px;
                        // author · version · age — the note-footer idiom
                        Text {
                            text: WikiState.doc-meta;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        // a click on the document body opens the markdown
                        // editor — the preview reads, one click writes.
                        // The edit TouchArea sits UNDER the block view so
                        // a link's own TouchArea wins its click.
                        for b in WikiState.blocks: Rectangle {
                            height: bv.preferred-height;
                            TouchArea {
                                mouse-cursor: MouseCursor.text;
                                clicked => {
                                    WikiState.edit-toggle();
                                }
                            }
                            bv := BrainBlockView {
                                width: 100%;
                                b: b;
                            }
                        }
                        // cross-links — what makes the tree a wiki. One
                        // chip per line: paths are long and the chips
                        // neither wrap nor elide, so a row would clip at
                        // the content pane's minimum width.
                        if WikiState.links.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 6px;
                            Rectangle {
                                height: Theme.border-w;
                                background: Theme.line;
                            }
                            Text {
                                text: Strings.mem-linked;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            for l in WikiState.links: HorizontalLayout {
                                alignment: start;
                                TagChip {
                                    glyph: "🔗";
                                    label: l;
                                }
                            }
                        }
                    }
                    // raw-markdown mode: the same document as editable .md
                    // source. The buffer PERSISTS in the model across
                    // switches — every keystroke lands in the pending
                    // change set (that is what the colors track).
                    if WikiState.doc-open && WikiState.editing: Rectangle {
                        vertical-stretch: 1;
                        // Escape leaves the raw editor back to the preview:
                        // the inner TextInput rejects the key, so it
                        // bubbles up here (the inline-rename pattern)
                        FocusScope {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    WikiState.edit-toggle();
                                    return accept;
                                }
                                reject
                            }
                            AppArea {
                                width: 100%;
                                height: 100%;
                                font-size: Theme.fs-editor;
                                text <=> WikiState.raw;
                                changed text => {
                                    WikiState.edited(self.text);
                                }
                                init => {
                                    // click-to-edit lands typing-ready —
                                    // and focused, Escape reaches us
                                    self.focus-input();
                                }
                            }
                        }
                    }
                    // no open tab — the honest empty state
                    if !WikiState.doc-open: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: Strings.mem-empty;
                            color: Theme.faint;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

}

// ---------------------------------------------------------------------------
// Quests — the quest board
// ---------------------------------------------------------------------------

struct MockQuest {
    title: string,
    detail: string,
    reward: string, // "5 XMR" ("" = none)
    who: string, // open: put forward by; claimed/done: the claimant
    when: string,
    done: bool,
}

component QuestCard inherits Rectangle {
    in property <MockQuest> q;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    opacity: root.q.done ? 0.62 : 1.0;
    VerticalLayout {
        padding: 11px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.q.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.q.done: Rectangle {
                width: 18px;
                height: 20px;
                clip: true;
                Text {
                    text: "✅";
                    font-family: "Twemoji Mozilla";
                    font-size: 13px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.q.detail != "": Text {
            text: root.q.detail;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.q.reward != "": TagChip {
                glyph: "🪙";
                label: root.q.reward;
                y: (parent.height - self.height) / 2;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            GlyphCaption {
                glyph: "👤";
                label: "\{root.q.who} · \{root.q.when}";
            }
        }
    }
}

component QuestColumn inherits Rectangle {
    in property <string> title;
    in property <color> tone;
    in property <[MockQuest]> quests;
    horizontal-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            DotLabel {
                tone: root.tone;
                label: root.title;
                label-size: Theme.fs-cap;
                label-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "\{root.quests.length}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            cfl := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: clist.preferred-height;
                clist := VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for q in root.quests: QuestCard {
                        q: q;
                    }
                }
            }
            ScrollHint {
                x: parent.width - 5px;
                view-h: cfl.height;
                content-h: cfl.viewport-height;
                scroll-y: cfl.viewport-y;
            }
        }
    }
}

