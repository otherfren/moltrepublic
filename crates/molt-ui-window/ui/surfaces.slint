// SPDX-License-Identifier: GPL-3.0-or-later
//
// DESIGN MOCKS for the staged surfaces: Memory (shared brain) and Wallet
// (Monero multisig); the Vault and the Kanban panes are real (their rows
// come from the engine).
//
// These panes are badged UX drafts to iterate on look & feel — every dataset
// below is .slint-side sample data, never engine state. Actions either work
// as pure view-state mocks or render DISABLED (with the "not yet" tooltip,
// the same idiom as the greyed network options). The REAL threshold
// governance for these surfaces (pending proposals / applied log / propose)
// stays in app.slint and routes to the "proposals" (resp. wallet "status")
// sub-views.
//
// EXCEPTION: the Multisig-Wiki's state (doc tree, tabs, edit buffers, the
// pending-change set) lives in the Rust model `crates/molt-ui/src/wiki.rs`
// and reaches this pane through the `WikiState` global — still a badged
// mock (nothing is stored or sent), but the client state machine is real
// and unit-tested. This pane only renders rows and routes actions.
//
// Each pane is one component taking only the selected sub-view key, so the
// panes stay independently editable under scripts/dev-ui.sh hot-reload.

import { Theme, Strings, HintTip, Kanban, KbCard, KbLine, KbPick, KbType, KbCheck, WikiState, WikiNavRow, WikiTabRow, WikiBlock, WikiSpan, WikiProp, VaultDepositRow, VaultGrantRow, VaultUnsealedRow } from "theme.slint";
import { AppButton, AppField, AppArea, AppDropdown, ScrollHint, DotLabel, InsetWell } from "components.slint";

// ---------------------------------------------------------------------------
// shared chrome
// ---------------------------------------------------------------------------

// The small-but-unmissable badge every mock pane carries: warn-coloured like
// the founding ritual's SIMULATION badge, with an honesty tooltip.
export component MockBadge inherits Rectangle {
    background: Theme.warn;
    border-radius: Theme.win95 ? 0px : 4px;
    width: bt.preferred-width + 12px;
    height: bt.preferred-height + 5px;
    bt := Text {
        x: 6px;
        y: 2.5px;
        text: Strings.mock-badge;
        color: #1a1200;
        font-size: Theme.fs-cap;
        font-weight: 700;
    }
    // the hint goes through the window-topmost HintTip overlay (renders
    // above everything, never clipped, and — unlike a PopupWindow — grabs
    // no input, so the hover cannot strobe)
    ta := TouchArea {
        // the tip generation this element owns (HintTip.show hands it out):
        // only its owner may clear the bubble, so hovering straight onto
        // another control cannot wipe the hint that control just opened
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover) {
                self.tip-gen = HintTip.show(Strings.mock-tip,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
    }
}

// One pane/view header: Twemoji glyph + title + the mock badge, and an
// optional one-line hint underneath (the honest "what this will be" line).
component PaneHeader inherits VerticalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint: "";
    // a real pane (the vault) carries no mock badge
    in property <bool> mock: true;
    spacing: 5px;
    HorizontalLayout {
        spacing: 10px;
        // fixed clip box, like the nav rows: an oversized emoji glyph must
        // never bleed into the neighbours
        Rectangle {
            width: 22px;
            height: 24px;
            clip: true;
            Text {
                text: root.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 16px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-h2;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.mock: VerticalLayout {
            alignment: center;
            MockBadge { }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
    }
}

// The standard content panel every pane's body sits on (chat's message list
// idiom): a themed surface with a Flickable + scroll hint.
component PanePanel inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    out property <length> inner-width: fl.width;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height + 24px;
        body := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 7px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// A tiny accent-tinted chip: tags, rewards, badges, signer marks. The
// optional leading glyph renders in the Twemoji font (never plain-text
// emoji in labels); `muted` turns it into a quiet outline (e.g. a signer
// who has not signed yet).
component TagChip inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> muted: false;
    // the chip's colour family; the default keeps the classic accent chip
    // byte-identical (accent-soft IS accent.transparentize(0.84))
    in property <color> tone: Theme.accent;
    // Opt-in: tint only the GROUND and keep the theme's ink for the label.
    // A derived hue may land anywhere on the circle, and a dark-blue label
    // on a dark-blue ground is unreadable in the dark palette.
    in property <bool> tone-ground-only: false;
    background: root.muted ? transparent : root.tone.transparentize(0.84);
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.muted ? 1px : 0px;
    border-color: Theme.line;
    // the label's inset, on BOTH sides: the width adds exactly two of
    // them and the row is bounded to what is left. Unbounded, the row ran
    // the full chip width from an inset x, and a stretch layout handed the
    // surplus to its children - which pushed the label's glyphs flush onto
    // the chip's right edge.
    property <length> pad: 6px * Theme.ui-scale;
    width: tag-row.preferred-width + 2 * root.pad;
    height: 20px * Theme.ui-scale;
    // full-height row + centered texts: an offset row sized off the text's
    // preferred height sat the label visibly at the chip's bottom edge
    tag-row := HorizontalLayout {
        x: root.pad;
        y: 0;
        width: parent.width - 2 * root.pad;
        height: parent.height;
        spacing: 4px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px * Theme.ui-scale;
            height: 100%;
            vertical-alignment: center;
        }
        tag-label := Text {
            text: root.label;
            color: root.muted ? Theme.faint
                : (Theme.win95 || root.tone-ground-only ? Theme.text : root.tone);
            font-size: 11px * Theme.ui-scale;
            font-weight: root.muted ? 400 : 600;
            height: 100%;
            vertical-alignment: center;
        }
    }
}

// The signature-collection meter (the pending-proposal progress idiom):
// a thin track with an accent fill plus the "x/y signed" caption.
component SigMeter inherits HorizontalLayout {
    in property <int> signed;
    in property <int> need;
    // the counted word — "signed" by default; the vault's unseal meter
    // counts re-sealed key shares instead
    in property <string> word: Strings.vt-signed-word;
    spacing: 10px;
    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 3px;
        background: Theme.line;
        horizontal-stretch: 1;
        Rectangle {
            x: 0;
            height: parent.height;
            border-radius: parent.border-radius;
            width: parent.width * min(1.0, root.signed * 1.0 / max(root.need, 1));
            background: Theme.accent;
        }
    }
    Text {
        text: "\{root.signed}/\{root.need} \{root.word}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

// A quiet "glyph + text" caption row (authors, dates, rewards …).
component GlyphCaption inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <color> tone: Theme.faint;
    spacing: 5px;
    Rectangle {
        width: 16px;
        height: 16px;
        clip: true;
        y: (parent.height - self.height) / 2;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        color: root.tone;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// Memory — the Multisig-Wiki (the shared brain)
// ---------------------------------------------------------------------------



// The slim toolbar strip on top of the navigator / content panes.
component ToolStrip inherits Rectangle {
    height: 34px;
    background: Theme.panel-2;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 4px;
        padding-bottom: 5px;
        spacing: 3px;
        @children
    }
    // bottom hairline separating the strip from the pane body
    Rectangle {
        x: 0;
        y: parent.height - Theme.border-w;
        width: parent.width;
        height: Theme.border-w;
        background: Theme.line;
    }
}

// A compact square toolbar button: Twemoji glyph, named tooltip below.
// Disabled by default — the pane idiom: an action that would change shared
// state renders greyed with the honest "not yet" suffix; wired actions
// pass `enabled: true` and really work. The tooltip is a PopupWindow, not
// an in-tree bubble: popups render above and outside the panel's clipped
// bounds, so a hint near a panel edge is never cut off.
component ToolBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <bool> enabled: false;
    // a working view-state toggle (the Kanban board filters) marks its
    // "on" state with the soft accent field
    in property <bool> active: false;
    callback clicked();
    width: 30px * Theme.ui-scale;
    // the glyph is the whole label, so the button's NAME is what a screen
    // reader (and the headless suite) has to go by
    accessible-role: button;
    accessible-label: root.name;
    border-radius: Theme.win95 ? 0px : 5px;
    background: root.active ? Theme.accent-soft
        : (root.enabled && ta.has-hover ? Theme.raised : transparent);
    Rectangle {
        width: 18px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 13px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.4;
        }
    }
    // the TouchArea stays enabled either way — a disabled button still
    // names itself on hover; only clicked() gates. Every disabled ToolBtn
    // today is STATE-disabled (no tab, nothing to act on), so the hint is
    // the plain name — the dimmed glyph already says "inactive", and a
    // "not yet" suffix here would wrongly claim the feature is unbuilt.
    // The hint renders through the window-topmost HintTip overlay (never
    // clipped, grabs no input — a PopupWindow here strobed the hover).
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        // the tip generation this element owns (HintTip.show hands it out):
        // only its owner may clear the bubble, so hovering straight onto
        // another button cannot wipe the hint that button just opened
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover) {
                self.tip-gen = HintTip.show(root.name,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
        clicked => {
            HintTip.label = "";
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The scrolling body under a ToolStrip (PanePanel's padless cousin for
// panes that carry their own chrome): Flickable + scroll hint, with the
// caller's padding/spacing.
component ScrollBody inherits Rectangle {
    in property <length> pad: 8px;
    in property <length> gap: 2px;
    // scroll row N (fixed-stride rows) to the middle of the view, then
    // forget it - a request, not a state. The content height comes from
    // `row-count`, not the viewport: rows that arrived with the request
    // are not laid out yet when this runs, and clamping against the old
    // height scrolled nowhere.
    in-out property <int> scroll-to-row: -1;
    in property <length> row-stride: 28px;
    in property <int> row-count: 0;
    vertical-stretch: 1;
    clip: true;
    // the content height as the MODEL knows it: rows that arrived with a
    // scroll request are not laid out yet when the request is handled,
    // and a viewport clamped against the old height scrolls nowhere
    property <length> content-h: root.row-count > 0
        ? 2 * root.pad + root.row-count * root.row-stride - root.gap
        : body.preferred-height;
    changed scroll-to-row => {
        if (self.scroll-to-row >= 0) {
            fl.viewport-y = clamp(
                fl.height / 2 - root.pad - self.scroll-to-row * self.row-stride - self.row-stride / 2,
                min(0px, fl.height - root.content-h), 0px);
            self.scroll-to-row = -1;
        }
    }
    // the band the view shows right now, for a `for` that windows its
    // rows (rows outside it must not exist as element trees)
    out property <length> scroll-y: -fl.viewport-y;
    out property <length> view-h: fl.height;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: root.content-h;
        body := VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 5px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// One pseudo-rendered markdown block of the content pane, with its diff
// verdict: a colored bar marks added (good) / changed (warn) / removed
// (bad) blocks; a removed GHOST keeps the dropped base content visible,
// dimmed in the bad tone (Slint Text has no strikethrough).
// One clickable .md-link run in the preview: accent + underline, a soft
// pill while hovered; a click navigates to the linked document. With a
// `rel` it also carries a CLAIM, and hovering renders it: an inline
// annotation binds to the page, never to the sentence's subject, so the
// reader has to see what the graph will store.
component LinkRun inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <string> rel;
    in property <length> fsize: Theme.fs-editor;
    width: lt.preferred-width + 4px;
    height: lt.preferred-height;
    border-radius: 3px;
    background: lta.has-hover ? Theme.accent-soft : transparent;
    lt := Text {
        x: 2px;
        text: root.label;
        color: Theme.accent;
        font-size: root.fsize;
    }
    // Text has no underline — the link affordance is drawn
    Rectangle {
        x: 2px;
        y: parent.height - 1px;
        width: parent.width - 4px;
        height: 1px;
        background: Theme.accent;
    }
    lta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            WikiState.open-link(root.target);
        }
        // the overlay is shared, so the writer marks its own bubble and
        // only that generation may clear it (an anchor comparison breaks
        // the moment the run moves under the pointer)
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover && root.rel != "") {
                self.tip-gen = HintTip.show(
                    WikiState.doc-title + " " + root.rel + " " + root.label,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
    }
}

// ---- file references (images + file links) --------------------------------
// wiki_files_and_images.md §3.4. `file-state`: 0 none · 1 unknown ·
// 2 ambiguous · 3 remote · 4 fetching · 5 decoding · 6 ready · 7 failed ·
// 8 temporary. A resolved reference reads normally; an unresolvable one
// says the ONE word in the bad tone, a temporary one in the warn tone.

// The tone every file reference paints in.
global FileTone {
    public pure function ink(state: int) -> color {
        return state == 1 || state == 2 || state == 7 ? Theme.bad
            : state == 8 ? Theme.warn
            : Theme.accent;
    }
}

// One file LINK run: the clip, the name, and its size in the dim tone.
// A click jumps to Shared Files with the table filtered to this file.
component FileRun inherits Rectangle {
    in property <string> label;
    in property <string> target; // the `upload:` destination
    in property <int> state;
    in property <string> size;
    in property <length> fsize: Theme.fs-editor;
    width: fl.preferred-width + 6px;
    height: fl.preferred-height;
    border-radius: 3px;
    background: fa.has-hover ? Theme.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    fl := HorizontalLayout {
        x: 3px;
        spacing: 4px;
        Text {
            text: "📎";
            font-family: "Twemoji Mozilla";
            font-size: root.fsize - 1px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: FileTone.ink(root.state);
            font-size: root.fsize;
        }
        if root.size != "": Text {
            text: "(" + root.size + ")";
            color: Theme.dim;
            font-size: root.fsize - 1px;
            vertical-alignment: center;
        }
    }
    fa := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            WikiState.jump-upload(root.target);
        }
    }
}

// One file/image reference that is NOT a picture on screen: the kind
// glyph, `name · size · von <member>`, the state word, and at most ONE
// verb. A card whose name is still empty is an answer in flight - it
// shows the reference and no verb.
component FileCard inherits Rectangle {
    in property <WikiBlock> b;
    in property <bool> ghost;
    property <string> ref-hex: root.b.spans.length > 0 ? root.b.spans[0].link : "";
    height: fc.preferred-height + 16px;
    border-radius: Theme.win95 ? 0px : 6px;
    border-width: Theme.border-w;
    border-color: root.b.file-state == 1 || root.b.file-state == 2 || root.b.file-state == 7
        ? Theme.bad
        : (root.b.file-state == 8 ? Theme.warn : Theme.line);
    background: Theme.bg;
    fc := HorizontalLayout {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        spacing: 8px;
        Text {
            text: root.b.file-state == 6 ? "📎" : "🖼️";
            font-family: "Twemoji Mozilla";
            font-size: Theme.fs-editor;
            vertical-alignment: top;
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.b.file-name == ""
                    ? root.ref-hex
                    : root.b.file-name + " · " + root.b.file-size + " · "
                        + Strings.mem-file-by + " " + root.b.file-member;
                color: FileTone.ink(root.b.file-state);
                font-size: Theme.fs-editor - 1px;
                overflow: elide;
            }
            if root.b.text != "": Text {
                text: root.b.text;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
            }
            if root.b.file-avail != "": Text {
                text: root.b.file-avail;
                color: FileTone.ink(root.b.file-state);
                font-size: Theme.fs-cap;
            }
        }
        // a ghost is history, not navigation: no verb, nothing fetched
        if !root.ghost: VerticalLayout {
            alignment: center;
            // remote and resolved: the ONE verb, gated by availability
            if root.b.file-state == 3 && root.b.file-name != "": AppButton {
                height: 28px * Theme.ui-scale;
                pad: 10px;
                label: Strings.mem-file-fetch;
                enabled: root.b.file-can-fetch;
                // why it is dead, only where it IS dead
                tooltip: root.b.file-can-fetch ? "" : root.b.file-avail;
                tooltip-left: true;
                clicked => {
                    WikiState.file-fetch(root.ref-hex);
                }
            }
            if root.b.file-state == 7: AppButton {
                height: 28px * Theme.ui-scale;
                pad: 10px;
                label: Strings.mem-file-retry;
                clicked => {
                    WikiState.file-retry(root.ref-hex);
                }
            }
            // here, or not persistent yet: the one place to look at it
            if root.b.file-state == 6 || root.b.file-state == 8: AppButton {
                height: 28px * Theme.ui-scale;
                pad: 10px;
                label: Strings.mem-file-show;
                clicked => {
                    WikiState.jump-upload(root.ref-hex);
                }
            }
        }
    }
}

// One offered header key. The republic's ontology has no schema and no
// dialog, so a header-less document is where a member meets it: a click
// writes the syntax, the value stays theirs.
component PropChip inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: pct.preferred-width + 12px;
    height: pct.preferred-height + 6px;
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: Theme.border-w;
    border-color: pca.has-hover ? Theme.accent : Theme.line;
    background: pca.has-hover ? Theme.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    pct := Text {
        x: 6px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: pca.has-hover ? Theme.accent : Theme.faint;
        font-size: Theme.fs-cap;
    }
    pca := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover) {
                self.tip-gen = HintTip.show(Strings.mem-prop-hint,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
    }
}

// One header property as a chip: the key dim, the value in the reading
// colour and clickable when it points at a document. The quiet own ground
// tells a RELATION apart from the hue-coloured tag pills - what a page
// relates to is a fact, not a topic. A qualified relation stays ONE chip
// (`to: Acme · since: 2019`): it is one claim, and a chip per qualifier
// would repeat the predicate until it read as several.
component RelChip inherits Rectangle {
    in property <WikiProp> p;
    // a value past this elides - one long note must not set the width of
    // every other chip
    in property <length> cap: 320px * Theme.ui-scale;
    property <length> pad: 8px * Theme.ui-scale;
    width: min(root.cap, rc-row.preferred-width + 2 * root.pad);
    height: 24px * Theme.ui-scale;
    background: Theme.raised;
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    rc-row := HorizontalLayout {
        x: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height;
        spacing: 6px;
        // the same 3px rail a changed prose block carries: the header
        // renders HERE, so a header-only edit has to colour HERE
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: root.p.status == 1 ? Theme.good
                : root.p.status == 2 ? Theme.warn
                : root.p.status == 3 ? Theme.bad
                : transparent;
        }
        rc-key := Text {
            text: root.p.key;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 600;
            vertical-alignment: center;
        }
        // a LinkRun carries a fixed height, and a row parks a fixed-height
        // child at its TOP edge while it stretches the texts beside it -
        // only a centring wrapper puts the two on one line
        if root.p.link != "" && root.p.status != 3: VerticalLayout {
            alignment: center;
            rc-link := LinkRun {
                label: root.p.value;
                target: root.p.link;
                fsize: Theme.fs-cap;
            }
        }
        // a removed value is history, not navigation
        if root.p.link == "" || root.p.status == 3: rc-val := Text {
            text: root.p.value;
            color: root.p.status == 3
                ? Theme.bad.mix(Theme.dim, 0.6)
                : Theme.text;
            font-size: Theme.fs-cap;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A chip's inner metrics for the two hidden measures below - one
// component, so a change to the chip cannot silently un-measure it.
component RelMeasure inherits HorizontalLayout {
    in property <WikiProp> p;
    spacing: 6px;
    Rectangle {
        width: 3px;
    }
    Text {
        text: root.p.key;
        font-size: Theme.fs-cap;
        font-weight: 600;
    }
    Text {
        text: root.p.value;
        font-size: Theme.fs-cap;
    }
    // a link-valued chip draws a LinkRun, which is 4px wider than its
    // text - measured for every chip, so the cell never clips one
    Rectangle {
        width: 4px;
    }
}

// The front matter's relations, side by side and WRAPPING. Slint has no
// flow layout and a repeater cannot read its siblings' widths, so this is
// the measured pair the tree already uses: while the whole set fits on one
// line the chips render at their NATURAL widths (SpanFlow's idiom), and
// past that they fall into a grid whose cell is the WIDEST chip (a
// VerticalLayout's preferred width is the maximum over its rows), which
// wraps by index. `visible: false` stops the painting, not the measuring.
component RelFlow inherits Rectangle {
    in property <[WikiProp]> props;
    property <length> gap: 6px;
    property <length> cap: 320px * Theme.ui-scale;
    property <length> cell-h: 24px * Theme.ui-scale;
    property <length> pad: 8px * Theme.ui-scale;
    property <length> cell-w: min(root.cap, mcol.preferred-width + 2 * root.pad);
    property <bool> fits:
        mrow.preferred-width + 2 * root.pad * root.props.length <= root.width - 8px;
    property <int> cols: max(1, Math.floor((root.width + root.gap) / (root.cell-w + root.gap)));
    property <int> rows: Math.ceil(root.props.length / root.cols);
    height: root.fits ? root.cell-h
        : root.rows * root.cell-h + max(0, root.rows - 1) * root.gap;
    mcol := VerticalLayout {
        visible: false;
        for p in root.props: RelMeasure {
            p: p;
        }
    }
    mrow := HorizontalLayout {
        visible: false;
        spacing: root.gap;
        for p in root.props: RelMeasure {
            p: p;
        }
    }
    if root.fits: HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: root.gap;
        alignment: start;
        for p in root.props: RelChip {
            p: p;
            cap: root.cap;
        }
    }
    if !root.fits: Rectangle {
        width: 100%;
        height: 100%;
        for p[i] in root.props: RelChip {
            x: Math.mod(i, root.cols) * (root.cell-w + root.gap);
            y: Math.floor(i / root.cols) * (root.cell-h + root.gap);
            width: root.cell-w;
            height: root.cell-h;
            p: p;
            cap: root.cap;
        }
    }
}

// The document's tags, side by side and WRAPPING. RelFlow's measured
// idiom, but the pill is its OWN measure: a TagChip's width is derived
// from its content, so a hidden copy can never drift from the real one.
// The two branches carry different ids because one component may not
// name the same element twice.
component TagFlow inherits Rectangle {
    in property <[WikiProp]> pills;
    property <length> gap: 6px;
    property <length> cell-h: 20px * Theme.ui-scale;
    property <length> cell-w: mcol.preferred-width;
    property <bool> fits: mrow.preferred-width <= root.width;
    property <int> cols: max(1, Math.floor((root.width + root.gap) / (root.cell-w + root.gap)));
    property <int> rows: Math.ceil(root.pills.length / root.cols);
    height: root.fits ? root.cell-h
        : root.rows * root.cell-h + max(0, root.rows - 1) * root.gap;
    mcol := VerticalLayout {
        visible: false;
        // `muted` picks the label's weight, and the weight is a width
        for p in root.pills: TagChip {
            label: p.value;
            glyph: "🏷️";
            muted: p.status == 3;
        }
    }
    mrow := HorizontalLayout {
        visible: false;
        spacing: root.gap;
        for p in root.pills: TagChip {
            label: p.value;
            glyph: "🏷️";
            muted: p.status == 3;
        }
    }
    if root.fits: HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: root.gap;
        alignment: start;
        for p in root.pills: tag-pill := TagChip {
            label: p.value;
            glyph: "🏷️";
            muted: p.status == 3;
            tone: Colors.hsv(p.hue, 0.70, 0.62);
            tone-ground-only: true;
        }
    }
    if !root.fits: Rectangle {
        width: 100%;
        height: 100%;
        for p[i] in root.pills: tag-cell := TagChip {
            x: Math.mod(i, root.cols) * (root.cell-w + root.gap);
            y: Math.floor(i / root.cols) * (root.cell-h + root.gap);
            width: root.cell-w;
            height: root.cell-h;
            label: p.value;
            glyph: "🏷️";
            muted: p.status == 3;
            tone: Colors.hsv(p.hue, 0.70, 0.62);
            tone-ground-only: true;
        }
    }
}

// A block's inline runs with clickable .md links. While the whole line
// fits unwrapped it renders as a true inline row; a longer link-bearing
// block falls back to stacked runs (Slint has no wrapping rich text) —
// plain runs wrap there and each link sits on its own line.
component SpanFlow inherits Rectangle {
    in property <[WikiSpan]> spans;
    in property <string> flat; // the flattened text — the fits-measure
    in property <color> ink;
    in property <length> fsize: Theme.fs-editor;
    property <bool> fits: m.preferred-width <= root.width - 8px;
    height: root.fits ? one.preferred-height : many.preferred-height;
    // every child here carries an x/y: a child without one hands its
    // size constraints to the flow (Slint's rule, layout or not), and the
    // unwrapped measure alone made the flow as wide as the whole line -
    // the stacked runs then wrapped at a width the pane never had
    m := Text {
        x: 0px;
        y: 0px;
        text: root.flat;
        font-size: root.fsize;
        visible: false;
    }
    one := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        visible: root.fits;
        alignment: start;
        spacing: 0;
        for sp in root.spans: HorizontalLayout {
            if sp.link == "": Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
            }
            if sp.link != "" && sp.file-state == 0: LinkRun {
                label: sp.text;
                target: sp.link;
                rel: sp.rel;
                fsize: root.fsize;
            }
            if sp.file-state != 0: FileRun {
                label: sp.text;
                target: sp.link;
                state: sp.file-state;
                size: sp.file-size;
                fsize: root.fsize;
            }
        }
    }
    many := VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        visible: !root.fits;
        spacing: 0;
        for sp[i] in root.spans: row := VerticalLayout {
            // a plain run right after a link rides in that link's row -
            // otherwise the ", " between two links stands alone on a line
            property <bool> tail: sp.link == "" && i > 0 && root.spans[i - 1].link != "";
            property <bool> has-tail: sp.link != "" && i + 1 < root.spans.length
                && root.spans[i + 1].link == "";
            padding-top: i > 0 && !row.tail ? 2px : 0px;
            // a plain run fills the width and wraps; a link keeps its
            // natural width so the pill hugs the text
            if sp.link == "" && !row.tail: Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
                wrap: word-wrap;
            }
            if sp.link != "": HorizontalLayout {
                alignment: row.has-tail ? stretch : start;
                if sp.file-state == 0: LinkRun {
                    label: sp.text;
                    target: sp.link;
                    rel: sp.rel;
                    fsize: root.fsize;
                }
                if sp.file-state != 0: FileRun {
                    label: sp.text;
                    target: sp.link;
                    state: sp.file-state;
                    size: sp.file-size;
                    fsize: root.fsize;
                }
                if row.has-tail: Text {
                    text: root.spans[i + 1].text;
                    color: root.ink;
                    font-size: root.fsize;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
    }
}

component BrainBlockView inherits HorizontalLayout {
    in property <WikiBlock> b;
    // an h2 gets extra air above — the one spacing exception a doc needs
    padding-top: root.b.kind == 1 ? 6px : 0px;
    spacing: 8px;
    property <bool> ghost: root.b.status == 3;
    property <color> ink: root.ghost ? Theme.bad.mix(Theme.dim, 0.6) : Theme.text;
    // link-bearing paragraphs/bullets render their spans (clickable);
    // ghosts stay flat text — a removed block is history, not navigation
    property <bool> linked: !root.ghost
        && (root.b.spans.length > 1
            || (root.b.spans.length == 1 && root.b.spans[0].link != ""));
    // a picture only where a DECODED one is here and the block still
    // lives: a PDF or an SVG written as `![…]` reaches READY without one
    property <bool> shows-image: root.b.kind == 5 && root.b.file-state == 6
        && !root.ghost && root.b.image.width > 0;
    property <string> file-ref: root.b.spans.length > 0 ? root.b.spans[0].link : "";
    Rectangle {
        width: 3px;
        border-radius: 1.5px;
        background: root.b.status == 1 ? Theme.good
            : root.b.status == 2 ? Theme.warn
            : root.b.status == 3 ? Theme.bad
            : transparent;
    }
    VerticalLayout {
        if root.b.kind == 0: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor + 4px;
            font-weight: 800;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 1: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-weight: 700;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && !root.linked: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && root.linked: flow := SpanFlow {
            spans: root.b.spans;
            flat: root.b.text;
            ink: root.ink;
        }
        if root.b.kind == 3: HorizontalLayout {
            spacing: 7px;
            Text {
                text: "•";
                color: root.ghost ? Theme.bad : Theme.accent;
                font-size: Theme.fs-editor;
                vertical-alignment: top;
            }
            if !root.linked: Text {
                text: root.b.text;
                color: root.ink;
                font-size: Theme.fs-editor;
                font-italic: root.ghost;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.linked: SpanFlow {
                spans: root.b.spans;
                flat: root.b.text;
                ink: root.ink;
                horizontal-stretch: 1;
            }
        }
        // an `upload:` picture: the card until the bytes are here, then
        // the picture itself (a click opens it large - Q3)
        if root.b.kind == 5 && !root.shows-image: FileCard {
            b: root.b;
            ghost: root.ghost;
        }
        if root.shows-image: VerticalLayout {
            spacing: 3px;
            Rectangle {
                height: min(root.b.image.height * 1px * (parent.width / max(root.b.image.width * 1px, 1px)),
                    520px);
                pic := Image {
                    source: root.b.image;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                pica := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.right) {
                            picmenu.show({ x: self.mouse-x, y: self.mouse-y });
                        }
                    }
                    clicked => {
                        WikiState.file-view-image = root.b.image;
                        WikiState.file-view-caption = root.b.file-name + " · "
                            + root.b.file-size + " · " + Strings.mem-file-by + " "
                            + root.b.file-member;
                        WikiState.file-view-ref = root.file-ref;
                        WikiState.file-view-open = true;
                    }
                    property <int> tip-gen;
                    changed has-hover => {
                        if (self.has-hover) {
                            self.tip-gen = HintTip.show(root.b.file-name + " · "
                                + root.b.file-size + " · " + Strings.mem-file-by
                                + " " + root.b.file-member,
                                root.absolute-position.x,
                                root.absolute-position.y + root.height + 6px);
                        } else {
                            HintTip.hide(self.tip-gen);
                        }
                    }
                }
                // the picture's own TouchArea eats the right click, so
                // the menu claims no area and is opened at the pointer
                picmenu := ContextMenuArea {
                    width: 0px;
                    height: 0px;
                    enabled: false;
                    Menu {
                        MenuItem {
                            title: Strings.mem-file-show;
                            activated => {
                                WikiState.jump-upload(root.file-ref);
                            }
                        }
                    }
                }
            }
            if root.b.text != "": Text {
                text: root.b.text;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
            }
        }
        if root.b.kind == 4: Rectangle {
            background: Theme.bg;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            height: ct.preferred-height + 16px;
            ct := Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: root.b.text;
                color: root.ghost ? root.ink : Theme.dim;
                font-size: Theme.fs-editor - 2px;
                font-italic: root.ghost;
                wrap: word-wrap;
            }
        }
        // a pipe table: one framed grid - the header row on Theme.bg, a
        // rule between rows and columns, each cell wrapping in its column
        if root.b.kind == 6: Rectangle {
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            clip: true;
            height: grid.preferred-height;
            grid := VerticalLayout {
                for r in root.b.rows: VerticalLayout {
                    if !r.head: Rectangle {
                        height: Theme.border-w;
                        background: Theme.line;
                    }
                    Rectangle {
                        background: r.head ? Theme.bg : transparent;
                        height: cells.preferred-height;
                        cells := HorizontalLayout {
                            // the column's share is a STRETCH factor over
                            // zero constraints: a width derived from the
                            // layout's own width would be a binding loop
                            for c[i] in r.cells: Rectangle {
                                min-width: 0px;
                                preferred-width: 0px;
                                horizontal-stretch: c.frac;
                                height: body.preferred-height;
                                property <bool> linked: !root.ghost
                                    && (c.spans.length > 1
                                        || (c.spans.length == 1 && c.spans[0].link != ""));
                                if i > 0: Rectangle {
                                    x: 0px;
                                    width: Theme.border-w;
                                    height: parent.height;
                                    background: Theme.line;
                                }
                                // explicit geometry keeps the text's own
                                // width out of the cell's constraints
                                body := VerticalLayout {
                                    x: 0px;
                                    width: parent.width;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    if !linked: Text {
                                        text: c.text;
                                        color: root.ink;
                                        font-size: Theme.fs-editor - 1px;
                                        font-weight: r.head ? 700 : 400;
                                        font-italic: root.ghost;
                                        wrap: word-wrap;
                                        horizontal-alignment: c.align == 2 ? center
                                            : c.align == 3 ? right : left;
                                    }
                                    if linked: SpanFlow {
                                        spans: c.spans;
                                        flat: c.text;
                                        ink: root.ink;
                                        fsize: Theme.fs-editor - 1px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MemoryPane inherits VerticalLayout {
    in property <string> view;
    // the 📋 button's path travels up to the app root — the real clipboard
    // write and the toast live there, the pane stays a pure view
    callback copy-path(string);
    // the ⚙️ gear routes to the app-level settings screen
    callback open-settings();
    // "discard all" asks first — the modal lives at the app root (a
    // layout child here could not overlay the pane)
    callback confirm-revert();
    // the whole local changeset as a patch, for the details modal
    callback show-changes(string);
    // the action stack, for the changes modal (both live at the app root)
    callback show-stack();
    // 💾 raises the export dialog, which lives at the app root too
    callback wiki-export();
    spacing: 8px;

    // Everything the wiki KNOWS lives in the Rust model behind WikiState
    // (tree, tabs, buffers, pending changes). What stays here is view
    // state that belongs to the pane: the splitter fraction and the
    // in-flight drag gesture.
    property <float> split: 0.32;
    // drag-move: a file row arms it once the press moves past a small
    // threshold; the drop target is a ROW INDEX computed from pointer
    // geometry (uniform 26px rows + 2px gap = 28px pitch), and the
    // folder-vs-file-vs-past-the-end semantics resolve in the model.
    // (Slint 1.17's native DragArea needs a host-built data-transfer
    // payload, which only exists behind private_unstable_api — hence
    // this small pane-local gesture instead.)
    property <int> drag-id: -1;
    // a dragged FOLDER goes by name (folders have no DocId); "" = none
    property <string> drag-folder: "";
    property <int> drag-to: -1;
    property <bool> drag-live: false;
    // swallows the click that ends a drag (clicked fires after the
    // pointer-up that commits the drop)
    property <bool> drag-was: false;

    // WHICH page the preview is rendering ("" = none, the raw editor
    // included). A link run unmounted while hovered never gets its
    // hover-out and can never clear its own bubble, so the switch drops
    // the hint here - the one place every path through it passes.
    property <string> shown-doc: WikiState.editing ? "" : WikiState.doc-path;
    changed shown-doc => {
        HintTip.label = "";
    }

    // status → tone, ONE mapping for nav rows, tabs and the breadcrumb:
    // 1 added (good) · 2 modified (warn) · 3 deleted (bad)
    pure function tone(status: int, idle: color) -> color {
        return status == 1 ? Theme.good
            : status == 2 ? Theme.warn
            : status == 3 ? Theme.bad
            : idle;
    }

    if root.view == "brain": VerticalLayout {
        spacing: 8px;

        // ---- the changeset panel: every local action, and what the
        // next vote would bundle. Visible only while changes exist. ----
        if WikiState.cs-rows.length > 0: cs-panel := Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            // ONE row, whatever the stack holds: the panel is measured
            // off its content, and the actions themselves live behind the
            // Changes / Patch details modals (a listed stack grew until it
            // ate the pane)
            height: cs-box.preferred-height;
            cs-box := VerticalLayout {
                padding: 9px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px * Theme.ui-scale;
                    spacing: 10px;
                    Text {
                        text: Strings.mem-cs-title;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    // the NET summary: only non-zero parts speak
                    if WikiState.cs-added > 0: Text {
                        text: "+\{WikiState.cs-added} \{Strings.mem-cs-new}";
                        color: Theme.good;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-deleted > 0: Text {
                        text: "-\{WikiState.cs-deleted} \{Strings.mem-cs-deleted}";
                        color: Theme.bad;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-moved > 0: Text {
                        text: "→\{WikiState.cs-moved} \{Strings.mem-cs-moved}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-lines > 0: Text {
                        text: "~\{WikiState.cs-lines} \{Strings.mem-cs-lines}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // the stack and the patch both read in a modal —
                    // the panel itself never grows past this row
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-changes;
                        emoji: "📋";
                        clicked => {
                            root.show-stack();
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-details;
                        emoji: "📄";
                        enabled: WikiState.cs-patch != "";
                        clicked => {
                            root.show-changes(WikiState.cs-patch);
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-undo;
                        emoji: "↩️";
                        clicked => {
                            WikiState.cs-undo();
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-revert;
                        emoji: "🗑️";
                        clicked => {
                            root.confirm-revert();
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-vote;
                        emoji: "🗳️";
                        primary: true;
                        // a queued vote is already on its way: it goes out
                        // by itself when the ratified bytes land
                        enabled: WikiState.base-pending == "" && !WikiState.cs-vote-queued;
                        clicked => {
                            WikiState.cs-vote();
                        }
                    }
                }
            }
        }
        // no PaneHeader here: the Multisig-Wiki title (with the mock
        // badge) sits in the app's top bar, left of the republic name —
        // the full pane height belongs to navigator + document.
        // The two-pane split: file navigator | draggable splitter |
        // content. The navigator width is a stored FRACTION of the row,
        // so a window resize keeps the proportion; both sides keep a
        // hard minimum.
        srow := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            property <length> avail: self.width - 8px;
            // ONE clamp for layout and drag: navigator ≥ 213px (the
            // SIX-button toolbar's floor — 6*30 + 5*3 + 10 = 205, plus the
            // 8px slack the five-button floor carried), content ≥ 300px
            // (below their sum the navigator floor wins — the window is far
            // below any usable width there anyway)
            pure function clamp-nav(w: length) -> length {
                return max(213px, min(self.avail - 300px, w));
            }
            property <length> nav-w: self.clamp-nav(root.split * self.avail);

            // ---- navigator: browse the wiki tree ----
            Rectangle {
                width: srow.nav-w;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                // a rename input lives in its ROW, and a windowed row
                // out of view has none - bring it in first
                property <int> renaming-row: WikiState.nav-renaming-row;
                changed renaming-row => {
                    if (self.renaming-row >= 0) {
                        WikiState.nav-scroll-to = self.renaming-row;
                    }
                }
                // ---- ONE menu per row KIND for the whole navigator,
                // built from the MARKED row (WikiState.marked-*) instead
                // of one ContextMenuArea per row. They claim no area and
                // never open by themselves - the row's right-click marks
                // itself and calls show() at the pointer.
                navfilemenu := ContextMenuArea {
                    width: 0px;
                    height: 0px;
                    enabled: false;
                    Menu {
                        MenuItem {
                            title: Strings.mem-menu-open;
                            enabled: WikiState.marked-status != 3;
                            activated => {
                                WikiState.nav-open(WikiState.marked-id);
                            }
                        }
                        MenuItem {
                            title: Strings.mem-menu-rename;
                            enabled: WikiState.marked-status != 3;
                            activated => {
                                WikiState.nav-rename-start(WikiState.marked-id);
                            }
                        }
                        // out of its folder - the drag can only target
                        // folders, so root needs an explicit verb
                        if WikiState.marked-depth > 0: MenuItem {
                            title: Strings.mem-menu-move-root;
                            enabled: WikiState.marked-status != 3;
                            activated => {
                                WikiState.nav-move-root(WikiState.marked-id);
                            }
                        }
                        // pending rename/edit (2) or pending deletion (3):
                        // back to the base state
                        MenuItem {
                            title: Strings.mem-menu-revert;
                            enabled: WikiState.marked-status == 2 || WikiState.marked-status == 3;
                            activated => {
                                WikiState.nav-revert(WikiState.marked-id);
                            }
                        }
                        // link markup to the clipboard, ready to paste
                        // into any open editor
                        MenuItem {
                            title: Strings.mem-menu-copy-link;
                            enabled: WikiState.marked-status != 3;
                            activated => {
                                WikiState.copy-link(WikiState.marked-id);
                            }
                        }
                        // …and the TYPED link: the document opens first,
                        // because the relation is written into ITS prose.
                        // No can-write-body gate here: that flag describes
                        // the OPEN document, and this row is not open yet -
                        // the lazy base arrives while the member types.
                        MenuItem {
                            title: Strings.mem-menu-relate;
                            enabled: WikiState.marked-status != 3;
                            activated => {
                                WikiState.nav-open(WikiState.marked-id);
                                WikiState.link-open("");
                                WikiState.link-modal-open = true;
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: Strings.mem-menu-delete;
                            activated => {
                                WikiState.nav-delete(WikiState.marked-id);
                            }
                        }
                    }
                }
                navfoldermenu := ContextMenuArea {
                    width: 0px;
                    height: 0px;
                    enabled: false;
                    Menu {
                        MenuItem {
                            title: Strings.mem-tb-new-file;
                            activated => {
                                WikiState.new-file-in(WikiState.marked-path);
                            }
                        }
                        MenuItem {
                            title: Strings.mem-tb-new-folder;
                            activated => {
                                WikiState.new-folder-in(WikiState.marked-path);
                            }
                        }
                        MenuItem {
                            title: Strings.mem-menu-rename;
                            activated => {
                                WikiState.nav-folder-rename-start(WikiState.marked-path);
                            }
                        }
                        if WikiState.marked-depth > 0: MenuItem {
                            title: Strings.mem-menu-move-root;
                            activated => {
                                WikiState.nav-folder-move-root(WikiState.marked-path);
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: Strings.mem-menu-delete;
                            activated => {
                                WikiState.nav-folder-delete(WikiState.marked-path);
                            }
                        }
                    }
                }
                // Enter opens / Del deletes the MARKED row as soon as the
                // navigator was clicked (the row click below hands this
                // scope the focus); anything else bubbles to the window
                // handler, which carries the same routes as a fallback
                nav-scope := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.Return && WikiState.has-marked) {
                            WikiState.open-marked();
                            return accept;
                        }
                        if (event.text == Key.Delete && WikiState.has-marked) {
                            WikiState.delete-marked();
                            return accept;
                        }
                        if (event.text == Key.F2 && WikiState.has-marked) {
                            WikiState.rename-marked();
                            return accept;
                        }
                        reject
                    }
                VerticalLayout {
                    ToolStrip {
                        ToolBtn {
                            glyph: "📁";
                            name: Strings.mem-tb-new-folder;
                            enabled: true;
                            clicked => {
                                WikiState.new-folder();
                            }
                        }
                        ToolBtn {
                            glyph: "📝";
                            name: Strings.mem-tb-new-file;
                            // a document written over a base this node does
                            // not hold would be a patch against nothing
                            enabled: WikiState.base-pending == "";
                            clicked => {
                                WikiState.new-file();
                            }
                        }
                        ToolBtn {
                            glyph: "🗑️";
                            name: Strings.mem-tb-delete;
                            // deletion acts on the navigator's MARKED row
                            // (the tab strip has its own × per tab)
                            enabled: WikiState.has-marked;
                            clicked => {
                                WikiState.delete-marked();
                            }
                        }
                        ToolBtn {
                            glyph: "💾";
                            name: Strings.mem-tb-export;
                            // an export writes the APPROVED tree, so an
                            // empty base has nothing to write
                            enabled: WikiState.has-base();
                            clicked => {
                                root.wiki-export();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        ToolBtn {
                            glyph: "🔽";
                            name: Strings.mem-tb-collapse;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(false);
                            }
                        }
                        ToolBtn {
                            glyph: "🔼";
                            name: Strings.mem-tb-open-all;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(true);
                            }
                        }
                    }
                    // the wiki's search: a query REPLACES the tree with its
                    // ranked hits, an empty field brings the tree back. The
                    // index is the engine's — the same one an agent reads.
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-bottom: 4px;
                        AppField {
                            placeholder: Strings.mem-search-ph;
                            text <=> WikiState.search-query;
                            edited => {
                                WikiState.search(self.text);
                            }
                        }
                    }
                    if WikiState.search-query != "": ScrollBody {
                        pad: 6px;
                        gap: 4px;
                        if WikiState.search-building: Text {
                            text: Strings.mem-search-building;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                        if WikiState.search-ran && WikiState.search-hits.length == 0: Text {
                            text: Strings.mem-search-none;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                        }
                        for h in WikiState.search-hits: Rectangle {
                            background: hta.has-hover ? Theme.zebra : transparent;
                            border-radius: Theme.win95 ? 0px : 5px;
                            height: hbox.preferred-height;
                            hbox := VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                Text {
                                    text: h.title == "" ? h.path : h.title;
                                    color: Theme.text;
                                    font-size: Theme.fs-cap;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: h.snippet;
                                    color: Theme.dim;
                                    font-size: Theme.fs-cap;
                                    wrap: word-wrap;
                                }
                            }
                            hta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    WikiState.open-link(h.path);
                                }
                            }
                        }
                    }
                    if WikiState.search-query == "": navbody := ScrollBody {
                        pad: 6px;
                        gap: 2px;
                        row-stride: 26px + self.gap;
                        row-count: WikiState.nav-rows.length;
                        scroll-to-row <=> WikiState.nav-scroll-to;
                        for r[idx] in WikiState.nav-rows: Rectangle {
                            height: 26px;
                            border-radius: Theme.win95 ? 0px : 5px;
                            // the drop-target rim while a drag hovers this row
                            // (drawn by the inner variant rects — children
                            // would paint over a border set out here)
                            property <bool> drop-target: root.drag-live && root.drag-to == idx;
                            // WINDOWED: only the rows the view shows (plus two
                            // rows of margin) exist as element trees. Eager rows
                            // cost 5.5 ms each to build, and a 134-row tree took
                            // 690 ms per frame (docs_archive/ui/wiki_pane_performance.md
                            // F3). The empty shell keeps its 26px slot, so the
                            // scroll geometry and every row index are unchanged.
                            property <bool> live:
                                idx * navbody.row-stride >= navbody.scroll-y - 2 * navbody.row-stride
                                && idx * navbody.row-stride <= navbody.scroll-y + navbody.view-h + 2 * navbody.row-stride;

                            // ---- a folder row: click folds/unfolds,
                            // right-click menu, drag to merge elsewhere ----
                            if r.is-folder && live: frow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: r.marked ? Theme.accent-soft : (fta.has-hover ? Theme.zebra : transparent);
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: r.marked ? Theme.accent : transparent;
                                }
                                HorizontalLayout {
                                    padding-left: 6px + r.depth * 16px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 18px;
                                        height: 100%;
                                        clip: true;
                                        Text {
                                            text: r.open ? "📂" : "📁";
                                            font-family: "Twemoji Mozilla";
                                            font-size: 12px;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !r.renaming: Rectangle {
                                        horizontal-stretch: 1;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: r.label;
                                            color: root.tone(r.status, Theme.dim);
                                            font-size: Theme.fs-nav;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            // a cut name shows in full beside the
                                            // row (window-topmost HintTip overlay)
                                            property <bool> tip-on: fta.has-hover && !root.drag-live && self.width < self.preferred-width;
                                            // the tip generation this element owns (HintTip.show hands
                                            // it out): only its owner may clear the bubble
                                            property <int> tip-gen;
                                            changed tip-on => {
                                                if (self.tip-on) {
                                                    self.tip-gen = HintTip.show(r.label,
                                                        frow.absolute-position.x + frow.width + 8px,
                                                        frow.absolute-position.y + (frow.height - 23px) / 2);
                                                } else {
                                                    HintTip.hide(self.tip-gen);
                                                }
                                            }
                                        }
                                    }
                                    // inline rename: Enter commits, Escape
                                    // cancels (a fresh folder starts here)
                                    if r.renaming: FocusScope {
                                        horizontal-stretch: 1;
                                        key-pressed(event) => {
                                            if (event.text == Key.Escape) {
                                                WikiState.nav-rename-cancel();
                                                return accept;
                                            }
                                            reject
                                        }
                                        TextInput {
                                            width: 100%;
                                            height: 100%;
                                            text: r.label;
                                            color: Theme.text;
                                            font-size: Theme.fs-nav;
                                            single-line: true;
                                            vertical-alignment: center;
                                            accepted => {
                                                WikiState.nav-folder-rename-commit(r.path, self.text);
                                            }
                                            init => {
                                                self.focus();
                                                self.select-all();
                                            }
                                        }
                                    }
                                }
                                fta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        // a click that ended a drag is the
                                        // drop, not a fold toggle
                                        nav-scope.focus();
                                        if (!root.drag-was) {
                                            WikiState.nav-mark-folder(r.path);
                                            WikiState.nav-toggle-folder(r.path);
                                        }
                                        root.drag-was = false;
                                    }
                                    moved => {
                                        if (self.pressed && (root.drag-live || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                                            root.drag-live = true;
                                            root.drag-was = true;
                                            root.drag-folder = r.path;
                                            root.drag-to = max(0, idx + Math.floor(self.mouse-y / 28px));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        // the right-click MARKS the row and
                                        // opens the pane's one menu at the
                                        // pointer - the menu is built from
                                        // the marked row, so mark first
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !root.drag-live) {
                                            WikiState.nav-mark-folder(r.path);
                                            navfoldermenu.show({
                                                x: self.absolute-position.x + self.mouse-x - navfoldermenu.absolute-position.x,
                                                y: self.absolute-position.y + self.mouse-y - navfoldermenu.absolute-position.y });
                                        }
                                        if (ev.kind == PointerEventKind.up && root.drag-live && root.drag-folder == r.path) {
                                            WikiState.nav-folder-drop(root.drag-folder, root.drag-to);
                                            root.drag-live = false;
                                            root.drag-folder = "";
                                            root.drag-to = -1;
                                        }
                                        if (ev.kind == PointerEventKind.cancel) {
                                            root.drag-live = false;
                                            root.drag-folder = "";
                                            root.drag-to = -1;
                                        }
                                    }
                                }
                            }

                            // ---- a file row: open on click (Enter / menu
                            // too), right-click marks and opens the menu,
                            // drag to move ----
                            if !r.is-folder && live: filerow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: r.marked ? Theme.accent-soft : (ta.has-hover ? Theme.zebra : transparent);
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: r.marked ? Theme.accent : transparent;
                                }
                                ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        // one click opens (and marks); a
                                        // click that ended a drag is the
                                        // drop, not an open
                                        nav-scope.focus();
                                        if (!root.drag-was) {
                                            WikiState.nav-open(r.id);
                                        }
                                        root.drag-was = false;
                                    }
                                    moved => {
                                        if (self.pressed && (root.drag-live || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                                            root.drag-live = true;
                                            root.drag-was = true;
                                            root.drag-id = r.id;
                                            root.drag-to = max(0, idx + Math.floor(self.mouse-y / 28px));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        // the right-click MARKS the row and
                                        // opens the pane's one menu at the
                                        // pointer - the menu is built from
                                        // the marked row, so mark first
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !root.drag-live) {
                                            WikiState.nav-mark(r.id);
                                            navfilemenu.show({
                                                x: self.absolute-position.x + self.mouse-x - navfilemenu.absolute-position.x,
                                                y: self.absolute-position.y + self.mouse-y - navfilemenu.absolute-position.y });
                                        }
                                        if (ev.kind == PointerEventKind.up && root.drag-live && root.drag-id == r.id) {
                                            WikiState.nav-drop(root.drag-id, root.drag-to);
                                            root.drag-live = false;
                                            root.drag-id = -1;
                                            root.drag-to = -1;
                                        }
                                        if (ev.kind == PointerEventKind.cancel) {
                                            root.drag-live = false;
                                            root.drag-id = -1;
                                            root.drag-to = -1;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px + r.depth * 16px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 16px;
                                        height: 100%;
                                        clip: true;
                                        Text {
                                            text: "📄";
                                            font-family: "Twemoji Mozilla";
                                            font-size: 11px;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            opacity: r.status == 3 ? 0.5 : 1.0;
                                        }
                                    }
                                    if !r.renaming: Rectangle {
                                        horizontal-stretch: 1;
                                        nlabel := Text {
                                            width: 100%;
                                            height: 100%;
                                            text: r.label;
                                            color: root.tone(r.status, r.marked ? Theme.text : Theme.dim);
                                            font-size: Theme.fs-nav;
                                            // the mark rides the accent bar, the
                                            // background and this colour ONLY: a
                                            // weight switch changes the text
                                            // metrics, which relayouts the pane
                                            // and repaints the whole window
                                            font-weight: 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            // a cut name shows in full
                                            // beside the row — but never
                                            // while a drag is live
                                            property <bool> tip-on: ta.has-hover && !root.drag-live && self.width < self.preferred-width;
                                            // the tip generation this element owns (HintTip.show hands
                                            // it out): only its owner may clear the bubble
                                            property <int> tip-gen;
                                            changed tip-on => {
                                                if (self.tip-on) {
                                                    self.tip-gen = HintTip.show(r.label,
                                                        filerow.absolute-position.x + filerow.width + 8px,
                                                        filerow.absolute-position.y + (filerow.height - 23px) / 2);
                                                } else {
                                                    HintTip.hide(self.tip-gen);
                                                }
                                            }
                                        }
                                        // a deleted file stays visible as a
                                        // pending change: struck in the bad
                                        // tone until the future patch seals
                                        if r.status == 3: strike := Rectangle {
                                            x: 0;
                                            y: parent.height / 2;
                                            width: min(nlabel.preferred-width, parent.width);
                                            height: 1px;
                                            background: Theme.bad;
                                        }
                                    }
                                    // inline rename: Enter commits, Escape
                                    // cancels, focus is taken on creation
                                    if r.renaming: FocusScope {
                                        horizontal-stretch: 1;
                                        key-pressed(event) => {
                                            if (event.text == Key.Escape) {
                                                WikiState.nav-rename-cancel();
                                                return accept;
                                            }
                                            reject
                                        }
                                        rin := TextInput {
                                            width: 100%;
                                            height: 100%;
                                            text: r.label;
                                            color: Theme.text;
                                            font-size: Theme.fs-nav;
                                            single-line: true;
                                            vertical-alignment: center;
                                            accepted => {
                                                WikiState.nav-rename-commit(r.id, self.text);
                                            }
                                            init => {
                                                self.focus();
                                                self.select-all();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            // ---- the draggable splitter (Slint has no built-in one) ----
            Rectangle {
                width: 8px;
                // center line, accent-lit under hover/drag
                Rectangle {
                    x: 3px;
                    width: 2px;
                    height: 100%;
                    background: sta.pressed || sta.has-hover ? Theme.accent : transparent;
                }
                // the grip pill
                Rectangle {
                    x: 2px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 30px;
                    border-radius: Theme.win95 ? 0px : 2px;
                    background: sta.pressed || sta.has-hover ? Theme.accent : Theme.line;
                }
                sta := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    moved => {
                        // mouse-x and pressed-x are both in THIS element's
                        // current frame, so their difference is exactly how
                        // far the press point drifted from the pointer —
                        // adding it to the current width re-centers the
                        // grip under the pointer and converges in one step.
                        // (A width frozen at press time double-corrects:
                        // every event undershoots by the already-applied
                        // delta and the splitter oscillates.)
                        root.split = srow.clamp-nav(srow.nav-w + (self.mouse-x - self.pressed-x)) / max(srow.avail, 1px);
                    }
                }
            }

            // ---- content: tabs, toolbar, document ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                VerticalLayout {
                    // ---- the open documents as TABS, in OPEN order:
                    // clicking focuses, × closes, right-click offers the
                    // close-all/right/left sweeps. ----
                    Rectangle {
                        height: 32px;
                        background: Theme.panel-2;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;
                            alignment: start;
                            for t in WikiState.tabs: Rectangle {
                                border-radius: Theme.win95 ? 0px : 5px;
                                background: t.active ? Theme.panel
                                    : (tab-ta.has-hover ? Theme.raised : transparent);
                                border-width: t.active ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                tmenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-menu-close-all;
                                            activated => {
                                                WikiState.tab-close-all();
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-right;
                                            activated => {
                                                WikiState.tab-close-right(t.id);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-left;
                                            activated => {
                                                WikiState.tab-close-left(t.id);
                                            }
                                        }
                                    }
                                    tab-ta := TouchArea {
                                        clicked => {
                                            WikiState.tab-focus(t.id);
                                        }
                                        pointer-event(ev) => {
                                            // same right-click starvation as the
                                            // nav rows - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                tmenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                    }
                                    // padding-based row (no x-anchored child):
                                    // the layout's preferred width IS the tab
                                    // width, so the × always sits inside
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 3px;
                                        spacing: 4px;
                                        Text {
                                            text: t.label;
                                            color: root.tone(t.status, t.active ? Theme.text : Theme.dim);
                                            font-size: Theme.fs-cap;
                                            font-weight: t.active ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 16px * Theme.ui-scale;
                                            Text {
                                                text: "×";
                                                color: close-ta.has-hover ? Theme.bad : Theme.faint;
                                                font-size: Theme.fs-body;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            close-ta := TouchArea {
                                                clicked => {
                                                    WikiState.tab-close(t.id);
                                                }
                                                pointer-event(ev) => {
                                                    // the x is inside the menu
                                                    // area too - map into its
                                                    // coordinates via absolute
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        tmenu.show({
                                                            x: self.absolute-position.x - tmenu.absolute-position.x + self.mouse-x,
                                                            y: self.absolute-position.y - tmenu.absolute-position.y + self.mouse-y,
                                                        });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height - Theme.border-w;
                            width: parent.width;
                            height: Theme.border-w;
                            background: Theme.line;
                        }
                    }
                    ToolStrip {
                        // ⬅️/➡️ — walk the OPEN TABS in strip order,
                        // wrapping; deliberately leaves the navigator mark
                        // behind, which arms 🎯
                        ToolBtn {
                            glyph: "⬅️";
                            name: Strings.mem-tb-prev;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(-1);
                            }
                        }
                        ToolBtn {
                            glyph: "➡️";
                            name: Strings.mem-tb-next;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(1);
                            }
                        }
                        Rectangle {
                            width: 4px;
                        }
                        // the open file's path is the strip's breadcrumb;
                        // its tone mirrors the pending-change state
                        Text {
                            text: WikiState.doc-open ? WikiState.doc-path : "";
                            color: root.tone(WikiState.doc-status, Theme.faint);
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // ✏️/👁️ — pretty preview ⇄ raw .md source
                        ToolBtn {
                            glyph: WikiState.editing ? "👁️" : "✏️";
                            name: WikiState.editing ? Strings.mem-tb-preview : Strings.mem-tb-edit;
                            enabled: WikiState.doc-open;
                            clicked => {
                                WikiState.edit-toggle();
                            }
                        }
                        // 🔗 — say what this document IS to another one.
                        // An agent has no real-world experience: the
                        // relation has to be written down, not inferred.
                        // Gated on the BODY: the default write is prose,
                        // which a header the parser rejects does not block.
                        ToolBtn {
                            glyph: "🔗";
                            name: Strings.mem-tb-relate;
                            enabled: WikiState.can-write-body;
                            clicked => {
                                WikiState.link-open("");
                                WikiState.link-modal-open = true;
                            }
                        }
                        // 📎 — point at a file the republic KEEPS. Same
                        // gate as the link: the reference is prose, and
                        // prose needs the document's bytes.
                        ToolBtn {
                            glyph: "📎";
                            name: "+ " + Strings.mem-tb-file;
                            enabled: WikiState.can-write-body;
                            clicked => {
                                WikiState.file-open();
                                WikiState.file-modal-open = true;
                            }
                        }
                        // the open file changed vs base: a plain hint plus
                        // its own revert — the numeric summary lives in the
                        // changeset panel, not here
                        if WikiState.doc-status == 2: Text {
                            text: Strings.mem-changed-hint;
                            color: Theme.warn;
                            font-size: Theme.fs-cap;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if WikiState.doc-status == 2: ToolBtn {
                            glyph: "↩️";
                            name: Strings.mem-tb-revert-doc;
                            enabled: true;
                            clicked => {
                                WikiState.revert-active();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // 🎯 — re-align the navigator with the active tab;
                        // armed only while they diverge
                        ToolBtn {
                            glyph: "🎯";
                            name: Strings.mem-tb-locate;
                            enabled: WikiState.can-reveal;
                            clicked => {
                                WikiState.reveal();
                            }
                        }
                        // 📋 — copy the document's path
                        ToolBtn {
                            glyph: "📋";
                            name: Strings.mem-tb-link;
                            enabled: WikiState.doc-open;
                            clicked => {
                                root.copy-path(WikiState.doc-path);
                            }
                        }
                        // ⚙️ — the app settings (font sizes live there)
                        ToolBtn {
                            glyph: "⚙️";
                            name: Strings.tip-settings;
                            enabled: true;
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                    if WikiState.doc-open && !WikiState.editing: doc-body := ScrollBody {
                        pad: 16px;
                        gap: Theme.pane-gap;
                        // the document's tags, one coloured pill each: the
                        // colour is the tag's own (hue from the lowercased
                        // string), so the same tag reads the same everywhere.
                        // The band opens the document - what a page IS comes
                        // before what it says.
                        if WikiState.tag-pills.length > 0: TagFlow {
                            pills: WikiState.tag-pills;
                        }
                        // the rest of the front matter as RELATION CHIPS:
                        // the viewer shows what the header means, the editor
                        // shows the header itself. A link-valued property is
                        // as clickable as a link in the prose.
                        if WikiState.props.length > 0: RelFlow {
                            props: WikiState.props;
                        }
                        // …and one grey rule under the band: what the
                        // document IS is not what it SAYS. It exists only
                        // when the band above it does.
                        if WikiState.tag-pills.length > 0
                            || WikiState.props.length > 0: head-rule := Rectangle {
                            height: Theme.border-w;
                            background: Theme.line;
                        }
                        // a headerless document's one offer: tags. The
                        // chip disappears the moment a header exists.
                        if WikiState.can-add-tags: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            PropChip {
                                label: "+ " + Strings.mem-tag-add;
                                clicked => {
                                    WikiState.tag-open();
                                    WikiState.tag-modal-open = true;
                                }
                            }
                        }
                        // a click on the document body opens the markdown
                        // editor — the preview reads, one click writes.
                        // The edit TouchArea sits UNDER the block view so
                        // a link's own TouchArea wins its click.
                        for b in WikiState.blocks: Rectangle {
                            height: bv.preferred-height;
                            TouchArea {
                                mouse-cursor: MouseCursor.text;
                                clicked => {
                                    WikiState.edit-toggle();
                                }
                            }
                            bv := BrainBlockView {
                                width: 100%;
                                b: b;
                            }
                        }
                        // author · version · age, where the note-footer
                        // idiom puts it. A ratified document carries none
                        // of the three, and an empty line at the TOP is
                        // what pushed the tag band off the edge.
                        if WikiState.doc-meta != "": Text {
                            text: WikiState.doc-meta;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        // cross-links — what makes the tree a wiki. The
                        // same clickable run as the backlinks below: a
                        // list you cannot follow is decoration. One per
                        // line, because paths are long and a run neither
                        // wraps nor elides.
                        if WikiState.links.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 6px;
                            Rectangle {
                                height: Theme.border-w;
                                background: Theme.line;
                            }
                            Text {
                                text: Strings.mem-linked;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            for l in WikiState.links: HorizontalLayout {
                                alignment: start;
                                LinkRun {
                                    label: l;
                                    target: l;
                                    fsize: Theme.fs-cap;
                                }
                            }
                        }
                        // …and who points HERE. The other half of a wiki:
                        // the engine's in-edges, header relations included.
                        if WikiState.backlinks.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 6px;
                            Rectangle {
                                height: Theme.border-w;
                                background: Theme.line;
                            }
                            Text {
                                text: Strings.mem-backlinks;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            for l in WikiState.backlinks: HorizontalLayout {
                                alignment: start;
                                LinkRun {
                                    label: l;
                                    target: l;
                                    fsize: Theme.fs-cap;
                                }
                            }
                        }
                    }
                    // raw-markdown mode: the same document as editable .md
                    // source. The buffer PERSISTS in the model across
                    // switches — every keystroke lands in the pending
                    // change set (that is what the colors track).
                    if WikiState.doc-open && WikiState.editing: Rectangle {
                        vertical-stretch: 1;
                        // Escape leaves the raw editor back to the preview:
                        // the inner TextInput rejects the key, so it
                        // bubbles up here (the inline-rename pattern)
                        FocusScope {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    WikiState.edit-toggle();
                                    return accept;
                                }
                                reject
                            }
                            AppArea {
                                width: 100%;
                                height: 100%;
                                font-size: Theme.fs-editor;
                                extra-label: WikiState.can-write-body
                                    ? Strings.mem-menu-relate : "";
                                extra-activated => {
                                    WikiState.link-open("");
                                    WikiState.link-modal-open = true;
                                }
                                // the caret rides along, so the modal knows
                                // where the member is writing
                                changed cursor-byte-offset => {
                                    WikiState.set-cursor(self.cursor-byte-offset);
                                }
                                text <=> WikiState.raw;
                                changed text => {
                                    WikiState.edited(self.text);
                                }
                                init => {
                                    // click-to-edit lands typing-ready —
                                    // and focused, Escape reaches us
                                    self.focus-input();
                                }
                            }
                        }
                    }
                    // no open tab — the honest empty state
                    if !WikiState.doc-open: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            // "nothing here" and "not here YET" are
                            // different claims (§4.9.6)
                            text: WikiState.base-pending != ""
                                ? WikiState.base-pending
                                : Strings.mem-empty;
                            color: Theme.faint;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

}

// ---------------------------------------------------------------------------
// Quests - the Kanban (kanban_workflows.md §8)
// ---------------------------------------------------------------------------
//
// Real: every row arrives pre-rendered through the `Kanban` global (molt-ui
// kanban.rs). A drop or a move STAGES an act in the local basket; only
// "Propose" turns the basket into one threshold vote.

// A fixed Twemoji clip box (the nav-row idiom): an oversized emoji glyph
// must never bleed into its neighbours.
component KGlyph inherits Rectangle {
    in property <string> glyph;
    width: 18px;
    height: 20px;
    clip: true;
    Text {
        text: root.glyph;
        font-family: "Twemoji Mozilla";
        font-size: 13px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The type chip (§2.4): the colour never stands alone, the label rides
// beside it.
component TypeChip inherits HorizontalLayout {
    in property <string> label;
    in property <int> slot;
    spacing: 4px;
    Rectangle {
        width: 10px * Theme.ui-scale;
        height: self.width;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 2px;
        background: Kanban.type-color(root.slot);
    }
    Text {
        text: root.label;
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

// A dashed outline: a staged move's shadow (Slint borders are solid).
component Dashes inherits Rectangle {
    property <int> across: max(1, floor(root.width / 9px));
    property <int> down: max(1, floor(root.height / 9px));
    for i in root.across: Rectangle {
        x: i * 9px;
        y: 0;
        width: 5px;
        height: 1px;
        background: Theme.dim;
    }
    for i in root.across: Rectangle {
        x: i * 9px;
        y: root.height - 1px;
        width: 5px;
        height: 1px;
        background: Theme.dim;
    }
    for i in root.down: Rectangle {
        x: 0;
        y: i * 9px;
        width: 1px;
        height: 5px;
        background: Theme.dim;
    }
    for i in root.down: Rectangle {
        x: root.width - 1px;
        y: i * 9px;
        width: 1px;
        height: 5px;
        background: Theme.dim;
    }
}

// A clickable "vote: → success (2/3)" badge (§8).
component VoteBadge inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: ta.has-hover ? Theme.moved.transparentize(0.7) : Theme.moved.transparentize(0.84);
    border-radius: Theme.win95 ? 0px : 4px;
    width: vt.preferred-width + 12px;
    height: 20px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    vt := Text {
        x: 6px;
        height: 100%;
        text: root.label;
        color: Theme.win95 ? Theme.text : Theme.moved;
        font-size: 11px * Theme.ui-scale;
        font-weight: 600;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

component KanbanCard inherits Rectangle {
    in property <KbCard> c;
    callback clicked();
    callback vote(int);
    // the pointer's window x while dragging / where it was let go
    callback drag(length);
    callback drop(length);
    property <bool> dragged: false;
    property <bool> suppress: false;
    accessible-role: button;
    accessible-label: root.c.title;
    background: root.c.shadow ? transparent : Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: root.c.shadow ? 0px : Theme.border-w;
    border-color: Theme.line;
    opacity: root.dragged ? 0.5 : (root.c.shadow ? 0.8 : 1.0);
    ta := TouchArea {
        mouse-cursor: root.c.shadow ? MouseCursor.default : MouseCursor.pointer;
        moved => {
            if (self.pressed && !root.c.shadow
                && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px)) {
                root.dragged = true;
                root.drag(root.absolute-position.x + self.mouse-x);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.suppress = false;
            }
            if (e.kind == PointerEventKind.up && root.dragged) {
                root.dragged = false;
                root.suppress = true;
                root.drop(root.absolute-position.x + self.mouse-x);
            }
        }
        clicked => {
            if (!root.suppress && !root.c.shadow) {
                root.clicked();
            }
            root.suppress = false;
        }
    }
    if root.c.shadow: Dashes {
        width: 100%;
        height: 100%;
    }
    if !root.c.shadow && root.c.type-slot >= 0: Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        background: Kanban.type-color(root.c.type-slot);
    }
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.c.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            Text {
                text: root.c.short;
                color: Theme.faint;
                font-size: Theme.fs-cap;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            TagChip {
                label: root.c.badge;
                tone: root.c.bad ? Theme.bad : Theme.accent;
                muted: root.c.shown == "open" || root.c.shown == "later";
            }
            if root.c.type-slot >= 0: TypeChip {
                label: root.c.type-label;
                slot: root.c.type-slot;
            }
            if root.c.size != "": TagChip {
                label: root.c.size;
                muted: true;
            }
        }
        if root.c.who != "": GlyphCaption {
            glyph: "👤";
            label: root.c.who;
        }
        if root.c.dates != "": GlyphCaption {
            glyph: "🗓️";
            label: root.c.dates;
            tone: root.c.bad ? Theme.bad : Theme.faint;
        }
        if root.c.flags != "": Text {
            text: root.c.flags;
            color: Theme.bad;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        if root.c.note != "": Text {
            text: root.c.note;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        if root.c.staged != "": Text {
            text: root.c.staged;
            color: Theme.accent;
            font-size: Theme.fs-cap;
            font-weight: 600;
        }
        if root.c.vote != "" && !root.c.shadow: HorizontalLayout {
            alignment: start;
            VoteBadge {
                label: root.c.vote;
                clicked => {
                    root.vote(root.c.vote-id);
                }
            }
        }
    }
}

// One board column: header + count over the scrolling card list.
component KanbanColumn inherits Rectangle {
    in property <string> title;
    in property <color> tone;
    in property <[KbCard]> cards;
    // a dragged card hovers this column
    in property <bool> hot: false;
    callback vote(int);
    callback drag(length);
    callback drop(string, length);
    horizontal-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: root.hot ? max(2px, Theme.border-w) : Theme.border-w;
    border-color: root.hot ? Theme.accent : Theme.line;
    clip: true;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            DotLabel {
                tone: root.tone;
                label: root.title;
                label-size: Theme.fs-cap;
                label-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "\{root.cards.length}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            cfl := Flickable {
                width: 100%;
                height: 100%;
                // a press-drag belongs to the card (the drop); the wheel scrolls
                interactive: false;
                viewport-width: self.width;
                viewport-height: clist.preferred-height;
                clist := VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for c in root.cards: KanbanCard {
                        c: c;
                        clicked => {
                            Kanban.pick(c.id);
                        }
                        vote(id) => {
                            root.vote(id);
                        }
                        drag(x) => {
                            root.drag(x);
                        }
                        drop(x) => {
                            root.drop(c.id, x);
                        }
                    }
                }
            }
            ScrollHint {
                x: parent.width - 5px;
                view-h: cfl.height;
                content-h: cfl.viewport-height;
                scroll-y: cfl.viewport-y;
            }
        }
    }
}

// A chip-styled toggle (filters, size, time mode, pickers, moves).
component KChipToggle inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.accent;
    in property <bool> active: false;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    background: root.active ? root.tone.transparentize(0.84) : (kta.has-hover ? Theme.raised : transparent);
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.active ? 0px : 1px;
    border-color: Theme.line;
    width: kt.preferred-width + 16px;
    height: 26px * Theme.ui-scale;
    kt := Text {
        x: 8px;
        height: 100%;
        text: root.label;
        color: root.active ? (Theme.win95 ? Theme.text : root.tone) : Theme.dim;
        font-size: 11px * Theme.ui-scale;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
    kta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A captioned form slot (fs-cap caption over the field).
component FormSlot inherits VerticalLayout {
    in property <string> cap;
    spacing: 4px;
    horizontal-stretch: 1;
    Text {
        text: root.cap;
        color: Theme.dim;
        font-size: Theme.fs-cap;
    }
    @children
}

// Wrapping chips: a fixed-width flow, rows of `per-row`.
component ChipRow inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;
    @children
}

// One list row: a related task, an action of "Mine", a declined changeset.
component KLineRow inherits Rectangle {
    in property <KbLine> line;
    in property <string> action-label;
    callback clicked();
    callback action();
    accessible-role: button;
    accessible-label: root.line.text;
    height: max(34px * Theme.ui-scale, lrow.preferred-height);
    border-radius: Theme.win95 ? 0px : 6px;
    background: lta.has-hover ? Theme.raised : Theme.panel-2;
    lta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
    lrow := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        if root.line.glyph != "": VerticalLayout {
            alignment: center;
            KGlyph {
                glyph: root.line.glyph;
            }
        }
        Text {
            text: root.line.text;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.line.sub;
            color: root.line.bad ? Theme.bad : Theme.faint;
            font-size: Theme.fs-cap;
            vertical-alignment: center;
        }
        if root.action-label != "": VerticalLayout {
            alignment: center;
            AppButton {
                label: root.action-label;
                height: 26px * Theme.ui-scale;
                pad: 8px;
                clicked => {
                    root.action();
                }
            }
        }
    }
}

// A section caption.
component KCap inherits Text {
    color: Theme.dim;
    font-size: Theme.fs-cap;
    font-weight: 700;
}

// An editable list, one line per item (§8 "+ add").
component KListEditor inherits VerticalLayout {
    in property <[string]> items;
    in property <int> which;
    spacing: 6px;
    for item[i] in root.items: HorizontalLayout {
        spacing: 6px;
        AppField {
            text: item;
            edited => {
                Kanban.f-list-set(root.which, i, self.text);
            }
        }
        AppButton {
            label: "✕";
            pad: 10px;
            clicked => {
                Kanban.f-list-remove(root.which, i);
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        AppButton {
            label: Strings.kb-add-item;
            clicked => {
                Kanban.f-list-add(root.which);
            }
        }
    }
}

// The view header plus the "New task" button every kanban view carries.
component KHead inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint;
    spacing: 10px;
    PaneHeader {
        glyph: root.glyph;
        title: root.title;
        hint: root.hint;
        mock: false;
        horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: start;
        AppButton {
            label: Strings.kb-new-task;
            emoji: "➕";
            clicked => {
                Kanban.form-new();
            }
        }
    }
}

// The New task form (§8): title, type, size, assignees, blocked-by, dates,
// time mode, description, acceptance and out-of-scope lists.
component KForm inherits VerticalLayout {
    spacing: 8px;
    PanePanel {
        HorizontalLayout {
            spacing: 8px;
            KGlyph {
                glyph: "➕";
            }
            Text {
                text: Strings.kb-new-task;
                color: Theme.text;
                font-size: Theme.fs-h2;
                font-weight: 700;
                horizontal-stretch: 1;
            }
        }
        FormSlot {
            cap: Strings.kb-fl-title;
            AppField {
                text <=> Kanban.f-title;
                hero: true;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            FormSlot {
                cap: Strings.kb-fl-type;
                AppField {
                    text <=> Kanban.f-type;
                }
            }
            FormSlot {
                cap: Strings.kb-fl-size;
                ChipRow {
                    for z in ["", "XS", "S", "M", "L", "XL", "XXL"]: KChipToggle {
                        label: z == "" ? "-" : z;
                        active: Kanban.f-size == z;
                        clicked => {
                            Kanban.f-size = z;
                        }
                    }
                }
            }
        }
        FormSlot {
            cap: Strings.kb-fl-assignees;
            ChipRow {
                for a in Kanban.f-assignees: KChipToggle {
                    label: a.label;
                    active: a.on;
                    clicked => {
                        Kanban.f-assignee-toggle(a.key);
                    }
                }
            }
        }
        FormSlot {
            cap: Strings.kb-fl-blocked;
            AppField {
                text <=> Kanban.f-blocked-filter;
                placeholder: Strings.kb-ph-filter;
                edited => {
                    Kanban.f-blocked-filter-edited(self.text);
                }
            }
            for b in Kanban.f-blocked: KChipToggle {
                label: b.label;
                active: b.on;
                clicked => {
                    Kanban.f-blocked-toggle(b.key);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            FormSlot {
                cap: Strings.kb-fl-due;
                AppField {
                    text <=> Kanban.f-due;
                    placeholder: Strings.kb-ph-date;
                }
            }
            FormSlot {
                cap: Strings.kb-fl-after;
                AppField {
                    text <=> Kanban.f-after;
                    placeholder: Strings.kb-ph-date;
                }
            }
        }
        FormSlot {
            cap: Strings.kb-fl-time;
            ChipRow {
                KChipToggle {
                    label: Strings.kb-tm-floating;
                    active: Kanban.f-mode == 0;
                    clicked => {
                        Kanban.f-mode = 0;
                    }
                }
                KChipToggle {
                    label: Strings.kb-tm-once;
                    active: Kanban.f-mode == 1;
                    clicked => {
                        Kanban.f-mode = 1;
                    }
                }
                KChipToggle {
                    label: Strings.kb-tm-recurring;
                    active: Kanban.f-mode == 2;
                    clicked => {
                        Kanban.f-mode = 2;
                    }
                }
            }
        }
        if Kanban.f-mode > 0: HorizontalLayout {
            spacing: 10px;
            FormSlot {
                cap: Strings.kb-fl-start;
                AppField {
                    text <=> Kanban.f-start;
                    placeholder: Strings.kb-ph-when;
                }
            }
            FormSlot {
                cap: Strings.kb-fl-end;
                AppField {
                    text <=> Kanban.f-end;
                    placeholder: Strings.kb-ph-when;
                }
            }
        }
        if Kanban.f-mode == 2: HorizontalLayout {
            spacing: 10px;
            FormSlot {
                cap: Strings.kb-fl-time;
                ChipRow {
                    KChipToggle {
                        label: Strings.kb-daily;
                        active: Kanban.f-freq == "daily";
                        clicked => {
                            Kanban.f-freq = "daily";
                        }
                    }
                    KChipToggle {
                        label: Strings.kb-weekly;
                        active: Kanban.f-freq == "weekly";
                        clicked => {
                            Kanban.f-freq = "weekly";
                        }
                    }
                    KChipToggle {
                        label: Strings.kb-monthly;
                        active: Kanban.f-freq == "monthly";
                        clicked => {
                            Kanban.f-freq = "monthly";
                        }
                    }
                }
            }
            FormSlot {
                cap: Strings.kb-fl-interval;
                AppField {
                    text <=> Kanban.f-interval;
                    placeholder: "1";
                    numeric: true;
                }
            }
            FormSlot {
                cap: Strings.kb-fl-until;
                AppField {
                    text <=> Kanban.f-until;
                    placeholder: Strings.kb-ph-date;
                }
            }
            FormSlot {
                cap: Strings.kb-fl-count;
                AppField {
                    text <=> Kanban.f-count;
                    numeric: true;
                }
            }
        }
        FormSlot {
            cap: Strings.kb-fl-desc;
            AppArea {
                height: 120px;
                text <=> Kanban.f-desc;
                placeholder: Strings.kb-ph-desc;
            }
        }
        FormSlot {
            cap: Strings.kb-fl-acceptance;
            KListEditor {
                items: Kanban.f-acceptance;
                which: 0;
            }
        }
        FormSlot {
            cap: Strings.kb-fl-scope;
            KListEditor {
                items: Kanban.f-scope;
                which: 1;
            }
        }
        if Kanban.f-error != "": Text {
            text: Kanban.f-error;
            color: Theme.bad;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            AppButton {
                label: Strings.kb-back;
                clicked => {
                    Kanban.form-cancel();
                }
            }
            AppButton {
                label: Strings.kb-add-basket;
                primary: true;
                enabled: Kanban.f-title != "";
                clicked => {
                    Kanban.form-submit();
                }
            }
        }
    }
}

// The drill-in (§8): both link directions, the prerequisites with their
// progress, the acceptance checklist with evidence, the legal moves.
component KDrill inherits VerticalLayout {
    callback vote(int);
    spacing: 8px;
    PanePanel {
        HorizontalLayout {
            spacing: 8px;
            AppButton {
                label: Strings.kb-back;
                clicked => {
                    Kanban.pick("");
                }
            }
            Text {
                text: Kanban.detail.title;
                color: Theme.text;
                font-size: Theme.fs-h2;
                font-weight: 700;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: Kanban.detail.short;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            TagChip {
                label: Kanban.detail.badge;
                tone: Kanban.detail.bad ? Theme.bad : Theme.accent;
            }
            if Kanban.detail.type-slot >= 0: TypeChip {
                label: Kanban.detail.type-label;
                slot: Kanban.detail.type-slot;
            }
            if Kanban.detail.size != "": TagChip {
                label: Kanban.detail.size;
                muted: true;
            }
            if Kanban.detail.vote != "": VoteBadge {
                label: Kanban.detail.vote;
                clicked => {
                    root.vote(Kanban.detail.vote-id);
                }
            }
        }
        GlyphCaption {
            glyph: "👤";
            label: "\{Kanban.detail.who} · \{Strings.kb-fl-created} \{Kanban.detail.creator}";
        }
        if Kanban.detail.dates != "": GlyphCaption {
            glyph: "🗓️";
            label: Kanban.detail.dates;
            tone: Kanban.detail.bad ? Theme.bad : Theme.faint;
        }
        if Kanban.detail.flags != "": Text {
            text: Kanban.detail.flags;
            color: Theme.bad;
            font-size: Theme.fs-cap;
        }
        if Kanban.detail.note != "": Text {
            text: "\{Strings.kb-fl-note}: \{Kanban.detail.note}";
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        if Kanban.detail.description != "": Text {
            text: Kanban.detail.description;
            color: Theme.text;
            font-size: Theme.fs-body;
            wrap: word-wrap;
        }
        if Kanban.checks.length > 0: KCap {
            text: Strings.kb-fl-acceptance;
        }
        for k in Kanban.checks: HorizontalLayout {
            spacing: 8px;
            KGlyph {
                glyph: k.done ? "✅" : "⬜";
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: k.text;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                }
                if k.evidence != "": Text {
                    text: k.evidence;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    wrap: word-wrap;
                }
            }
        }
        if Kanban.scope.length > 0: KCap {
            text: Strings.kb-fl-scope;
        }
        for o in Kanban.scope: Text {
            text: "- \{o}";
            color: Theme.dim;
            font-size: Theme.fs-body;
            wrap: word-wrap;
        }
        if Kanban.blocked-by.length > 0: KCap {
            text: Strings.kb-fl-blocked;
        }
        for b in Kanban.blocked-by: KLineRow {
            line: b;
            clicked => {
                Kanban.pick(b.key);
            }
        }
        if Kanban.prereq-for.length > 0: KCap {
            text: Strings.kb-fl-prereq-for;
        }
        for b in Kanban.prereq-for: KLineRow {
            line: b;
            clicked => {
                Kanban.pick(b.key);
            }
        }
        if Kanban.prereqs.length > Kanban.blocked-by.length: KCap {
            text: "\{Strings.kb-fl-prereqs} · \{Kanban.detail.progress}";
        }
        if Kanban.prereqs.length > Kanban.blocked-by.length: VerticalLayout {
            spacing: 4px;
            for b in Kanban.prereqs: KLineRow {
                line: b;
                clicked => {
                    Kanban.pick(b.key);
                }
            }
        }
        if Kanban.detail.staged != "": Text {
            text: Kanban.detail.staged;
            color: Theme.accent;
            font-size: Theme.fs-cap;
            font-weight: 600;
        }
        if Kanban.moves.length > 0: FormSlot {
            cap: Strings.kb-fl-note;
            AppField {
                text <=> Kanban.note;
            }
        }
        if Kanban.checks.length > 0 && Kanban.moves.length > 0: FormSlot {
            cap: Strings.kb-fl-evidence;
            for e[i] in Kanban.evidence: AppField {
                text: e;
                placeholder: Kanban.checks[i].text;
                edited => {
                    Kanban.evidence-set(i, self.text);
                }
            }
        }
        ChipRow {
            for m in Kanban.moves: KChipToggle {
                label: m.label;
                active: m.on;
                clicked => {
                    Kanban.stage(m.key);
                }
            }
        }
    }
}

// The basket bar (§8): "N changes - Propose / Discard", the voter's view
// of it on hover.
component BasketBar inherits VerticalLayout {
    property <bool> open: false;
    spacing: 6px;
    if root.open || bar-ta.has-hover: Rectangle {
        background: Theme.panel-2;
        border-radius: Theme.win95 ? 0px : 8px;
        border-width: Theme.border-w;
        border-color: Theme.line;
        height: min(320px, blist.preferred-height);
        clip: true;
        bfl := Flickable {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            viewport-height: blist.preferred-height;
            blist := VerticalLayout {
                padding: 10px;
                spacing: 4px;
                for r[i] in Kanban.basket-rows: KLineRow {
                    line: r;
                    action-label: "✕";
                    action => {
                        Kanban.basket-remove(i);
                    }
                }
                if Kanban.basket-tip != "": Text {
                    text: Kanban.basket-tip;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    wrap: word-wrap;
                }
            }
        }
    }
    Rectangle {
        background: Theme.accent-soft;
        border-radius: Theme.win95 ? 0px : 8px;
        border-width: Theme.border-w;
        border-color: Theme.accent;
        height: 50px * Theme.ui-scale;
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            Rectangle {
                width: bcount.preferred-width + 8px;
                accessible-role: button;
                accessible-label: bcount.text;
                bcount := Text {
                    text: "🧺 \{Kanban.basket-count} \{Strings.kb-changes}";
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                bar-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.open = !root.open;
                    }
                }
            }
            AppField {
                text <=> Kanban.basket-summary;
                placeholder: Kanban.basket-auto;
            }
            AppButton {
                label: Strings.kb-propose;
                primary: true;
                clicked => {
                    Kanban.basket-propose();
                }
            }
            AppButton {
                label: Strings.kb-discard;
                clicked => {
                    Kanban.basket-discard();
                }
            }
        }
    }
}

export component QuestsPane inherits VerticalLayout {
    in property <string> view;
    // a vote badge or a vote action: open that proposal's discussion
    callback open-proposal(int);
    // a poke action: the chat
    callback open-chat();
    // the column a dragged card hovers (-1 = none)
    property <int> drag-col: -1;
    spacing: 8px;

    pure function col-at(x: length) -> int {
        return x < col-b.absolute-position.x ? 0 : (x < col-c.absolute-position.x ? 1 : 2);
    }

    if Kanban.form-open: KForm {
        vertical-stretch: 1;
    }
    if !Kanban.form-open && Kanban.sel != "": KDrill {
        vertical-stretch: 1;
        vote(id) => {
            root.open-proposal(id);
        }
    }

    // -- Board: To do · In progress · Done ---------------------------------
    if !Kanban.form-open && Kanban.sel == "" && root.view == "board": KHead {
        glyph: "📋";
        title: Strings.kb-title-board;
        hint: Strings.kb-hint-board;
    }
    if !Kanban.form-open && Kanban.sel == "" && root.view == "board": HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for f in Kanban.filters: KChipToggle {
            label: f.label;
            active: f.on;
            clicked => {
                Kanban.filter-toggle(f.key);
            }
        }
        for t in Kanban.legend: Rectangle {
            width: tchip.preferred-width + 14px;
            height: 26px * Theme.ui-scale;
            border-radius: Theme.win95 ? 0px : 4px;
            border-width: 1px;
            border-color: t.on ? Theme.accent : Theme.line;
            background: t.on ? Theme.accent-soft : transparent;
            accessible-role: button;
            accessible-label: t.label;
            tchip := TypeChip {
                x: 7px;
                height: 100%;
                label: t.label;
                slot: t.slot;
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    Kanban.type-toggle(t.key);
                }
            }
        }
    }
    // the columns stay laid out (hidden) under the form and the drill-in:
    // the drop target is read off their positions
    HorizontalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        visible: !Kanban.form-open && Kanban.sel == "" && root.view == "board";
        max-height: self.visible ? 100000px : 0px;
        col-a := KanbanColumn {
            title: Strings.kb-col-todo;
            tone: Theme.faint;
            cards: Kanban.todo;
            hot: root.drag-col == 0;
            vote(id) => {
                root.open-proposal(id);
            }
            drag(x) => {
                root.drag-col = root.col-at(x);
            }
            drop(id, x) => {
                root.drag-col = -1;
                Kanban.move(id, root.col-at(x));
            }
        }
        col-b := KanbanColumn {
            title: Strings.kb-col-wip;
            tone: Theme.warn;
            cards: Kanban.wip;
            hot: root.drag-col == 1;
            vote(id) => {
                root.open-proposal(id);
            }
            drag(x) => {
                root.drag-col = root.col-at(x);
            }
            drop(id, x) => {
                root.drag-col = -1;
                Kanban.move(id, root.col-at(x));
            }
        }
        col-c := KanbanColumn {
            title: Strings.kb-col-done;
            tone: Theme.good;
            cards: Kanban.done;
            hot: root.drag-col == 2;
            vote(id) => {
                root.open-proposal(id);
            }
            drag(x) => {
                root.drag-col = root.col-at(x);
            }
            drop(id, x) => {
                root.drag-col = -1;
                Kanban.move(id, root.col-at(x));
            }
        }
    }

    // -- Mine: read_actions first, then my other tasks --------------------
    if !Kanban.form-open && Kanban.sel == "" && root.view == "my-quests": KHead {
        glyph: "🎯";
        title: "\{Strings.kb-title-mine} (\{Kanban.action-count})";
        hint: Strings.kb-hint-mine;
    }
    if !Kanban.form-open && Kanban.sel == "" && root.view == "my-quests": PanePanel {
        KCap {
            text: "\{Strings.kb-sec-actions} (\{Kanban.action-count})";
        }
        if Kanban.actions.length == 0: Text {
            text: Strings.kb-empty;
            color: Theme.faint;
            font-size: Theme.fs-cap;
        }
        for a in Kanban.actions: KLineRow {
            line: a;
            clicked => {
                if (a.kind == "task") {
                    Kanban.pick(a.key);
                } else if (a.kind == "vote") {
                    root.open-proposal(a.key.to-float());
                } else {
                    root.open-chat();
                }
            }
        }
        KCap {
            text: Strings.kb-sec-mine;
        }
        if Kanban.mine.length == 0: Text {
            text: Strings.kb-empty;
            color: Theme.faint;
            font-size: Theme.fs-cap;
        }
        for m in Kanban.mine: KLineRow {
            line: m;
            clicked => {
                Kanban.pick(m.key);
            }
        }
        if Kanban.declined.length > 0: KCap {
            text: Strings.kb-sec-declined;
        }
        for d in Kanban.declined: KLineRow {
            line: d;
            action-label: Strings.kb-rescue;
            clicked => {
                root.open-proposal(d.key.to-float());
            }
            action => {
                Kanban.rescue(d.key.to-float());
            }
        }
    }

    // -- the views of the next stage ---------------------------------------
    if !Kanban.form-open && Kanban.sel == "" && root.view == "plan": KHead {
        glyph: "🗓️";
        title: Strings.kb-title-plan;
        hint: Strings.kb-off-board;
    }
    if !Kanban.form-open && Kanban.sel == "" && root.view == "calendar": KHead {
        glyph: "📅";
        title: Strings.kb-title-calendar;
        hint: Strings.kb-off-board;
    }
    if !Kanban.form-open && Kanban.sel == "" && root.view == "dependencies": KHead {
        glyph: "🔗";
        title: Strings.kb-title-deps;
        hint: Strings.kb-off-board;
    }
    if !Kanban.form-open && Kanban.sel == ""
        && (root.view == "plan" || root.view == "calendar" || root.view == "dependencies"): Rectangle {
        vertical-stretch: 1;
    }

    if Kanban.basket-count > 0: BasketBar { }
}

// ---------------------------------------------------------------------------
// Vault - sealed secrets, threshold-elected disclosure
// ---------------------------------------------------------------------------
//
// docs_archive/vault/vault_threshold_disclosure.md: the rows arrive pre-rendered
// from the engine's VaultView (molt-ui surfaces.rs); this pane only lays
// them out and routes the four vault commands.

// The state chip of a deposit card (spec §7: what is proven, not what
// committed).
component VaultStateChip inherits TagChip {
    in property <int> state;
    glyph: root.state == 0 ? "⏳" : (root.state == 3 ? "🛡️" : (root.state == 2 ? "🔒" : "📥"));
    muted: root.state == 0;
    tone: root.state >= 2 ? Theme.good : Theme.accent;
}

component DepositCard inherits Rectangle {
    in property <VaultDepositRow> d;
    callback grant(string /* secret-id */, string /* name */);
    callback read(string /* secret-id */);
    callback reseal(string /* secret-id */);
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.d.name;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    TagChip {
                        label: root.d.kind;
                        muted: true;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.d.caption;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                VaultStateChip {
                    state: root.d.state;
                    label: root.d.state-word;
                }
                if root.d.state > 0: TagChip {
                    label: root.d.verified;
                    muted: true;
                }
            }
            if root.d.readable != "": Text {
                text: root.d.readable;
                color: Theme.warn;
                font-size: Theme.fs-cap;
            }
            for c in root.d.complaints: Text {
                text: c.text;
                color: c.bad ? Theme.bad : Theme.warn;
                font-size: Theme.fs-cap;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            cross-axis-alignment: center;
            if root.d.reseal: AppButton {
                height: 30px * Theme.ui-scale;
                pad: 10px;
                emoji: "🔏";
                label: Strings.vt-reseal;
                clicked => {
                    root.reseal(root.d.secret-id);
                }
            }
            if root.d.can-grant: AppButton {
                height: 30px * Theme.ui-scale;
                pad: 10px;
                emoji: "🗳️";
                label: Strings.vt-grant;
                clicked => {
                    root.grant(root.d.secret-id, root.d.name);
                }
            }
            if root.d.can-read: AppButton {
                height: 30px * Theme.ui-scale;
                pad: 10px;
                primary: true;
                emoji: "🔓";
                label: Strings.vt-read;
                clicked => {
                    root.read(root.d.secret-id);
                }
            }
        }
    }
}

component GrantCard inherits Rectangle {
    in property <VaultGrantRow> g;
    callback approve(int /* proposal */);
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    opacity: root.g.dimmed ? 0.55 : 1.0;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.g.line;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                TagChip {
                    glyph: root.g.state == 1 ? "🔓" : "";
                    label: root.g.state-word;
                    muted: root.g.state != 1;
                }
            }
            if root.g.state == 0 && root.g.proposal >= 0: AppButton {
                height: 30px * Theme.ui-scale;
                pad: 10px;
                emoji: "✍️";
                label: Strings.mv-approve;
                enabled: root.g.can-vote;
                clicked => {
                    root.approve(root.g.proposal);
                }
            }
        }
        if root.g.votes != "": Text {
            text: root.g.votes;
            color: Theme.dim;
            font-size: Theme.fs-cap;
        }
        if root.g.waiting != "": Text {
            text: root.g.waiting;
            color: Theme.dim;
            font-size: Theme.fs-cap;
        }
        if root.g.bad != "": Text {
            text: root.g.bad;
            color: Theme.bad;
            font-size: Theme.fs-cap;
        }
    }
}

component UnsealedCard inherits Rectangle {
    in property <VaultUnsealedRow> u;
    callback copy(string);
    property <bool> shown: false;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.u.name;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                TagChip {
                    label: root.u.kind;
                    muted: true;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.u.status == "": AppButton {
                pad: 10px;
                icon: @image-url("assets/eye.svg");
                icon-set: true;
                primary: root.shown;
                tooltip: root.shown ? Strings.peek-hide : Strings.peek-show;
                clicked => {
                    root.shown = !root.shown;
                }
            }
            if root.u.status == "": AppButton {
                pad: 10px;
                label: Strings.vt-copy;
                clicked => {
                    root.copy(root.u.text);
                }
            }
        }
        if root.u.status != "": Text {
            text: root.u.status;
            color: Theme.dim;
            font-size: Theme.fs-cap;
        }
        if root.u.status == "": InsetWell {
            text: root.u.text;
            revealed: root.shown;
        }
    }
}

// A quiet one-line placeholder inside a pane panel.
component VaultNote inherits Text {
    color: Theme.faint;
    font-size: Theme.fs-cap;
    wrap: word-wrap;
}

export component VaultPane inherits VerticalLayout {
    in property <string> view;
    in property <bool> real;
    in property <bool> base-pending;
    in property <string> base-line;
    in property <[VaultDepositRow]> deposits;
    in property <[VaultGrantRow]> grants;
    in property <[VaultUnsealedRow]> unsealed;
    callback seal-clicked();
    callback grant-clicked(string /* secret-id */, string /* name */);
    callback read-clicked(string /* secret-id */);
    callback reseal-clicked(string /* secret-id */);
    callback approve(int /* proposal */);
    callback copy(string);
    spacing: 8px;

    if root.view == "secrets": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🔐";
            title: Strings.vt-title-secrets;
            hint: Strings.vt-hint-secrets;
            mock: false;
        }
        if root.real && !root.base-pending: HorizontalLayout {
            alignment: start;
            vt-seal-btn := AppButton {
                emoji: "🔏";
                label: Strings.vt-seal-new;
                primary: true;
                clicked => {
                    root.seal-clicked();
                }
            }
        }
        PanePanel {
            if !root.real: VaultNote {
                text: Strings.vt-needs-vault;
            }
            if root.real && root.base-pending: VaultNote {
                text: root.base-line;
            }
            if root.real && !root.base-pending && root.deposits.length == 0: VaultNote {
                text: Strings.vt-empty-secrets;
            }
            if root.real && !root.base-pending: VerticalLayout {
                spacing: 10px;
                for d in root.deposits: DepositCard {
                    d: d;
                    grant(id, name) => {
                        root.grant-clicked(id, name);
                    }
                    read(id) => {
                        root.read-clicked(id);
                    }
                    reseal(id) => {
                        root.reseal-clicked(id);
                    }
                }
            }
        }
    }

    if root.view == "requests": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📤";
            title: Strings.vt-title-requests;
            hint: Strings.vt-hint-requests;
            mock: false;
        }
        PanePanel {
            if !root.real: VaultNote {
                text: Strings.vt-needs-vault;
            }
            if root.real && root.grants.length == 0: VaultNote {
                text: Strings.vt-empty-grants;
            }
            if root.real: VerticalLayout {
                spacing: 10px;
                for g in root.grants: GrantCard {
                    g: g;
                    approve(id) => {
                        root.approve(id);
                    }
                }
            }
        }
    }

    if root.view == "unsealed": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🔓";
            title: Strings.vt-title-unsealed;
            hint: Strings.vt-hint-unsealed;
            mock: false;
        }
        PanePanel {
            if !root.real: VaultNote {
                text: Strings.vt-needs-vault;
            }
            if root.real && root.unsealed.length == 0: VaultNote {
                text: Strings.vt-empty-unsealed;
            }
            if root.real: VerticalLayout {
                spacing: 10px;
                for u in root.unsealed: UnsealedCard {
                    u: u;
                    copy(text) => {
                        root.copy(text);
                    }
                }
            }
        }
    }
}

// A signer mark on a mock card (the wallet pane).
struct MockSigner {
    name: string,
    signed: bool,
}

// ---------------------------------------------------------------------------
// Wallet — Monero multisig
// ---------------------------------------------------------------------------

struct MockTransfer {
    incoming: bool,
    amount: string, // "12.0000"
    label: string,
    when: string,
    conf: int, // confirmations, capped at 10
    txid: string,
}

struct MockPendingTx {
    label: string,
    amount: string,
    signed: int,
    need: int,
    signers: [MockSigner],
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    height: max(44px, Theme.fs-body * 1.4 + 20px);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component WalletPane inherits VerticalLayout {
    in property <string> view;
    spacing: 8px;

    // sample data — design mock only, never engine state
    property <[MockTransfer]> transfers: [
        { incoming: true, amount: "0.5028", label: "Donation (anonymous)", when: "5 h", conf: 3, txid: "b41c…9e" },
        { incoming: true, amount: "12.0000", label: "Member top-up - mara", when: "2 d", conf: 10, txid: "9f3c…a1" },
        { incoming: false, amount: "4.0000", label: "Quest reward - multisig setup", when: "1 w", conf: 10, txid: "77ab…04" },
        { incoming: true, amount: "25.0000", label: "Member top-up - petra", when: "2 w", conf: 10, txid: "c2d8…5f" },
        { incoming: false, amount: "2.4000", label: "Relay hosting Q2", when: "1 m", conf: 10, txid: "e901…bc" },
        { incoming: false, amount: "0.8000", label: "Domain renewal", when: "1 m", conf: 10, txid: "12fe…77" },
        { incoming: true, amount: "100.0000", label: "Founding treasury", when: "4 m", conf: 10, txid: "a0b1…c2" },
    ];
    property <[MockPendingTx]> pending-tx: [
        { label: "Quest reward - recovery drill → jonas", amount: "5.0000", signed: 1, need: 3, signers: [
            { name: "petra", signed: true }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
        { label: "Relay hosting Q3", amount: "2.4000", signed: 0, need: 3, signers: [
            { name: "petra", signed: false }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
    ];
    // send form: pure pane state for design iteration — the drafts are
    // bound so typed input survives a view switch (a field that forgets
    // on tab-away reads as broken, mock or not)
    property <int> prio: 1;
    property <string> send-addr;
    property <string> send-amount;

    // the receive card's decorative pseudo-QR: a deterministic 17×17
    // module pattern with the three finder squares — design chrome only,
    // NOT an encoding of the (equally fictional) address below it
    pure function qr-cell(row: int, col: int) -> bool {
        if (row <= 6 && col <= 6) {
            return row == 0 || row == 6 || col == 0 || col == 6 || (row >= 2 && row <= 4 && col >= 2 && col <= 4);
        }
        if (row <= 6 && col >= 10) {
            return row == 0 || row == 6 || col == 10 || col == 16 || (row >= 2 && row <= 4 && col >= 12 && col <= 14);
        }
        if (row >= 10 && col <= 6) {
            return row == 10 || row == 16 || col == 0 || col == 6 || (row >= 12 && row <= 14 && col >= 2 && col <= 4);
        }
        return Math.mod(row * 17 + col * 31 + row * col * 7, 11) < 5;
    }

    if root.view != "history" && root.view != "send" && root.view != "receive"
        && root.view != "settings": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "💰";
            title: Strings.wl-title-balance;
            hint: Strings.wl-hint-balance;
        }
        // the balance figure — the wallet's signature moment. A real
        // padded layout, not an anchored one (the parts.slint mis-measure
        // trap), and the figure rides the font ladder.
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "128.4062";
                        color: Theme.text;
                        font-size: Theme.fs-h1 + 10px;
                        font-weight: 800;
                    }
                    Text {
                        text: "XMR";
                        color: Theme.faint;
                        font-size: Theme.fs-h2;
                        font-weight: 700;
                        vertical-alignment: bottom;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        TagChip {
                            label: Strings.wl-rule-sample;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    GlyphCaption {
                        glyph: "🔓";
                        label: "121.9034 XMR \{Strings.wl-unlocked}";
                        tone: Theme.dim;
                    }
                    GlyphCaption {
                        glyph: "⏳";
                        label: "6.5028 XMR \{Strings.wl-locked}";
                        tone: Theme.dim;
                    }
                }
            }
        }
        // transfers awaiting the threshold's signatures
        Text {
            text: Strings.wl-pending-sigs;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 600;
        }
        PanePanel {
            for t in root.pending-tx: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 11px;
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "- \{t.amount} XMR";
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    SigMeter {
                        signed: t.signed;
                        need: t.need;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for m in t.signers: TagChip {
                            glyph: m.signed ? "✍️" : "";
                            label: m.name;
                            muted: !m.signed;
                        }
                    }
                }
            }
        }
    }

    if root.view == "history": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📜";
            title: Strings.wl-title-history;
            hint: Strings.wl-hint-history;
        }
        PanePanel {
            for t in root.transfers: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                // follows the font ladder — a fixed 52px clipped the two
                // stacked lines at larger app fonts
                height: max(52px, Theme.fs-body * 1.4 + Theme.fs-cap * 1.4 + 20px);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 20px;
                        height: 100%;
                        clip: true;
                        Text {
                            text: t.incoming ? "📥" : "📤";
                            font-family: "Twemoji Mozilla";
                            font-size: 14px;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: "\{t.when} · \{t.txid}";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            overflow: elide;
                        }
                    }
                    // the tone alone says "confirmed" — a plain-text ✓ would
                    // render as a thin monochrome outline (the Twemoji rule)
                    Text {
                        text: "\{min(t.conf, 10)}/10";
                        color: t.conf >= 10 ? Theme.good : Theme.warn;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                    Text {
                        text: t.incoming ? "+ \{t.amount}" : "- \{t.amount}";
                        color: t.incoming ? Theme.good : Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: max(90px, Theme.fs-body * 6);
                    }
                }
            }
        }
    }

    if root.view == "send": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📤";
            title: Strings.wl-title-send;
            hint: Strings.wl-hint-send;
        }
        PanePanel {
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-to-address;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "4…";
                    text <=> root.send-addr;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-amount;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "0.0000";
                    text <=> root.send-amount;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-priority;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    AppButton {
                        label: Strings.wl-prio-low;
                        primary: root.prio == 0;
                        clicked => {
                            root.prio = 0;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-normal;
                        primary: root.prio == 1;
                        clicked => {
                            root.prio = 1;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-high;
                        primary: root.prio == 2;
                        clicked => {
                            root.prio = 2;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                AppButton {
                    emoji: "🗳️";
                    label: Strings.wl-propose-transfer;
                    primary: true;
                    enabled: false;
                    tooltip: Strings.not-implemented-yet;
                    tooltip-below: true;
                }
                Text {
                    text: "\{Strings.wl-fee} ~0.000021 XMR";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }

    if root.view == "receive": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📥";
            title: Strings.wl-title-receive;
            hint: Strings.wl-hint-receive;
        }
        PanePanel {
            HorizontalLayout {
                spacing: 16px;
                // no alignment:start here — it cancelled the address
                // column's horizontal-stretch and left the pane's right
                // half dead space
                // decorative pseudo-QR on a light well (QR needs light
                // ground on every theme)
                Rectangle {
                    width: 17 * 6px + 24px;
                    height: 17 * 6px + 24px;
                    background: #ffffff;
                    border-radius: Theme.win95 ? 0px : 8px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    for i in 289: Rectangle {
                        x: 12px + Math.mod(i, 17) * 6px;
                        y: 12px + Math.floor(i / 17) * 6px;
                        width: 6px;
                        height: 6px;
                        background: root.qr-cell(Math.floor(i / 17), Math.mod(i, 17)) ? #1a1d21 : transparent;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Strings.wl-subaddress;
                        color: Theme.dim;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                    }
                    Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.win95 ? 0px : 6px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 10px;
                            // deliberately mid-truncated: a design-mock
                            // address must never be transcribable into a
                            // send field
                            Text {
                                text: "8BdKQ9wJ3mPZxVtF7nRqYcLhG2sD4eTv … PxQbUcFgAt2iE9oRk4";
                                color: Theme.text;
                                font-size: Theme.fs-cap;
                                wrap: char-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        AppButton {
                            label: Strings.ow-copy;
                            enabled: false;
                            tooltip: Strings.not-implemented-yet;
                            tooltip-below: true;
                        }
                    }
                }
            }
        }
    }

    if root.view == "settings": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "⚙️";
            title: Strings.wl-title-settings;
            hint: Strings.wl-hint-settings;
        }
        PanePanel {
            SettingRow {
                label: Strings.wl-node;
                value: "node.example.org:18081 · Tor";
            }
            SettingRow {
                label: Strings.wl-sync;
                value: "3 214 502";
            }
            SettingRow {
                label: Strings.wl-signer-set;
                value: "\{Strings.wl-rule-sample} - petra, walter, mara, jonas";
            }
        }
    }
}
