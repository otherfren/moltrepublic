// SPDX-License-Identifier: GPL-3.0-or-later
//
// DESIGN MOCKS for the five staged surfaces: Memory (shared brain), Quests
// (planning Kanban), Vault (sealed secrets, threshold-elected disclosure),
// Wallet (Monero multisig) and Shared Files (chunked, seat-replicated).
//
// These panes are badged UX drafts to iterate on look & feel — every dataset
// below is .slint-side sample data, never engine state. Actions either work
// as pure view-state mocks or render DISABLED (with the "not yet" tooltip,
// the same idiom as the greyed network options). The REAL threshold
// governance for these surfaces (pending proposals / applied log / propose)
// stays in app.slint and routes to the "proposals" (resp. wallet "status")
// sub-views.
//
// EXCEPTION: the Multisig-Wiki's state (doc tree, tabs, edit buffers, the
// pending-change set) lives in the Rust model `crates/molt-ui/src/wiki.rs`
// and reaches this pane through the `WikiState` global — still a badged
// mock (nothing is stored or sent), but the client state machine is real
// and unit-tested. This pane only renders rows and routes actions.
//
// Each pane is one component taking only the selected sub-view key, so the
// panes stay independently editable under scripts/dev-ui.sh hot-reload.

import { Theme, Strings, HintTip, WikiState, WikiNavRow, WikiTabRow, WikiBlock, WikiSpan } from "theme.slint";
import { AppButton, AppField, AppArea, AppDropdown, ScrollHint, DotLabel, InsetWell } from "components.slint";

// ---------------------------------------------------------------------------
// shared chrome
// ---------------------------------------------------------------------------

// The small-but-unmissable badge every mock pane carries: warn-coloured like
// the founding ritual's SIMULATION badge, with an honesty tooltip.
export component MockBadge inherits Rectangle {
    background: Theme.warn;
    border-radius: Theme.win95 ? 0px : 4px;
    width: bt.preferred-width + 12px;
    height: bt.preferred-height + 5px;
    bt := Text {
        x: 6px;
        y: 2.5px;
        text: Strings.mock-badge;
        color: #1a1200;
        font-size: Theme.fs-cap;
        font-weight: 700;
    }
    // the hint goes through the window-topmost HintTip overlay (renders
    // above everything, never clipped, and — unlike a PopupWindow — grabs
    // no input, so the hover cannot strobe)
    ta := TouchArea {
        // the tip generation this element owns (HintTip.show hands it out):
        // only its owner may clear the bubble, so hovering straight onto
        // another control cannot wipe the hint that control just opened
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover) {
                self.tip-gen = HintTip.show(Strings.mock-tip,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
    }
}

// One pane/view header: Twemoji glyph + title + the mock badge, and an
// optional one-line hint underneath (the honest "what this will be" line).
component PaneHeader inherits VerticalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint: "";
    spacing: 5px;
    HorizontalLayout {
        spacing: 10px;
        // fixed clip box, like the nav rows: an oversized emoji glyph must
        // never bleed into the neighbours
        Rectangle {
            width: 22px;
            height: 24px;
            clip: true;
            Text {
                text: root.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 16px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-h2;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            MockBadge { }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
    }
}

// The standard content panel every pane's body sits on (chat's message list
// idiom): a themed surface with a Flickable + scroll hint.
component PanePanel inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    out property <length> inner-width: fl.width;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height + 24px;
        body := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 7px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// A tiny accent-tinted chip: tags, rewards, badges, signer marks. The
// optional leading glyph renders in the Twemoji font (never plain-text
// emoji in labels); `muted` turns it into a quiet outline (e.g. a signer
// who has not signed yet).
component TagChip inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> muted: false;
    // the chip's colour family; the default keeps the classic accent chip
    // byte-identical (accent-soft IS accent.transparentize(0.84))
    in property <color> tone: Theme.accent;
    background: root.muted ? transparent : root.tone.transparentize(0.84);
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.muted ? 1px : 0px;
    border-color: Theme.line;
    width: row.preferred-width + 12px;
    height: 20px;
    // full-height row + centered texts: an offset row sized off the text's
    // preferred height sat the label visibly at the chip's bottom edge
    row := HorizontalLayout {
        x: 6px;
        y: 0;
        height: parent.height;
        spacing: 4px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            height: 100%;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.muted ? Theme.faint : (Theme.win95 ? Theme.text : root.tone);
            font-size: 11px;
            font-weight: root.muted ? 400 : 600;
            height: 100%;
            vertical-alignment: center;
        }
    }
}

// The signature-collection meter (the pending-proposal progress idiom):
// a thin track with an accent fill plus the "x/y signed" caption.
component SigMeter inherits HorizontalLayout {
    in property <int> signed;
    in property <int> need;
    // the counted word — "signed" by default; the vault's unseal meter
    // counts re-sealed key shares instead
    in property <string> word: Strings.vt-signed-word;
    spacing: 10px;
    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.win95 ? 0px : 3px;
        background: Theme.line;
        horizontal-stretch: 1;
        Rectangle {
            x: 0;
            height: parent.height;
            border-radius: parent.border-radius;
            width: parent.width * min(1.0, root.signed * 1.0 / max(root.need, 1));
            background: Theme.accent;
        }
    }
    Text {
        text: "\{root.signed}/\{root.need} \{root.word}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

// A quiet "glyph + text" caption row (authors, dates, rewards …).
component GlyphCaption inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <color> tone: Theme.faint;
    spacing: 5px;
    Rectangle {
        width: 16px;
        height: 16px;
        clip: true;
        y: (parent.height - self.height) / 2;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 11px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        color: root.tone;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// Memory — the Multisig-Wiki (the shared brain)
// ---------------------------------------------------------------------------



// The slim toolbar strip on top of the navigator / content panes.
component ToolStrip inherits Rectangle {
    height: 34px;
    background: Theme.panel-2;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 4px;
        padding-bottom: 5px;
        spacing: 3px;
        @children
    }
    // bottom hairline separating the strip from the pane body
    Rectangle {
        x: 0;
        y: parent.height - Theme.border-w;
        width: parent.width;
        height: Theme.border-w;
        background: Theme.line;
    }
}

// A compact square toolbar button: Twemoji glyph, named tooltip below.
// Disabled by default — the pane idiom: an action that would change shared
// state renders greyed with the honest "not yet" suffix; wired actions
// pass `enabled: true` and really work. The tooltip is a PopupWindow, not
// an in-tree bubble: popups render above and outside the panel's clipped
// bounds, so a hint near a panel edge is never cut off.
component ToolBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <bool> enabled: false;
    // a working view-state toggle (the Kanban board filters) marks its
    // "on" state with the soft accent field
    in property <bool> active: false;
    callback clicked();
    width: 30px * Theme.ui-scale;
    border-radius: Theme.win95 ? 0px : 5px;
    background: root.active ? Theme.accent-soft
        : (root.enabled && ta.has-hover ? Theme.raised : transparent);
    Rectangle {
        width: 18px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;
        Text {
            text: root.glyph;
            font-family: "Twemoji Mozilla";
            font-size: 13px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.4;
        }
    }
    // the TouchArea stays enabled either way — a disabled button still
    // names itself on hover; only clicked() gates. Every disabled ToolBtn
    // today is STATE-disabled (no tab, nothing to act on), so the hint is
    // the plain name — the dimmed glyph already says "inactive", and a
    // "not yet" suffix here would wrongly claim the feature is unbuilt.
    // The hint renders through the window-topmost HintTip overlay (never
    // clipped, grabs no input — a PopupWindow here strobed the hover).
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        // the tip generation this element owns (HintTip.show hands it out):
        // only its owner may clear the bubble, so hovering straight onto
        // another button cannot wipe the hint that button just opened
        property <int> tip-gen;
        changed has-hover => {
            if (self.has-hover) {
                self.tip-gen = HintTip.show(root.name,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 6px);
            } else {
                HintTip.hide(self.tip-gen);
            }
        }
        clicked => {
            HintTip.label = "";
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The scrolling body under a ToolStrip (PanePanel's padless cousin for
// panes that carry their own chrome): Flickable + scroll hint, with the
// caller's padding/spacing.
component ScrollBody inherits Rectangle {
    in property <length> pad: 8px;
    in property <length> gap: 2px;
    vertical-stretch: 1;
    clip: true;
    fl := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height;
        body := VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
    ScrollHint {
        x: parent.width - 5px;
        view-h: fl.height;
        content-h: fl.viewport-height;
        scroll-y: fl.viewport-y;
    }
}

// One pseudo-rendered markdown block of the content pane, with its diff
// verdict: a colored bar marks added (good) / changed (warn) / removed
// (bad) blocks; a removed GHOST keeps the dropped base content visible,
// dimmed in the bad tone (Slint Text has no strikethrough).
// One clickable .md-link run in the preview: accent + underline, a soft
// pill while hovered; a click navigates to the linked document.
component LinkRun inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <length> fsize: Theme.fs-editor;
    width: lt.preferred-width + 4px;
    height: lt.preferred-height;
    border-radius: 3px;
    background: lta.has-hover ? Theme.accent-soft : transparent;
    lt := Text {
        x: 2px;
        text: root.label;
        color: Theme.accent;
        font-size: root.fsize;
    }
    // Text has no underline — the link affordance is drawn
    Rectangle {
        x: 2px;
        y: parent.height - 1px;
        width: parent.width - 4px;
        height: 1px;
        background: Theme.accent;
    }
    lta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            WikiState.open-link(root.target);
        }
    }
}

// A block's inline runs with clickable .md links. While the whole line
// fits unwrapped it renders as a true inline row; a longer link-bearing
// block falls back to stacked runs (Slint has no wrapping rich text) —
// plain runs wrap there and each link sits on its own line.
component SpanFlow inherits Rectangle {
    in property <[WikiSpan]> spans;
    in property <string> flat; // the flattened text — the fits-measure
    in property <color> ink;
    in property <length> fsize: Theme.fs-editor;
    property <bool> fits: m.preferred-width <= root.width - 8px;
    height: root.fits ? one.preferred-height : many.preferred-height;
    m := Text {
        text: root.flat;
        font-size: root.fsize;
        visible: false;
    }
    one := HorizontalLayout {
        visible: root.fits;
        alignment: start;
        spacing: 0;
        for sp in root.spans: HorizontalLayout {
            if sp.link == "": Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
            }
            if sp.link != "": LinkRun {
                label: sp.text;
                target: sp.link;
                fsize: root.fsize;
            }
        }
    }
    many := VerticalLayout {
        visible: !root.fits;
        spacing: 2px;
        for sp in root.spans: VerticalLayout {
            // a plain run fills the width and wraps; a link keeps its
            // natural width (alignment: start) so the pill hugs the text
            if sp.link == "": Text {
                text: sp.text;
                color: root.ink;
                font-size: root.fsize;
                wrap: word-wrap;
            }
            if sp.link != "": HorizontalLayout {
                alignment: start;
                LinkRun {
                    label: sp.text;
                    target: sp.link;
                    fsize: root.fsize;
                }
            }
        }
    }
}

component BrainBlockView inherits HorizontalLayout {
    in property <WikiBlock> b;
    // an h2 gets extra air above — the one spacing exception a doc needs
    padding-top: root.b.kind == 1 ? 6px : 0px;
    spacing: 8px;
    property <bool> ghost: root.b.status == 3;
    property <color> ink: root.ghost ? Theme.bad.mix(Theme.dim, 0.6) : Theme.text;
    // link-bearing paragraphs/bullets render their spans (clickable);
    // ghosts stay flat text — a removed block is history, not navigation
    property <bool> linked: !root.ghost
        && (root.b.spans.length > 1
            || (root.b.spans.length == 1 && root.b.spans[0].link != ""));
    Rectangle {
        width: 3px;
        border-radius: 1.5px;
        background: root.b.status == 1 ? Theme.good
            : root.b.status == 2 ? Theme.warn
            : root.b.status == 3 ? Theme.bad
            : transparent;
    }
    VerticalLayout {
        if root.b.kind == 0: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor + 4px;
            font-weight: 800;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 1: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-weight: 700;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && !root.linked: Text {
            text: root.b.text;
            color: root.ink;
            font-size: Theme.fs-editor;
            font-italic: root.ghost;
            wrap: word-wrap;
        }
        if root.b.kind == 2 && root.linked: SpanFlow {
            spans: root.b.spans;
            flat: root.b.text;
            ink: root.ink;
        }
        if root.b.kind == 3: HorizontalLayout {
            spacing: 7px;
            Text {
                text: "•";
                color: root.ghost ? Theme.bad : Theme.accent;
                font-size: Theme.fs-editor;
                vertical-alignment: top;
            }
            if !root.linked: Text {
                text: root.b.text;
                color: root.ink;
                font-size: Theme.fs-editor;
                font-italic: root.ghost;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.linked: SpanFlow {
                spans: root.b.spans;
                flat: root.b.text;
                ink: root.ink;
                horizontal-stretch: 1;
            }
        }
        if root.b.kind == 4: Rectangle {
            background: Theme.bg;
            border-radius: Theme.win95 ? 0px : 6px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            height: ct.preferred-height + 16px;
            ct := Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: root.b.text;
                color: root.ghost ? root.ink : Theme.dim;
                font-size: Theme.fs-editor - 2px;
                font-italic: root.ghost;
                wrap: word-wrap;
            }
        }
    }
}

export component MemoryPane inherits VerticalLayout {
    in property <string> view;
    // the 📋 button's path travels up to the app root — the real clipboard
    // write and the toast live there, the pane stays a pure view
    callback copy-path(string);
    // the ⚙️ gear routes to the app-level settings screen
    callback open-settings();
    // "discard all" asks first — the modal lives at the app root (a
    // layout child here could not overlay the pane)
    callback confirm-revert();
    // 💾 raises the export dialog, which lives at the app root too
    callback wiki-export();
    spacing: 8px;

    // Everything the wiki KNOWS lives in the Rust model behind WikiState
    // (tree, tabs, buffers, pending changes). What stays here is view
    // state that belongs to the pane: the splitter fraction and the
    // in-flight drag gesture.
    property <float> split: 0.32;
    // drag-move: a file row arms it once the press moves past a small
    // threshold; the drop target is a ROW INDEX computed from pointer
    // geometry (uniform 26px rows + 2px gap = 28px pitch), and the
    // folder-vs-file-vs-past-the-end semantics resolve in the model.
    // (Slint 1.17's native DragArea needs a host-built data-transfer
    // payload, which only exists behind private_unstable_api — hence
    // this small pane-local gesture instead.)
    property <int> drag-id: -1;
    // a dragged FOLDER goes by name (folders have no DocId); "" = none
    property <string> drag-folder: "";
    property <int> drag-to: -1;
    property <bool> drag-live: false;
    // swallows the click that ends a drag (clicked fires after the
    // pointer-up that commits the drop)
    property <bool> drag-was: false;

    // status → tone, ONE mapping for nav rows, tabs and the breadcrumb:
    // 1 added (good) · 2 modified (warn) · 3 deleted (bad)
    pure function tone(status: int, idle: color) -> color {
        return status == 1 ? Theme.good
            : status == 2 ? Theme.warn
            : status == 3 ? Theme.bad
            : idle;
    }

    // changeset stack rows: kind → glyph / tone
    // (0 created · 1 folder · 2 renamed · 3 moved · 4 deleted · 5 edited)
    pure function cs-glyph(kind: int) -> string {
        return kind == 0 ? "➕"
            : kind == 1 ? "📁"
            : kind == 2 ? "🏷️"
            : kind == 3 ? "➡️"
            : kind == 4 ? "🗑️"
            : "✏️";
    }
    pure function cs-tone(kind: int) -> color {
        return kind == 4 ? Theme.bad
            : (kind == 0 || kind == 1) ? Theme.good
            : Theme.warn;
    }

    if root.view == "brain": VerticalLayout {
        spacing: 8px;

        // ---- the changeset panel: every local action, and what the
        // next vote would bundle. Visible only while changes exist. ----
        if WikiState.cs-rows.length > 0: Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            property <length> list-h: min(WikiState.cs-rows.length, 4) * 24px;
            height: 18px + 28px + 6px + self.list-h;
            VerticalLayout {
                padding: 9px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px * Theme.ui-scale;
                    spacing: 10px;
                    Text {
                        text: Strings.mem-cs-title;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    // the NET summary: only non-zero parts speak
                    if WikiState.cs-added > 0: Text {
                        text: "+\{WikiState.cs-added} \{Strings.mem-cs-new}";
                        color: Theme.good;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-deleted > 0: Text {
                        text: "-\{WikiState.cs-deleted} \{Strings.mem-cs-deleted}";
                        color: Theme.bad;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-moved > 0: Text {
                        text: "→\{WikiState.cs-moved} \{Strings.mem-cs-moved}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if WikiState.cs-lines > 0: Text {
                        text: "~\{WikiState.cs-lines} \{Strings.mem-cs-lines}";
                        color: Theme.warn;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-undo;
                        clicked => {
                            WikiState.cs-undo();
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-revert;
                        clicked => {
                            root.confirm-revert();
                        }
                    }
                    AppButton {
                        height: 28px * Theme.ui-scale;
                        pad: 10px;
                        label: Strings.mem-cs-vote;
                        emoji: "🗳️";
                        primary: true;
                        clicked => {
                            WikiState.cs-vote();
                        }
                    }
                }
                // the action stack, oldest first (capped, scrolls)
                Rectangle {
                    clip: true;
                    csl := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: self.width;
                        viewport-height: WikiState.cs-rows.length * 24px;
                        VerticalLayout {
                            alignment: start;
                            for r in WikiState.cs-rows: HorizontalLayout {
                                height: 24px;
                                spacing: 6px;
                                Rectangle {
                                    width: 16px;
                                    height: 100%;
                                    clip: true;
                                    Text {
                                        text: root.cs-glyph(r.kind);
                                        font-family: "Twemoji Mozilla";
                                        font-size: 11px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: r.label;
                                    color: root.cs-tone(r.kind);
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    ScrollHint {
                        x: parent.width - 5px;
                        view-h: csl.height;
                        content-h: csl.viewport-height;
                        scroll-y: csl.viewport-y;
                    }
                }
            }
        }
        // no PaneHeader here: the Multisig-Wiki title (with the mock
        // badge) sits in the app's top bar, left of the republic name —
        // the full pane height belongs to navigator + document.
        // The two-pane split: file navigator | draggable splitter |
        // content. The navigator width is a stored FRACTION of the row,
        // so a window resize keeps the proportion; both sides keep a
        // hard minimum.
        srow := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            property <length> avail: self.width - 8px;
            // ONE clamp for layout and drag: navigator ≥ 213px (the
            // SIX-button toolbar's floor — 6*30 + 5*3 + 10 = 205, plus the
            // 8px slack the five-button floor carried), content ≥ 300px
            // (below their sum the navigator floor wins — the window is far
            // below any usable width there anyway)
            pure function clamp-nav(w: length) -> length {
                return max(213px, min(self.avail - 300px, w));
            }
            property <length> nav-w: self.clamp-nav(root.split * self.avail);

            // ---- navigator: browse the wiki tree ----
            Rectangle {
                width: srow.nav-w;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                // Enter opens / Del deletes the MARKED row as soon as the
                // navigator was clicked (the row click below hands this
                // scope the focus); anything else bubbles to the window
                // handler, which carries the same routes as a fallback
                nav-scope := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.Return && WikiState.has-marked) {
                            WikiState.open-marked();
                            return accept;
                        }
                        if (event.text == Key.Delete && WikiState.has-marked) {
                            WikiState.delete-marked();
                            return accept;
                        }
                        if (event.text == Key.F2 && WikiState.has-marked) {
                            WikiState.rename-marked();
                            return accept;
                        }
                        reject
                    }
                VerticalLayout {
                    ToolStrip {
                        ToolBtn {
                            glyph: "📁";
                            name: Strings.mem-tb-new-folder;
                            enabled: true;
                            clicked => {
                                WikiState.new-folder();
                            }
                        }
                        ToolBtn {
                            glyph: "📝";
                            name: Strings.mem-tb-new-file;
                            enabled: true;
                            clicked => {
                                WikiState.new-file();
                            }
                        }
                        ToolBtn {
                            glyph: "🗑️";
                            name: Strings.mem-tb-delete;
                            // deletion acts on the navigator's MARKED row
                            // (the tab strip has its own × per tab)
                            enabled: WikiState.has-marked;
                            clicked => {
                                WikiState.delete-marked();
                            }
                        }
                        ToolBtn {
                            glyph: "💾";
                            name: Strings.mem-tb-export;
                            // an export writes the APPROVED tree, so an
                            // empty base has nothing to write
                            enabled: WikiState.has-base();
                            clicked => {
                                root.wiki-export();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        ToolBtn {
                            glyph: "🔽";
                            name: Strings.mem-tb-collapse;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(false);
                            }
                        }
                        ToolBtn {
                            glyph: "🔼";
                            name: Strings.mem-tb-open-all;
                            enabled: true;
                            clicked => {
                                WikiState.fold-all(true);
                            }
                        }
                    }
                    ScrollBody {
                        pad: 6px;
                        gap: 2px;
                        for r[idx] in WikiState.nav-rows: Rectangle {
                            height: 26px;
                            border-radius: Theme.win95 ? 0px : 5px;
                            // the drop-target rim while a drag hovers this row
                            // (drawn by the inner variant rects — children
                            // would paint over a border set out here)
                            property <bool> drop-target: root.drag-live && root.drag-to == idx;

                            // ---- a folder row: click folds/unfolds,
                            // right-click menu, drag to merge elsewhere ----
                            if r.is-folder: frow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: r.marked ? Theme.accent-soft : (fta.has-hover ? Theme.zebra : transparent);
                                if r.marked: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }
                                fomenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-tb-new-file;
                                            activated => {
                                                WikiState.new-file-in(r.path);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-tb-new-folder;
                                            activated => {
                                                WikiState.new-folder-in(r.path);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-rename;
                                            activated => {
                                                WikiState.nav-folder-rename-start(r.path);
                                            }
                                        }
                                        if r.depth > 0: MenuItem {
                                            title: Strings.mem-menu-move-root;
                                            activated => {
                                                WikiState.nav-folder-move-root(r.path);
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Strings.mem-menu-delete;
                                            activated => {
                                                WikiState.nav-folder-delete(r.path);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px + r.depth * 16px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 18px;
                                            height: 100%;
                                            clip: true;
                                            Text {
                                                text: r.open ? "📂" : "📁";
                                                font-family: "Twemoji Mozilla";
                                                font-size: 12px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        if !r.renaming: Rectangle {
                                            horizontal-stretch: 1;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label + "/";
                                                color: root.tone(r.status, Theme.dim);
                                                font-size: Theme.fs-nav;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                // a cut name shows in full beside the
                                                // row (window-topmost HintTip overlay)
                                                property <bool> tip-on: fta.has-hover && !root.drag-live && self.width < self.preferred-width;
                                                // the tip generation this element owns (HintTip.show hands
                                                // it out): only its owner may clear the bubble
                                                property <int> tip-gen;
                                                changed tip-on => {
                                                    if (self.tip-on) {
                                                        self.tip-gen = HintTip.show(r.label + "/",
                                                            frow.absolute-position.x + frow.width + 8px,
                                                            frow.absolute-position.y + (frow.height - 23px) / 2);
                                                    } else {
                                                        HintTip.hide(self.tip-gen);
                                                    }
                                                }
                                            }
                                        }
                                        // inline rename: Enter commits, Escape
                                        // cancels (a fresh folder starts here)
                                        if r.renaming: FocusScope {
                                            horizontal-stretch: 1;
                                            key-pressed(event) => {
                                                if (event.text == Key.Escape) {
                                                    WikiState.nav-rename-cancel();
                                                    return accept;
                                                }
                                                reject
                                            }
                                            TextInput {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label;
                                                color: Theme.text;
                                                font-size: Theme.fs-nav;
                                                single-line: true;
                                                vertical-alignment: center;
                                                accepted => {
                                                    WikiState.nav-folder-rename-commit(r.path, self.text);
                                                }
                                                init => {
                                                    self.focus();
                                                    self.select-all();
                                                }
                                            }
                                        }
                                    }
                                    fta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            // a click that ended a drag is the
                                            // drop, not a fold toggle
                                            nav-scope.focus();
                                            if (!root.drag-was) {
                                                WikiState.nav-mark-folder(r.path);
                                                WikiState.nav-toggle-folder(r.path);
                                            }
                                            root.drag-was = false;
                                        }
                                        moved => {
                                            if (self.pressed && (root.drag-live || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                                                root.drag-live = true;
                                                root.drag-was = true;
                                                root.drag-folder = r.path;
                                                root.drag-to = max(0, idx + Math.floor(self.mouse-y / 28px));
                                            }
                                        }
                                        pointer-event(ev) => {
                                            // the TouchArea sits ABOVE the
                                            // ContextMenuArea and eats the right
                                            // click - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !root.drag-live) {
                                                fomenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                            if (ev.kind == PointerEventKind.up && root.drag-live && root.drag-folder == r.path) {
                                                WikiState.nav-folder-drop(root.drag-folder, root.drag-to);
                                                root.drag-live = false;
                                                root.drag-folder = "";
                                                root.drag-to = -1;
                                            }
                                            if (ev.kind == PointerEventKind.cancel) {
                                                root.drag-live = false;
                                                root.drag-folder = "";
                                                root.drag-to = -1;
                                            }
                                        }
                                    }
                                }
                            }

                            // ---- a file row: mark on click, open on
                            // double-click / Enter / menu, right-click menu,
                            // drag to move ----
                            if !r.is-folder: filerow := Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: parent.border-radius;
                                border-width: parent.drop-target ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                background: r.marked ? Theme.accent-soft : (ta.has-hover ? Theme.zebra : transparent);
                                clip: true;
                                if r.marked: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }
                                fmenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-menu-open;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.nav-open(r.id);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-rename;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.nav-rename-start(r.id);
                                            }
                                        }
                                        // out of its folder - the drag can
                                        // only target folders, so root needs
                                        // an explicit verb
                                        if r.depth > 0: MenuItem {
                                            title: Strings.mem-menu-move-root;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.nav-move-root(r.id);
                                            }
                                        }
                                        // pending rename/edit (2) or pending
                                        // deletion (3): back to the base state
                                        MenuItem {
                                            title: Strings.mem-menu-revert;
                                            enabled: r.status == 2 || r.status == 3;
                                            activated => {
                                                WikiState.nav-revert(r.id);
                                            }
                                        }
                                        // link markup to the clipboard, ready
                                        // to paste into any open editor
                                        MenuItem {
                                            title: Strings.mem-menu-copy-link;
                                            enabled: r.status != 3;
                                            activated => {
                                                WikiState.copy-link(r.id);
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Strings.mem-menu-delete;
                                            activated => {
                                                WikiState.nav-delete(r.id);
                                            }
                                        }
                                    }
                                    ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            // marking only — opening needs the
                                            // double-click / Enter / menu route.
                                            // A click that ended a drag is the
                                            // drop, not a mark.
                                            nav-scope.focus();
                                            if (!root.drag-was) {
                                                WikiState.nav-mark(r.id);
                                            }
                                            root.drag-was = false;
                                        }
                                        double-clicked => {
                                            WikiState.nav-open(r.id);
                                        }
                                        moved => {
                                            if (self.pressed && (root.drag-live || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6)) {
                                                root.drag-live = true;
                                                root.drag-was = true;
                                                root.drag-id = r.id;
                                                root.drag-to = max(0, idx + Math.floor(self.mouse-y / 28px));
                                            }
                                        }
                                        pointer-event(ev) => {
                                            // the row's TouchArea sits ABOVE the
                                            // ContextMenuArea and eats the right
                                            // click - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !root.drag-live) {
                                                fmenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                            if (ev.kind == PointerEventKind.up && root.drag-live && root.drag-id == r.id) {
                                                WikiState.nav-drop(root.drag-id, root.drag-to);
                                                root.drag-live = false;
                                                root.drag-id = -1;
                                                root.drag-to = -1;
                                            }
                                            if (ev.kind == PointerEventKind.cancel) {
                                                root.drag-live = false;
                                                root.drag-id = -1;
                                                root.drag-to = -1;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px + r.depth * 16px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 16px;
                                            height: 100%;
                                            clip: true;
                                            Text {
                                                text: "📄";
                                                font-family: "Twemoji Mozilla";
                                                font-size: 11px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                opacity: r.status == 3 ? 0.5 : 1.0;
                                            }
                                        }
                                        if !r.renaming: Rectangle {
                                            horizontal-stretch: 1;
                                            nlabel := Text {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label;
                                                color: root.tone(r.status, r.marked ? Theme.text : Theme.dim);
                                                font-size: Theme.fs-nav;
                                                font-weight: r.marked ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                // a cut name shows in full
                                                // beside the row — but never
                                                // while a drag is live
                                                property <bool> tip-on: ta.has-hover && !root.drag-live && self.width < self.preferred-width;
                                                // the tip generation this element owns (HintTip.show hands
                                                // it out): only its owner may clear the bubble
                                                property <int> tip-gen;
                                                changed tip-on => {
                                                    if (self.tip-on) {
                                                        self.tip-gen = HintTip.show(r.label,
                                                            filerow.absolute-position.x + filerow.width + 8px,
                                                            filerow.absolute-position.y + (filerow.height - 23px) / 2);
                                                    } else {
                                                        HintTip.hide(self.tip-gen);
                                                    }
                                                }
                                            }
                                            // a deleted file stays visible as a
                                            // pending change: struck in the bad
                                            // tone until the future patch seals
                                            if r.status == 3: Rectangle {
                                                x: 0;
                                                y: parent.height / 2;
                                                width: min(nlabel.preferred-width, parent.width);
                                                height: 1px;
                                                background: Theme.bad;
                                            }
                                        }
                                        // inline rename: Enter commits, Escape
                                        // cancels, focus is taken on creation
                                        if r.renaming: FocusScope {
                                            horizontal-stretch: 1;
                                            key-pressed(event) => {
                                                if (event.text == Key.Escape) {
                                                    WikiState.nav-rename-cancel();
                                                    return accept;
                                                }
                                                reject
                                            }
                                            rin := TextInput {
                                                width: 100%;
                                                height: 100%;
                                                text: r.label;
                                                color: Theme.text;
                                                font-size: Theme.fs-nav;
                                                single-line: true;
                                                vertical-alignment: center;
                                                accepted => {
                                                    WikiState.nav-rename-commit(r.id, self.text);
                                                }
                                                init => {
                                                    self.focus();
                                                    self.select-all();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            // ---- the draggable splitter (Slint has no built-in one) ----
            Rectangle {
                width: 8px;
                // center line, accent-lit under hover/drag
                Rectangle {
                    x: 3px;
                    width: 2px;
                    height: 100%;
                    background: sta.pressed || sta.has-hover ? Theme.accent : transparent;
                }
                // the grip pill
                Rectangle {
                    x: 2px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 30px;
                    border-radius: Theme.win95 ? 0px : 2px;
                    background: sta.pressed || sta.has-hover ? Theme.accent : Theme.line;
                }
                sta := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    moved => {
                        // mouse-x and pressed-x are both in THIS element's
                        // current frame, so their difference is exactly how
                        // far the press point drifted from the pointer —
                        // adding it to the current width re-centers the
                        // grip under the pointer and converges in one step.
                        // (A width frozen at press time double-corrects:
                        // every event undershoots by the already-applied
                        // delta and the splitter oscillates.)
                        root.split = srow.clamp-nav(srow.nav-w + (self.mouse-x - self.pressed-x)) / max(srow.avail, 1px);
                    }
                }
            }

            // ---- content: tabs, toolbar, document ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                clip: true;
                VerticalLayout {
                    // ---- the open documents as TABS, in OPEN order:
                    // clicking focuses, × closes, right-click offers the
                    // close-all/right/left sweeps. ----
                    Rectangle {
                        height: 32px;
                        background: Theme.panel-2;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;
                            alignment: start;
                            for t in WikiState.tabs: Rectangle {
                                border-radius: Theme.win95 ? 0px : 5px;
                                background: t.active ? Theme.panel
                                    : (tab-ta.has-hover ? Theme.raised : transparent);
                                border-width: t.active ? Theme.border-w : 0px;
                                border-color: Theme.accent;
                                tmenu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Strings.mem-menu-close-all;
                                            activated => {
                                                WikiState.tab-close-all();
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-right;
                                            activated => {
                                                WikiState.tab-close-right(t.id);
                                            }
                                        }
                                        MenuItem {
                                            title: Strings.mem-menu-close-left;
                                            activated => {
                                                WikiState.tab-close-left(t.id);
                                            }
                                        }
                                    }
                                    tab-ta := TouchArea {
                                        clicked => {
                                            WikiState.tab-focus(t.id);
                                        }
                                        pointer-event(ev) => {
                                            // same right-click starvation as the
                                            // nav rows - open the menu explicitly
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                tmenu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                    }
                                    // padding-based row (no x-anchored child):
                                    // the layout's preferred width IS the tab
                                    // width, so the × always sits inside
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 3px;
                                        spacing: 4px;
                                        Text {
                                            text: t.label;
                                            color: root.tone(t.status, t.active ? Theme.text : Theme.dim);
                                            font-size: Theme.fs-cap;
                                            font-weight: t.active ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 16px * Theme.ui-scale;
                                            Text {
                                                text: "×";
                                                color: close-ta.has-hover ? Theme.bad : Theme.faint;
                                                font-size: Theme.fs-body;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            close-ta := TouchArea {
                                                clicked => {
                                                    WikiState.tab-close(t.id);
                                                }
                                                pointer-event(ev) => {
                                                    // the x is inside the menu
                                                    // area too - map into its
                                                    // coordinates via absolute
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        tmenu.show({
                                                            x: self.absolute-position.x - tmenu.absolute-position.x + self.mouse-x,
                                                            y: self.absolute-position.y - tmenu.absolute-position.y + self.mouse-y,
                                                        });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height - Theme.border-w;
                            width: parent.width;
                            height: Theme.border-w;
                            background: Theme.line;
                        }
                    }
                    ToolStrip {
                        // ⬅️/➡️ — walk the OPEN TABS in strip order,
                        // wrapping; deliberately leaves the navigator mark
                        // behind, which arms 🎯
                        ToolBtn {
                            glyph: "⬅️";
                            name: Strings.mem-tb-prev;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(-1);
                            }
                        }
                        ToolBtn {
                            glyph: "➡️";
                            name: Strings.mem-tb-next;
                            enabled: WikiState.tabs.length > 1;
                            clicked => {
                                WikiState.tab-step(1);
                            }
                        }
                        Rectangle {
                            width: 4px;
                        }
                        // the open file's path is the strip's breadcrumb;
                        // its tone mirrors the pending-change state
                        Text {
                            text: WikiState.doc-open ? WikiState.doc-path : "";
                            color: root.tone(WikiState.doc-status, Theme.faint);
                            font-size: Theme.fs-cap;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // ✏️/👁️ — pretty preview ⇄ raw .md source
                        ToolBtn {
                            glyph: WikiState.editing ? "👁️" : "✏️";
                            name: WikiState.editing ? Strings.mem-tb-preview : Strings.mem-tb-edit;
                            enabled: WikiState.doc-open;
                            clicked => {
                                WikiState.edit-toggle();
                            }
                        }
                        // the open file changed vs base: a plain hint plus
                        // its own revert — the numeric summary lives in the
                        // changeset panel, not here
                        if WikiState.doc-status == 2: Text {
                            text: Strings.mem-changed-hint;
                            color: Theme.warn;
                            font-size: Theme.fs-cap;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if WikiState.doc-status == 2: ToolBtn {
                            glyph: "↩️";
                            name: Strings.mem-tb-revert-doc;
                            enabled: true;
                            clicked => {
                                WikiState.revert-active();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // 🎯 — re-align the navigator with the active tab;
                        // armed only while they diverge
                        ToolBtn {
                            glyph: "🎯";
                            name: Strings.mem-tb-locate;
                            enabled: WikiState.can-reveal;
                            clicked => {
                                WikiState.reveal();
                            }
                        }
                        // 📋 — copy the document's path
                        ToolBtn {
                            glyph: "📋";
                            name: Strings.mem-tb-link;
                            enabled: WikiState.doc-open;
                            clicked => {
                                root.copy-path(WikiState.doc-path);
                            }
                        }
                        // ⚙️ — the app settings (font sizes live there)
                        ToolBtn {
                            glyph: "⚙️";
                            name: Strings.tip-settings;
                            enabled: true;
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                    if WikiState.doc-open && !WikiState.editing: ScrollBody {
                        pad: 16px;
                        gap: 8px;
                        // author · version · age — the note-footer idiom
                        Text {
                            text: WikiState.doc-meta;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        // a click on the document body opens the markdown
                        // editor — the preview reads, one click writes.
                        // The edit TouchArea sits UNDER the block view so
                        // a link's own TouchArea wins its click.
                        for b in WikiState.blocks: Rectangle {
                            height: bv.preferred-height;
                            TouchArea {
                                mouse-cursor: MouseCursor.text;
                                clicked => {
                                    WikiState.edit-toggle();
                                }
                            }
                            bv := BrainBlockView {
                                width: 100%;
                                b: b;
                            }
                        }
                        // cross-links — what makes the tree a wiki. One
                        // chip per line: paths are long and the chips
                        // neither wrap nor elide, so a row would clip at
                        // the content pane's minimum width.
                        if WikiState.links.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 6px;
                            Rectangle {
                                height: Theme.border-w;
                                background: Theme.line;
                            }
                            Text {
                                text: Strings.mem-linked;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            for l in WikiState.links: HorizontalLayout {
                                alignment: start;
                                TagChip {
                                    glyph: "🔗";
                                    label: l;
                                }
                            }
                        }
                    }
                    // raw-markdown mode: the same document as editable .md
                    // source. The buffer PERSISTS in the model across
                    // switches — every keystroke lands in the pending
                    // change set (that is what the colors track).
                    if WikiState.doc-open && WikiState.editing: Rectangle {
                        vertical-stretch: 1;
                        // Escape leaves the raw editor back to the preview:
                        // the inner TextInput rejects the key, so it
                        // bubbles up here (the inline-rename pattern)
                        FocusScope {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    WikiState.edit-toggle();
                                    return accept;
                                }
                                reject
                            }
                            AppArea {
                                width: 100%;
                                height: 100%;
                                font-size: Theme.fs-editor;
                                text <=> WikiState.raw;
                                changed text => {
                                    WikiState.edited(self.text);
                                }
                                init => {
                                    // click-to-edit lands typing-ready —
                                    // and focused, Escape reaches us
                                    self.focus-input();
                                }
                            }
                        }
                    }
                    // no open tab — the honest empty state
                    if !WikiState.doc-open: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: Strings.mem-empty;
                            color: Theme.faint;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

}

// ---------------------------------------------------------------------------
// Quests — the planning Kanban (kanban_workflows.md §6)
// ---------------------------------------------------------------------------

// One board item: epic (kind 0) / story (1) / task (2). `points` of an epic
// is the precomputed descendant roll-up (`rollup: true`); `overdue` is
// precomputed sample state (due < "today", a local-clock rendering).
struct MockItem {
    id: string, // 8-hex display form of the 128-bit item id
    kind: int, // 0 epic · 1 story · 2 task
    title: string,
    parent: string, // parent item id ("" = none)
    responsible: string, // exactly one roster seat
    start: string, // ISO YYYY-MM-DD
    due: string,
    overdue: bool,
    points: int,
    rollup: bool, // points are the epic roll-up (rendered muted)
    prio: int, // 0 low · 1 normal · 2 high · 3 critical
    sprint: string, // sprint name ("" = unscheduled)
    pi: string, // program-increment label (epics)
    status: int, // 0 backlog · 1 ready · 2 doing · 3 review · 4 done
    details: string,
    ready: string, // Definition of Ready ("" = none)
    done-crit: string, // acceptance criteria
    scope: string, // explicitly out of scope
    deps: [string], // item ids this depends on
    refs: [string], // wiki pages citing this item (backlink paths)
}

// One governed sprint row; `off`/`len` are the precomputed day offsets on
// the Planning axis (2026-08-01 = day 0).
struct MockSprintRow {
    id: string,
    name: string,
    start: string,
    end: string,
    pi: string,
    points: int, // committed points (precomputed sum)
    current: bool,
    off: int,
    len: int,
}

// One timeline bar of the Planning view: `i` indexes the pane's flat item
// table, `level` is the indent depth (epic 0 / story 1 / task 2).
struct MockPlanBar {
    i: int,
    level: int,
    off: int,
    len: int,
}

// One closed item of the Archive.
struct MockClosed {
    id: string,
    kind: int,
    title: string,
    responsible: string,
    closed: string, // ISO close date
    done: bool, // true = done · false = dropped
    points: int, // 0 = none shown (epics store no points)
}

// A fixed Twemoji clip box (the nav-row idiom): an oversized emoji glyph
// must never bleed into its neighbours.
component KGlyph inherits Rectangle {
    in property <string> glyph;
    width: 18px;
    height: 20px;
    clip: true;
    Text {
        text: root.glyph;
        font-family: "Twemoji Mozilla";
        font-size: 13px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component KanbanCard inherits Rectangle {
    in property <MockItem> it;
    callback clicked();
    // formatting twins of the QuestsPane helpers (a component cannot reach
    // its instantiator's functions)
    pure function kind-glyph(k: int) -> string {
        return k == 0 ? "🏔️" : (k == 1 ? "📘" : "🔧");
    }
    pure function prio-label(p: int) -> string {
        return p == 3 ? Strings.kb-prio-critical
            : (p == 2 ? Strings.kb-prio-high
            : (p == 1 ? Strings.kb-prio-normal : Strings.kb-prio-low));
    }
    pure function prio-tone(p: int) -> color {
        return p == 3 ? Theme.bad
            : (p == 2 ? Theme.warn : (p == 1 ? Theme.accent : Theme.faint));
    }
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    // the done column keeps the finished-work opacity idiom
    opacity: root.it.status == 4 ? 0.62 : 1.0;
    VerticalLayout {
        padding: 11px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 6px;
            KGlyph {
                glyph: root.kind-glyph(root.it.kind);
            }
            Text {
                text: root.it.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            TagChip {
                glyph: "👤";
                label: root.it.responsible;
            }
            TagChip {
                label: "\{root.it.points} pt";
                muted: root.it.rollup;
            }
            TagChip {
                label: root.prio-label(root.it.prio);
                tone: root.prio-tone(root.it.prio);
                muted: root.it.prio == 0;
            }
            if root.it.sprint != "": TagChip {
                label: root.it.sprint;
                muted: true;
            }
        }
        GlyphCaption {
            glyph: "🗓️";
            label: "\{root.it.start} → \{root.it.due}";
            tone: root.it.overdue ? Theme.bad : Theme.faint;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One board column: DotLabel header + visible count over the scrolling card
// list. `idxs` indexes the pane's flat item table (pre-sorted by priority
// desc, due asc, id asc — §3.4); the kind/mine filters are pure view-state.
component KanbanColumn inherits Rectangle {
    in property <string> title;
    in property <color> tone;
    in property <[MockItem]> all;
    in property <[int]> idxs;
    in property <bool> f-epic: true;
    in property <bool> f-story: true;
    in property <bool> f-task: true;
    in property <bool> f-mine: false;
    in property <string> me;
    callback pick(int);
    pure function vis(it: MockItem) -> bool {
        return (it.kind == 0 ? root.f-epic : (it.kind == 1 ? root.f-story : root.f-task))
            && (!root.f-mine || it.responsible == root.me);
    }
    pure function vis-at(k: int) -> bool {
        return k < root.idxs.length && root.vis(root.all[root.idxs[k]]);
    }
    // guarded index sum — the sample columns hold at most 5 items
    property <int> shown: (root.vis-at(0) ? 1 : 0) + (root.vis-at(1) ? 1 : 0)
        + (root.vis-at(2) ? 1 : 0) + (root.vis-at(3) ? 1 : 0) + (root.vis-at(4) ? 1 : 0);
    horizontal-stretch: 1;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    clip: true;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            DotLabel {
                tone: root.tone;
                label: root.title;
                label-size: Theme.fs-cap;
                label-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "\{root.shown}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            cfl := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: clist.preferred-height;
                clist := VerticalLayout {
                    spacing: 0;
                    alignment: start;
                    // a repeater cannot carry an `if` directly — a filtered
                    // card collapses instead (visible off + zero height; the
                    // 8px list gap rides inside the wrapper)
                    for i in root.idxs: Rectangle {
                        property <bool> on: root.vis(root.all[i]);
                        visible: self.on;
                        height: self.on ? kc.preferred-height + 8px : 0px;
                        clip: true;
                        kc := KanbanCard {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: self.preferred-height;
                            it: root.all[i];
                            clicked => {
                                root.pick(i);
                            }
                        }
                    }
                }
            }
            ScrollHint {
                x: parent.width - 5px;
                view-h: cfl.height;
                content-h: cfl.viewport-height;
                scroll-y: cfl.viewport-y;
            }
        }
    }
}

// A caption/value pair of the drill-in meta grid.
component KMeta inherits HorizontalLayout {
    in property <string> cap;
    in property <string> val;
    in property <color> val-color: Theme.text;
    spacing: 8px;
    horizontal-stretch: 1;
    Text {
        text: root.cap;
        color: Theme.dim;
        font-size: Theme.fs-cap;
        width: 92px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.val;
        color: root.val-color;
        font-size: Theme.fs-body;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// A drill-in template section: dim fs-cap heading over the body text.
component KSection inherits VerticalLayout {
    in property <string> cap;
    in property <string> body;
    spacing: 3px;
    Text {
        text: root.cap;
        color: Theme.dim;
        font-size: Theme.fs-cap;
        font-weight: 600;
    }
    Text {
        text: root.body;
        color: Theme.text;
        font-size: Theme.fs-body;
        wrap: word-wrap;
    }
}

// A chip-styled view-state toggle (the Create form's priority selector).
component KChipToggle inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.accent;
    in property <bool> active: false;
    callback clicked();
    background: root.active ? root.tone.transparentize(0.84) : transparent;
    border-radius: Theme.win95 ? 0px : 4px;
    border-width: root.active ? 0px : 1px;
    border-color: Theme.line;
    width: kt.preferred-width + 16px;
    height: 26px * Theme.ui-scale;
    kt := Text {
        x: 8px;
        height: 100%;
        text: root.label;
        color: root.active ? (Theme.win95 ? Theme.text : root.tone) : Theme.faint;
        font-size: 11px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A captioned form slot (fs-cap caption over the field — the create idiom).
component FormSlot inherits VerticalLayout {
    in property <string> cap;
    spacing: 4px;
    horizontal-stretch: 1;
    Text {
        text: root.cap;
        color: Theme.dim;
        font-size: Theme.fs-cap;
    }
    @children
}

// One row of the Mine view: the item plus the honest next act (disabled).
component MineRow inherits Rectangle {
    in property <MockItem> it;
    in property <int> act; // 0 none · 1 propose review · 2 propose done
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 11px;
        spacing: 10px;
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            Text {
                text: root.it.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                cross-axis-alignment: center;
                GlyphCaption {
                    glyph: "🗓️";
                    label: "\{root.it.start} → \{root.it.due}";
                    tone: root.it.overdue ? Theme.bad : Theme.faint;
                }
                TagChip {
                    label: "\{root.it.points} pt";
                    muted: true;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            if root.act > 0: AppButton {
                label: root.act == 1 ? Strings.kb-mv-review : Strings.kb-mv-done;
                enabled: false;
                tooltip: Strings.not-implemented-yet;
                tooltip-left: true;
            }
        }
    }
}

export component QuestsPane inherits VerticalLayout {
    in property <string> view;
    spacing: 8px;

    // -- sample data — design mock only, never engine state -----------------
    // One coherent dataset (kanban_workflows.md §6.1): cast petra (the local
    // member), walter, mara, jonas; "today" is 2026-08-16.
    property <[MockItem]> all-items: [
        { id: "3fa1c802", kind: 0, title: "Public onboarding path", responsible: "petra", start: "2026-08-05", due: "2026-10-09", points: 16, rollup: true, prio: 2, pi: "PI-3", status: 2, details: "Everything a newcomer needs from invite to first vote." },
        { id: "9b04d1ee", kind: 0, title: "Treasury operations", responsible: "walter", start: "2026-08-17", due: "2026-11-20", points: 11, rollup: true, prio: 1, pi: "PI-3", status: 1, details: "Running the treasury day to day: multisig, runbooks, drills." },
        { id: "51c2ab07", kind: 1, title: "Onboarding guide v1", parent: "3fa1c802", responsible: "mara", start: "2026-08-17", due: "2026-08-28", points: 8, prio: 2, sprint: "S9", status: 1, details: "Turn the reading list into a guided path - see [onboarding](guides/onboarding.md).", ready: "Reading list curated (#20d5b3a1 done); guide skeleton agreed in chat.", done-crit: "A new member reaches their first signed proposal with no help beyond the guide.", scope: "No video material; no translation.", refs: ["guides/onboarding.md"] },
        { id: "7e99f0c4", kind: 1, title: "Invite flow dry-run", parent: "3fa1c802", responsible: "jonas", start: "2026-08-05", due: "2026-08-16", points: 5, prio: 1, sprint: "S8", status: 3, details: "Walk a fresh invite end to end and note every rough edge." },
        { id: "20d5b3a1", kind: 1, title: "Reading list curation", parent: "3fa1c802", responsible: "petra", start: "2026-08-05", due: "2026-08-14", points: 3, prio: 1, sprint: "S8", status: 4, details: "Pick the ten documents a newcomer actually needs." },
        { id: "c4188e5b", kind: 1, title: "Multisig runbook", parent: "9b04d1ee", responsible: "walter", start: "2026-08-31", due: "2026-09-11", points: 8, prio: 1, sprint: "S10", status: 0, details: "Step-by-step multisig operations for treasury signers." },
        { id: "aa07c9d3", kind: 2, title: "Draft chapter: first signed proposal", parent: "51c2ab07", responsible: "mara", start: "2026-08-17", due: "2026-08-21", points: 3, prio: 2, sprint: "S9", status: 1, details: "The guide chapter that ends in a first signed proposal." },
        { id: "5f31e6b8", kind: 2, title: "Screenshots per surface", parent: "51c2ab07", responsible: "jonas", start: "2026-08-17", due: "2026-08-26", points: 2, prio: 1, sprint: "S9", status: 0, details: "One current screenshot per surface for the guide.", deps: ["aa07c9d3"] },
        { id: "0b6d42f7", kind: 2, title: "Recovery drill notes", parent: "7e99f0c4", responsible: "jonas", start: "2026-08-11", due: "2026-08-16", points: 3, prio: 1, sprint: "S8", status: 2, details: "Notes from the recovery drill, ready for the runbook.", refs: ["runbooks/node-recovery.md"] },
        { id: "d17f30c5", kind: 2, title: "Charter FAQ draft", parent: "51c2ab07", responsible: "petra", start: "2026-08-12", due: "2026-08-16", points: 2, prio: 1, sprint: "S8", status: 2, details: "Short answers to the questions every charter reader asks." },
        { id: "6c25a984", kind: 2, title: "Glossary pass", responsible: "petra", start: "2026-09-01", due: "2026-09-05", points: 2, prio: 0, status: 0, details: "Align glossary terms across guide and charter." },
        { id: "e3b8071d", kind: 2, title: "Second relay checklist", parent: "c4188e5b", responsible: "walter", start: "2026-08-31", due: "2026-09-04", points: 3, prio: 2, sprint: "S10", status: 1, details: "What the second relay needs before it joins the pool." },
        { id: "4a90cc16", kind: 2, title: "Emblem vector cleanup", responsible: "mara", start: "2026-08-10", due: "2026-08-15", overdue: true, points: 1, prio: 0, sprint: "S8", status: 3, details: "Clean paths and export the emblem in three sizes." },
    ];
    // per-column index lists into `all-items`, pre-sorted (§3.4: priority
    // desc, due asc, id asc)
    property <[int]> col-backlog: [7, 5, 10];
    property <[int]> col-ready: [6, 2, 11, 1];
    property <[int]> col-doing: [0, 8, 9];
    property <[int]> col-review: [3, 12];
    property <[int]> col-done: [4];
    // sprints (§6.1), day offsets on the Planning axis (2026-08-01 = day 0);
    // `points` is the straight sum of the items scheduled into the sprint
    property <[MockSprintRow]> sprints: [
        { id: "b41a77d0", name: "S8", start: "2026-08-05", end: "2026-08-16", pi: "PI-3", points: 14, current: true, off: 4, len: 12 },
        { id: "5b28c9e1", name: "S9", start: "2026-08-17", end: "2026-08-28", pi: "PI-3", points: 13, off: 16, len: 12 },
        { id: "c93d10f2", name: "S10", start: "2026-08-31", end: "2026-09-11", pi: "PI-3", points: 11, off: 30, len: 12 },
    ];
    // timeline rows: epics first, then stories, then tasks (§6.3); a bar
    // whose due date passes the axis clips with the edge glyph
    property <[MockPlanBar]> plan-bars: [
        { i: 0, level: 0, off: 4, len: 66 },
        { i: 1, level: 0, off: 16, len: 96 },
        { i: 2, level: 1, off: 16, len: 12 },
        { i: 3, level: 1, off: 4, len: 12 },
        { i: 4, level: 1, off: 4, len: 10 },
        { i: 5, level: 1, off: 30, len: 12 },
        { i: 6, level: 2, off: 16, len: 5 },
        { i: 7, level: 2, off: 16, len: 10 },
        { i: 8, level: 2, off: 10, len: 6 },
        { i: 9, level: 2, off: 11, len: 5 },
        { i: 11, level: 2, off: 30, len: 5 },
        { i: 12, level: 2, off: 9, len: 6 },
    ];
    // Mine: petra's open story/task items by status (done/closed omitted)
    property <[int]> mine-doing: [9];
    property <[int]> mine-backlog: [10];
    // Archive: closed items, newest first
    property <[MockClosed]> closed-items: [
        { id: "77b2f4d9", kind: 2, title: "Treasury multisig setup", responsible: "walter", closed: "2026-07-14", done: true, points: 5 },
        { id: "1e8ca6f3", kind: 1, title: "Old reading list", responsible: "petra", closed: "2026-07-02", done: false, points: 3 },
        { id: "b5d30f28", kind: 0, title: "Found the republic", responsible: "petra", closed: "2026-04-12", done: true, points: 0 },
    ];

    // -- view state ---------------------------------------------------------
    property <int> selected-item: -1; // board drill-in (index into all-items)
    property <bool> f-epic: true; // board kind filters
    property <bool> f-story: true;
    property <bool> f-task: true;
    property <bool> f-mine: false;
    property <int> c-kind: 2; // create form: 0 epic · 1 story · 2 task
    property <int> c-prio: 1;

    // -- formatting helpers -------------------------------------------------
    pure function kind-glyph(k: int) -> string {
        return k == 0 ? "🏔️" : (k == 1 ? "📘" : "🔧");
    }
    pure function prio-label(p: int) -> string {
        return p == 3 ? Strings.kb-prio-critical
            : (p == 2 ? Strings.kb-prio-high
            : (p == 1 ? Strings.kb-prio-normal : Strings.kb-prio-low));
    }
    pure function prio-tone(p: int) -> color {
        return p == 3 ? Theme.bad
            : (p == 2 ? Theme.warn : (p == 1 ? Theme.accent : Theme.faint));
    }
    pure function status-label(s: int) -> string {
        return s == 0 ? Strings.kb-col-backlog
            : (s == 1 ? Strings.kb-col-ready
            : (s == 2 ? Strings.kb-col-doing
            : (s == 3 ? Strings.kb-col-review : Strings.kb-col-done)));
    }
    pure function status-tone(s: int) -> color {
        return s == 0 ? Theme.faint
            : (s == 1 ? Theme.accent
            : (s == 2 ? Theme.warn : (s == 3 ? Theme.moved : Theme.good)));
    }
    // flat index of a sample item id (-1 = unknown) — sample-side lookup,
    // the fold will own resolution once the surface is real
    pure function idx-of(id: string) -> int {
        return id == "3fa1c802" ? 0
            : (id == "9b04d1ee" ? 1
            : (id == "51c2ab07" ? 2
            : (id == "7e99f0c4" ? 3
            : (id == "20d5b3a1" ? 4
            : (id == "c4188e5b" ? 5
            : (id == "aa07c9d3" ? 6
            : (id == "5f31e6b8" ? 7
            : (id == "0b6d42f7" ? 8
            : (id == "d17f30c5" ? 9
            : (id == "6c25a984" ? 10
            : (id == "e3b8071d" ? 11
            : (id == "4a90cc16" ? 12 : -1))))))))))));
    }
    // the one linked sample body, hand-segmented so the markdown link
    // renders as an accent span (static in the mock — §6.2); Slint has no
    // string parsing, and the sample is fixed
    pure function d-link(id: string) -> string {
        return id == "51c2ab07" ? "onboarding" : "";
    }
    pure function d-pre(id: string) -> string {
        return id == "51c2ab07" ? "Turn the reading list into a guided path - see" : "";
    }
    pure function d-post(id: string) -> string {
        return id == "51c2ab07" ? "." : "";
    }

    // -- Board: the five columns -------------------------------------------
    if root.view == "board" && root.selected-item < 0: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        PaneHeader {
            glyph: "📋";
            title: Strings.kb-title-board;
            hint: Strings.kb-hint-board;
        }
        ToolStrip {
            ToolBtn {
                glyph: "🏔️";
                name: Strings.kb-kind-epic;
                enabled: true;
                active: root.f-epic;
                clicked => {
                    root.f-epic = !root.f-epic;
                }
            }
            ToolBtn {
                glyph: "📘";
                name: Strings.kb-kind-story;
                enabled: true;
                active: root.f-story;
                clicked => {
                    root.f-story = !root.f-story;
                }
            }
            ToolBtn {
                glyph: "🔧";
                name: Strings.kb-kind-task;
                enabled: true;
                active: root.f-task;
                clicked => {
                    root.f-task = !root.f-task;
                }
            }
            Rectangle {
                width: 4px;
            }
            ToolBtn {
                glyph: "🎯";
                name: Strings.kb-title-mine;
                enabled: true;
                active: root.f-mine;
                clicked => {
                    root.f-mine = !root.f-mine;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            KanbanColumn {
                title: Strings.kb-col-backlog;
                tone: Theme.faint;
                all: root.all-items;
                idxs: root.col-backlog;
                f-epic: root.f-epic;
                f-story: root.f-story;
                f-task: root.f-task;
                f-mine: root.f-mine;
                me: "petra";
                pick(i) => {
                    root.selected-item = i;
                }
            }
            KanbanColumn {
                title: Strings.kb-col-ready;
                tone: Theme.accent;
                all: root.all-items;
                idxs: root.col-ready;
                f-epic: root.f-epic;
                f-story: root.f-story;
                f-task: root.f-task;
                f-mine: root.f-mine;
                me: "petra";
                pick(i) => {
                    root.selected-item = i;
                }
            }
            KanbanColumn {
                title: Strings.kb-col-doing;
                tone: Theme.warn;
                all: root.all-items;
                idxs: root.col-doing;
                f-epic: root.f-epic;
                f-story: root.f-story;
                f-task: root.f-task;
                f-mine: root.f-mine;
                me: "petra";
                pick(i) => {
                    root.selected-item = i;
                }
            }
            KanbanColumn {
                title: Strings.kb-col-review;
                tone: Theme.moved;
                all: root.all-items;
                idxs: root.col-review;
                f-epic: root.f-epic;
                f-story: root.f-story;
                f-task: root.f-task;
                f-mine: root.f-mine;
                me: "petra";
                pick(i) => {
                    root.selected-item = i;
                }
            }
            KanbanColumn {
                title: Strings.kb-col-done;
                tone: Theme.good;
                all: root.all-items;
                idxs: root.col-done;
                f-epic: root.f-epic;
                f-story: root.f-story;
                f-task: root.f-task;
                f-mine: root.f-mine;
                me: "petra";
                pick(i) => {
                    root.selected-item = i;
                }
            }
        }
    }

    // -- Board: the drill-in (replaces the columns, in-pane) ----------------
    if root.view == "board" && root.selected-item >= 0: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        PaneHeader {
            glyph: "📋";
            title: Strings.kb-title-board;
            hint: Strings.kb-hint-board;
        }
        ToolStrip {
            ToolBtn {
                glyph: "⬅️";
                name: Strings.kb-back;
                enabled: true;
                clicked => {
                    root.selected-item = -1;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        dv := PanePanel {
            property <MockItem> sel: root.all-items[root.selected-item];
            // title row: kind glyph + title + id caption + status
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;
                KGlyph {
                    glyph: root.kind-glyph(dv.sel.kind);
                }
                Text {
                    text: dv.sel.title;
                    color: Theme.text;
                    font-size: Theme.fs-h2;
                    font-weight: 700;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "#\{dv.sel.id}";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                }
                DotLabel {
                    tone: root.status-tone(dv.sel.status);
                    label: root.status-label(dv.sel.status);
                    label-size: Theme.fs-cap;
                    label-weight: 700;
                }
            }
            // meta grid
            HorizontalLayout {
                spacing: 8px;
                KMeta {
                    cap: Strings.kb-f-resp;
                    val: dv.sel.responsible;
                }
                KMeta {
                    cap: Strings.kb-f-start;
                    val: dv.sel.start;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                KMeta {
                    cap: Strings.kb-f-due;
                    val: dv.sel.due;
                    val-color: dv.sel.overdue ? Theme.bad : Theme.text;
                }
                KMeta {
                    cap: Strings.kb-f-points;
                    val: dv.sel.rollup ? "\{dv.sel.points} pt · \{Strings.kb-rollup}" : "\{dv.sel.points} pt";
                }
            }
            HorizontalLayout {
                spacing: 8px;
                KMeta {
                    cap: Strings.kb-f-prio;
                    val: root.prio-label(dv.sel.prio);
                    val-color: root.prio-tone(dv.sel.prio);
                }
                KMeta {
                    cap: dv.sel.kind == 0 ? Strings.kb-f-pi : Strings.kb-f-sprint;
                    val: dv.sel.kind == 0 ? (dv.sel.pi == "" ? "-" : dv.sel.pi)
                        : (dv.sel.sprint == "" ? "-" : dv.sel.sprint);
                }
            }
            // parent — clickable, selects the parent item
            if dv.sel.parent != "": HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Strings.kb-f-parent;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    width: 92px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                pl := Rectangle {
                    width: plt.preferred-width + 4px;
                    height: plt.preferred-height + 2px;
                    border-radius: 3px;
                    background: pl-ta.has-hover ? Theme.accent-soft : transparent;
                    plt := Text {
                        x: 2px;
                        text: "#\{dv.sel.parent} · \{root.all-items[root.idx-of(dv.sel.parent)].title}";
                        color: Theme.accent;
                        font-size: Theme.fs-body;
                    }
                    pl-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if (root.idx-of(dv.sel.parent) >= 0) {
                                root.selected-item = root.idx-of(dv.sel.parent);
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            // dependencies — id chips, muted when the id is unknown
            if dv.sel.deps.length > 0: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Strings.kb-f-deps;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    width: 92px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    horizontal-stretch: 1;
                    for d in dv.sel.deps: TagChip {
                        label: "#\{d}";
                        muted: root.idx-of(d) < 0;
                    }
                }
            }
            // children of an epic/story: status dot + title + responsible
            // (a repeater cannot carry an `if` — foreign rows collapse)
            if dv.sel.kind != 2: VerticalLayout {
                spacing: 0;
                for c[ci] in root.all-items: Rectangle {
                    property <bool> on: c.parent == dv.sel.id;
                    visible: self.on;
                    height: self.on ? 28px : 0px;
                    border-radius: Theme.win95 ? 0px : 4px;
                    background: ch-ta.has-hover ? Theme.raised : transparent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: root.status-tone(c.status);
                        }
                        Text {
                            text: c.title;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: c.responsible;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                        }
                    }
                    ch-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.selected-item = ci;
                        }
                    }
                }
            }
            // template sections; the one linked body renders its link as an
            // accent span (SpanFlow's stacked-runs idiom, static here)
            if root.d-link(dv.sel.id) == "": KSection {
                cap: Strings.kb-sec-details;
                body: dv.sel.details;
            }
            if root.d-link(dv.sel.id) != "": VerticalLayout {
                spacing: 3px;
                Text {
                    text: Strings.kb-sec-details;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    font-weight: 600;
                }
                Text {
                    text: root.d-pre(dv.sel.id);
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 0;
                    alignment: start;
                    dl := Rectangle {
                        width: dlt.preferred-width + 4px;
                        height: dlt.preferred-height;
                        border-radius: 3px;
                        dlt := Text {
                            x: 2px;
                            text: root.d-link(dv.sel.id);
                            color: Theme.accent;
                            font-size: Theme.fs-body;
                        }
                        Rectangle {
                            x: 2px;
                            y: parent.height - 1px;
                            width: parent.width - 4px;
                            height: 1px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: root.d-post(dv.sel.id);
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                    }
                }
            }
            if dv.sel.ready != "": KSection {
                cap: Strings.kb-sec-ready;
                body: dv.sel.ready;
            }
            if dv.sel.done-crit != "": KSection {
                cap: Strings.kb-sec-done;
                body: dv.sel.done-crit;
            }
            if dv.sel.scope != "": KSection {
                cap: Strings.kb-sec-scope;
                body: dv.sel.scope;
            }
            // wiki backlinks (computed on read once real — §4)
            if dv.sel.refs.length > 0: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Strings.kb-f-refs;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    width: 92px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    horizontal-stretch: 1;
                    for r in dv.sel.refs: Text {
                        text: r;
                        color: Theme.accent;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                AppButton {
                    emoji: "📋";
                    label: Strings.kb-propose-change;
                    primary: true;
                    enabled: false;
                    tooltip: Strings.not-implemented-yet;
                }
            }
        }
    }

    // -- Planning: sprints + timeline ---------------------------------------
    if root.view == "plan": VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        PaneHeader {
            glyph: "🗓️";
            title: Strings.kb-title-plan;
            hint: Strings.kb-hint-plan;
        }
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            // sprint list
            VerticalLayout {
                width: 240px;
                spacing: 8px;
                alignment: start;
                for sp in root.sprints: Rectangle {
                    background: Theme.panel-2;
                    border-radius: Theme.win95 ? 0px : 8px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: sp.name;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                                font-weight: 700;
                                horizontal-stretch: 1;
                            }
                            if sp.current: DotLabel {
                                tone: Theme.good;
                                label: Strings.kb-current;
                                label-size: Theme.fs-cap;
                            }
                        }
                        Text {
                            text: "\{sp.start} → \{sp.end}";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "\{sp.points} pt \{Strings.kb-committed}";
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                horizontal-stretch: 1;
                            }
                            TagChip {
                                label: sp.pi;
                                muted: true;
                            }
                        }
                    }
                }
            }
            // timeline: axis 2026-08-01..2026-09-30 (60 days)
            PanePanel {
                pb := Rectangle {
                    property <length> ppd: max(0px, (self.width - 160px) / 60);
                    height: tl-content.preferred-height;
                    // sprint labels on top …
                    for sp in root.sprints: Text {
                        x: 160px + sp.off * pb.ppd + 3px;
                        y: 0px;
                        height: 16px;
                        text: sp.name;
                        color: Theme.faint;
                        font-size: Theme.fs-cap;
                    }
                    // … and their boundary hairlines underneath
                    for sp in root.sprints: Rectangle {
                        x: 160px + sp.off * pb.ppd;
                        y: 16px;
                        width: 1px;
                        height: parent.height - 16px;
                        background: Theme.line;
                    }
                    for sp in root.sprints: Rectangle {
                        x: 160px + (sp.off + sp.len) * pb.ppd;
                        y: 16px;
                        width: 1px;
                        height: parent.height - 16px;
                        background: Theme.line;
                    }
                    tl-content := VerticalLayout {
                        width: 100%;
                        Rectangle {
                            height: 16px;
                        }
                        for b in root.plan-bars: HorizontalLayout {
                            height: 24px;
                            spacing: 0;
                            Rectangle {
                                width: 160px;
                                Text {
                                    x: b.level * 12px;
                                    width: parent.width - b.level * 12px;
                                    height: 100%;
                                    text: root.all-items[b.i].title;
                                    color: Theme.dim;
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                // epic: soft accent block; story/task: thin
                                // bar in the status-column tone
                                Rectangle {
                                    x: b.off * pb.ppd;
                                    y: (parent.height - self.height) / 2;
                                    width: max(0, min(b.len, 60 - b.off)) * pb.ppd;
                                    height: root.all-items[b.i].kind == 0 ? 14px : 8px;
                                    border-radius: Theme.win95 ? 0px : 3px;
                                    border-width: root.all-items[b.i].kind == 0 ? 1px : 0px;
                                    border-color: Theme.accent;
                                    background: root.all-items[b.i].kind == 0
                                        ? Theme.accent-soft
                                        : root.status-tone(root.all-items[b.i].status);
                                }
                                // a due date past the axis clips with the
                                // edge glyph
                                if b.off + b.len > 60: Text {
                                    x: parent.width - self.preferred-width - 2px;
                                    height: 100%;
                                    text: "→";
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "\{Strings.kb-unscheduled}: #\{root.all-items[10].id} \{root.all-items[10].title}";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                }
            }
        }
    }

    // -- Create -------------------------------------------------------------
    if root.view == "create": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "✨";
            title: Strings.kb-title-create;
            hint: Strings.kb-hint-create;
        }
        PanePanel {
            // kind selector (view-state): epic hides points and swaps
            // sprint for PI
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                AppButton {
                    label: Strings.kb-kind-epic;
                    pad: 10px;
                    primary: root.c-kind == 0;
                    clicked => {
                        root.c-kind = 0;
                    }
                }
                AppButton {
                    label: Strings.kb-kind-story;
                    pad: 10px;
                    primary: root.c-kind == 1;
                    clicked => {
                        root.c-kind = 1;
                    }
                }
                AppButton {
                    label: Strings.kb-kind-task;
                    pad: 10px;
                    primary: root.c-kind == 2;
                    clicked => {
                        root.c-kind = 2;
                    }
                }
            }
            AppField {
                placeholder: Strings.kb-ph-title;
            }
            HorizontalLayout {
                spacing: 8px;
                FormSlot {
                    cap: Strings.kb-f-parent;
                    AppField {
                        placeholder: Strings.kb-ph-parent;
                    }
                }
                FormSlot {
                    cap: Strings.kb-f-resp;
                    AppField {
                        placeholder: Strings.kb-ph-resp;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                FormSlot {
                    cap: Strings.kb-f-start;
                    AppField {
                        placeholder: Strings.kb-ph-date;
                    }
                }
                FormSlot {
                    cap: Strings.kb-f-due;
                    AppField {
                        placeholder: Strings.kb-ph-date;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                if root.c-kind != 0: FormSlot {
                    cap: Strings.kb-f-points;
                    AppField {
                        placeholder: Strings.kb-ph-points;
                    }
                }
                FormSlot {
                    cap: Strings.kb-f-prio;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        KChipToggle {
                            label: Strings.kb-prio-low;
                            tone: Theme.faint;
                            active: root.c-prio == 0;
                            clicked => {
                                root.c-prio = 0;
                            }
                        }
                        KChipToggle {
                            label: Strings.kb-prio-normal;
                            tone: Theme.accent;
                            active: root.c-prio == 1;
                            clicked => {
                                root.c-prio = 1;
                            }
                        }
                        KChipToggle {
                            label: Strings.kb-prio-high;
                            tone: Theme.warn;
                            active: root.c-prio == 2;
                            clicked => {
                                root.c-prio = 2;
                            }
                        }
                        KChipToggle {
                            label: Strings.kb-prio-critical;
                            tone: Theme.bad;
                            active: root.c-prio == 3;
                            clicked => {
                                root.c-prio = 3;
                            }
                        }
                    }
                }
                if root.c-kind != 0: FormSlot {
                    cap: Strings.kb-f-sprint;
                    AppField {
                        placeholder: "S9";
                    }
                }
                if root.c-kind == 0: FormSlot {
                    cap: Strings.kb-f-pi;
                    AppField {
                        placeholder: "PI-3";
                    }
                }
            }
            FormSlot {
                cap: Strings.kb-sec-details;
                AppArea {
                    height: 90px;
                    placeholder: Strings.kb-ph-details;
                }
            }
            FormSlot {
                cap: Strings.kb-sec-ready;
                AppArea {
                    height: 90px;
                    placeholder: Strings.kb-ph-ready;
                }
            }
            FormSlot {
                cap: Strings.kb-sec-done;
                AppArea {
                    height: 90px;
                    placeholder: Strings.kb-ph-done;
                }
            }
            FormSlot {
                cap: Strings.kb-sec-scope;
                AppArea {
                    height: 90px;
                    placeholder: Strings.kb-ph-scope;
                }
            }
            FormSlot {
                cap: Strings.kb-f-deps;
                AppField {
                    placeholder: Strings.kb-ph-deps;
                }
            }
            HorizontalLayout {
                alignment: start;
                AppButton {
                    emoji: "📋";
                    label: Strings.kb-propose;
                    primary: true;
                    enabled: false;
                    tooltip: Strings.not-implemented-yet;
                    tooltip-below: true;
                }
            }
        }
    }

    // -- Mine ---------------------------------------------------------------
    if root.view == "my-quests": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🎯";
            title: Strings.kb-title-mine;
            hint: Strings.kb-hint-mine;
        }
        PanePanel {
            DotLabel {
                tone: Theme.warn;
                label: Strings.kb-col-doing;
                label-size: Theme.fs-cap;
                label-weight: 700;
            }
            for i in root.mine-doing: MineRow {
                it: root.all-items[i];
                act: 1;
            }
            DotLabel {
                tone: Theme.faint;
                label: Strings.kb-col-backlog;
                label-size: Theme.fs-cap;
                label-weight: 700;
            }
            for i in root.mine-backlog: MineRow {
                it: root.all-items[i];
                act: 0;
            }
        }
    }

    // -- Archive ------------------------------------------------------------
    if root.view == "archive": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🗄️";
            title: Strings.kb-title-archive;
            hint: Strings.kb-hint-archive;
        }
        PanePanel {
            for c in root.closed-items: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                height: 44px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    KGlyph {
                        glyph: c.done ? "✅" : "🚫";
                    }
                    KGlyph {
                        glyph: root.kind-glyph(c.kind);
                    }
                    Text {
                        text: c.title;
                        color: Theme.dim;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: c.points > 0
                            ? "\{c.responsible} · \{c.done ? Strings.kb-closed-done : Strings.kb-closed-dropped} \{c.closed} · \{c.points} pt"
                            : "\{c.responsible} · \{c.done ? Strings.kb-closed-done : Strings.kb-closed-dropped} \{c.closed}";
                        color: Theme.faint;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Vault — sealed secrets, threshold-elected disclosure
// ---------------------------------------------------------------------------
//
// The model (docs/vault/vault_threshold_disclosure.md): a deposit is
// encrypted and its key Shamir-shared across ALL seats; a threshold vote
// elects ONE reader; the share holders then re-seal their shares to that
// member alone. Everyone else — voters included — sees only THAT the grant
// happened, never the content.

struct MockSecret {
    name: string,
    desc: string, // the depositor's own line about it ("" = none)
    glyph: string, // 🔑 credential · 📄 document
    by: string,
    when: string,
    need: int, // unseals at `need` of `total` re-sealed shares
    total: int,
    verified: int, // seats whose share passed the commitment check
    sealing: bool, // committed, shares still hardening (§4: pre-commit deposits are ephemeral and live in Proposals)
    unsealed: bool, // a granted deposit reads "unsealed" instead of its threshold
}

struct MockSigner {
    name: string,
    signed: bool,
}

// The lifecycle of one access request: vote (threshold elects the reader)
// → unseal (share holders re-encrypt to the reader) → granted | denied.
enum VtReqState { vote, unseal, granted, denied }

// One access request walking `VtReqState`.
struct MockRequest {
    secret: string,
    reader: string, // the ONE member the vote elects
    by: string,
    reason: string,
    state: VtReqState,
    // the ONE per-phase progress count: vote signatures while voting,
    // re-sealed shares while unsealing (frozen at the outcome after)
    done: int,
    need: int,
    when: string, // outcome age (granted/denied states)
    signers: [MockSigner], // vote: ✍️ marks · unseal: 🧩 marks (no reader)
}

// One entry of the unsealed audit list: content only when `mine`.
struct MockUnsealed {
    name: string,
    reader: string,
    mine: bool, // the local member is the elected reader
    content: string,
    when: string,
}

component SecretCard inherits Rectangle {
    in property <MockSecret> s;
    // the roster the reader is elected from, and this card's pick
    in property <[string]> members;
    property <int> reader: 0;
    callback unseal-requested(string /* secret */, string /* reader */);
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        // the seal plate — the vault's signature element; a rounded square,
        // amber-ringed with an hourglass while the seats still verify their
        // shares
        Rectangle {
            width: 52px;
            height: 52px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.win95 ? 0px : 12px;
            background: Theme.accent-soft;
            border-width: Theme.border-w;
            border-color: root.s.sealing ? Theme.warn : Theme.accent;
            clip: true;
            Text {
                text: root.s.glyph;
                font-family: "Twemoji Mozilla";
                font-size: 22px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 17px;
                y: parent.height - 17px;
                width: 15px;
                height: 15px;
                border-radius: 4px;
                background: Theme.panel;
                Text {
                    text: root.s.sealing ? "⏳" : (root.s.unsealed ? "🔓" : "🔒");
                    font-family: "Twemoji Mozilla";
                    font-size: 9px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.s.name;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: "\{Strings.vt-sealed-by} \{root.s.by} · \{root.s.when}";
                color: Theme.faint;
                font-size: Theme.fs-cap;
                overflow: elide;
            }
            // ONE state line: the release threshold as share dots while the
            // deposit is closed, the plain word once it has been opened —
            // and the depositor's own description beside it, when there is one
            HorizontalLayout {
                spacing: 4px;
                if !root.s.unsealed: HorizontalLayout {
                    spacing: 4px;
                    for i in root.s.total: Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        y: (parent.height - self.height) / 2;
                        background: i < root.s.need ? Theme.accent : transparent;
                        border-width: 1px;
                        border-color: i < root.s.need ? Theme.accent : Theme.faint;
                    }
                }
                Text {
                    text: root.s.unsealed
                        ? Strings.vt-unsealed-word
                        : "  \{Strings.vt-opens-at} \{root.s.need} \{Strings.cw-rule-b} \{root.s.total}";
                    color: root.s.unsealed ? Theme.good : Theme.dim;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
                // the description takes whatever is left and elides — a
                // wrapping Text would report its whole line as preferred
                // width and push the row past the card
                Text {
                    text: root.s.desc == "" ? "" : "· \{root.s.desc}";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    overflow: elide;
                }
            }
            if root.s.sealing: HorizontalLayout {
                alignment: start;
                TagChip {
                    glyph: "⏳";
                    label: "\{Strings.vt-sealing} - \{root.s.verified}/\{root.s.total} \{Strings.vt-verified-word}";
                    muted: true;
                }
            }
        }
        // electing a reader is what a deposit is FOR: the pick and the
        // request sit on the card, not behind a second screen. An already
        // unsealed deposit has nothing to request.
        if !root.s.unsealed: HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // the layout centres them against the card - an x/y-anchored
            // child inside a layout is the collapse trap, not the idiom
            cross-axis-alignment: center;
            AppDropdown {
                width: 120px;
                height: 30px;
                model: root.members;
                current-index <=> root.reader;
            }
            AppButton {
                height: 30px * Theme.ui-scale;
                pad: 10px;
                emoji: "🗳️";
                label: Strings.vt-request-unseal;
                clicked => {
                    root.unseal-requested(root.s.name, root.members[root.reader]);
                }
            }
        }
    }
}

// The card-top idiom the vault cards share: bold elided title, quiet
// right-aligned caption.
component CardHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> caption;
    spacing: 8px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.fs-body;
        font-weight: 700;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.caption;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

component RequestCard inherits Rectangle {
    in property <MockRequest> r;
    // the signer mark this request's phase awards (derived, one place)
    property <string> mark: root.r.state == VtReqState.vote ? "✍️" : "🧩";
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        CardHead {
            title: root.r.secret;
            caption: "\{Strings.vt-requested-by} \{root.r.by}";
        }
        // the elected reader — the request's one deciding fact
        HorizontalLayout {
            alignment: start;
            TagChip {
                glyph: "👤";
                label: "→ \{root.r.reader}";
            }
        }
        Text {
            text: root.r.reason;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
        if root.r.state == VtReqState.vote || root.r.state == VtReqState.unseal: SigMeter {
            signed: root.r.done;
            need: root.r.need;
            word: root.r.state == VtReqState.unseal
                ? Strings.vt-resealed-word : Strings.vt-signed-word;
        }
        if root.r.state == VtReqState.vote || root.r.state == VtReqState.unseal: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for m in root.r.signers: TagChip {
                glyph: m.signed ? root.mark : "";
                label: m.name;
                muted: !m.signed;
            }
        }
        if root.r.state == VtReqState.granted: GlyphCaption {
            glyph: "🔓";
            label: "\{Strings.vt-granted-word} · \{root.r.when} · \{Strings.vt-only-by} \{root.r.reader}";
            tone: Theme.good;
        }
        if root.r.state == VtReqState.denied: GlyphCaption {
            glyph: "🚫";
            label: "\{Strings.vt-denied-word} · \{root.r.when} · \{root.r.done}/\{root.r.need} \{Strings.vt-signed-word}";
        }
    }
}

component UnsealedCard inherits Rectangle {
    in property <MockUnsealed> u;
    // pure view-state: the toggle only shows/hides sample content
    property <bool> shown: false;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        CardHead {
            title: root.u.name;
            caption: "\{Strings.vt-granted-word} · \{root.u.when}";
        }
        // mine: the eye chip + reveal toggle — foreign: only the lock,
        // which IS the zero-knowledge story
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                TagChip {
                    glyph: root.u.mine ? "👁️" : "🔒";
                    label: root.u.mine
                        ? Strings.vt-only-you
                        : "\{Strings.vt-only-by} \{root.u.reader}";
                    muted: !root.u.mine;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // the shared peek idiom (settings token): eye icon button,
            // primary while revealed, tooltip not label, no auto-remask
            if root.u.mine: AppButton {
                pad: 10px;
                icon: @image-url("assets/eye.svg");
                icon-set: true;
                primary: root.shown;
                tooltip: root.shown ? Strings.peek-hide : Strings.peek-show;
                clicked => {
                    root.shown = !root.shown;
                }
            }
        }
        if root.u.mine: InsetWell {
            text: root.u.content;
            revealed: root.shown;
        }
    }
}

export component VaultPane inherits VerticalLayout {
    in property <string> view;
    // this node's seat, and the one secret a mock seal has produced in this
    // session (the pane's sample list is a literal - a new deposit rides its
    // own properties instead)
    in property <string> me;
    in property <bool> new-set;
    in property <string> new-name;
    in property <string> new-desc;
    in property <string> new-glyph;
    callback seal-clicked();
    callback unseal-requested(string /* secret */, string /* reader */);
    spacing: 8px;

    // sample data — design mock only, never engine state
    property <[MockSecret]> secrets: [
        { name: "Treasury seed phrase", desc: "25 words, the founding wallet", glyph: "🔑", by: "petra", when: "at the founding", need: 3, total: 4, verified: 4, sealing: false, unsealed: false },
        { name: "S3 backup credentials", desc: "", glyph: "🔑", by: "walter", when: "2 w", need: 3, total: 4, verified: 4, sealing: false, unsealed: false },
        { name: "Emergency contact list", desc: "Phone numbers for the four seats", glyph: "📄", by: "mara", when: "1 m", need: 3, total: 4, verified: 4, sealing: false, unsealed: false },
        { name: "Domain registrar login", desc: "", glyph: "🔑", by: "petra", when: "2 h", need: 3, total: 4, verified: 2, sealing: true, unsealed: false },
        // a GRANT does not remove the deposit — granted secrets stay
        // listed (vault_threshold_disclosure.md §5), and read as unsealed
        { name: "Old relay admin password", desc: "Rotated after the provider notice", glyph: "🔑", by: "walter", when: "3 m", need: 3, total: 4, verified: 4, sealing: false, unsealed: true },
        { name: "Budget sheet key (2025)", desc: "", glyph: "📄", by: "petra", when: "6 m", need: 3, total: 4, verified: 4, sealing: false, unsealed: true },
    ];
    // the roster this mock elects a reader from
    property <[string]> members: ["petra", "walter", "mara", "jonas"];
    property <[MockRequest]> requests: [
        { secret: "S3 backup credentials", reader: "jonas", by: "walter", reason: "Walter hands the bucket ops to jonas.", state: VtReqState.vote, done: 2, need: 3, when: "", signers: [
            { name: "walter", signed: true }, { name: "petra", signed: true }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
        { secret: "Emergency contact list", reader: "petra", by: "mara", reason: "The yearly check that the numbers still work.", state: VtReqState.unseal, done: 2, need: 3, when: "", signers: [
            { name: "walter", signed: true }, { name: "mara", signed: true }, { name: "jonas", signed: false }] },
        { secret: "Old relay admin password", reader: "walter", by: "walter", reason: "Rotating the relay after the provider notice.", state: VtReqState.granted, done: 3, need: 3, when: "2 m", signers: [] },
        // every grant is ON RECORD — the unsealed "Budget sheet key" entry
        // has its granted request here, visibly
        { secret: "Budget sheet key (2025)", reader: "petra", by: "petra", reason: "Quarterly budget close.", state: VtReqState.granted, done: 3, need: 3, when: "5 m", signers: [] },
        { secret: "Treasury seed phrase", reader: "jonas", by: "jonas", reason: "Backup access while petra travels.", state: VtReqState.denied, done: 1, need: 3, when: "3 w", signers: [] },
    ];
    property <[MockUnsealed]> unsealed: [
        { name: "Budget sheet key (2025)", reader: "", mine: true, content: "age1q…8vte - decrypts budget-2025.age in the uploads", when: "5 m" },
        { name: "Old relay admin password", reader: "walter", mine: false, content: "", when: "2 m" },
    ];

    if root.view == "secrets": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🔐";
            title: Strings.vt-title-secrets;
            hint: Strings.vt-hint-secrets;
        }
        HorizontalLayout {
            alignment: start;
            vt-seal-btn := AppButton {
                emoji: "🔏";
                label: Strings.vt-seal-new;
                primary: true;
                clicked => {
                    root.seal-clicked();
                }
            }
        }
        PanePanel {
            if root.new-set: SecretCard {
                s: {
                    name: root.new-name,
                    desc: root.new-desc,
                    glyph: root.new-glyph,
                    by: root.me,
                    when: "now",
                    need: 3,
                    total: 4,
                    verified: 1,
                    sealing: true,
                    unsealed: false,
                };
                members: root.members;
                unseal-requested(secret, reader) => {
                    root.unseal-requested(secret, reader);
                }
            }
            for s in root.secrets: SecretCard {
                s: s;
                members: root.members;
                unseal-requested(secret, reader) => {
                    root.unseal-requested(secret, reader);
                }
            }
        }
    }

    if root.view == "requests": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📤";
            title: Strings.vt-title-requests;
            hint: Strings.vt-hint-requests;
        }
        HorizontalLayout {
            alignment: start;
            AppButton {
                emoji: "🗳️";
                label: Strings.vt-request;
                primary: true;
                enabled: false;
                tooltip: Strings.not-implemented-yet;
                tooltip-below: true;
            }
        }
        PanePanel {
            for r in root.requests: RequestCard {
                r: r;
            }
        }
    }

    if root.view == "unsealed": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "🔓";
            title: Strings.vt-title-unsealed;
            hint: Strings.vt-hint-unsealed;
        }
        PanePanel {
            for u in root.unsealed: UnsealedCard {
                u: u;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Wallet — Monero multisig
// ---------------------------------------------------------------------------

struct MockTransfer {
    incoming: bool,
    amount: string, // "12.0000"
    label: string,
    when: string,
    conf: int, // confirmations, capped at 10
    txid: string,
}

struct MockPendingTx {
    label: string,
    amount: string,
    signed: int,
    need: int,
    signers: [MockSigner],
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Theme.panel-2;
    border-radius: Theme.win95 ? 0px : 8px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    height: max(44px, Theme.fs-body * 1.4 + 20px);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component WalletPane inherits VerticalLayout {
    in property <string> view;
    spacing: 8px;

    // sample data — design mock only, never engine state
    property <[MockTransfer]> transfers: [
        { incoming: true, amount: "0.5028", label: "Donation (anonymous)", when: "5 h", conf: 3, txid: "b41c…9e" },
        { incoming: true, amount: "12.0000", label: "Member top-up - mara", when: "2 d", conf: 10, txid: "9f3c…a1" },
        { incoming: false, amount: "4.0000", label: "Quest reward - multisig setup", when: "1 w", conf: 10, txid: "77ab…04" },
        { incoming: true, amount: "25.0000", label: "Member top-up - petra", when: "2 w", conf: 10, txid: "c2d8…5f" },
        { incoming: false, amount: "2.4000", label: "Relay hosting Q2", when: "1 m", conf: 10, txid: "e901…bc" },
        { incoming: false, amount: "0.8000", label: "Domain renewal", when: "1 m", conf: 10, txid: "12fe…77" },
        { incoming: true, amount: "100.0000", label: "Founding treasury", when: "4 m", conf: 10, txid: "a0b1…c2" },
    ];
    property <[MockPendingTx]> pending-tx: [
        { label: "Quest reward - recovery drill → jonas", amount: "5.0000", signed: 1, need: 3, signers: [
            { name: "petra", signed: true }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
        { label: "Relay hosting Q3", amount: "2.4000", signed: 0, need: 3, signers: [
            { name: "petra", signed: false }, { name: "walter", signed: false }, { name: "mara", signed: false }, { name: "jonas", signed: false }] },
    ];
    // send form: pure pane state for design iteration — the drafts are
    // bound so typed input survives a view switch (a field that forgets
    // on tab-away reads as broken, mock or not)
    property <int> prio: 1;
    property <string> send-addr;
    property <string> send-amount;

    // the receive card's decorative pseudo-QR: a deterministic 17×17
    // module pattern with the three finder squares — design chrome only,
    // NOT an encoding of the (equally fictional) address below it
    pure function qr-cell(row: int, col: int) -> bool {
        if (row <= 6 && col <= 6) {
            return row == 0 || row == 6 || col == 0 || col == 6 || (row >= 2 && row <= 4 && col >= 2 && col <= 4);
        }
        if (row <= 6 && col >= 10) {
            return row == 0 || row == 6 || col == 10 || col == 16 || (row >= 2 && row <= 4 && col >= 12 && col <= 14);
        }
        if (row >= 10 && col <= 6) {
            return row == 10 || row == 16 || col == 0 || col == 6 || (row >= 12 && row <= 14 && col >= 2 && col <= 4);
        }
        return Math.mod(row * 17 + col * 31 + row * col * 7, 11) < 5;
    }

    if root.view != "history" && root.view != "send" && root.view != "receive"
        && root.view != "settings": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "💰";
            title: Strings.wl-title-balance;
            hint: Strings.wl-hint-balance;
        }
        // the balance figure — the wallet's signature moment. A real
        // padded layout, not an anchored one (the parts.slint mis-measure
        // trap), and the figure rides the font ladder.
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "128.4062";
                        color: Theme.text;
                        font-size: Theme.fs-h1 + 10px;
                        font-weight: 800;
                    }
                    Text {
                        text: "XMR";
                        color: Theme.faint;
                        font-size: Theme.fs-h2;
                        font-weight: 700;
                        vertical-alignment: bottom;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        TagChip {
                            label: Strings.wl-rule-sample;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    GlyphCaption {
                        glyph: "🔓";
                        label: "121.9034 XMR \{Strings.wl-unlocked}";
                        tone: Theme.dim;
                    }
                    GlyphCaption {
                        glyph: "⏳";
                        label: "6.5028 XMR \{Strings.wl-locked}";
                        tone: Theme.dim;
                    }
                }
            }
        }
        // transfers awaiting the threshold's signatures
        Text {
            text: Strings.wl-pending-sigs;
            color: Theme.dim;
            font-size: Theme.fs-cap;
            font-weight: 600;
        }
        PanePanel {
            for t in root.pending-tx: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 11px;
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "- \{t.amount} XMR";
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    SigMeter {
                        signed: t.signed;
                        need: t.need;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for m in t.signers: TagChip {
                            glyph: m.signed ? "✍️" : "";
                            label: m.name;
                            muted: !m.signed;
                        }
                    }
                }
            }
        }
    }

    if root.view == "history": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📜";
            title: Strings.wl-title-history;
            hint: Strings.wl-hint-history;
        }
        PanePanel {
            for t in root.transfers: Rectangle {
                background: Theme.panel-2;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: Theme.border-w;
                border-color: Theme.line;
                // follows the font ladder — a fixed 52px clipped the two
                // stacked lines at larger app fonts
                height: max(52px, Theme.fs-body * 1.4 + Theme.fs-cap * 1.4 + 20px);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 20px;
                        height: 100%;
                        clip: true;
                        Text {
                            text: t.incoming ? "📥" : "📤";
                            font-family: "Twemoji Mozilla";
                            font-size: 14px;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: t.label;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: "\{t.when} · \{t.txid}";
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            overflow: elide;
                        }
                    }
                    // the tone alone says "confirmed" — a plain-text ✓ would
                    // render as a thin monochrome outline (the Twemoji rule)
                    Text {
                        text: "\{min(t.conf, 10)}/10";
                        color: t.conf >= 10 ? Theme.good : Theme.warn;
                        font-size: Theme.fs-cap;
                        vertical-alignment: center;
                    }
                    Text {
                        text: t.incoming ? "+ \{t.amount}" : "- \{t.amount}";
                        color: t.incoming ? Theme.good : Theme.text;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: max(90px, Theme.fs-body * 6);
                    }
                }
            }
        }
    }

    if root.view == "send": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📤";
            title: Strings.wl-title-send;
            hint: Strings.wl-hint-send;
        }
        PanePanel {
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-to-address;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "4…";
                    text <=> root.send-addr;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-amount;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                AppField {
                    placeholder: "0.0000";
                    text <=> root.send-amount;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: Strings.wl-priority;
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    AppButton {
                        label: Strings.wl-prio-low;
                        primary: root.prio == 0;
                        clicked => {
                            root.prio = 0;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-normal;
                        primary: root.prio == 1;
                        clicked => {
                            root.prio = 1;
                        }
                    }
                    AppButton {
                        label: Strings.wl-prio-high;
                        primary: root.prio == 2;
                        clicked => {
                            root.prio = 2;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                AppButton {
                    emoji: "🗳️";
                    label: Strings.wl-propose-transfer;
                    primary: true;
                    enabled: false;
                    tooltip: Strings.not-implemented-yet;
                    tooltip-below: true;
                }
                Text {
                    text: "\{Strings.wl-fee} ~0.000021 XMR";
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }

    if root.view == "receive": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📥";
            title: Strings.wl-title-receive;
            hint: Strings.wl-hint-receive;
        }
        PanePanel {
            HorizontalLayout {
                spacing: 16px;
                // no alignment:start here — it cancelled the address
                // column's horizontal-stretch and left the pane's right
                // half dead space
                // decorative pseudo-QR on a light well (QR needs light
                // ground on every theme)
                Rectangle {
                    width: 17 * 6px + 24px;
                    height: 17 * 6px + 24px;
                    background: #ffffff;
                    border-radius: Theme.win95 ? 0px : 8px;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    for i in 289: Rectangle {
                        x: 12px + Math.mod(i, 17) * 6px;
                        y: 12px + Math.floor(i / 17) * 6px;
                        width: 6px;
                        height: 6px;
                        background: root.qr-cell(Math.floor(i / 17), Math.mod(i, 17)) ? #1a1d21 : transparent;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Strings.wl-subaddress;
                        color: Theme.dim;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                    }
                    Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.win95 ? 0px : 6px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 10px;
                            // deliberately mid-truncated: a design-mock
                            // address must never be transcribable into a
                            // send field
                            Text {
                                text: "8BdKQ9wJ3mPZxVtF7nRqYcLhG2sD4eTv … PxQbUcFgAt2iE9oRk4";
                                color: Theme.text;
                                font-size: Theme.fs-cap;
                                wrap: char-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        AppButton {
                            label: Strings.ow-copy;
                            enabled: false;
                            tooltip: Strings.not-implemented-yet;
                            tooltip-below: true;
                        }
                    }
                }
            }
        }
    }

    if root.view == "settings": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "⚙️";
            title: Strings.wl-title-settings;
            hint: Strings.wl-hint-settings;
        }
        PanePanel {
            SettingRow {
                label: Strings.wl-node;
                value: "node.example.org:18081 · Tor";
            }
            SettingRow {
                label: Strings.wl-sync;
                value: "3 214 502";
            }
            SettingRow {
                label: Strings.wl-signer-set;
                value: "\{Strings.wl-rule-sample} - petra, walter, mara, jonas";
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Shared Files — chunked like a torrent, replicated by the seats
// ---------------------------------------------------------------------------

struct MockSharedFile {
    name: string,
    glyph: string,
    folder: string,
    size: string,
    by: string,
    when: string,
    // seats holding the file, averaged over its chunks: 1.00 = the uploader
    // alone, N = every seat
    repl: float,
}

struct MockUploadJob {
    name: string,
    size: string,
    progress: float, // 0..1
    state: int, // 0 chunking · 1 seeding · 2 done
}

// The replication meter: one cell per seat, filled left to right; a
// partial cell shows the fraction (2.75 of 4 = two full cells + ¾).
export component ReplMeter inherits HorizontalLayout {
    in property <float> value;
    in property <int> seats;
    spacing: 8px;
    alignment: start;
    HorizontalLayout {
        spacing: 2px;
        alignment: start;
        for i in root.seats: Rectangle {
            width: 14px * Theme.ui-scale;
            height: 10px * Theme.ui-scale;
            border-radius: Theme.win95 ? 0px : 2px;
            background: Theme.panel-2;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.value - i, 0, 1);
                height: parent.height;
                background: root.value >= root.seats ? Theme.good
                    : root.value > 1 ? Theme.accent : Theme.warn;
            }
        }
    }
    // two fixed decimals: Slint has no precision format, so the hundredths
    // are assembled by hand (2.75 → "2.75", 1 → "1.00")
    property <int> cents: round(root.value * 100);
    property <int> whole: floor(root.cents / 100);
    property <int> frac: root.cents - root.whole * 100;
    Text {
        text: "\{root.whole}.\{root.frac < 10 ? "0" : ""}\{root.frac} / \{root.seats}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
}

export component FilesPane inherits VerticalLayout {
    in property <string> view;
    // the config view's line: the applied backup bucket ("" = not set)
    in property <string> bucket;
    callback open-settings();
    spacing: 8px;

    // sample data — design mock only, never engine state
    property <int> seats: 4;
    property <string> folder: "";
    property <[string]> folders: ["Minutes", "Designs", "Treasury", "Archive"];
    property <[MockSharedFile]> files: [
        { name: "minutes-2026-08.md", glyph: "📄", folder: "Minutes", size: "12 KiB", by: "petra", when: "2 d", repl: 4.0 },
        { name: "logo-final.svg", glyph: "🖼️", folder: "Designs", size: "48 KiB", by: "mara", when: "5 d", repl: 3.5 },
        { name: "budget-2026.ods", glyph: "📊", folder: "Treasury", size: "210 KiB", by: "walter", when: "1 w", repl: 2.75 },
        { name: "relay-map.png", glyph: "🗺️", folder: "Designs", size: "1.4 MiB", by: "jonas", when: "3 h", repl: 1.0 },
        { name: "founding-recording.opus", glyph: "🎙️", folder: "Archive", size: "38 MiB", by: "petra", when: "4 m", repl: 2.0 },
        { name: "charter-draft-v3.md", glyph: "📄", folder: "Minutes", size: "9 KiB", by: "mara", when: "20 m", repl: 1.25 },
    ];
    property <[MockUploadJob]> queue: [
        { name: "field-notes-08-28.md", size: "6 KiB", progress: 1.0, state: 2 },
        { name: "relay-latency.csv", size: "310 KiB", progress: 0.62, state: 1 },
        { name: "talk-slides.pdf", size: "4.8 MiB", progress: 0.18, state: 0 },
    ];
    // bucket quota, used of limit
    property <float> quota-used: 1.2;
    property <float> quota-limit: 5.0;

    if root.view == "browse": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "📂";
            title: Strings.sf-title-browse;
            hint: Strings.sf-hint-browse;
        }
        // folder chips: a view filter, nothing more
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            KChipToggle {
                label: Strings.sf-folder-all;
                active: root.folder == "";
                clicked => {
                    root.folder = "";
                }
            }
            for f in root.folders: KChipToggle {
                label: f;
                active: root.folder == f;
                clicked => {
                    root.folder = f;
                }
            }
        }
        sf-table := PanePanel {
            // header + rows are separate HorizontalLayouts: fixed widths
            // scale on both, the name column is the one that stretches
            HorizontalLayout {
                spacing: 10px;
                Text { text: Strings.sf-col-name; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; horizontal-stretch: 1; preferred-width: 0px; }
                Text { text: Strings.sf-col-size; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; width: 70px * Theme.ui-scale; }
                Text { text: Strings.sf-col-by; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; width: 70px * Theme.ui-scale; }
                Text { text: Strings.sf-col-when; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; width: 50px * Theme.ui-scale; }
                Text { text: Strings.sf-col-repl; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; width: 130px * Theme.ui-scale; }
                Rectangle { width: 32px * Theme.ui-scale; }
            }
            // a filtered-out row collapses to 0px inside a spacing-free
            // column, so the folder filter leaves no gaps behind
            VerticalLayout {
                spacing: 0px;
                for f in root.files: Rectangle {
                    property <bool> shown: root.folder == "" || root.folder == f.folder;
                    height: self.shown ? 30px * Theme.ui-scale : 0px;
                    clip: true;
                    sf-row := HorizontalLayout {
                    spacing: 10px;
                    height: 30px * Theme.ui-scale;
                    HorizontalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        Text {
                            text: f.glyph;
                            font-family: "Twemoji Mozilla";
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: f.name;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                        }
                    }
                    Text { text: f.size; color: Theme.dim; font-size: Theme.fs-cap; vertical-alignment: center; width: 70px * Theme.ui-scale; }
                    Text { text: f.by; color: Theme.dim; font-size: Theme.fs-cap; vertical-alignment: center; width: 70px * Theme.ui-scale; overflow: elide; }
                    Text { text: f.when; color: Theme.faint; font-size: Theme.fs-cap; vertical-alignment: center; width: 50px * Theme.ui-scale; }
                    VerticalLayout {
                        width: 130px * Theme.ui-scale;
                        alignment: center;
                        ReplMeter {
                            value: f.repl;
                            seats: root.seats;
                        }
                    }
                    AppButton {
                        width: 32px * Theme.ui-scale;
                        height: 26px * Theme.ui-scale;
                        pad: 0px;
                        emoji: "⬇️";
                        enabled: false;
                        tooltip: Strings.not-implemented-yet;
                        tooltip-left: true;
                    }
                    }
                }
            }
        }
    }

    if root.view == "upload": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "⬆️";
            title: Strings.sf-title-upload;
            hint: Strings.sf-hint-upload;
        }
        sf-queue := PanePanel {
            // the drop zone
            Rectangle {
                height: 90px * Theme.ui-scale;
                border-radius: Theme.win95 ? 0px : 8px;
                border-width: 2px;
                border-color: Theme.line;
                background: Theme.panel-2;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: Strings.sf-drop;
                        color: Theme.dim;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        AppButton {
                            emoji: "📎";
                            label: Strings.sf-pick;
                            primary: true;
                            enabled: false;
                            tooltip: Strings.not-implemented-yet;
                            tooltip-below: true;
                        }
                    }
                }
            }
            Text {
                text: Strings.sf-queue;
                color: Theme.faint;
                font-size: Theme.fs-cap;
                font-weight: 600;
            }
            for j in root.queue: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: j.name;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        overflow: elide;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                    }
                    Text { text: j.size; color: Theme.dim; font-size: Theme.fs-cap; width: 70px * Theme.ui-scale; }
                    Text {
                        text: j.state == 2 ? Strings.sf-st-done : j.state == 1 ? Strings.sf-st-seeding : Strings.sf-st-chunking;
                        color: j.state == 2 ? Theme.good : Theme.accent;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                        width: 80px * Theme.ui-scale;
                    }
                }
                Rectangle {
                    height: 6px * Theme.ui-scale;
                    border-radius: Theme.win95 ? 0px : 3px;
                    background: Theme.panel-2;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * j.progress;
                        height: parent.height;
                        background: j.state == 2 ? Theme.good : Theme.accent;
                    }
                }
            }
            // the bucket quota, the seed's limit
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: Strings.sf-quota;
                    color: Theme.faint;
                    font-size: Theme.fs-cap;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 8px * Theme.ui-scale;
                    border-radius: Theme.win95 ? 0px : 4px;
                    background: Theme.panel-2;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.quota-used / root.quota-limit;
                        height: parent.height;
                        background: Theme.accent;
                    }
                }
                Text {
                    text: "\{root.quota-used} GiB / \{root.quota-limit} GiB";
                    color: Theme.dim;
                    font-size: Theme.fs-cap;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.view == "config": VerticalLayout {
        spacing: 8px;
        PaneHeader {
            glyph: "⚙️";
            title: Strings.sf-title-config;
        }
        sf-config := PanePanel {
            GridLayout {
                spacing: 8px;
                Row {
                    Text { text: Strings.sf-cfg-bucket; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; }
                    // optional, so an unset bucket is a fact, not a warning
                    Text {
                        text: root.bucket == "" ? Strings.sf-not-set : root.bucket;
                        color: root.bucket == "" ? Theme.faint : Theme.text;
                        font-size: Theme.fs-body;
                        overflow: elide;
                    }
                }
                Row {
                    Text { text: Strings.sf-cfg-seats; color: Theme.faint; font-size: Theme.fs-cap; font-weight: 600; }
                    Text { text: "\{root.seats}"; color: Theme.text; font-size: Theme.fs-body; }
                }
            }
            HorizontalLayout {
                alignment: start;
                sf-settings := AppButton {
                    icon: @image-url("assets/gear.svg");
                    icon-set: true;
                    label: Strings.sf-open-settings;
                    clicked => {
                        root.open-settings();
                    }
                }
            }
        }
    }
}
