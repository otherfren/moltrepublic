// SPDX-License-Identifier: GPL-3.0-or-later
//
// The MoltRepublic node GUI. Multi-stage flow modelled after konkinwallet:
// a persistent left sidebar (wordmark, the surfaces, and the theme / language /
// settings controls + a close-workspace button at the bottom-left) plus a main
// area that routes between the first-run choice, the create/open/join/restore
// wizards, a shared done screen, the settings panel, and the surfaces view.
//
// This GUI is a LIVE-MIRROR of the engine's shared session: navigation,
// language, theme and settings are pushed back from the engine after a
// SessionChanged event, and every UI action calls a callback the Rust side
// turns into a molt_core::Command on the shared WalletHandle. An MCP agent
// issuing the same commands drives this same state — the two operators are
// co-equal. Everything is a mock: nothing is written to disk.
//
// Three runtime themes (Monero light / dark.fi dark / Win95 Brutalism) via
// Theme; all controls are hand-rolled (components.slint) so they restyle live.

// The colorful emoji font (Twemoji, borrowed from konkinwallet) — used for
// the nav sub-view icons, the reaction pills and the emoji palette.
import "assets/fonts/Twemoji.Mozilla.ttf";

import { Theme, Strings, HintTip, AppScreen, SurfaceTab, ViewItem, LogLine, ReactionItem, ReceiptItem, ProposalRow, ChannelItem, WorkspaceItem, MemberSync, MemberRow, UploadRow, RitualSeat, InvitePreview, LinkPreview, BackupRow, ChainRow, RelayItem, RelayPick } from "theme.slint";
import {
    AppButton, AppField, AppArea, AppDropdown, AppStepper, AppCheck, ChromeControls, ScrollHint, HoverTip,
    ConfirmModal, DotLabel
} from "components.slint";
import {
    BusyModal, ChoiceCard, PendingBadge, SurfaceRow, ViewRow, EmojiGrid, ReactionPill, ChatRow, StatusPill, MemberPill, DetailGroup, RestoreWay, WayBranch, SeedPanel, SeedConfirmStep, RunView, ProposalCard, DecisionTable, Spinner
} from "parts.slint";
// the four staged surfaces' badged DESIGN-MOCK panes (sample data lives
// .slint-side only; the real governance views stay below in this file)
import { MemoryPane, MockBadge, QuestsPane, VaultPane, WalletPane } from "surfaces.slint";

export { Strings, Theme }

// A settings form group: caption sitting tight above its control(s), so a
// label+field pair reads as one unit inside the wider panel rhythm.
component FieldLabel inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.text;
    }
    @children
}

// Settings → General: the two form groups, factored into components so the
// wide pane can seat them side by side and a narrow pane can stack the
// SAME content — one set of bindings, two arrangements.
component LanguageAppearanceGroup inherits DetailGroup {
    in property <int> lang-index;
    callback set-language(int);
    title: Strings.set-panel-appearance;
    FieldLabel {
        label: Strings.field-language;
        AppDropdown {
            width: 200px;
            model: ["English", "Deutsch"];
            current-index: root.lang-index;
            changed(i) => {
                root.set-language(i);
            }
        }
    }
    FieldLabel {
        label: Strings.field-theme;
        AppDropdown {
            width: 200px;
            model: ["Classic", "Dark", "Brutalism"];
            current-index <=> Theme.theme-index;
            changed(i) => {
                Theme.picked(i);
            }
        }
    }
}

// one alert-sound picker row: dropdown plus the conditional preview
// button — the sound model and the index→name mapping live here exactly
// once, shared by the message and vote rows
component SoundPickerRow inherits FieldLabel {
    in-out property <int> index;
    callback test(string);
    HorizontalLayout {
        spacing: 8px;
        AppDropdown {
            width: 200px;
            model: [Strings.sound-off, "Bell", "Chime", "Pop"];
            current-index <=> root.index;
        }
        if root.index > 0: AppButton {
            width: 32px;
            height: 32px;
            pad: 0px;
            label: "🔊";
            clicked => {
                root.test(root.index == 1 ? "bell" : (root.index == 2 ? "chime" : "pop"));
            }
        }
    }
}

component SoundAlertsGroup inherits DetailGroup {
    in-out property <int> message-index;
    in-out property <int> vote-index;
    callback test-sound(string);
    title: Strings.set-panel-sounds;
    SoundPickerRow {
        label: Strings.field-sound-message;
        index <=> root.message-index;
        test(s) => {
            root.test-sound(s);
        }
    }
    SoundPickerRow {
        label: Strings.field-sound-vote;
        index <=> root.vote-index;
        test(s) => {
            root.test-sound(s);
        }
    }
}

// One button of the Settings tab bar. The bar is ONE row: a tab whose TITLE
// does not fit wraps its own title onto a second line instead of the bar
// breaking into two rows.
//
// That needs a floor. A word-wrapping Slint Text reports min-width 0, so the
// row would otherwise shrink every tab — including the single-word ones, which
// cannot wrap — until the letters are clipped. `floor` is the same title with
// a newline at every break opportunity (Rust: `tab_title_floor`); an unseen
// Text of it has exactly the width of the widest unbreakable
// chunk, measured in the real font, and that plus the padding is this tab's
// minimum width. So: a single-word tab never shrinks at all, and a wrappable
// one shrinks only down to its longest word — it wraps, it never clips.
//
// `pad` is tighter than the default button: eight labels are a lot of width.
component SettingsTab inherits AppButton {
    in property <int> index;
    // the title broken at every line-break opportunity — Strings.set-tab-*-floor
    in property <string> floor;
    in-out property <int> current;
    pad: 8px;
    wrap-label: true;
    // room for TWO 14px lines (≈33px) — fixed, so the bar keeps its height
    // whether or not a title happens to wrap at the current window width
    height: 38px;
    min-width: tab-floor.preferred-width + 2 * root.pad;
    primary: root.current == root.index;
    // Measured, never seen: drawn transparent rather than `visible: false`,
    // because that lowers to a Clip that expands to the button's geometry —
    // it would clip nothing away. It carries the SAME font as the label, so
    // its preferred width is the real floor in the real font.
    tab-floor := Text {
        text: root.floor;
        color: transparent;
        font-size: Theme.fs-body;
        font-weight: 600;
    }
    clicked => {
        root.current = root.index;
    }
}

// Settings → Anonymity network: the anonymity network form group (tor mode + SOCKS
// port) — factored like the General pair so the wide pane can seat it and
// a narrow pane shows the SAME content.
component AnonNetworkGroup inherits DetailGroup {
    in-out property <int> network-index;
    in-out property <int> tor-mode-index;
    in-out property <int> tor-port;
    in property <[bool]> tor-modes-enabled;
    title: Strings.field-network;
    // form panel: content hugs the top, the panel takes its content height
    pack: true;
    AppDropdown {
        width: 200px;
        model: ["tor", "none"];
        current-index <=> root.network-index;
    }
    // tor mode only applies to tor; the SOCKS port only to tor+local
    // (embedded/whonix configure themselves)
    if root.network-index == 0: FieldLabel {
        label: Strings.field-tor-mode;
        AppDropdown {
            width: 200px;
            model: ["local", "embedded", "whonix"];
            // "embedded" greys out unless this binary was built with
            // the embedded-tor feature
            enabled: root.tor-modes-enabled;
            current-index <=> root.tor-mode-index;
        }
        // honest copy: say WHY embedded is greyed
        if !root.tor-modes-enabled[1]: Text {
            text: Strings.set-tor-embedded-missing;
            color: Theme.faint;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
            // keep the long hint out of the group's preferred width —
            // it wraps at whatever width the pane grants the panel
            preferred-width: 0px;
        }
    }
    if root.network-index == 0 && root.tor-mode-index == 0: FieldLabel {
        label: Strings.field-tor-port;
        AppStepper {
            width: 200px;
            value <=> root.tor-port;
            minimum: 1;
            maximum: 65535;
        }
    }
}

// The kind badge of a relay row, derived from the URL (never stored — see
// molt_core::relay). Onion reads as the private choice (good tone), clearnet
// as the exposed one (warn tone), local as your own box (accent tone — still
// outside Tor, which is why it shares the clearnet gate); the pictogram
// rides in the colorful Twemoji font, so a plain-text emoji never sneaks
// into a label.
component RelayBadge inherits Rectangle {
    in property <int> kind; // 0 = onion · 1 = clearnet · 2 = local
    property <color> tone: root.kind == 0 ? Theme.good
        : (root.kind == 2 ? Theme.accent : Theme.warn);
    // sized by its own content, like StatusPill: the row must never stretch
    // it (the padding is 8px on both sides of the x-anchored inner row)
    width: bd-row.preferred-width + 16px;
    height: 20px;
    border-radius: Theme.win95 ? 0px : 10px;
    border-width: Theme.border-w;
    border-color: root.tone;
    background: root.tone.transparentize(0.86);
    bd-row := HorizontalLayout {
        x: 8px;
        height: 100%;
        spacing: 5px;
        // safe `alignment: start`: every child is a Text with a real
        // preferred width (see the collapse trap in parts.slint)
        alignment: start;
        Text {
            text: root.kind == 0 ? "🧅" : (root.kind == 2 ? "🏠" : "🌐");
            font-family: "Twemoji Mozilla";
            font-size: Theme.fs-cap;
            vertical-alignment: center;
        }
        Text {
            text: root.kind == 0 ? Strings.rp-badge-onion
                : (root.kind == 2 ? Strings.rp-badge-local : Strings.rp-badge-clearnet);
            color: Theme.text;
            font-size: Theme.fs-cap;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// One relay of the pool: its priority position, the URL, the kind badge, the
// honest status line, and the row's controls (reorder / confirm / withdraw /
// remove). The row never decides the policy — `blocked` arrives derived from
// the engine and is only turned into words here.
component RelayRow inherits Rectangle {
    in property <RelayItem> r;
    callback moved(bool); // true = towards position 1 (higher priority)
    callback confirm(string, int); // url + kind: a non-onion relay must pass the warning first
    callback revoke(string);
    callback removed(string);
    callback copied(string); // put the address on the clipboard
    property <string> status: root.r.blocked == 1 ? Strings.rp-st-unconfirmed
        : (root.r.blocked == 2 ? Strings.rp-st-locked
        : (root.r.kind == 0 ? Strings.rp-st-auto : Strings.rp-st-active));
    // in use = green, waiting for a decision of the user = amber, simply
    // not in use = faint (an unconfirmed relay is not a problem)
    property <color> tone: root.r.blocked == 1 ? Theme.faint
        : (root.r.blocked == 2 ? Theme.warn : Theme.good);
    height: 56px;
    background: Theme.panel;
    border-radius: Theme.win95 ? 0px : 6px;
    border-width: Theme.border-w;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        // THE idiom for centring fixed-height controls in a row: the layout
        // itself does it. A HorizontalLayout stretches its children over the
        // full row height and puts anything that cannot stretch (every button
        // here has an explicit height, the badge too) at the TOP. Do NOT reach
        // for `y: (parent.height - self.height) / 2` — an x/y-anchored child
        // drops out of the implicit preferred size (the collapse trap in
        // parts.slint), which is how a control ends up 0px wide.
        cross-axis-alignment: center;
        Text {
            text: "\{root.r.pos}";
            color: Theme.faint;
            font-size: Theme.fs-cap;
            font-weight: 700;
            width: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.r.url;
                color: Theme.text;
                font-size: Theme.fs-body;
                overflow: elide;
                vertical-alignment: center;
            }
            DotLabel {
                tone: root.tone;
                label: root.status;
                label-size: Theme.fs-cap;
            }
        }
        // the kind badge belongs to the relay, not to the URL line: as a row
        // child it is centred with the controls instead of clinging to the
        // first of the two text lines
        RelayBadge {
            kind: root.r.kind;
        }
        // an address is long and unmemorable — one compact click puts it on
        // the clipboard (the row has no field to edit it in; a wrong address
        // is removed and re-added, which is also what re-confirms it)
        AppButton {
            width: 26px;
            height: 26px;
            pad: 0px;
            icon: @image-url("assets/copy.svg");
            icon-set: true;
            // even icon in an even button: whole-pixel margins, or an
            // icon-only button renders visibly off-centre (AppButton)
            icon-size: 14px;
            tooltip: Strings.rp-copy;
            tooltip-left: true;
            clicked => {
                root.copied(root.r.url);
            }
        }
        // the reorder pair is disabled (not hidden) at the ends, so the row
        // keeps its shape wherever it sits in the list
        AppButton {
            label: "▲";
            pad: 8px;
            height: 26px;
            enabled: !root.r.first;
            tooltip: Strings.rp-up;
            tooltip-left: true;
            clicked => {
                root.moved(true);
            }
        }
        AppButton {
            label: "▼";
            pad: 8px;
            height: 26px;
            enabled: !root.r.last;
            tooltip: Strings.rp-down;
            tooltip-left: true;
            clicked => {
                root.moved(false);
            }
        }
        if !root.r.confirmed: AppButton {
            label: Strings.rp-confirm;
            pad: 10px;
            height: 26px;
            primary: true;
            clicked => {
                root.confirm(root.r.url, root.r.kind);
            }
        }
        if root.r.confirmed: AppButton {
            label: Strings.rp-revoke;
            pad: 10px;
            height: 26px;
            tooltip: Strings.rp-revoke-tip;
            tooltip-left: true;
            clicked => {
                root.revoke(root.r.url);
            }
        }
        AppButton {
            label: "×";
            pad: 9px;
            height: 26px;
            tooltip: Strings.rp-remove;
            tooltip-left: true;
            clicked => {
                root.removed(root.r.url);
            }
        }
    }
}

// Settings → Nostr relays: the relay-pool editor (docs/transport/relay_pool.md
// §6). Nothing is preset, and nothing is dialed until the user confirms it —
// so an empty pool is stated as a plain fact with a way forward, never as an
// error. The clearnet session control appears only once a confirmed clearnet
// relay exists to activate.
component RelayPoolGroup inherits DetailGroup {
    in property <[RelayItem]> rows;
    in property <int> dialable; // relays in use right now (engine-derived)
    in property <bool> clearnet-confirmed; // at least one confirmed clearnet relay
    in property <bool> clearnet-session; // activated for THIS session only
    in-out property <string> draft; // the add field
    in property <string> error; // inline validation message under the field
    callback add(string);
    callback moved(string, bool);
    callback confirm(string, int); // url + kind (0 onion · 1 clearnet · 2 local)
    callback revoke(string);
    callback removed(string);
    callback session(bool);
    callback copied(string); // a row's address goes to the clipboard
    callback edited(); // typing clears the stale error
    title: Strings.rp-title;
    // with a list the panel spreads (the list claims the leftover height);
    // with the empty state there is nothing to stretch — hug the top
    pack: root.rows.length == 0;
    if root.rows.length > 0: DotLabel {
        tone: root.dialable > 0 ? Theme.good : Theme.faint;
        label: root.dialable > 0 ? "\{Strings.rp-in-use} \{root.dialable}" : Strings.rp-none-dialable;
        label-size: Theme.fs-cap;
        label-color: root.dialable > 0 ? Theme.dim : Theme.faint;
    }
    // empty pool: the FIRST thing a new operator sees — an invitation, with
    // the honest consequence (not connected) and what .onion buys them
    if root.rows.length == 0: Rectangle {
        background: Theme.accent-soft;
        border-radius: Theme.win95 ? 0px : 6px;
        border-width: Theme.border-w;
        border-color: Theme.accent;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text {
                text: Strings.rp-empty-title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                wrap: word-wrap;
                preferred-width: 0px;
            }
            Text {
                text: Strings.rp-empty-body;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
                preferred-width: 0px;
            }
        }
    }
    if root.rows.length > 0: Rectangle {
        vertical-stretch: 1;
        // a long pool scrolls inside its own panel instead of pushing the
        // add field out of the settings pane
        min-height: 60px;
        clip: true;
        rp-fl := Flickable {
            VerticalLayout {
                padding-right: 8px;
                padding-bottom: 6px;
                spacing: 4px;
                alignment: start;
                for item in root.rows: RelayRow {
                    r: item;
                    moved(up) => {
                        root.moved(item.url, up);
                    }
                    confirm(url, kind) => {
                        root.confirm(url, kind);
                    }
                    revoke(url) => {
                        root.revoke(url);
                    }
                    removed(url) => {
                        root.removed(url);
                    }
                    copied(url) => {
                        root.copied(url);
                    }
                }
            }
        }
        ScrollHint {
            x: parent.width - 7px;
            view-h: rp-fl.height;
            content-h: rp-fl.viewport-height;
            scroll-y: rp-fl.viewport-y;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        AppField {
            horizontal-stretch: 1;
            // a shape example, never a reachable host
            placeholder: "wss://your-relay.onion";
            text <=> root.draft;
            invalid: root.error != "";
            edited => {
                root.edited();
            }
            accepted => {
                if (root.draft != "") {
                    root.add(root.draft);
                }
            }
        }
        AppButton {
            label: Strings.rp-add;
            primary: true;
            enabled: root.draft != "";
            clicked => {
                root.add(root.draft);
            }
        }
    }
    // never a silent failure: what the pool refused, right under the field
    if root.error != "": Text {
        text: root.error;
        color: Theme.bad;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
        preferred-width: 0px;
    }
    Text {
        text: Strings.rp-add-hint;
        color: Theme.faint;
        font-size: Theme.fs-cap;
        wrap: word-wrap;
        preferred-width: 0px;
    }
    // the per-session clearnet activation, set apart from the pool itself:
    // shown only when there is something to activate, calm (not alarming)
    // while it is on
    if root.clearnet-confirmed: Rectangle {
        background: Theme.panel;
        border-radius: Theme.win95 ? 0px : 6px;
        border-width: Theme.border-w;
        border-color: root.clearnet-session ? Theme.good : Theme.line;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            DotLabel {
                tone: root.clearnet-session ? Theme.good : Theme.faint;
                label: Strings.rp-cn-session-title;
                label-color: Theme.text;
                label-size: Theme.fs-cap;
                label-weight: 700;
            }
            Text {
                text: root.clearnet-session ? Strings.rp-cn-session-on : Strings.rp-cn-session-off;
                color: Theme.dim;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
                preferred-width: 0px;
            }
            HorizontalLayout {
                alignment: start;
                AppButton {
                    label: root.clearnet-session ? Strings.rp-cn-deactivate : Strings.rp-cn-activate;
                    height: 28px;
                    primary: !root.clearnet-session;
                    clicked => {
                        root.session(!root.clearnet-session);
                    }
                }
            }
        }
    }
}

// The paged lists' footer: ‹ Page x of y › — the caller shows it only when
// the list exceeds one page (count > 20); the actual paging (slice, clamp
// on shrink) runs in Rust, this row merely steps and displays the echo.
component PagerRow inherits HorizontalLayout {
    in property <int> page; // 1-based current page
    in property <int> pages; // total page count
    callback paged(int); // -1 = prev, +1 = next
    spacing: 8px;
    alignment: center;
    AppButton {
        label: "‹";
        pad: 10px;
        height: 26px;
        enabled: root.page > 1;
        clicked => {
            root.paged(-1);
        }
    }
    Text {
        text: "\{Strings.pg-page} \{root.page} \{Strings.pg-of} \{root.pages}";
        color: Theme.dim;
        font-size: Theme.fs-cap;
        vertical-alignment: center;
    }
    AppButton {
        label: "›";
        pad: 10px;
        height: 26px;
        enabled: root.page < root.pages;
        clicked => {
            root.paged(1);
        }
    }
}

// Organization → Status: the gated-settings card (chat retention with its
// propose-edit pencil). One definition, two placements: beside the info
// strip when the pane is wide enough, below the charter otherwise.
component OrgSettingsCard inherits DetailGroup {
    in property <int> retention;
    // the GROUP's relay pool — a group setting like the name or the
    // retention window, editable as a threshold-gated proposal (R6).
    in property <[string]> relays;
    callback edit();
    callback edit-relays();
    title: Strings.ocs-title;
    if root.relays.length > 0: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: Strings.ocs-relays;
                color: Theme.text;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.relays.length;
                color: Theme.dim;
                font-size: Theme.fs-body;
                vertical-alignment: center;
            }
            AppButton {
                width: 26px;
                height: 26px;
                pad: 0px;
                label: "✎";
                tooltip: Strings.org-edit;
                tooltip-left: true;
                clicked => {
                    root.edit-relays();
                }
            }
        }
        // deliberately no URL list here (2026-08-09): the real addresses
        // are the modal's business — Status shows the count, the pencil
        // opens the editable table
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Strings.ocs-chat-retention;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "\{root.retention} \{Strings.ocs-days}";
            color: Theme.dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        AppButton {
            width: 26px;
            height: 26px;
            pad: 0px;
            label: "✎";
            tooltip: Strings.org-edit;
            tooltip-left: true;
            clicked => {
                root.edit();
            }
        }
    }
}

// A clickable, sortable column header for the backup table (the Open
// screen's header idiom: faint until hovered/active, accent ▲/▼).
component SortHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> desc;
    in property <LayoutAlignment> align: start;
    callback clicked();
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: root.align;
        spacing: 5px;
        Text {
            text: root.label;
            color: root.active || ta.has-hover ? Theme.text : Theme.faint;
            font-size: Theme.fs-cap;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.active: Text {
            text: root.desc ? "▼" : "▲";
            color: Theme.accent;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
}


export component AppWindow inherits Window {
    title: "MoltRepublic - node";
    // Raised 940 → 1060 so the Open screen's table fits WITHOUT a manual
    // resize. Measured against that table's own columns (app.slint, the
    // header and the rows carry the same widths):
    //   18 padding + 9 dot + 140 name(min) + 110 sync + 120 backup
    //   + 85 status + 330 buttons (86 Open + 134 Encrypt + 86 Delete, 2×12
    //   spacing) + 5 × 12 column spacing + 18 padding = 890px of table.
    // The Open screen runs with the nav rail COLLAPSED (`nav-collapsed` is
    // `screen != main`), so it takes 64px, plus the screen's own 2 × 16px
    // padding: the table wants 986px of window. At 940 it was 46px short —
    // exactly the right edge of Delete, the last fixed column.
    // 1060 leaves the stretching name column ~70px above its 140px floor, so
    // the default actually shows names rather than eliding them at the floor.
    preferred-width: 1060px;
    preferred-height: 720px;
    // Raised 760 → 900 for the one-row settings tab bar. Measured (DejaVu Sans
    // Bold 14px, the default sans here), German — the widest set:
    // Allgemein 79 · Workspace 87 · Backup 58 · Anonymitäts-Netzwerk 181 ·
    // Nostr-Relays 101 · MCP 35 · Node 41 · Chain-History 108 = 690px of text,
    // + 8 tabs × 2 × 8px padding + 7 × 6px spacing = 860px of bar. The bar sits
    // in the content area: window − 64px icon rail − 2 × 24px pane padding, so
    // 860px of bar wants 972px of window. Rather than demand that as a MINIMUM,
    // the minimum buys the row enough width to carry the widest German title on
    // two lines: 860 − 75 (the wrap saved by "Anonymitäts-|Netzwerk") = 785px of
    // bar → 897px of window, rounded to 900. Narrower still is safe (the bar's
    // absolute floor — every wrappable title on two lines — is 686px of bar,
    // i.e. 798px of window); it just wraps more titles.
    // …and raised 900 → 990 for the same table. Leaving the minimum at 900
    // would keep the bug reachable by dragging the window narrow: the
    // Flickable's viewport is `self.width`, so the table does not scroll
    // horizontally, it CLIPS — and Delete is the last column, so it is always
    // the one that disappears. 990 is the 986px floor above, rounded.
    min-width: 990px;
    min-height: 600px;
    background: Theme.bg;

    // ---- shared session state, pushed from the engine (live-mirror) ----
    in property <AppScreen> screen: AppScreen.choice;
    in property <int> lang-index: 0;
    in property <string> notice;
    // a failed config write ("save-failed: …", raw detail from the engine);
    // empty = none. Split off `notice` in Rust so slint needs no string ops.
    in property <string> notice-failed;
    // comma-joined config keys that changed but only apply on restart
    // (session.restart_required); empty = none. Persistent, not a toast.
    in property <string> restart-keys;
    // the config.toml location, split for display: directory (greyed) and
    // file name (text color) — set together by the Rust side
    in property <string> config-dir;
    in property <string> config-file;

    // ---- active workspace (main header), live-mirrored from the engine ----
    in property <string> active-workspace;
    in property <string> active-status;
    in property <int> active-state: 0;
    // transport health for the header "chat" pill (P6), set by Rust from
    // SessionView.net_health: tone 0 = ok/green, 1 = degraded/amber,
    // 2 = down/red; the reason is the pill's hover tooltip (empty when ok).
    in property <int> net-health-tone: 0;
    in property <string> net-health-reason;

    // ---- surfaces (main view), live-mirrored from the engine ----
    in property <string> node-member;
    in property <string> threshold-badge;
    in property <[SurfaceTab]> surfaces;
    // the active workspace's roster (chat members strip: who is online)
    in property <[MemberSync]> active-members;
    // the Organization tables, mirrored from the engine's ReadMembers /
    // ReadUploads (the same projections the MCP tools of those names read)
    in property <[MemberRow]> org-members;
    in property <[UploadRow]> org-uploads;
    // the tables' presentation state (sorting/filtering runs in Rust over
    // the mirrored rows and lives in the UI-local state there — these echo
    // it back so the headers render the ▲/▼ arrow and the filter box
    // follows a Rust-side change like the members-table uploads-jump)
    in property <string> om-sort-column;
    in property <bool> om-sort-ascending: true;
    in property <string> ou-sort-column;
    in property <bool> ou-sort-ascending: true;
    in-out property <string> ou-filter;
    // header click: toggle-or-switch the sort on that column (in Rust)
    callback sort-members(string);
    callback sort-uploads(string);
    // uploads filter needle edited (matches user/filename/checksum in Rust)
    callback filter-uploads(string);
    // a member row's uploads count: jump to Organization → Uploads with
    // the filter pre-filled to that member's name
    callback jump-member-uploads(string);
    // pager step on a paged proposal-outcome list: surface key, list key
    // ("declined" | "applied"), page delta (-1/+1) — the page state lives
    // in Rust and the sliced model + "page x of y" echo back on the push
    callback page-list(string, string, int);
    // the ratified founding charter (free-text agenda) for the Constitution surface
    in property <string> active-agenda;
    // the charter pre-split into up to 3 balanced display columns (Rust
    // charter-columns; empty = no charter → the no-agenda line shows)
    in property <[string]> charter-cols;
    // Organization → Status/Members: reachable count derived from the roster
    in property <int> org-online;
    in property <int> org-total;
    // the status info panel: founding date label ("—" = unknown) and the
    in property <string> org-founded;
    // whether the open workspace is a chain-governed republic — recovery
    // exists exactly there, so the Members table offers the per-member
    // "recovery link" action only then (never keyed on the member's
    // presence: a recovery link is FOR an unreachable member)
    in property <bool> org-chain-governed: false;

    // ---- actions: each becomes a Command on the shared WalletHandle ----
    callback navigate(AppScreen);
    callback set-language(int);
    callback save-settings();
    // leave the settings screen — handled in Rust: navigates straight back
    // when the draft is clean, raises the unsaved-changes modal otherwise
    callback close-settings();
    // the unsaved-changes modal's two ways forward (both leave settings)
    callback save-and-leave();
    callback discard-and-leave();
    callback rotate-token();
    callback quit();
    // body + quoted message id ("" = plain message)
    callback send-chat(string, string);
    callback propose(string, string);
    // an Organization change (charter / image / …): op, display title, and
    // the drafted value — Rust turns it into the same Command::Propose the
    // MCP propose tool drives (co-equality)
    // (op, value) — the op is the language-neutral title placeholder;
    // the Rust side never bakes a rendered title into the payload
    callback org-propose(string, string);
    // R6 pool-edit modal draft ops (rows live Rust-side, see above)
    callback relays-draft-seed();
    callback relays-draft-add(string);
    callback relays-draft-remove(int);
    callback approve(int);
    callback decline(int);
    // select the main-view surface (routed to a SelectSurface command; the
    // sub-view resets to the surface's default)
    callback select-surface(string);
    // select a surface AND one of its sub-views (a SelectView command)
    callback select-view(string, string);
    // share a file into the chat: opens the native file picker; Rust reads
    // the real metadata (name, size, type, date) — no bytes are uploaded
    callback share-pick();
    callback download-file(string);
    callback remove-file(string);
    // toggle the local member's emoji reaction on a chat message, by its
    // stable id (ReactChat)
    callback toggle-reaction(string, string);
    // wipe a chat message (by stable id) and leave the deletion notice
    // (DeleteChat)
    callback delete-chat(string);
    // WP4b: propose a chain checkpoint (threshold compaction cut)
    // jump from a patch channel's discussion back to its vote — Rust
    // resolves the hosting surface from the proposal cache
    callback jump-to-vote();
    // workspace verbs (engine-backed, co-equal with MCP)
    callback open-workspace(string);
    // real at-rest sealing (S6): encrypt verifies the phrase and removes
    // the device-sealed keys, decrypt verifies and restores them — the
    // same commands the MCP encrypt_/decrypt_workspace tools drive
    callback encrypt-workspace(string, string);
    callback decrypt-workspace(string, string);
    // the phrase dialog for one workspace: decrypt-seal picks the
    // direction (true = sealing/encrypt, false = unsealing/decrypt) —
    // both directions verify the typed recovery phrase in the engine
    property <bool> decrypt-modal-open: false;
    property <bool> decrypt-seal: false;
    property <string> decrypt-id;
    property <string> decrypt-name;
    property <string> decrypt-phrase;
    callback close-workspace();
    // restore verbs (engine-backed: real fetch + decrypt + chain-verify;
    // args: way, target, secret — the recovery phrase / export passphrase)
    callback restore-start(string, string, string);
    callback restore-cancel();
    callback restore-finish();
    // founding verbs (engine-backed; the engine ticks progress + log and
    // derives the seed + invites): name, handle, threshold, members — the
    // transport is NOT a parameter: it always follows the global anonymity
    // settings (Settings → Anonymity network)
    callback create-start(string, string, int, int);
    callback create-cancel();
    callback create-finish();
    // deliberation step: the founder proposes the final name + charter (agenda)
    // once every member has joined; every member then ratifies it
    callback create-propose(string, string);
    // join verbs (engine-backed; the real join runs off the actor and
    // enters the republic on its own once the founder seals)
    callback join-start(string, string);
    callback adopt-invite-relays(string);
    callback join-cancel();
    // the joiner ratifies the founder's proposed charter (releases its seal
    // signature; the workspace opens only after this)
    callback join-confirm-charter();
    callback join-finish();
    // …or declines it (tells the founder, ends the join)
    callback join-decline-charter();
    // copy a text (seed / invite link) into the system clipboard, in Rust
    callback copy-text(string);
    // read the system clipboard (for the paste buttons), handled in Rust
    pure callback paste-clipboard() -> string;
    // parse an invite link for the join preview — the same molt-core parser
    // the engine uses, so preview and run can never disagree
    pure callback parse-invite(string) -> InvitePreview;
    // the Restore wizard's one link field: is this an invite or a recovery
    // link? The answer decides which FIELD is required and which command the
    // continue button issues (`docs_archive/ui/welcome_rework.md`).
    pure callback classify-link(string) -> LinkPreview;
    // live folder preview for the create wizard: (workspace dir, typed
    // name) → the on-disk path, from the same molt-core slug rule the
    // storage layer uses ("" while the name is empty)
    pure callback folder-preview(string, string) -> string;
    // whether a workspace of this name already exists (checks the mirrored
    // session list in Rust; the engine re-validates on create-start)
    // live run logs, mirrored from the engine session; copy-log("restore" |
    // "create" | "join") joins one and puts it on the clipboard
    in property <[string]> rw-log;
    in property <[string]> cw-log;
    // the same log as ONE string (joined in Rust) — feeds the selectable
    // read-only text input the lobby shows
    in property <string> cw-log-text;
    in property <[string]> jw-log;
    // per-line ✓/✗ tones for the three run logs (see cw-log-tone)
    in property <[int]> rw-log-tone;
    in property <[int]> jw-log-tone;
    // the ONE thing that went wrong, a few words, rendered large + signal
    in property <string> rw-headline;
    in property <string> jw-headline;
    in property <string> cw-headline;
    callback copy-log(string);
    // (theme changes are routed via the Theme.picked global callback, bound in Rust)

    // ---- local UI working state (not shared) ----
    // read from Rust (close-settings needs the return target), so in-out
    in-out property <AppScreen> settings-return: AppScreen.choice;
    // modal: leaving settings with unsaved draft edits (raised from Rust)
    in-out property <bool> confirm-leave-open: false;
    // modal: aborting a RUNNING founding ritual (voids every invite link)
    in-out property <bool> confirm-abort-ritual-open: false;
    // mirrored from the engine session (co-equal): which surface the main
    // view shows and which of its sub-views is active; changing them is a
    // SelectSurface / SelectView command
    in property <string> selected-surface: "chat";
    in property <string> selected-view: "today";
    // sidebar mode: expanded (labels) or collapsed to an icon rail. Toggled
    // by clicking the vertical divider on the sidebar's right edge. Off the
    // main screen the sidebar carries no navigation, so the default is the
    // collapsed rail; entering/leaving a workspace re-applies the default
    // (a manual toggle holds within the current screen).
    property <bool> nav-collapsed: root.screen != AppScreen.main;
    // last screen the default was applied for: `screen` is re-pushed with
    // every session snapshot, so only a REAL change may reset a manual toggle
    property <AppScreen> nav-default-screen: AppScreen.choice;
    changed screen => {
        if (root.screen != root.nav-default-screen) {
            root.nav-default-screen = root.screen;
            root.nav-collapsed = root.screen != AppScreen.main;
            // the welcome screen's arrow-key mark starts fresh per visit,
            // and the root scope re-takes focus so the arrow/hotkey handler
            // hears keys even if a (now hidden) wizard field held them
            root.choice-focus = -1;
            if (root.screen == AppScreen.choice) {
                esc.focus();
            }
        }
    }
    // the welcome card marked via arrow keys (-1 = none): mirrors the hover
    // look (ChoiceCard.marked); Enter/Space acts like a click on it
    property <int> choice-focus: -1;
    // focus lifeline for the modal keyboard driving: a ConfirmModal takes
    // focus while it is up (Enter = action, Escape = cancel); when the LAST
    // modal closes — by button, key or scrim — the root scope re-takes
    // focus so the global key handler keeps hearing the keyboard
    property <bool> any-modal-open: root.confirm-close-open
        || root.confirm-leave-open
        || root.confirm-abort-ritual-open
        || root.confirm-quit-open
        || root.confirm-delete-open
        || root.confirm-delmsg-open
        || root.backup-modal-open
        || root.ws-dir-modal-open
        || root.org-logo-modal-open
        || root.org-charter-modal-open
        || root.org-name-modal-open
        || root.org-retention-modal-open
        || root.org-relays-modal-open
        || root.org-features-modal-open
        || root.decrypt-modal-open
        || root.charter-view-open
        || root.relay-clearnet-modal-open
        || root.nt-open
        || root.recover-link-open;
    changed any-modal-open => {
        if (!root.any-modal-open) {
            esc.focus();
        }
    }
    // ONE place performs a welcome card's action — the cards' click handlers
    // and the keyboard paths (arrows + Enter/Space, hotkey letters) share it
    function choice-go(i: int) {
        if (i == 0) {
            root.navigate(AppScreen.open);
        } else if (i == 1) {
            root.reset-create();
            root.navigate(AppScreen.create);
        } else if (i == 3) {
            // S7: restore-from-backup lives in the settings' backup tab —
            // pick a remote workspace there, fetch it sealed, open it from
            // the workspace list with the phrase
            root.settings-return = AppScreen.choice;
            root.set-tab = 2;
            root.navigate(AppScreen.settings);
        } else if (i == 2) {
            root.rw-seed = "";
            // a fresh visit always starts at the way in, never on the
            // phrase step a previous visit walked to
            // …unless a recovery is in flight: it reports on the phrase
            // step, and dropping the user on step 1 would hide it
            root.rw-phase = root.rv-running ? 1 : 0;
            root.rw-pending = root.rv-running ? "recover" : "";
            root.rw-mode = "link";
            // the join half of this wizard starts clean too - the name is
            // only asked for once a link turns out to be an invite
            root.jw-member = "";
            // a recovery already in flight keeps its state; a fresh visit
            // starts clean
            if (!root.rv-running) {
                root.rv-link = "";
                root.rv-error = "";
            }
            root.navigate(AppScreen.restore);
        }
    }
    // modal: confirm closing the workspace (raised by either close button)
    property <bool> confirm-close-open: false;
    // modal: confirm quitting the program while a workspace is open
    // (raised from Rust's window close-requested handler)
    in-out property <bool> confirm-quit-open: false;
    // ---- chat channels (chat bus) ----
    // sidebar rows, pushed from Rust: the DISCUSSIONS of open votes only
    // (the group view is the chat surface's "today" nav row)
    in property <[ChannelItem]> chat-channels;
    // unread count of the group channel — the badge on the Gruppe nav row
    // (the group has no channel row of its own anymore)
    in property <int> group-unread;
    // The SELECTED channel is deliberately UI-LOCAL state (like
    // nav-collapsed), NOT part of the shared SessionView: the filter itself
    // runs engine-side (ReadState { channel }), so GUI and MCP stay
    // co-equal — each operator passes its own filter; which channel this
    // window looks at is presentation, not shared state. Written only from
    // Rust: select-channel echoes the canonical key back into it.
    in property <string> selected-channel: "group";
    // display label of the selected channel ("" = group): the compose
    // banner's feedback — for a fresh topic the only signal it is armed
    in property <string> selected-channel-label: "";
    // the selected channel is a patch channel (a vote's discussion) — set
    // by Rust alongside selected-channel; gates the banner's vote jump
    in property <bool> selected-channel-votable: false;
    // whether the selected channel has a row of its own in the list below —
    // the Gruppe row only stands in for filters that do NOT
    in property <bool> selected-channel-listed: false;
    // the selected channel is a DECIDED vote's discussion: read-only —
    // the compose row collapses and the banner says so (computed in Rust
    // from the engine's channel annotation, instant on selection)
    in property <bool> selected-channel-closed: false;
    // the selected channel is an ORGANIZATION decision's discussion: the
    // compact detail panel sits above the log, so opening a decision's chat
    // always says WHICH decision without scrolling anywhere. Other surfaces'
    // decisions are handled differently and get no panel.
    in property <bool> selected-channel-org: false;
    in property <ProposalRow> selected-decision;
    // Which surface the NAV shows expanded — normally the selected one.
    //
    // An Organization decision's chat lives on the CHAT surface while the
    // user navigated to it from Organization, so following `selected-surface`
    // alone would collapse the section the click came from and hide the row
    // that just started working. Hence the override — but only while the chat
    // pane is actually on screen: the channel does NOT change when the user
    // picks another surface, and without that second term an open decision
    // chat would pin Organization expanded and leave the surface they just
    // clicked collapsed instead.
    property <string> nav-expanded: root.selected-channel-org && root.selected-surface == "chat"
        ? "organization"
        : root.selected-surface;
    callback select-channel(string);
    // new-topic affordance: a MODAL that asks for the name and nothing else.
    // It used to be a reveal row beside the compose field, which put two
    // inputs and two buttons on screen at once and left the user guessing
    // which belonged to which.
    //
    // Still deliberately NOT a "create channel" ritual — a channel exists
    // because a message exists (concept Q2). The dialog only selects it.
    property <bool> nt-open: false;
    property <string> nt-draft: "";
    // mirrors `molt_core::TOPIC_NAME_MAX_CHARS`; the engine normalizes and
    // would refuse a longer name on the first send, which is far too late to
    // tell the user about it
    property <int> nt-max: 64;
    property <string> mv-draft;
    // compose quote state: the id of the message the next send replies to
    // ("" = none); the scroll target stays a row index (chat-scroll-to).
    // Quoting ACROSS channels is allowed — it is one log, the quote is the
    // sanctioned cross-post.
    property <string> mv-quote-id: "";
    property <string> mv-quote-label;
    // one-shot scroll request: the ChatRow with this index brings itself
    // into view and resets it to -1
    property <int> chat-scroll-to: -1;
    // modal: confirm deleting a chat message (holds the target id)
    property <bool> confirm-delmsg-open: false;
    property <string> delmsg-id: "";

    // create: the local configuration draft (like the settings draft, local
    // until create-start hands it to the engine) …
    // the EFFECTIVE global anonymity network ("tor" | "none") — read-only
    // display on the create screen, fed from the saved settings
    in property <string> cw-net: "none";
    property <string> cw-name;
    // the founder's editable charter draft, proposed once every seat is filled
    property <string> cw-agenda;
    // true once the founder has proposed — hides the propose form (the members
    // are now ratifying; re-proposing a different charter would be a footgun)
    property <bool> cw-proposed;
    property <string> cw-member;
    // the re-typed phrase proving the backup (create step 4 / join finish);
    // checked in Rust so whitespace/case never block an honest re-type
    property <string> cw-seed-check;
    property <string> jw-seed-check;
    pure callback seed-matches(string, string) -> bool;
    property <int> cw-threshold: 2;
    property <int> cw-members: 3;
    // the configured workspace root (mirrored from the session settings)
    // and the live on-disk folder preview it yields for the typed name —
    // re-evaluated on every keystroke via the two-way bound cw-name
    in property <string> cw-dir;
    property <string> cw-folder: root.folder-preview(root.cw-dir, root.cw-name);
    // the recommended threshold: the simple majority of n
    property <int> cw-rule-default: Math.floor(root.cw-members / 2) + 1;
    // … and the founding ritual, mirrored from the engine session:
    // step 0 = configure, 1 = ritual lobby; outcome 0 = in ritual,
    // 1 = sealed (workspace created), 2 = failed
    in property <int> cw-step: 0;
    in property <int> cw-outcome: 0;
    in property <string> cw-seed;
    // the member list: founder + one row per seat, rows turn green as
    // members activate their link and sign the roster
    in property <[RitualSeat]> cw-seats;
    in property <int> cw-sealed;   // how many rows are green
    in property <int> cw-total;    // total rows (n)
    in property <bool> cw-can-propose; // every seat joined → deliberation unlocked
    // a seat declined the charter: the failure banner switches from the
    // network wording to "the founding is over" (mirrored from seat state 3)
    in property <bool> cw-declined;
    // per-line tone of the ritual log (0 = neutral, 1 = good, 2 = bad) —
    // computed in Rust from the ✓/✗ prefix, so terminal lines stand out
    in property <[int]> cw-log-tone;
    // the one charter length limit, engine and UI alike (AGENDA_MAX)
    property <int> cw-agenda-max: 4096;
    // the charter step's feature selection (charter_features.md): chat is
    // core and not a property; wallet defaults on, the rest off. Read by
    // the Rust create-propose handler, reset when a ritual starts.
    in-out property <bool> cw-feat-memory: false;
    in-out property <bool> cw-feat-quests: false;
    in-out property <bool> cw-feat-vault: false;
    in-out property <bool> cw-feat-wallet: true;
    // the members are in-process simulations (no real network yet): the
    // lobby shows a SIMULATION badge so it is never mistaken for a real
    // off-band exchange
    in property <bool> cw-simulated;
    // run-header labels ("who is being founded"), composed in Rust so an
    // MCP-started founding shows real values even with an empty local form
    in property <string> cw-run-name;
    in property <string> cw-run-detail;
    out property <bool> cw-running: root.cw-step == 1 && root.cw-outcome == 0;

    // join: the local invite draft + its live preview (parsed by the same
    // molt-core parser the engine runs) …
    property <string> jw-invite;
    property <string> jw-member;
    property <InvitePreview> jw-preview: root.parse-invite(root.jw-invite);
    // … and the join lifecycle, mirrored from the engine session:
    // step 0 = invite form, 1 = run view
    in property <int> jw-step: 0;
    in property <float> jw-progress: 0.0;
    in property <int> jw-outcome: 0;
    in property <string> jw-republic;
    in property <string> jw-rule;
    in property <string> jw-inviter;
    // the joiner's own recovery phrase, generated + shown once during the join
    in property <string> jw-seed;
    // the ratification step: the founder's proposed charter, which the joiner
    // must confirm before its signature is released and the workspace opens
    in property <bool> jw-awaiting-ratify;
    in property <string> jw-proposed-name;
    in property <string> jw-proposed-agenda;
    // the proposed feature selection at the ratification step (a pre-v5
    // founder's proposal renders the legacy baseline: memory only)
    in property <bool> jw-feat-memory;
    in property <bool> jw-feat-quests;
    in property <bool> jw-feat-vault;
    in property <bool> jw-feat-wallet;
    // the join sealed a workspace (join.sealed_id) — entry now waits on the
    // wizard's phrase-backup step and its join-finish()
    in property <bool> jw-sealed;
    out property <bool> jw-running: root.jw-step == 1 && root.jw-outcome == 0;

    // recovery (total-loss rejoin over a molt://recover/… link):
    // coordinator side — mint a single-use link for an anchored seat
    // (RecoverInviteStart); the mint's lifecycle arrives as notices:
    // "recovery-link-pending:" opens the dialog calm-pending, then either
    // "recovery-link:" (the link) or "recovery-link-failed:" (a calm,
    // localized failed state — never an error toast) fills it in
    callback recover-invite(string);
    // rejoiner side — rejoin from link + phrase (RecoverStart)
    callback recover-start(string, string);
    // The Restore wizard's live verdict on its link field, and the two
    // helpers the panel drives from it. Both flows already exist as co-equal
    // commands (join-start / recover-start); what the merge changes is only
    // which of them a click issues.
    property <LinkPreview> rv-kind: root.classify-link(root.rv-link);
    pure function link-armed() -> bool {
        // a run in flight owns the screen: a second start can only be
        // refused, and a button that can only fail reads as a broken UI
        return !root.run-active && !root.rv-running
            && (root.rv-kind.kind == 1 ? root.jw-member != "" : root.rv-kind.kind == 2);
    }
    function link-continue() {
        if (!root.link-armed()) {
            return;
        }
        if (root.rv-kind.kind == 1) {
            // a JOIN needs no phrase at all - the ritual mints one and shows
            // it once, which is why this leg never reaches the phrase step
            root.jw-invite = root.rv-link;
            root.join-start(root.rv-link, root.jw-member);
        } else {
            root.rw-pending = "recover";
            root.rw-phase = 1;
        }
    }
    // the phrase step's own button: it starts whichever leg sent us here
    function phrase-continue() {
        if (root.rw-seed == "") {
            return;
        }
        if (root.rw-pending == "recover") {
            root.recover-start(root.rv-link, root.rw-seed);
        } else if (root.rw-pending == "s3") {
            root.restore-start("s3", root.rw-s3-target, root.rw-seed);
        }
    }
    // the last notice the recovery flow handled (edge-trigger mirror so a
    // re-pushed unchanged session cannot re-fire a dialog; Rust-owned)
    in-out property <string> recover-notice-seen;
    // the minted link and its presentation dialog (opened from Rust when the
    // engine's notices arrive); link == "" and error == "" is the pending
    // state, a non-empty error is the failed state
    in-out property <string> recovery-link;
    in-out property <string> recovery-link-error;
    in-out property <bool> recover-link-open: false;
    in-out property <string> recover-link-member;
    // the rejoiner's recovery link (the peer way on the Restore screen; the
    // phrase is the shared rw-seed) …
    property <string> rv-link;
    // … and its lifecycle, driven by the engine notices (pushed from Rust):
    // running from "recover-started:", error from "recover-failed:"; on
    // success the engine flips to Main by itself
    in-out property <bool> rv-running: false;
    in-out property <string> rv-member;
    in-out property <string> rv-error;
    // the recovery task's live status line (NetRecoverNote) — a bounded
    // wait must not look dead
    in-out property <string> rv-note;

    property <string> rw-seed;
    // restore: chosen backup file + picker modal (continues gate themselves
    // on the inputs, so there are no attempted-validation flags)
    // s3 way: WHICH backup — the workspace-id pseudonym from the settings
    // backup table, or a full molt/<id>/<ts>.molt.enc object key
    property <string> rw-s3-target;
    // restore lifecycle, mirrored from the engine session (the engine ticks
    // the progress and the live log; the GUI only renders and sends verbs):
    // step 0 = pick a way in, 1 = run view; outcome 0 = running, 1 = ok, 2 = failed
    in property <int> rw-step: 0;
    // The (Re)Join/Recovery wizard's own step, GUI-local: `rw-step` above is
    // the ENGINE's restore RUN state and cannot carry a step the engine
    // knows nothing about. 0 = which way in, 1 = the recovery phrase.
    //
    // The phrase is asked HERE and not before, because a founding invite
    // needs none: joining mints one and shows it once. Asking for it on the
    // first screen made the join look impossible to anyone who did not have
    // a phrase yet - which is everyone a founding invite is meant for.
    property <int> rw-phase: 0;
    // WHICH wizard this screen is running: "link" = (Re)Join / Recovery,
    // "s3" = restore from a backup. One screen, two errands, chosen at the
    // door - they share the phrase step and nothing else, and mixing them
    // on one page made the user pick before they knew there was a choice.
    property <string> rw-mode: "link";
    // A run in flight owns every start button on these screens. Naming it -
    // and offering the way to it - is what keeps a disabled button from
    // reading as a dead one. A JOIN awaiting the charter is the case that
    // has no busy modal to stand behind: that step needs the operator's
    // decision, so blocking the screen would hang it.
    pure function run-banner() -> string {
        if (root.jw-running) {
            return root.jw-awaiting-ratify ? Strings.rw-join-awaits : Strings.rw-join-running;
        }
        if (root.cw-running) {
            return Strings.rw-founding-running;
        }
        // a recovery is NOT part of `run-active` (that one is the three
        // RunCore lifecycles), and the engine has no re-entrancy guard on
        // RecoverStart at all - a second start would raise a second task
        // holding its own relay subscriptions. Not offering it is the fix
        // this layer can make honestly.
        if (root.rv-running) {
            return Strings.rw-recovery-running;
        }
        return "";
    }
    function run-goto() {
        if (root.jw-running) {
            root.navigate(AppScreen.join);
        } else if (root.cw-running) {
            root.navigate(AppScreen.create);
        } else if (root.rv-running) {
            root.rw-mode = "link";
            root.rw-phase = 1; // where a running recovery reports
            root.navigate(AppScreen.restore);
        }
    }
    // what the phrase step will start: "recover" | "s3"
    property <string> rw-pending: "";
    // which dot is lit: the way in, the phrase, then the run
    property <int> rw-dot: root.rw-step == 1 ? 2 : root.rw-phase;
    in property <string> rw-way;
    in property <string> rw-target;
    in property <float> rw-progress: 0.0;
    in property <int> rw-outcome: 0;
    // true while the restore is in flight — locks every escape hatch
    // (header ×, back, chrome controls; Rust blocks the window close too)
    out property <bool> restore-running: root.rw-step == 1 && root.rw-outcome == 0;
    // any engine run in flight (restore / founding / join): one lock for the
    // chrome controls and the WM close (read from Rust)
    out property <bool> run-active: root.restore-running || root.cw-running || root.jw-running;
    // folder picker for the settings workspace tab
    property <bool> ws-dir-modal-open: false;
    // in-out: the native picker (Rust, ws-dir-pick) writes the chosen path;
    // the field stays editable as a manual fallback
    in-out property <string> ws-dir-draft;
    // browse for the workspace folder via the real (rfd) dialog — fills
    // ws-dir-draft
    callback ws-dir-pick();
    // Organization → Status edit drafts (image path + charter). Confirming
    // creates a REAL gated proposal on the Organization surface (org-propose)
    property <bool> org-logo-modal-open: false;
    // in-out: the native picker (Rust, org-logo-pick) writes the chosen path
    in-out property <string> org-logo-draft;
    // the republic's CURRENT image (engine StatusView.image): the file
    // reference, plus the picture when the file is locally loadable — the
    // Rust side loads it (bytes stay with the sharer; mock transfer)
    in property <string> org-img-path;
    in property <image> org-img;
    in property <bool> org-img-set: false;
    // pick a new image via the real (rfd) file dialog — fills org-logo-draft
    callback org-logo-pick();
    // image preview overlay: a proposed image after its (mock) download —
    // the chat file-share mechanism (download from the proposer's device)
    // inline proposed-image viewer: ONE decoded image at a time, keyed by
    // the proposal id it belongs to (-1 = none open) — the card whose id
    // matches renders it inside its own panel, no modal
    in-out property <int> img-inline-id: -1;
    in property <image> img-inline-src;
    // decode the proposed image behind a pending set_image and show it
    // inline in that proposal's card (same id → toggle off); Rust toasts
    // if the bytes do not decode
    callback view-proposal-image(int /* proposal id */, string /* base64 payload bytes */);
    // save the proposed image's original bytes to disk (save dialog,
    // suggested file name = the proposal's value)
    callback save-proposal-image(string /* base64 payload bytes */, string /* file name */);
    property <bool> org-charter-modal-open: false;
    property <string> org-charter-draft;
    property <bool> org-name-modal-open: false;
    property <string> org-name-draft;
    // charter reader (click on the charter → full text, scrollable)
    property <bool> charter-view-open: false;
    // chat-retention setting (mock current value; a change is a proposal)
    // the effective "delete chat after" window — mirrored from the
    // engine's StatusView (an applied set_chat_retention changes it)
    in property <int> org-chat-retention: 7;
    // the GROUP's relay pool (StatusView.relays), shown beside the other
    // group settings — empty on a legacy queue-shaped republic
    in property <[string]> org-relays;
    // the create wizard's relay picker: this node's dialable relays and the
    // founder's choice among them
    in property <[RelayPick]> cw-relay-picks;
    callback cw-toggle-relay(int);
    property <bool> org-retention-modal-open: false;
    property <int> org-retention-draft: 7;
    // the charter's EFFECTIVE feature selection (StatusView.features) and
    // the enable-modal's draft; an already-enabled feature is locked in the
    // modal - enable-only, the engine refuses removals either way
    in property <bool> org-feat-memory;
    in property <bool> org-feat-quests;
    in property <bool> org-feat-vault;
    in property <bool> org-feat-wallet;
    property <bool> org-features-modal-open: false;
    property <bool> of-memory-draft;
    property <bool> of-quests-draft;
    property <bool> of-vault-draft;
    property <bool> of-wallet-draft;
    property <bool> org-relays-modal-open: false;
    // R6 pool-edit modal: the draft as ROWS plus the space-joined payload
    // string — the Rust side keeps the two in step (set-relay-draft-rows)
    in-out property <string> org-relays-draft;
    in-out property <[string]> org-relays-draft-rows: [];
    in-out property <string> org-relay-add-draft;
    in-out property <string> org-relay-add-error;
    // mirrors the engine's make-before-break gate (Rust-computed): the
    // draft keeps at least one relay of the effective pool, so Propose
    // never sends what the engine would refuse after the modal closed
    in-out property <bool> org-relays-draft-overlap: true;
    // the pool, space-joined by Rust — the pencil's draft prefill
    in property <string> org-relays-joined;
    // the OPEN workspace's transport kind ("nostr" on a relay republic) —
    // what §10.7 file gating and the §6.5 coarse-presence hint key on
    in property <string> session-transport;

    // settings: a local editable draft, seeded from the engine session by Rust.
    in-out property <bool> cfg-headless: false;
    in-out property <string> cfg-workspace-dir;
    // where downloaded chat files land (config-file setting; no edit UI
    // yet — mirrored so a settings save round-trips it unchanged)
    in-out property <string> cfg-download-dir;
    in-out property <int> cfg-mcp-port: 4040;
    in-out property <string> cfg-mcp-allow: "127.0.0.1";
    in-out property <string> cfg-mcp-token;
    in-out property <int> cfg-network-index: 0;
    in-out property <int> cfg-tor-mode-index: 0;
    // per-row enabled flags for the tor-mode dropdown (["local","embedded",
    // "whonix"]); Rust greys "embedded" unless the binary was built with the
    // embedded-tor feature (P3). Default matches feature-off.
    in property <[bool]> tor-mode-enabled: [true, false, true];
    in-out property <int> cfg-tor-port: 9050;
    // ---- settings → Nostr relays: the relay pool. NOT part of the settings
    // draft — it is edited live through the Relay* commands (the URL
    // validation and the clearnet acknowledgement live in the engine), so
    // every field here is a pushed mirror, never a form value. ----
    in property <[RelayItem]> relay-rows;
    // how many relays the engine would dial right now (0 = not connected)
    in property <int> relay-dialable: 0;
    // at least one CONFIRMED clearnet relay exists — only then is there
    // anything for the session activation to unlock
    in property <bool> relay-clearnet-confirmed: false;
    // the in-session clearnet activation (resets on every start)
    in property <bool> cfg-clearnet-session: false;
    // the SAVED anonymity setting is tor — the clearnet warning names the
    // right exposure (Tor hides the IP, never the subscriptions)
    in property <bool> net-tor-active: false;
    // in-out: Rust clears the field only once the engine ACCEPTED the entry,
    // so a refused URL stays there to be corrected
    in-out property <string> relay-draft;
    // the add field's inline message: the localized reason the pool refused
    // a URL, or an engine refusal verbatim — never a silent failure
    in-out property <string> relay-error;
    callback relay-add(string);
    callback relay-remove(string);
    callback relay-move(string /* url */, bool /* up */);
    callback relay-confirm(string /* url */, bool /* accept-clearnet */);
    callback relay-revoke(string);
    callback relay-clearnet-session(bool /* unlock */);
    // the outside-Tor warning: the ONLY path from the GUI to a confirmed
    // clearnet or local relay. The acknowledgement starts unchecked on EVERY
    // open; the body names the CONCRETE exposure of the relay's kind.
    property <bool> relay-clearnet-modal-open: false;
    property <string> relay-clearnet-url;
    property <int> relay-clearnet-kind: 1; // 1 clearnet · 2 local
    property <bool> relay-clearnet-ack: false;
    function open-clearnet-warning(url: string, kind: int) {
        root.relay-clearnet-url = url;
        root.relay-clearnet-kind = kind;
        root.relay-clearnet-ack = false;
        root.relay-clearnet-modal-open = true;
    }
    function close-clearnet-warning() {
        root.relay-clearnet-modal-open = false;
        root.relay-clearnet-ack = false;
    }
    in-out property <bool> cfg-s3-backup: false;
    in-out property <string> cfg-s3-endpoint;
    in-out property <string> cfg-s3-access;
    in-out property <string> cfg-s3-secret;
    in-out property <string> cfg-s3-bucket;
    // pushed from Rust: "" untested · "testing" · "ok" · "error: …"
    in property <string> cfg-s3-test;
    // run a live signed probe against the S3 target in the draft
    callback test-s3();
    // The Tor probe's verdict, pushed from Rust on every session update (it is
    // transient and lives outside the settings draft, like cfg-s3-test).
    // `cfg-tor-test` is the rung's key (molt_core::TorTestState::as_str) —
    // "idle" hides the line, "testing" is a probe in flight; `-text` is the
    // resolved localized sentence for that rung and `-tone` its colour
    // (0 neutral · 1 good · 2 warn · 3 bad — only a proven circuit is ever 1);
    // `-detail` is the untranslated technical specifics.
    in property <string> cfg-tor-test;
    in property <string> cfg-tor-test-text;
    in property <int> cfg-tor-test-tone;
    in property <string> cfg-tor-test-detail;
    // probe the anonymity settings in the DRAFT (restart-required, so they are
    // usually unsaved when the user wants to know whether Tor is there)
    callback test-tor();
    // pushed from Rust: "" never listed · "listing" · "ok" · "error: …"
    in property <string> cfg-bk-list;
    // list the SAVED backup target's bucket (real ListObjectsV2); the
    // outcome fills the orphan rows of the mapping table below
    callback list-backups();
    in-out property <int> cfg-s3-interval: 60;
    // the Chain-History panel's rows + pager (built Rust-side, paged at 20)
    in property <[ChainRow]> chain-rows;
    in property <int> chain-page: 1;
    in property <int> chain-pages: 1;
    // alert sounds (0 none, 1 bell, 2 chime, 3 pop)
    in-out property <int> cfg-sound-message-index: 0;
    in-out property <int> cfg-sound-vote-index: 0;
    // send (and show) per-message chat read receipts — a local privacy
    // switch, seeded from the applied session so the chat's receipt rows
    // track it live (the settings checkbox binds to it, save persists it).
    in-out property <bool> cfg-read-receipts: true;
    // preview the picked alert once ("bell" | "chime" | "pop")
    callback test-sound(string);
    // backup retention: keep at most this many copies per workspace
    in-out property <int> cfg-s3-copies: 5;
    property <int> set-tab: 0;
    // the backup tab's local↔bucket mapping table (mirrored, built in Rust)
    in property <[BackupRow]> bk-rows;
    // S7: the fetched-sealed outcome (workspace id / honest failure), from
    // the session notice
    in property <string> bk-fetched;
    in property <string> bk-fetch-error;
    callback backup-fetch(string);
    callback set-ws-backup(string, bool);
    // backup-table sorting (view-local, like the Open list): column key
    // ("" = session order) + direction; the sort runs in Rust over the
    // mirrored model and is re-applied on every session push.
    in-out property <string> bk-sort-key: "";
    in-out property <bool> bk-sort-desc: false;
    callback sort-backups(string, bool);

    // open screen (mock local workspace list + current selection). The list
    // itself is a Rust-side VecModel so entries can actually be deleted.
    in property <[WorkspaceItem]> ws-list;
    callback delete-workspace(string);
    // list sorting (view-local): column key ("" = session order) + direction.
    // The sort itself runs in Rust over the mirrored model, and is re-applied
    // there whenever the session pushes a fresh list.
    in-out property <string> ws-sort-key: "";
    in-out property <bool> ws-sort-desc: false;
    callback sort-workspaces(string, bool);
    property <int> open-selected: -1;
    property <string> open-id;
    property <string> open-name;
    property <string> open-detail;
    property <string> open-status;
    property <bool> open-synced: false;
    property <int> open-state: 0; // 0 = synced, 1 = syncing, 2 = offline
    property <bool> open-s3: false;
    property <string> open-seed;
    // LIVE binding into the list row (never assigned!) — the other open-*
    // fields are click-time copies, but encrypting/decrypting the selected
    // row must fold the seed/members groups immediately
    property <bool> open-encrypted: root.open-selected >= 0
        && root.open-selected < root.ws-list.length
        && root.ws-list[root.open-selected].encrypted;
    property <[MemberSync]> open-members;
    property <bool> seed-shown: false;
    // Manual-export status — Rust-driven from the session's honest export
    // state (never set locally): the note text, whether it is a failure,
    // and WHICH workspace it belongs to (shown only on that one's panel).
    in-out property <string> export-note;
    in-out property <bool> export-failed: false;
    in-out property <string> export-ws;
    callback export-workspace(string /* id */, string /* path */, string /* passphrase */);

    // ---- toast: short feedback bubble (e.g. after copy-to-clipboard).
    // The timer's `running` is BOUND to toast-open (declarative) — an
    // imperatively restart()ed stopped Timer never fires, which left the
    // bubble on screen forever. A re-trigger while shown only swaps the
    // text; the bubble is gone < 3 s after it appeared, always. ----
    property <string> toast-text;
    property <bool> toast-open: false;
    // tone of the bubble's dot: errors show RED, everything else green
    property <bool> toast-bad: false;
    public function show-toast(msg: string) {
        root.toast-text = msg;
        root.toast-bad = false;
        root.toast-open = true;
    }
    public function show-toast-error(msg: string) {
        root.toast-text = msg;
        root.toast-bad = true;
        root.toast-open = true;
    }
    function hide-toast() {
        root.toast-open = false;
    }
    toast-timer := Timer {
        interval: 2800ms; // the hard < 3 s cap
        running: root.toast-open;
        triggered => {
            root.hide-toast();
        }
    }
    // modal: manual backup — target path + export passphrase for the real
    // encrypted blob (the passphrase property is cleared on close, always)
    property <bool> backup-modal-open: false;
    property <string> backup-path;
    property <string> backup-pass;
    // modal: confirm deleting a workspace (type its name to arm the button;
    // the id is what the delete verb actually addresses)
    property <bool> confirm-delete-open: false;
    property <string> delete-id;
    property <string> delete-name;
    property <string> delete-typed;

    // Select a row on the Open screen: fill the details panel and drop any
    // revealed seed from the previous selection. (The export note is
    // session state, gated per workspace via export-ws — never cleared
    // locally, or a repaint would resurrect it.)
    function select-workspace(i: int, w: WorkspaceItem) {
        root.open-selected = i;
        root.open-id = w.id;
        root.open-name = w.name;
        root.open-detail = w.detail;
        root.open-status = w.status;
        root.open-synced = w.synced;
        root.open-state = w.state;
        root.open-s3 = w.s3;
        root.open-seed = w.seed;
        root.open-members = w.members;
        root.seed-shown = false;
    }

    // Deselect the current row: the details panel folds back to its hint.
    function deselect-workspace() {
        root.open-selected = -1;
        root.open-id = "";
        root.seed-shown = false;
    }

    // Forget the opened workspace entirely (close-workspace): without this a
    // later main-screen entry would show the previous republic's name.
    function reset-open-workspace() {
        root.deselect-workspace();
        root.open-name = "";
        root.open-detail = "";
        root.open-status = "";
        root.open-synced = false;
        root.open-state = 0;
        root.open-s3 = false;
        root.open-seed = "";
        // the chain-history tab exists only WITH a workspace — leave it
        // before it turns into an empty pane
        if (root.set-tab == 7) {
            root.set-tab = 0;
        }
    }

    // Sort the backup table by a header column: clicking the active column
    // again flips the direction.
    function bk-sort-by(key: string) {
        if (root.bk-sort-key == key) {
            root.bk-sort-desc = !root.bk-sort-desc;
        } else {
            root.bk-sort-key = key;
            root.bk-sort-desc = false;
        }
        root.sort-backups(root.bk-sort-key, root.bk-sort-desc);
    }

    // Sort the workspace list by a header column: clicking the active column
    // again flips the direction; a sort drops the row selection (the indices
    // change underneath it).
    function sort-by(key: string) {
        if (root.ws-sort-key == key) {
            root.ws-sort-desc = !root.ws-sort-desc;
        } else {
            root.ws-sort-key = key;
            root.ws-sort-desc = false;
        }
        root.deselect-workspace();
        root.sort-workspaces(root.ws-sort-key, root.ws-sort-desc);
    }

    // Escape presses the active screen's × — but only when that × is
    // clickable (never during a running engine mock-run). An open modal is
    // closed first, like a click on its scrim.
    function handle-escape() {
        if (root.recover-link-open) {
            root.recover-link-open = false;
        } else if (root.confirm-quit-open) {
            root.confirm-quit-open = false;
        } else if (root.confirm-abort-ritual-open) {
            root.confirm-abort-ritual-open = false;
        } else if (root.confirm-leave-open) {
            root.confirm-leave-open = false;
        } else if (root.confirm-close-open) {
            root.confirm-close-open = false;
        } else if (root.confirm-delete-open) {
            root.confirm-delete-open = false;
        } else if (root.confirm-delmsg-open) {
            root.confirm-delmsg-open = false;
        } else if (root.nt-open) {
            // ConfirmModal's own FocusScope takes Escape only while IT holds
            // focus; once the name field is clicked, Escape bubbles here — so
            // without this branch the dialog became uncancellable by keyboard
            // the moment the user started typing. The draft goes with it.
            root.nt-open = false;
            root.nt-draft = "";
        } else if (root.backup-modal-open) {
            root.backup-modal-open = false;
            // every way out of the modal drops the typed export passphrase
            root.backup-pass = "";
        } else if (root.ws-dir-modal-open) {
            root.ws-dir-modal-open = false;
        } else if (root.org-logo-modal-open) {
            root.org-logo-modal-open = false;
        } else if (root.org-charter-modal-open) {
            root.org-charter-modal-open = false;
        } else if (root.org-name-modal-open) {
            root.org-name-modal-open = false;
        } else if (root.charter-view-open) {
            root.charter-view-open = false;
        } else if (root.org-retention-modal-open) {
            root.org-retention-modal-open = false;
        } else if (root.org-relays-modal-open) {
            root.org-relays-modal-open = false;
        } else if (root.org-features-modal-open) {
            root.org-features-modal-open = false;
        } else if (root.decrypt-modal-open) {
            root.decrypt-modal-open = false;
        } else if (root.relay-clearnet-modal-open) {
            // Escape = cancel: the acknowledgement drops with it
            root.close-clearnet-warning();
        } else if (root.screen == AppScreen.open) {
            root.navigate(AppScreen.choice);
        } else if (root.screen == AppScreen.restore && !root.restore-running) {
            if (root.rw-step == 1) {
                root.restore-cancel();
            } else if (root.rw-phase == 1) {
                // back to the way in, not out of the wizard
                root.rw-phase = 0;
            } else {
                root.navigate(AppScreen.choice);
            }
        } else if (root.screen == AppScreen.create) {
            if (root.cw-running) {
                // mid-ritual: ask before voiding every distributed link
                root.confirm-abort-ritual-open = true;
            } else if (root.cw-step == 1) {
                root.create-cancel();
            } else {
                root.navigate(AppScreen.choice);
            }
        } else if (root.screen == AppScreen.join) {
            // a joiner may bail out any time — a stuck wait (spent link,
            // vanished founder) must never trap them
            if (root.jw-step == 1) {
                root.join-cancel();
            } else {
                root.navigate(AppScreen.choice);
            }
        } else if (root.screen == AppScreen.settings) {
            // guarded: raises the unsaved-changes modal when the draft is dirty
            root.close-settings();
        }
    }

    // Fresh founding form defaults.
    function reset-create() {
        root.cw-name = "";
        root.cw-agenda = "";
        root.cw-proposed = false;
        root.cw-member = "";
        root.cw-seed-check = "";
        root.cw-threshold = 2;
        root.cw-members = 3;
        root.cw-feat-memory = false;
        root.cw-feat-quests = false;
        root.cw-feat-vault = false;
        root.cw-feat-wallet = true;
    }

    init => {
        esc.focus();
    }

    // One FocusScope wraps the whole window: unhandled keys bubble up from
    // whatever has focus (including text fields), so Escape always reaches
    // this handler and presses the active screen's × via handle-escape().
    // (Children keep their indentation, like the list+details group idiom.)
    esc := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.handle-escape();
                return accept;
            }
            // welcome screen keyboard driving: Up/Down mark a card (hover
            // look), Enter/Space/Right click it, a title's hotkey letter
            // fires it directly
            if (root.screen == AppScreen.choice && !root.confirm-quit-open) {
                if (event.text == Key.DownArrow) {
                    root.choice-focus = root.choice-focus < 0 ? 0 : Math.mod(root.choice-focus + 1, 4);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.choice-focus = root.choice-focus < 0 ? 3 : Math.mod(root.choice-focus + 3, 4);
                    return accept;
                }
                if (root.choice-focus >= 0
                    && (event.text == Key.Return || event.text == " " || event.text == Key.RightArrow)) {
                    root.choice-go(root.choice-focus);
                    return accept;
                }
                if (event.text.to-lowercase() == Strings.choice-open-key.to-lowercase()) {
                    root.choice-go(0);
                    return accept;
                }
                if (event.text.to-lowercase() == Strings.choice-create-key.to-lowercase()) {
                    root.choice-go(1);
                    return accept;
                }
                if (event.text.to-lowercase() == Strings.choice-restore-key.to-lowercase()) {
                    root.choice-go(2);
                    return accept;
                }
                if (event.text.to-lowercase() == Strings.choice-backup-key.to-lowercase()) {
                    root.choice-go(3);
                    return accept;
                }
            }
            // Left = back wherever back makes sense: handle-escape() encodes
            // exactly that (modals close, open -> welcome, wizard steps walk
            // back with their running-guards) and stays a no-op elsewhere.
            // Reaches here only when no focused element consumed the key —
            // a text field keeps its cursor movement.
            if (event.text == Key.LeftArrow) {
                root.handle-escape();
                return accept;
            }
            reject
        }

    HorizontalLayout {
        spacing: 0;

        // =================================================================
        // Persistent sidebar: wordmark, surfaces (main), and the bottom-left
        // controls (theme / language / settings) + close workspace.
        // =================================================================
        Rectangle {
            width: root.nav-collapsed ? 64px : 252px;
            animate width {
                duration: 140ms;
                easing: ease-in-out;
            }
            background: Theme.panel;
            Rectangle {
                x: parent.width - Theme.border-w;
                width: Theme.border-w;
                height: parent.height;
                background: Theme.line;
            }
            VerticalLayout {
                // wordmark (brand): the moltrepublic.ai lockup as crisp text —
                // molt (orange) · republic (teal) · .ai (orange). The teal follows
                // the theme so it stays legible on the dark palette.
                brand := Rectangle {
                    // same height as the main view's header bar, so the two
                    // top panels line up
                    height: 64px;
                    // per-letter model of the lockup (o = brand orange, else
                    // the theme teal) — split so a hover can shuffle each
                    // letter's colour between the two brand tones
                    property <[{c: string, o: bool}]> letters: [
                        { c: "m", o: true }, { c: "o", o: true }, { c: "l", o: true }, { c: "t", o: true },
                        { c: "r", o: false }, { c: "e", o: false }, { c: "p", o: false }, { c: "u", o: false },
                        { c: "b", o: false }, { c: "l", o: false }, { c: "i", o: false }, { c: "c", o: false },
                        { c: ".", o: true }, { c: "a", o: true }, { c: "i", o: true }];
                    if !root.nav-collapsed: HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 0;
                                for l[i] in brand.letters: Text {
                                    text: l.c;
                                    // hovered: every letter picks one of the
                                    // two brand tones pseudo-randomly, re-
                                    // shuffling ~4×/s (animation-tick only
                                    // runs while the binding is on the hover
                                    // branch); unhovered: the lockup colours
                                    color: brand-ta.has-hover
                                        ? (Math.mod((Math.floor(animation-tick() / 280ms) + i) * (i * 2 + 3), 4) < 2
                                            ? #e65515
                                            : (Theme.theme-index == 1 ? #6fc7d0 : #064955))
                                        : (l.o ? #e65515 : (Theme.theme-index == 1 ? #6fc7d0 : #064955));
                                    animate color { duration: 150ms; }
                                    font-size: 24px;
                                    font-weight: 800;
                                }
                            }
                        }
                    }
                    // collapsed: the brand shrinks to its initial — a hover
                    // spins it once around, unhovering spins it back
                    if root.nav-collapsed: Text {
                        text: "m";
                        color: #e65515;
                        font-size: 26px;
                        font-weight: 800;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        transform-rotation: brand-ta.has-hover ? 360deg : 0deg;
                        animate transform-rotation {
                            duration: 600ms;
                            easing: ease-in-out;
                        }
                    }
                    brand-ta := TouchArea { }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                // workspace navigation (only when a workspace is open): the
                // five surfaces at the top level, each expandable into its
                // sub-views. The selected surface's group is the open one
                // (accordion — mirrored: an MCP select opens it too).
                if root.screen == AppScreen.main: VerticalLayout {
                    padding: 8px;
                    spacing: 3px;
                    alignment: start;
                    for s in root.surfaces: VerticalLayout {
                        spacing: 2px;
                        SurfaceRow {
                            s: s;
                            selected: s.key == root.nav-expanded;
                            compact: root.nav-collapsed;
                            // every row the model delivers is selectable: the
                            // charter's feature gating hides disabled surfaces
                            // in Rust (surface_tabs), and an enabled-but-unbuilt
                            // one opens its badged DESIGN-MOCK pane
                            enabled: true;
                            chosen => {
                                root.mv-draft = "";
                                // clicking "Chat" while an Organization
                                // decision's discussion is the filter is the
                                // way OUT of the nav-expanded pin: the surface
                                // is already "chat", so without resetting the
                                // channel the click changes nothing and the
                                // chat section can never be expanded again
                                // (live incident 2026-08-09, every approval)
                                if (s.key == "chat" && root.selected-channel-org) {
                                    root.select-channel("group");
                                }
                                root.select-surface(s.key);
                            }
                        }
                        if s.key == root.nav-expanded && !root.nav-collapsed: VerticalLayout {
                            spacing: 1px;
                            for v in s.views: VerticalLayout {
                                // Organization → Pending exists only while
                                // something is in voting; open decisions of
                                // THIS node raise the ⚠-badge on the row.
                                // Declined exists only while a decline is
                                // still inside the retention window (the
                                // view empties on the chat rhythm); Accepted
                                // only once something was applied.
                                if (v.key != "pending" || s.pending-count > 0)
                                    && (v.key != "accepted" || s.applied-count > 0)
                                    && (v.key != "declined" || s.declined-count > 0)
                                    // Memory's outcome view (key "denied",
                                    // same semantics as org's "declined")
                                    && (v.key != "denied" || s.declined-count > 0): ViewRow {
                                    // chat's "today" IS the group view —
                                    // localized like the old group channel
                                    // row it replaces
                                    label: s.key == "chat" && v.key == "today" ? Strings.ch-group : v.name;
                                    icon: v.icon;
                                    // exactly ONE active sub-item per surface:
                                    // while an OPEN discussion is the chat
                                    // filter, ITS row below is the active one.
                                    // A filter with no row of its own — group,
                                    // a topic, a decided vote's read-only
                                    // discussion (the sections lists open
                                    // votes only) — keeps the Gruppe row lit;
                                    // the compose banner names the filter.
                                    // exactly ONE active sub-item per surface.
                                    // On chat the Gruppe row is the stand-in
                                    // for every filter WITHOUT a row of its
                                    // own; a filter that has one (a topic, an
                                    // open vote's discussion) owns the
                                    // highlight itself. Standing in for a
                                    // listed channel is how a topic could be
                                    // on screen while the nav said "Gruppe".
                                    selected: v.key == root.selected-view
                                        && (s.key != "chat" || v.key != "today"
                                            || root.selected-channel == "group"
                                            || !root.selected-channel-listed);
                                    pending: v.key == "proposals" || v.key == "pending" ? s.pending-count
                                        : (s.key == "chat" && v.key == "today" ? root.group-unread : 0);
                                    alert: v.key == "pending" ? s.pending-my-vote-count : 0;
                                    alert-total: v.key == "pending" ? s.pending-count : 0;
                                    chosen => {
                                        root.mv-draft = "";
                                        root.select-view(s.key, v.key);
                                        // entering ANY chat view resets the
                                        // channel filter (the Gruppe row
                                        // replaces the old group channel row;
                                        // Archive must not stay silently
                                        // scoped to a stale discussion)
                                        if (s.key == "chat") {
                                            root.select-channel("group");
                                        }
                                    }
                                }
                                // …and Organization → Pending lists its open
                                // decisions BELOW itself: one row each, going
                                // straight into that decision's chat (which
                                // the compact card above the log then heads).
                                //
                                // The section survives the click because the
                                // nav follows `nav-expanded`, not the visible
                                // pane — the chat surface owns that pane, and
                                // collapsing Organization here would hide the
                                // row the user just used.
                                if s.key == "organization" && v.key == "pending"
                                    && s.pending-count > 0: VerticalLayout {
                                    spacing: 1px;
                                    for p in s.pending: ViewRow {
                                        label: p.text;
                                        icon: "🗳";
                                        // one level deeper than the view rows
                                        // they hang under — these are the
                                        // first sub-sub-items in this nav, so
                                        // without it they read as siblings of
                                        // Pending rather than its contents
                                        indent: 14px;
                                        // where this decision stands, quietly
                                        quorum: "\{p.approvals}/\{p.threshold}";
                                        // the channel filter OUTLIVES the
                                        // chat surface, so matching it alone
                                        // left a row lit (and bold) while the
                                        // user was somewhere else entirely —
                                        // the row is active only when its
                                        // discussion is actually on screen
                                        selected: root.selected-channel == "patch:\{p.id}"
                                            && root.selected-surface == "chat"
                                            && root.selected-view == "today";
                                        chosen => {
                                            root.mv-draft = "";
                                            root.select-view("chat", "today");
                                            root.select-channel("patch:\{p.id}");
                                        }
                                    }
                                }
                            }
                        }
                        // chat discussions (chat bus): the patch channels of
                        // OPEN votes only — views over the ONE log, with a
                        // per-channel unread pill; the section exists only
                        // while something is up for a vote. Selecting
                        // re-reads through the engine's channel filter.
                        if s.key == "chat" && s.key == root.nav-expanded && !root.nav-collapsed && root.chat-channels.length > 0: VerticalLayout {
                            spacing: 1px;
                            HorizontalLayout {
                                padding-left: 26px;
                                padding-top: 6px;
                                padding-bottom: 2px;
                                Text {
                                    text: Strings.ch-discussions;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    font-weight: 700;
                                }
                            }
                            for c in root.chat-channels: ViewRow {
                                label: c.label;
                                icon: c.icon;
                                // …and a discussion row only while the log
                                // view shows it (Archive selected = only the
                                // Archive row is active)
                                selected: c.key == root.selected-channel
                                    && root.selected-view == "today";
                                pending: c.unread;
                                chosen => {
                                    // channel switches keep the compose
                                    // draft — only the filter changes
                                    root.select-view("chat", "today");
                                    root.select-channel(c.key);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                // close workspace (only when a workspace is open and the
                // sidebar is expanded; the main-view header keeps its own ×)
                if root.screen == AppScreen.main && !root.nav-collapsed: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 10px;
                    AppButton {
                        label: Strings.mv-close-ws;
                        clicked => {
                            root.confirm-close-open = true;
                        }
                    }
                }

                // theme / language / settings controls (bottom, centered);
                // the icon rail keeps just the settings gear
                Rectangle {
                    height: 56px;
                    if !root.nav-collapsed: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        ChromeControls {
                            popup-up: true;
                            controls-enabled: !root.run-active;
                            lang-index: root.lang-index;
                            open-settings => {
                                // guard: opening settings FROM settings must not
                                // make the close button loop back to settings
                                if (root.screen != AppScreen.settings) {
                                    root.settings-return = root.screen;
                                }
                                root.navigate(AppScreen.settings);
                            }
                            set-language(i) => {
                                root.set-language(i);
                            }
                        }
                    }
                    if root.nav-collapsed: Rectangle {
                        width: 36px;
                        height: 36px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        background: gear-ta.has-hover ? Theme.raised : Theme.panel-2;
                        Image {
                            source: @image-url("assets/gear.svg");
                            colorize: Theme.dim;
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        gear-ta := TouchArea {
                            enabled: !root.run-active;
                            clicked => {
                                if (root.screen != AppScreen.settings) {
                                    root.settings-return = root.screen;
                                }
                                root.navigate(AppScreen.settings);
                            }
                        }
                        HoverTip {
                            label: Strings.tip-settings;
                            shown: gear-ta.has-hover;
                            x: parent.width + 8px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // clickable divider on the sidebar's right edge (below the header,
            // so the wordmark row stays untouched): hover highlights like the
            // horizontal splitter, a click flips expanded <-> icon rail.
            nav-toggle := TouchArea {
                x: parent.width - 8px;
                y: 65px;
                width: 8px;
                height: parent.height - 65px;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.nav-collapsed = !root.nav-collapsed;
                }
            }
            nav-grip := Rectangle {
                x: parent.width - 6px;
                y: 65px + (parent.height - 65px - self.height) / 2;
                width: 5px;
                height: 140px;
                border-radius: Theme.win95 ? 0px : 2.5px;
                background: nav-toggle.pressed || nav-toggle.has-hover ? Theme.accent : Theme.line;
            }
            // hinted gray arrows above/below the grip, pointing where a click
            // takes the sidebar: left = collapse, right = expand
            Text {
                text: root.nav-collapsed ? "▸" : "◂";
                color: Theme.faint;
                font-size: 10px;
                x: nav-grip.x + (nav-grip.width - self.width) / 2;
                y: nav-grip.y - self.height - 8px;
            }
            Text {
                text: root.nav-collapsed ? "▸" : "◂";
                color: Theme.faint;
                font-size: 10px;
                x: nav-grip.x + (nav-grip.width - self.width) / 2;
                y: nav-grip.y + nav-grip.height + 8px;
            }
        }

        // =================================================================
        // Main area: routes the current screen. A subtle radial glow evokes
        // the dark.fi hero (atmospheric in the dark theme, faint elsewhere).
        // =================================================================
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;

            // ---- choice ----
            if root.screen == AppScreen.choice: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 520px;
                        spacing: 12px;
                        Text {
                            text: Strings.choice-title;
                            color: Theme.text;
                            font-size: Theme.fs-h1;
                            font-weight: 800;
                        }
                        Rectangle { height: 8px; }
                        // A run in flight is the FIRST thing this screen has
                        // to say - especially a join awaiting the charter,
                        // which is a human decision with no busy modal to
                        // stand behind. Without this the user starts again,
                        // is told "already running", and sees nothing that
                        // explains where "already" is.
                        if root.run-banner() != "": Rectangle {
                            height: 52px;
                            border-radius: Theme.radius;
                            background: Theme.accent-soft;
                            border-width: max(2px, Theme.border-w);
                            border-color: Theme.accent;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text {
                                    text: root.run-banner();
                                    color: Theme.text;
                                    font-size: Theme.fs-body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                AppButton {
                                    height: 34px;
                                    primary: true;
                                    label: Strings.rw-join-goto;
                                    clicked => {
                                        root.run-goto();
                                    }
                                }
                            }
                        }
                        // Three ways in, and no subtitle telling the reader
                        // to choose one of them. Open and Create are the two
                        // "I know what I want" doors; Restore is the one for
                        // a link in hand - a founding invite and a recovery
                        // link both live behind it, because from where the
                        // user stands they are the same errand (the wizard
                        // tells them apart itself).
                        ChoiceCard {
                            key: Strings.choice-open-key;
                            rest: Strings.choice-open-rest;
                            sub: Strings.choice-open-sub;
                            icon: @image-url("assets/open.svg");
                            marked: root.choice-focus == 0;
                            chosen => {
                                root.choice-go(0);
                            }
                        }
                        ChoiceCard {
                            key: Strings.choice-create-key;
                            rest: Strings.choice-create-rest;
                            sub: Strings.choice-create-sub;
                            icon: @image-url("assets/create.svg");
                            marked: root.choice-focus == 1;
                            chosen => {
                                root.choice-go(1);
                            }
                        }
                        ChoiceCard {
                            lead: Strings.choice-restore-lead;
                            key: Strings.choice-restore-key;
                            rest: Strings.choice-restore-rest;
                            sub: Strings.choice-restore-sub;
                            icon: @image-url("assets/join.svg");
                            marked: root.choice-focus == 2;
                            chosen => {
                                root.choice-go(2);
                            }
                        }
                        ChoiceCard {
                            lead: Strings.choice-backup-lead;
                            key: Strings.choice-backup-key;
                            rest: Strings.choice-backup-rest;
                            icon: @image-url("assets/restore.svg");
                            marked: root.choice-focus == 3;
                            chosen => {
                                root.choice-go(3);
                            }
                        }
                    }
                }
            }

            // ---- create: found a new republic. Step 1 is one configuration
            // screen of three themed panels (republic / approval rule /
            // transport); "Found republic" starts the engine-run founding
            // (progress + live log, like the restore), and on success the
            // founding result appears: the recovery phrase and one one-time
            // invite link per future member. ----
            if root.screen == AppScreen.create: VerticalLayout {
                padding: 24px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: Strings.cw-title;
                        color: Theme.text;
                        font-size: Theme.fs-h1;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    AppButton {
                        label: "×";
                        // always armed: a stuck ritual (a spent link, absent
                        // joiners) must be abortable. Mid-run it asks first —
                        // aborting voids every distributed invite link.
                        clicked => {
                            if (root.cw-running) {
                                root.confirm-abort-ritual-open = true;
                            } else if (root.cw-step == 1) {
                                root.create-cancel();
                            } else {
                                root.navigate(AppScreen.choice);
                            }
                        }
                    }
                }

                // step dots: configure · ritual/invites · charter · phrase & enter
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    for i in 4: Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: i == (root.cw-step == 0 ? 0
                            : (root.cw-outcome == 1 ? 3
                            : ((root.cw-can-propose || root.cw-proposed) && root.cw-outcome == 0 ? 2 : 1))) ? Theme.accent : Theme.line;
                    }
                }

                if root.cw-step == 0: VerticalLayout {
                    spacing: 12px;
                    // pack to the top: leftover height stays blank instead of
                    // inflating the last panel
                    alignment: start;

                    // who this republic is
                    RestoreWay {
                        title: Strings.cw-grp-republic;
                        icon: @image-url("assets/republic.svg");
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 3;
                                    spacing: 5px;
                                    // the panel title IS this field's caption;
                                    // the spacer keeps both fields on one
                                    // baseline beside the captioned one
                                    Rectangle { vertical-stretch: 1; }
                                    AppField {
                                        text <=> root.cw-name;
                                        placeholder: Strings.ph-ws-name;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 5px;
                                    Text {
                                        text: Strings.field-member-name;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                    }
                                    AppField {
                                        text <=> root.cw-member;
                                        placeholder: Strings.ph-member;
                                    }
                                }
                            }
                            // where this republic will live on disk, live
                            // per keystroke (the trailing short id only
                            // exists once the seed is committed at finish)
                            if root.cw-folder != "": Text {
                                text: root.cw-folder;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                overflow: elide;
                            }
                        }
                    }

                    // the m-of-n approval rule, with a live sentence + seats
                    RestoreWay {
                        title: Strings.cw-grp-rule;
                        hint: Strings.cw-rule-hint;
                        icon: @image-url("assets/users.svg");
                        HorizontalLayout {
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 5px;
                                Text {
                                    text: Strings.field-threshold;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                }
                                AppStepper {
                                    width: 120px;
                                    value <=> root.cw-threshold;
                                    // never 1: a lone voice is no threshold,
                                    // and m=1 breeds special cases in the
                                    // decision logic (product decision
                                    // 2026-08-08)
                                    minimum: 2;
                                    maximum: root.cw-members;
                                }
                            }
                            VerticalLayout {
                                spacing: 5px;
                                Text {
                                    text: Strings.field-members;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                }
                                AppStepper {
                                    width: 120px;
                                    value <=> root.cw-members;
                                    minimum: 2;
                                    maximum: 13;
                                    // changing n snaps m to its default — the
                                    // simple majority (⌊n/2⌋+1); m stays freely
                                    // adjustable within 1..=n afterwards
                                    changed(v) => {
                                        root.cw-threshold = root.cw-rule-default;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 7px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "\{Strings.cw-rule-a} \{root.cw-threshold} \{Strings.cw-rule-b} \{root.cw-members} \{Strings.cw-rule-c}";
                                    color: Theme.dim;
                                    font-size: Theme.fs-body;
                                    wrap: word-wrap;
                                }
                                // one seat per member; the filled ones must
                                // approve. Straying more than 1 from the
                                // majority default earns a warning.
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    for i in root.cw-members: Rectangle {
                                        width: 13px;
                                        height: 13px;
                                        border-radius: Theme.win95 ? 0px : 6.5px;
                                        background: i < root.cw-threshold ? Theme.accent : transparent;
                                        border-width: Theme.border-w;
                                        border-color: i < root.cw-threshold ? Theme.accent : Theme.line;
                                    }
                                    if Math.abs(root.cw-threshold - root.cw-rule-default) > 1: Text {
                                        text: "⚠ \{Strings.cw-rule-warn}";
                                        color: Theme.warn;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // how the republic's traffic travels: a READ-ONLY view of
                    // the global anonymity setting — the ritual transport
                    // always comes from Settings → Anonymity network, never from a
                    // per-republic choice (tor doc §P8)
                    // Relays are the one thing the founder can still choose
                    // cheaply — once invites are out, a member who cannot
                    // reach the group's relay has to be re-invited. Relays do
                    // not federate, so this is a hard requirement, not advice.
                    RestoreWay {
                        title: Strings.cw-grp-relays;
                        hint: Strings.cw-relays-hint;
                        icon: @image-url("assets/cloud.svg");
                        VerticalLayout {
                            spacing: 5px;
                            // the founder's PICK — what the invites carry and
                            // what R3 signs into the genesis. Defaults to every
                            // relay this node can dial. A long pool scrolls
                            // inside its own table instead of growing the panel.
                            if root.cw-relay-picks.length > 0: Rectangle {
                                height: min(130px, root.cw-relay-picks.length * 26px);
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 6px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                clip: true;
                                cwrl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: cwrl-list.preferred-height;
                                    cwrl-list := VerticalLayout {
                                        padding: 2px;
                                        padding-right: 10px;
                                        alignment: start;
                                        for r[i] in root.cw-relay-picks: HorizontalLayout {
                                            height: 24px;
                                            spacing: 8px;
                                            AppButton {
                                                width: 26px;
                                                height: 22px;
                                                pad: 0px;
                                                emoji: r.picked ? "✅" : "⬜";
                                                tooltip: Strings.cw-relays-toggle;
                                                clicked => {
                                                    root.cw-toggle-relay(i);
                                                }
                                            }
                                            Text {
                                                text: r.url;
                                                color: r.picked ? Theme.text : Theme.faint;
                                                font-size: Theme.fs-cap;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: cwrl.height;
                                    content-h: cwrl.viewport-height;
                                    scroll-y: cwrl.viewport-y;
                                }
                            }
                            if root.cw-relay-picks.length == 0: Text {
                                text: Strings.cw-relays-none;
                                color: Theme.warn;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                AppButton {
                                    height: 28px;
                                    pad: 10px;
                                    label: Strings.cw-open-relay-settings;
                                    clicked => {
                                        root.settings-return = AppScreen.create;
                                        root.set-tab = 4;
                                        root.navigate(AppScreen.settings);
                                    }
                                }
                            }
                        }
                    }

                    RestoreWay {
                        title: Strings.cw-grp-transport;
                        hint: Strings.cw-transport-hint;
                        icon: @image-url("assets/globe.svg");
                        VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 4.5px;
                                    y: (parent.height - self.height) / 2;
                                    background: root.cw-net == "tor" ? Theme.good : Theme.warn;
                                }
                                Text {
                                    text: "\{Strings.cw-net-label}: \{root.cw-net} - \{root.cw-net == "tor" ? Strings.cw-net-ok-tor : Strings.cw-net-warn}";
                                    color: root.cw-net == "tor" ? Theme.good : Theme.warn;
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: Strings.cw-net-hint-settings;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            // one click to the place that changes it —
                            // especially when the panel is warning that no
                            // anonymization layer is configured
                            HorizontalLayout {
                                alignment: start;
                                AppButton {
                                    height: 28px;
                                    pad: 10px;
                                    label: Strings.cw-open-net-settings;
                                    clicked => {
                                        root.settings-return = AppScreen.create;
                                        root.set-tab = 3;
                                        root.navigate(AppScreen.settings);
                                    }
                                }
                            }
                        }
                    }


                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        AppButton {
                            height: 38px;
                            primary: true;
                            icon: @image-url("assets/create.svg");
                            icon-set: true;
                            label: Strings.cw-found;
                            enabled: root.cw-name != "" && root.cw-member != "";
                            clicked => {
                                root.create-start(root.cw-name, root.cw-member, root.cw-threshold, root.cw-members);
                            }
                        }
                    }
                }
                if root.cw-step == 0: Rectangle {
                    vertical-stretch: 1;
                }

                // step 2 AND the seed step share this branch: the founding
                // ritual lobby — the live member list (rows turn green as
                // members activate their link and sign the roster) and the
                // real ritual event log. Once the republic exists
                // (outcome 1) the phrase step replaces the lobby panels but
                // KEEPS the log: the post-seal lines (mesh bootstrap) land
                // there, and hiding them looked like a dead node.
                if root.cw-step == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;

                    // the founding failed: say so loudly, right where the
                    // user is looking — the log line alone is too quiet for
                    // "nothing will ever appear here". A declined charter
                    // means the ritual is over for good; anything else is a
                    // network-shaped failure and links to the settings.
                    if root.cw-outcome == 2: Rectangle {
                        vertical-stretch: 0;
                        background: Theme.bad.transparentize(0.92);
                        border-radius: Theme.win95 ? 0px : 8px;
                        border-width: Theme.border-w;
                        border-color: Theme.bad;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            // The ONE thing that went wrong, large and in the
                            // signal colour. The generic "founding failed"
                            // title says nothing an operator can act on, so
                            // the headline REPLACES it when there is one.
                            Text {
                                text: root.cw-declined
                                    ? Strings.cw-declined-title
                                    : (root.cw-headline != "" ? root.cw-headline
                                        : Strings.cw-failed-title);
                                color: Theme.bad;
                                font-size: Theme.fs-h1;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.cw-declined ? Strings.cw-declined-hint : Strings.cw-failed-hint;
                                color: Theme.text;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            // the engine's actual failure reason (the last
                            // ritual-log line carries it)
                            if root.cw-log.length > 0: Text {
                                text: root.cw-log[root.cw-log.length - 1];
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-family: "monospace";
                                wrap: word-wrap;
                            }
                            if !root.cw-declined: HorizontalLayout {
                                alignment: start;
                                AppButton {
                                    height: 28px;
                                    pad: 10px;
                                    label: Strings.cw-open-net-settings;
                                    clicked => {
                                        root.settings-return = AppScreen.create;
                                        root.set-tab = 3;
                                        root.navigate(AppScreen.settings);
                                    }
                                }
                            }
                        }
                    }

                    // the charter is OUT — the founder can only wait now, and
                    // the screen must SAY so (a silent lobby right after
                    // "Propose & Seal" reads as a bug)
                    if root.cw-proposed && root.cw-outcome == 0: Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;
                        border-radius: Theme.win95 ? 0px : 8px;
                        border-width: Theme.border-w;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Spinner {
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: Strings.cw-ratify-wait;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                                font-weight: 700;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // the member list: founder + one row per seat. Sized by
                    // its CONTENT (capped, the Flickable scrolls beyond the
                    // cap — a member is never cut off), never stretched; the
                    // log below takes the leftover height. Hidden during the
                    // charter step and the seed step — one thing at a time.
                    if root.cw-outcome != 1
                        && !(root.cw-can-propose && !root.cw-proposed && root.cw-outcome == 0): Rectangle {
                        height: min(340px, 84px + root.cw-seats.length * 49px);
                        background: Theme.panel-2;
                        border-radius: Theme.win95 ? 0px : 8px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: Strings.cw-members-title;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                // honest marker: these members are simulated
                                if root.cw-simulated: Rectangle {
                                    background: Theme.warn;
                                    border-radius: Theme.win95 ? 0px : 4px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 2px;
                                        padding-bottom: 2px;
                                        Text {
                                            text: Strings.cw-sim-badge;
                                            color: #1a1200;
                                            font-size: Theme.fs-cap;
                                            font-weight: 700;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "\{root.cw-sealed} / \{root.cw-total} \{Strings.cw-sealed-word}";
                                    color: root.cw-outcome == 1 ? Theme.good : Theme.faint;
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.cw-simulated ? Strings.cw-ritual-hint-sim : Strings.cw-ritual-hint;
                                color: root.cw-simulated ? Theme.warn : Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                seatfl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: seatlist.preferred-height;
                                    seatlist := VerticalLayout {
                                        spacing: 5px;
                                        alignment: start;
                                        for seat in root.cw-seats: Rectangle {
                                            height: 44px;
                                            border-radius: Theme.win95 ? 0px : 8px;
                                            background: Theme.panel;
                                            border-width: Theme.border-w;
                                            border-color: seat.state == 2 ? Theme.good
                                                : (seat.state == 3 ? Theme.bad : Theme.line);
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 6px;
                                                spacing: 10px;
                                                // status dot: gray waiting, amber
                                                // key-in, green sealed, red declined
                                                Rectangle {
                                                    width: 11px;
                                                    height: 11px;
                                                    border-radius: 5.5px;
                                                    y: (parent.height - self.height) / 2;
                                                    background: seat.state == 2 ? Theme.good
                                                        : (seat.state == 3 ? Theme.bad
                                                        : (seat.state == 1 ? Theme.warn : Theme.line));
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text {
                                                        text: seat.member;
                                                        color: Theme.text;
                                                        font-size: Theme.fs-body;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: seat.detail;
                                                        color: Theme.faint;
                                                        font-size: Theme.fs-cap;
                                                        overflow: elide;
                                                    }
                                                }
                                                // copy the link once it is ready
                                                // (empty until the queue is up)
                                                if seat.state == 0 && seat.detail != "": AppButton {
                                                    height: 28px;
                                                    pad: 10px;
                                                    y: (parent.height - self.height) / 2;
                                                    label: Strings.ow-copy;
                                                    clicked => {
                                                        root.copy-text(seat.detail);
                                                        root.show-toast(Strings.toast-copied);
                                                    }
                                                }
                                                // no link yet: the seat's transport
                                                // is being provisioned — show that
                                                // work, never a blank row
                                                if seat.state == 0 && seat.detail == "" && root.cw-outcome == 0: HorizontalLayout {
                                                    spacing: 8px;
                                                    padding-right: 6px;
                                                    Spinner {
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    Text {
                                                        text: Strings.cw-provisioning;
                                                        color: Theme.faint;
                                                        font-size: Theme.fs-cap;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: seatfl.height;
                                    content-h: seatfl.viewport-height;
                                    scroll-y: seatfl.viewport-y;
                                }
                            }
                        }
                    }

                    // ---- deliberation: the next step, right under the
                    // members — its own panel, accent-framed so it reads as
                    // "input needed now". It never stretches; the log below
                    // takes the leftover height. ----
                    if root.cw-can-propose && !root.cw-proposed && root.cw-outcome == 0: Rectangle {
                        // explicit: a Rectangle's implicit stretch is 1 and
                        // would split the leftover height with the log
                        vertical-stretch: 0;
                        background: Theme.panel;
                        border-radius: Theme.win95 ? 0px : 8px;
                        border-width: Theme.border-w;
                        border-color: Theme.accent;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text {
                                text: Strings.cw-charter-step;
                                color: Theme.accent;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            // the ONE instruction, at reading size — what to
                            // write and what it means
                            Text {
                                text: Strings.cw-charter-hint;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                                wrap: word-wrap;
                            }
                            // the name was fixed when the ritual started —
                            // shown read-only, never re-editable here
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "\{Strings.cw-charter-name-label}:";
                                    color: Theme.faint;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.cw-name;
                                    color: Theme.text;
                                    font-size: Theme.fs-body;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            // the charter itself: seven visible body lines
                            // (plus the skin's 2x8px padding), its own
                            // scroll hint, the engine's 4096-char limit
                            AppArea {
                                height: 7 * 1.2 * Theme.fs-body + 16px;
                                text <=> root.cw-agenda;
                                placeholder: Strings.cw-charter-agenda-ph;
                            }
                            // the feature selection, ratified with the
                            // charter: chat is core (locked on); the rest
                            // is this republic's choice - enable-only
                            // forever, so a vote can add but never remove
                            // content-sized, anchored left - the panel must
                            // not stretch across the step's width
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    background: Theme.panel-2;
                                    border-radius: Theme.win95 ? 0px : 8px;
                                    border-width: Theme.border-w;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 14px;
                                        padding-left: 18px;
                                        padding-right: 22px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: "🧩";
                                                font-family: "Twemoji Mozilla";
                                                font-size: Theme.fs-cap;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: Strings.cw-features;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                vertical-alignment: center;
                                            }
                                        }
                                        GridLayout {
                                            spacing: 10px;
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-chat; checked: true; enabled: false; }
                                                AppCheck { width: 180px; label: Strings.feat-memory; checked <=> root.cw-feat-memory; }
                                            }
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-quests; checked <=> root.cw-feat-quests; }
                                                AppCheck { width: 180px; label: Strings.feat-vault; checked <=> root.cw-feat-vault; }
                                            }
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-wallet; checked <=> root.cw-feat-wallet; }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; }
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: end;
                                    spacing: 6px;
                                    Text {
                                        text: "\{root.cw-agenda.character-count} / \{root.cw-agenda-max}";
                                        color: root.cw-agenda.character-count > root.cw-agenda-max ? Theme.bad : Theme.faint;
                                        font-size: Theme.fs-cap;
                                        horizontal-alignment: right;
                                    }
                                    AppButton {
                                        height: 34px;
                                        primary: true;
                                        label: Strings.cw-propose;
                                        // arms only once a charter is written
                                        // (and within the shared limit)
                                        enabled: root.cw-name != ""
                                            && root.cw-agenda != ""
                                            && root.cw-agenda.character-count <= root.cw-agenda-max;
                                        clicked => {
                                            root.cw-proposed = true;
                                            root.create-propose(root.cw-name, root.cw-agenda);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // the seed step (outcome 1): the republic EXISTS — the
                    // phrase, its re-typed backup proof, and below it the
                    // still-live ritual log. Compact (stretch 0): the log
                    // keeps the leftover height.
                    if root.cw-outcome == 1: SeedConfirmStep {
                        vertical-stretch: 0;
                        seed: root.cw-seed;
                        icon: @image-url("assets/create.svg");
                        armed: root.seed-matches(root.cw-seed-check, root.cw-seed);
                        check <=> root.cw-seed-check;
                        enter => {
                            root.cw-seed-check = "";
                            root.create-finish();
                        }
                        copy-requested => {
                            root.copy-text(root.cw-seed);
                            root.show-toast(Strings.toast-copied);
                        }
                    }

                    // the live ritual log: real events (activated · key
                    // received · signed · workspace created). It owns the
                    // leftover height, on the base background so the text
                    // carries real contrast.
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.panel;
                        border-radius: Theme.win95 ? 0px : 8px;
                        border-width: Theme.border-w;
                        border-color: root.cw-outcome == 2 ? Theme.bad : Theme.line;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                Text {
                                    // the log IS this step's content — its
                                    // title reads like one (gray = unimportant,
                                    // and this is not unimportant)
                                    text: Strings.cw-log-title;
                                    color: Theme.text;
                                    font-size: Theme.fs-h2;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                }
                                AppButton {
                                    height: 26px;
                                    pad: 9px;
                                    label: Strings.ow-copy;
                                    clicked => {
                                        root.copy-log("create");
                                        root.show-toast(Strings.toast-copied);
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                logfl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: max(self.height, logtext.preferred-height);
                                    // pinned to the bottom: the newest line is
                                    // always in view (like the RunView log)
                                    viewport-y: min(0px, self.height - self.viewport-height);
                                    // ONE read-only text input instead of a
                                    // Text-per-line list: the operator can
                                    // SELECT and copy any part of the log
                                    // (wrap, never elide — a failure line's
                                    // tail says what to DO about it)
                                    logtext := TextInput {
                                        width: 100%;
                                        height: logfl.viewport-height;
                                        text: root.cw-log-text;
                                        read-only: true;
                                        color: Theme.text;
                                        font-size: Theme.fs-body;
                                        font-family: "monospace";
                                        single-line: false;
                                        wrap: word-wrap;
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: logfl.height;
                                    content-h: logfl.viewport-height;
                                    scroll-y: logfl.viewport-y;
                                }
                            }
                        }
                    }

                }

            }

            // ---- open (mock empty list) ----
            if root.screen == AppScreen.open: VerticalLayout {
                padding: 24px;
                // side padding matches the 16px list/details splitter gap
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: Strings.ow-title;
                        color: Theme.text;
                        font-size: Theme.fs-h1;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    AppButton {
                        label: "×";
                        clicked => {
                            root.navigate(AppScreen.choice);
                        }
                    }
                }

                // workspace folder + change-folder button
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: ow-dir-ta.has-hover ? Theme.raised : Theme.panel;
                        border-radius: Theme.radius;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        // the path bar is itself clickable and does exactly
                        // what the change-folder button next to it does
                        ow-dir-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.settings-return = AppScreen.open;
                                root.set-tab = 1;
                                root.navigate(AppScreen.settings);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 9px;
                            Image {
                                source: @image-url("assets/open.svg");
                                colorize: Theme.dim;
                                width: 17px;
                                height: 17px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.cfg-workspace-dir;
                                color: Theme.dim;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                    AppButton {
                        height: 40px; // match the folder bar on the left
                        label: Strings.ow-change-folder;
                        clicked => {
                            // open settings on the storage tab, which edits the
                            // workspace folder; return here on close.
                            root.settings-return = AppScreen.open;
                            root.set-tab = 1;
                            root.navigate(AppScreen.settings);
                        }
                    }
                }

                // list + details as one group; the 16px gap matches the old
                // splitter-zone spacing
                VerticalLayout {
                spacing: 16px;
                vertical-stretch: 1;

                // scrollable list of local workspaces / republics, under a
                // sortable table header
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    clip: true;
                    VerticalLayout {

                    // table header: click a column to sort the list by it,
                    // click the active column again to flip the direction.
                    // Cell widths mirror the row columns (dot / name / status
                    // / the two fixed-width buttons), so header and rows align.
                    HorizontalLayout {
                        height: 32px;
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;
                        Rectangle {
                            width: 9px; // status-dot column
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            // the republic's name must never be crowded out
                            // by the fixed columns (mirrored in the rows)
                            min-width: 140px;
                            nh-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.sort-by("name");
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 5px;
                                Text {
                                    text: Strings.ow-col-name;
                                    color: root.ws-sort-key == "name" || nh-ta.has-hover ? Theme.text : Theme.faint;
                                    font-size: Theme.fs-cap;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.ws-sort-key == "name": Text {
                                    text: root.ws-sort-desc ? "▼" : "▲";
                                    color: Theme.accent;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: 110px;
                            sh-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.sort-by("sync");
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 5px;
                                Text {
                                    text: Strings.ow-col-sync;
                                    color: root.ws-sort-key == "sync" || sh-ta.has-hover ? Theme.text : Theme.faint;
                                    font-size: Theme.fs-cap;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.ws-sort-key == "sync": Text {
                                    text: root.ws-sort-desc ? "▼" : "▲";
                                    color: Theme.accent;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: Strings.ow-col-backup;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            font-weight: 700;
                            width: 120px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Strings.ow-col-status;
                            color: Theme.faint;
                            font-size: Theme.fs-cap;
                            font-weight: 700;
                            width: 85px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            // Open / Encrypt-Decrypt / Delete buttons zone
                            // (86 + 12 + 134 + 12 + 86)
                            width: 330px;
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }

                    Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    lfl := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: self.width;
                        viewport-height: lst.preferred-height;
                        lst := VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            for w[i] in root.ws-list: Rectangle {
                                height: 54px;
                                border-radius: Theme.win95 ? 0px : 8px;
                                background: i == root.open-selected ? Theme.raised : (rw-ta.has-hover ? Theme.panel-2 : transparent);
                                // Row-wide touch area first, so the per-row Open
                                // button (later in the tree) sits above it.
                                rw-ta := TouchArea {
                                    clicked => {
                                        // clicking the selected row again deselects
                                        if (root.open-selected == i) {
                                            root.deselect-workspace();
                                        } else {
                                            root.select-workspace(i, w);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 9px;
                                        height: 9px;
                                        border-radius: 4.5px;
                                        y: (parent.height - self.height) / 2;
                                        background: w.state == 0 ? Theme.good : (w.state == 2 ? Theme.faint : Theme.warn);
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        // elide, or a long name widens this row's
                                        // name column and the buttons misalign —
                                        // but never collapse below the header's
                                        // guaranteed name width
                                        min-width: 140px;
                                        Text {
                                            text: w.name;
                                            color: Theme.text;
                                            font-size: Theme.fs-body;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: w.detail;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        // fixed column, aligned under the
                                        // "Last sync" header
                                        width: 110px;
                                        text: w.status;
                                        color: w.state == 0 ? Theme.good : (w.state == 2 ? Theme.dim : Theme.warn);
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // the jump into the S3 backup settings +
                                    // last backup. The gear leads the cell so
                                    // it visibly belongs to the Backup column
                                    // (trailing, it read as part of Status);
                                    // its tip opens to the LEFT — above, the
                                    // first row's tip vanished under the
                                    // clipped table header.
                                    HorizontalLayout {
                                        width: 120px;
                                        spacing: 6px;
                                        AppButton {
                                            width: 26px;
                                            height: 26px;
                                            pad: 0px;
                                            icon-size: 16px;
                                            y: (parent.height - self.height) / 2;
                                            icon: @image-url("assets/gear.svg");
                                            icon-set: true;
                                            tooltip: Strings.ow-backup-cfg;
                                            tooltip-left: true;
                                            clicked => {
                                                root.settings-return = AppScreen.open;
                                                root.set-tab = 2;
                                                root.navigate(AppScreen.settings);
                                            }
                                        }
                                        Text {
                                            text: w.backup;
                                            color: Theme.dim;
                                            font-size: Theme.fs-cap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                    // at-rest state (derived from the dir's
                                    // manifest): encrypted = keys removed,
                                    // inactive until decrypted
                                    Text {
                                        width: 85px;
                                        text: w.encrypted ? Strings.ow-enc : Strings.ow-unenc;
                                        color: w.encrypted ? Theme.warn : Theme.good;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    AppButton {
                                        width: 86px;
                                        height: 32px;
                                        y: (parent.height - self.height) / 2;
                                        label: Strings.ow-open;
                                        primary: true;
                                        enabled: !w.encrypted;
                                        clicked => {
                                            root.select-workspace(i, w);
                                            root.open-workspace(w.id);
                                        }
                                    }
                                    AppButton {
                                        // wide enough for "Entschlüsseln"
                                        width: 134px;
                                        height: 32px;
                                        y: (parent.height - self.height) / 2;
                                        label: w.encrypted ? Strings.ow-decrypt : Strings.ow-encrypt;
                                        clicked => {
                                            // both directions prompt for the
                                            // recovery phrase — sealing needs
                                            // proof before keys are removed
                                            root.decrypt-id = w.id;
                                            root.decrypt-name = w.name;
                                            root.decrypt-phrase = "";
                                            root.decrypt-seal = !w.encrypted;
                                            root.decrypt-modal-open = true;
                                        }
                                    }
                                    AppButton {
                                        width: 86px;
                                        height: 32px;
                                        y: (parent.height - self.height) / 2;
                                        label: Strings.ow-delete;
                                        clicked => {
                                            root.delete-id = w.id;
                                            root.delete-name = w.name;
                                            root.delete-typed = "";
                                            root.confirm-delete-open = true;
                                        }
                                    }
                                }
                            }
                            if root.ws-list.length == 0: Rectangle {
                                height: 64px;
                                Text {
                                    text: Strings.ow-empty;
                                    color: Theme.faint;
                                    font-size: Theme.fs-body;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                    ScrollHint {
                        x: parent.width - 7px;
                        view-h: lfl.height;
                        content-h: lfl.viewport-height;
                        scroll-y: lfl.viewport-y;
                    }
                    } // end scroll area

                    } // end header + scroll-area column
                }

                // details panel — updates when a republic is selected; sizes
                // itself so its content is always fully visible (stretch 0:
                // the list above takes all remaining space). The inner
                // VerticalLayout is what gives the panel its preferred height
                // (conditional children only count inside a layout).
                Rectangle {
                    vertical-stretch: 0;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    VerticalLayout {
                    if root.open-selected < 0: VerticalLayout {
                        padding: 16px;
                        Rectangle {
                            height: 52px;
                            Text {
                                text: Strings.ow-select-hint;
                                color: Theme.faint;
                                font-size: Theme.fs-body;
                                x: 0;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    if root.open-selected >= 0: VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: root.open-name;
                                color: Theme.text;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                            }
                            Text {
                                text: "· \{root.open-detail}";
                                color: Theme.dim;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                            }
                        }
                        // stacked themed groups — backup, seed, members
                        // (each its own theme; the net panel is gone)
                        DetailGroup {
                            title: Strings.ow-grp-backup;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 4.5px;
                                    y: (parent.height - self.height) / 2;
                                    background: root.open-s3 ? Theme.good : Theme.warn;
                                }
                                Text {
                                    text: root.open-s3 ? Strings.ow-s3-on : Strings.ow-s3-off;
                                    color: root.open-s3 ? Theme.good : Theme.warn;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                AppButton {
                                    height: 30px;
                                    pad: 10px;
                                    icon: @image-url("assets/gear.svg");
                                    icon-set: true;
                                    label: Strings.ow-backup-cfg;
                                    clicked => {
                                        // S3 editing lives on the backup
                                        // tab; return here when it closes.
                                        root.settings-return = AppScreen.open;
                                        root.set-tab = 2;
                                        root.navigate(AppScreen.settings);
                                    }
                                }
                                AppButton {
                                    height: 30px;
                                    pad: 10px;
                                    icon: @image-url("assets/floppy.svg");
                                    icon-set: true;
                                    label: Strings.ow-export;
                                    clicked => {
                                        root.backup-path = "~/Backups/" + root.open-name + ".molt.enc";
                                        // never inherit a passphrase from a
                                        // previous (possibly other-workspace)
                                        // modal session
                                        root.backup-pass = "";
                                        root.backup-modal-open = true;
                                    }
                                }
                            }
                            if root.export-note != "" && root.export-ws == root.open-id: Text {
                                text: root.export-note;
                                color: root.export-failed ? Theme.bad : Theme.good;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                        // seed group: only while the workspace is at-rest-
                        // unencrypted (encrypted = no seed material around).
                        // Masked behind the reveal button; a dir from before
                        // seed storage says honestly that nothing is stored.
                        if !root.open-encrypted: DetailGroup {
                            title: Strings.ow-grp-seed;
                            if root.open-seed != "": HorizontalLayout {
                                alignment: start;
                                AppButton {
                                    height: 30px;
                                    pad: 10px;
                                    icon: @image-url("assets/eye.svg");
                                    icon-set: true;
                                    label: root.seed-shown ? Strings.ow-seed-hide : Strings.ow-seed-show;
                                    clicked => {
                                        root.seed-shown = !root.seed-shown;
                                    }
                                }
                            }
                            if root.open-seed != "" && root.seed-shown: SeedPanel {
                                seed: root.open-seed;
                                copy-requested => {
                                    root.copy-text(root.open-seed);
                                    root.show-toast(Strings.toast-copied);
                                }
                            }
                            if root.open-seed == "": Text {
                                text: Strings.ow-seed-missing;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                        // the DAO's members and when each of them last synced;
                        // fixed-width chips laid out as a grid that wraps to
                        // new lines (Slint has no flow layout, so x/y are
                        // computed from the index). Hidden while encrypted —
                        // like the seed, the roster is content.
                        if !root.open-encrypted && root.open-members.length > 0: DetailGroup {
                            title: Strings.ow-members;
                            mgrid := Rectangle {
                                property <length> chip-w: 160px;
                                property <length> chip-h: 24px;
                                property <length> gap: 6px;
                                property <int> cols: max(1, Math.floor(self.width / (self.chip-w + self.gap)));
                                property <int> rows: Math.ceil(root.open-members.length / self.cols);
                                height: self.rows * self.chip-h + max(0, self.rows - 1) * self.gap;
                                for m[i] in root.open-members: Rectangle {
                                    x: Math.mod(i, mgrid.cols) * (mgrid.chip-w + mgrid.gap);
                                    y: Math.floor(i / mgrid.cols) * (mgrid.chip-h + mgrid.gap);
                                    width: mgrid.chip-w;
                                    height: mgrid.chip-h;
                                    border-radius: Theme.win95 ? 0px : 12px;
                                    background: Theme.panel;
                                    border-width: Theme.border-w;
                                    border-color: Theme.line;
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 6px;
                                        // no presence knowledge (closed
                                        // workspace, empty "last") = no dot,
                                        // no fake offline status
                                        if m.last != "": Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            y: (parent.height - self.height) / 2;
                                            background: m.state == 0 ? Theme.good : (m.state == 2 ? Theme.faint : Theme.warn);
                                        }
                                        Text {
                                            text: m.last == "" ? m.name : "\{m.name} · \{m.last}";
                                            color: Theme.dim;
                                            font-size: Theme.fs-cap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                } // end list+details group

            }

            // ---- join via invite: the invite link on top (paste / example,
            // with a live parse check), then — branched off it like the
            // restore ways — what the invite says you are joining, plus your
            // handle and the Join button. Joining is an engine-run (progress
            // + live log); malformed invites fail partway. ----
            if root.screen == AppScreen.join: VerticalLayout {
                padding: 24px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: Strings.jw-title;
                        color: Theme.text;
                        font-size: Theme.fs-h1;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    AppButton {
                        label: "×";
                        // always armed: a joiner stuck waiting (spent link,
                        // vanished founder) must never be trapped — cancel
                        // invalidates the in-flight join task engine-side
                        clicked => {
                            if (root.jw-step == 1) {
                                root.join-cancel();
                            } else {
                                root.navigate(AppScreen.choice);
                            }
                        }
                    }
                }

                // step dots: 1 = the invite, 2 = join progress, 3 = phrase & enter
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    for i in 3: Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: i == (root.jw-sealed ? 2 : root.jw-step) ? Theme.accent : Theme.line;
                    }
                }

                if root.jw-step == 0: VerticalLayout {
                    spacing: 12px;
                    // pack to the top: leftover height stays blank instead of
                    // inflating the last panel
                    alignment: start;

                    // the invite link feeds everything below
                    RestoreWay {
                        title: Strings.jw-grp-invite;
                        hint: Strings.jw-invite-hint;
                        icon: @image-url("assets/join.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            AppField {
                                text <=> root.jw-invite;
                                placeholder: "molt://invite/…";
                                horizontal-stretch: 1;
                            }
                            AppButton {
                                height: 38px;
                                pad: 10px;
                                icon: @image-url("assets/paste.svg");
                                icon-set: true;
                                label: Strings.rw-paste;
                                clicked => {
                                    root.jw-invite = root.paste-clipboard();
                                }
                            }
                        }
                        // any non-empty invite is accepted for now (the real
                        // check comes with the network implementation)
                        if root.jw-invite != "": DotLabel {
                            tone: Theme.good;
                            label: Strings.jw-ok;
                            label-color: Theme.good;
                            label-size: Theme.fs-cap;
                        }
                    }

                    // what you are joining — the parsed republic details when
                    // the invite carries them; dimmed until something is pasted
                    WayBranch {
                        armed: root.jw-invite != "";
                        last: true;
                        RestoreWay {
                            horizontal-stretch: 1;
                            title: root.jw-preview.valid ? root.jw-preview.republic : Strings.jw-grp-preview;
                            hint: root.jw-preview.valid
                                ? "\{root.jw-preview.rule} · \{Strings.jw-invited-by} \{root.jw-preview.inviter}"
                                : Strings.jw-preview-hint;
                            icon: @image-url("assets/republic.svg");
                            HorizontalLayout {
                                spacing: 12px;
                                AppField {
                                    horizontal-stretch: 1;
                                    text <=> root.jw-member;
                                    placeholder: Strings.ph-member;
                                    // Enter confirms, exactly like the button
                                    // beside it — and behind the SAME gate, so
                                    // a keystroke can never start a join the
                                    // button would have refused
                                    accepted => {
                                        if (root.jw-invite != "" && root.jw-member != "") {
                                            root.join-start(root.jw-invite, root.jw-member);
                                        }
                                    }
                                }
                                // the invite already NAMES the republic's
                                // relays, so a joiner refused for not having
                                // them should not have to copy them out of a
                                // chat message by hand
                                if root.jw-preview.missing-relays > 0: AppButton {
                                    height: 38px;
                                    label: "\{Strings.jw-adopt-relays} (\{root.jw-preview.missing-relays})";
                                    clicked => {
                                        root.adopt-invite-relays(root.jw-invite);
                                        root.show-toast(Strings.jw-adopt-done);
                                    }
                                }
                                AppButton {
                                    height: 38px;
                                    primary: true;
                                    enabled: root.jw-invite != "" && root.jw-member != "";
                                    label: Strings.jw-join;
                                    clicked => {
                                        root.join-start(root.jw-invite, root.jw-member);
                                    }
                                }
                            }
                        }
                    }

                }
                if root.jw-step == 0: Rectangle {
                    vertical-stretch: 1;
                }

                // step 2: the real join run — the live log while it waits for
                // every member to seal. The recovery phrase is NOT shown here
                // (2026-08-08): a failed founding needs no phrase, and a
                // sealed one gates entry on the backup step below.
                if root.jw-step == 1 && !root.jw-sealed: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    // ---- ratification: confirm the founder's proposed charter
                    if root.jw-awaiting-ratify: Rectangle {
                        border-radius: Theme.win95 ? 0px : 8px;
                        background: Theme.panel;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text {
                                text: Strings.jw-ratify-title;
                                color: Theme.text;
                                font-weight: 700;
                                font-size: Theme.fs-body;
                            }
                            Text {
                                text: root.jw-proposed-name;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                            }
                            Text {
                                text: root.jw-proposed-agenda == "" ? Strings.jw-ratify-agenda-empty
                                    : root.jw-proposed-agenda;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            // the proposed feature selection, exactly as it
                            // will be signed - read-only, off rows dimmed;
                            // the same panel the founder's wizard shows
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    background: Theme.panel-2;
                                    border-radius: Theme.win95 ? 0px : 8px;
                                    border-width: Theme.border-w;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 14px;
                                        padding-left: 18px;
                                        padding-right: 22px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: "🧩";
                                                font-family: "Twemoji Mozilla";
                                                font-size: Theme.fs-cap;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: Strings.cw-features;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                vertical-alignment: center;
                                            }
                                        }
                                        GridLayout {
                                            spacing: 10px;
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-chat; checked: true; enabled: false; }
                                                AppCheck { width: 180px; label: Strings.feat-memory; checked: root.jw-feat-memory; enabled: false; }
                                            }
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-quests; checked: root.jw-feat-quests; enabled: false; }
                                                AppCheck { width: 180px; label: Strings.feat-vault; checked: root.jw-feat-vault; enabled: false; }
                                            }
                                            Row {
                                                AppCheck { width: 180px; label: Strings.feat-wallet; checked: root.jw-feat-wallet; enabled: false; }
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: Strings.jw-ratify-hint;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; }
                                AppButton {
                                    height: 34px;
                                    label: Strings.jw-ratify-decline;
                                    clicked => {
                                        root.join-decline-charter();
                                    }
                                }
                                AppButton {
                                    height: 34px;
                                    primary: true;
                                    label: Strings.jw-ratify-confirm;
                                    clicked => {
                                        root.join-confirm-charter();
                                    }
                                }
                            }
                        }
                    }
                    RunView {
                        vertical-stretch: 1;
                        title: root.jw-republic;
                        hint: root.jw-inviter == "" ? root.jw-rule
                            : "\{root.jw-rule} · \{Strings.jw-invited-by} \{root.jw-inviter}";
                        icon: @image-url("assets/join.svg");
                        progress: root.jw-progress;
                        outcome: root.jw-outcome;
                        ph1: Strings.jw-ph1;
                        ph2: Strings.jw-ph2;
                        ph3: Strings.jw-ph3;
                        ph-founder: Strings.jw-ph-founder;
                        failed-label: Strings.jw-failed;
                        log: root.jw-log;
                        headline: root.jw-headline;
                        tones: root.jw-log-tone;
                        back-shown: false;
                        // a sealed join enters through the phrase-backup
                        // step — so the only button here is the way OUT
                        // after a failure/decline (labelled, never blank)
                        finish-label: root.jw-outcome == 2 ? Strings.jw-back-to-start : "";
                        finish-enabled: root.jw-outcome == 2;
                        finish => {
                            root.join-cancel();
                        }
                        copy-log-clicked => {
                            root.copy-log("join");
                            root.show-toast(Strings.toast-copied);
                        }
                    }
                }

                // step 3: the join SEALED — the phrase-backup step, the exact
                // twin of the founder's. Entering IS the backup confirmation
                // (JoinFinish); the restore-link flow lands here too, because
                // a running join always owns the Join screen (engine-set).
                if root.jw-sealed: SeedConfirmStep {
                    seed: root.jw-seed;
                    icon: @image-url("assets/join.svg");
                    armed: root.seed-matches(root.jw-seed-check, root.jw-seed);
                    check <=> root.jw-seed-check;
                    enter => {
                        root.jw-seed-check = "";
                        root.join-finish();
                    }
                    copy-requested => {
                        root.copy-text(root.jw-seed);
                        root.show-toast(Strings.toast-copied);
                    }
                }
            }

            // ---- the two wizards that share this screen (`rw-mode`):
            // (Re)Join / Recovery from a link, and Backup restore from S3.
            // Step 1 asks the way in, step 2 the recovery phrase - and ONLY
            // when the way in needs one, which a founding invite does not
            // (joining is where a phrase comes from). Step 3 is the run.
            // See docs_archive/ui/welcome_rework.md. ----
            if root.screen == AppScreen.restore: VerticalLayout {
                padding: 24px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: root.rw-mode == "s3" ? Strings.rw-title-s3 : Strings.rw-title;
                        color: Theme.text;
                        font-size: Theme.fs-h1;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    AppButton {
                        label: "×";
                        // no bailing out while the restore is running; after a
                        // failure it works again
                        enabled: !root.restore-running;
                        clicked => {
                            if (root.rw-step == 1) {
                                root.restore-cancel();
                            } else if (root.rw-phase == 1) {
                                root.rw-phase = 0;
                            } else {
                                root.navigate(AppScreen.choice);
                            }
                        }
                    }
                }

                // step dots: the way in · the phrase (when needed) · the run
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    for i in 3: Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: i == root.rw-dot ? Theme.accent : Theme.line;
                    }
                }

                // STEP 2 - the recovery phrase, asked only once we know a
                // way in that needs it. A join never lands here.
                if root.rw-step == 0 && root.rw-phase == 1: VerticalLayout {
                    spacing: 12px;
                    RestoreWay {
                        title: Strings.rw-seed;
                        hint: root.rw-pending == "s3" ? Strings.rw-seed-hint-s3 : Strings.rw-seed-hint;
                        icon: @image-url("assets/key.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            AppField {
                                text <=> root.rw-seed;
                                placeholder: Strings.ph-seed;
                                horizontal-stretch: 1;
                                accepted => {
                                    root.phrase-continue();
                                }
                            }
                            AppButton {
                                height: 38px;
                                pad: 10px;
                                icon: @image-url("assets/paste.svg");
                                icon-set: true;
                                label: Strings.rw-paste;
                                clicked => {
                                    root.rw-seed = root.paste-clipboard();
                                }
                            }
                        }
                        // what this phrase is about to unlock, so the step
                        // never stands there without a subject
                        DotLabel {
                            tone: Theme.good;
                            label: root.rw-pending == "s3"
                                ? root.rw-s3-target
                                : "\{Strings.rw-link-recover} \{root.rv-kind.republic} · \{root.rv-kind.who}";
                            label-color: Theme.text;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            AppButton {
                                height: 38px;
                                label: Strings.rw-back;
                                clicked => {
                                    root.rw-phase = 0;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            AppButton {
                                height: 38px;
                                primary: true;
                                // any run in flight owns the screen (a
                                // second start can only be refused)
                                enabled: !root.run-active && !root.rv-running && root.rw-seed != "";
                                label: Strings.rw-continue;
                                clicked => {
                                    root.phrase-continue();
                                }
                            }
                        }
                        // a recovery runs from HERE: its wait spans the
                        // survivors' human approval, so it reports in place
                        if root.rv-running: VerticalLayout {
                            spacing: 4px;
                            DotLabel {
                                tone: Theme.warn;
                                label: root.rv-member;
                                label-color: Theme.text;
                            }
                            Text {
                                text: Strings.rv-running-note;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            if root.rv-note != "": Text {
                                text: root.rv-note;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                        if root.rv-error != "": VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.rv-error;
                                color: Theme.bad;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Strings.rv-failed-hint;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // STEP 1 - which way in
                if root.rw-step == 0 && root.rw-phase == 0: VerticalLayout {
                spacing: 12px;

                // The one way in that starts from a link somebody sent you.
                // BOTH shapes land here (welcome_rework.md): a founding
                // invite runs the join, a molt://recover/… link runs the
                // recovery ritual with the phrase above. Which one it is, is
                // the link's business to say - not the user's to know. The
                // engine notices drive the running / failed states; a sealed
                // JOIN enters through the join wizard's phrase-backup step
                // (JoinFinish), a recovery still enters by itself.
                if root.rw-mode == "link": WayBranch {
                    // never dimmed: an empty link gates only the Continue
                    // button, not the panel the user is about to type into
                    last: true;
                    RestoreWay {
                    horizontal-stretch: 1;
                    title: Strings.rw-link-title;
                    hero: true;
                    icon: @image-url("assets/link.svg");
                    // THE field this screen is about - hero-sized, accented
                    // and with a readable placeholder. It used to look like
                    // every other grey box on the screen, which left the user
                    // hunting for where to begin.
                    HorizontalLayout {
                        spacing: 8px;
                        AppField {
                            hero: true;
                            text <=> root.rv-link;
                            placeholder: Strings.rw-link-ph;
                            horizontal-stretch: 1;
                            accepted => {
                                root.link-continue();
                            }
                        }
                        AppButton {
                            height: 48px;
                            pad: 12px;
                            primary: root.rv-link == "";
                            icon: @image-url("assets/paste.svg");
                            icon-set: true;
                            label: Strings.rw-paste;
                            clicked => {
                                root.rv-link = root.paste-clipboard();
                            }
                        }
                    }
                    // what the link turned out to be, and what it still
                    // wants. One line, and only once there is a link to
                    // say anything about.
                    if root.rv-link != "": DotLabel {
                        tone: root.rv-kind.kind == 0 ? Theme.bad : Theme.good;
                        label: root.rv-kind.kind == 1
                            ? "\{Strings.rw-link-join} \{root.rv-kind.republic} · \{root.rv-kind.who}"
                            : (root.rv-kind.kind == 2
                                ? "\{Strings.rw-link-recover} \{root.rv-kind.republic} · \{root.rv-kind.who}"
                                : Strings.rw-link-unknown);
                        label-color: root.rv-kind.kind == 0 ? Theme.bad : Theme.text;
                    }
                    // the link's relay pool deviates from this node's — a
                    // hard blocker (relays do not federate), said loudly
                    // BEFORE the run fails on it
                    if root.rv-link != "" && root.rv-kind.kind != 0 && root.rv-kind.missing > 0: DotLabel {
                        tone: Theme.warn;
                        label: "\{root.rv-kind.missing} \{Strings.rw-link-missing-relays} · \{root.rv-kind.missing-first}";
                        label-color: Theme.warn;
                    }
                    // an INVITE needs a name (nobody knows who is joining);
                    // a recovery link brought its seat with it
                    if root.rv-kind.kind == 1: AppField {
                        text <=> root.jw-member;
                        placeholder: Strings.rw-link-name-ph;
                        accepted => {
                            root.link-continue();
                        }
                    }
                    // A run already in flight owns this screen: offering a
                    // Continue that can only answer "already running" is how
                    // the UI reads as broken. Say what is running and lead
                    // there instead.
                    if root.run-banner() != "": HorizontalLayout {
                        spacing: 8px;
                        DotLabel {
                            tone: Theme.warn;
                            label: root.run-banner();
                            label-color: Theme.text;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton {
                            height: 38px;
                            primary: true;
                            label: Strings.rw-join-goto;
                            clicked => {
                                root.run-goto();
                            }
                        }
                    }
                    if root.run-banner() == "": HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        AppButton {
                            height: 38px;
                            primary: true;
                            enabled: root.link-armed();
                            label: Strings.rw-continue;
                            clicked => {
                                root.link-continue();
                            }
                        }
                    }
                }

                }

                // the OTHER wizard: pull the encrypted backup from the
                // configured S3 bucket. Its own door on the Welcome screen,
                // so it never competes with a link for attention.
                if root.rw-mode == "s3": WayBranch {
                    armed: root.rw-s3-target != "";
                    last: true;
                    RestoreWay {
                    horizontal-stretch: 1;
                    title: Strings.rw-via-s3;
                    hint: Strings.rw-s3-hint;
                    icon: @image-url("assets/cloud.svg");
                    VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        // the configured endpoint with its HONEST state: green
                        // only after a real probe succeeded (settings "Test"),
                        // red on a real probe failure, neutral when untested
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            y: (parent.height - self.height) / 2;
                            background: root.cfg-s3-endpoint == "" ? Theme.warn
                                : (root.cfg-s3-test == "ok" ? Theme.good
                                : (root.cfg-s3-test == "" || root.cfg-s3-test == "testing" ? Theme.dim : Theme.bad));
                        }
                        Text {
                            text: root.cfg-s3-endpoint == "" ? Strings.rw-s3-none
                                : (root.cfg-s3-test == "ok" ? "\{root.cfg-s3-endpoint} · \{Strings.rw-s3-ok}"
                                : (root.cfg-s3-test == "" || root.cfg-s3-test == "testing" ? "\{root.cfg-s3-endpoint} · \{Strings.rw-s3-untested}"
                                : "\{root.cfg-s3-endpoint} · \{root.cfg-s3-test}"));
                            color: root.cfg-s3-endpoint == "" ? Theme.warn
                                : (root.cfg-s3-test == "ok" ? Theme.good
                                : (root.cfg-s3-test == "" || root.cfg-s3-test == "testing" ? Theme.dim : Theme.bad));
                            font-size: Theme.fs-body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        AppButton {
                            height: 38px;
                            pad: 10px;
                            icon: @image-url("assets/gear.svg");
                            icon-set: true;
                            label: Strings.ow-backup-cfg;
                            clicked => {
                                root.settings-return = AppScreen.restore;
                                root.set-tab = 2;
                                root.navigate(AppScreen.settings);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        // which backup: the id pseudonym from the backup
                        // table (newest object), or a full object key
                        AppField {
                            text <=> root.rw-s3-target;
                            placeholder: Strings.rw-s3-target-ph;
                            horizontal-stretch: 1;
                        }
                        AppButton {
                            height: 38px;
                            primary: true;
                            enabled: !root.run-active && !root.rv-running
                                && root.cfg-s3-endpoint != "" && root.rw-s3-target != "";
                            label: Strings.rw-continue;
                            clicked => {
                                root.rw-pending = "s3";
                                root.rw-phase = 1;
                            }
                        }
                    }
                    }
                }

                }

                }

                // step 2: the running restore (shared RunView: progress bar,
                // live log, outcome-gated Back/Finish)
                if root.rw-step == 1: RunView {
                    vertical-stretch: 1;
                    // `RestoreStart.way` is "s3" | "file" and nothing else -
                    // a recovery is not a restore and runs its own state
                    title: root.rw-way == "s3" ? Strings.rw-via-s3 : Strings.rw-via-file;
                    hint: root.rw-target;
                    icon: root.rw-way == "s3" ? @image-url("assets/cloud.svg") : @image-url("assets/floppy.svg");
                    progress: root.rw-progress;
                    outcome: root.rw-outcome;
                    ph1: Strings.rw-ph1;
                    ph2: Strings.rw-ph2;
                    ph3: Strings.rw-ph3;
                    failed-label: Strings.rw-failed;
                    log: root.rw-log;
                    headline: root.rw-headline;
                    tones: root.rw-log-tone;
                    back-enabled: root.rw-outcome == 2;
                    finish-enabled: root.rw-outcome == 1;
                    finish-label: Strings.rw-finish;
                    back => {
                        root.restore-cancel();
                    }
                    finish => {
                        root.restore-finish();
                    }
                    copy-log-clicked => {
                        root.copy-log("restore");
                        root.show-toast(Strings.toast-copied);
                    }
                }

                if root.rw-step == 0 && root.rw-phase == 0: Rectangle {
                    vertical-stretch: 1;
                }
            }

            // ---- main view: the selected surface (surfaces live in the sidebar) ----
            if root.screen == AppScreen.main: VerticalLayout {
                // top header bar (same height as the sidebar wordmark, so the
                // two line up): workspace name and the × — the daemon/
                // transport/sync status displays move into the left nav
                // (planned), not up here as pills.
                Rectangle {
                    height: 64px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;
                        // the Multisig-Wiki mock hoists its pane title up
                        // here, left of the republic name — the pane keeps
                        // its full height for navigator + document
                        if root.selected-surface == "memory" && root.selected-view == "brain": HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 22px;
                                clip: true;
                                Text {
                                    text: "🧠";
                                    font-family: "Twemoji Mozilla";
                                    font-size: 16px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: Strings.mem-title-brain;
                                color: Theme.text;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                MockBadge { }
                            }
                            Rectangle {
                                width: 1px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.line;
                            }
                        }
                        Text {
                            text: root.active-workspace == "" ? "Republic" : root.active-workspace;
                            color: Theme.text;
                            font-size: Theme.fs-h2;
                            font-weight: 700;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                label: "×";
                                tooltip: Strings.mv-close-ws;
                                tooltip-left: true;
                                clicked => {
                                    root.confirm-close-open = true;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                // mesh self-heal Phase 4 — honest connection-health banner.
                // `net-health-tone` is set from SessionView.net_health (0 ok /
                // 1 degraded / 2 down; the reason names the troubled peer(s)).
                // Green is silent (no chrome); amber says we are reconnecting
                // (the Stage 3 auto-heal runs and clears it on its own); red is
                // honest that nothing flows, notes the ephemeral gap, and offers
                // a repair route into the existing recovery rejoin.
                if root.net-health-tone > 0: Rectangle {
                    background: root.net-health-tone == 1
                        ? Theme.warn.transparentize(0.9)
                        : Theme.bad.transparentize(0.9);
                    HorizontalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.net-health-tone == 1 ? Theme.warn : Theme.bad;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.net-health-tone == 1: VerticalLayout {
                                    alignment: center;
                                    Spinner {
                                        size: 13px;
                                        tone: Theme.warn;
                                    }
                                }
                                Text {
                                    text: root.net-health-tone == 1
                                        ? Strings.banner-reconnecting
                                        : Strings.banner-disconnected;
                                    color: Theme.text;
                                    font-size: Theme.fs-body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            if root.net-health-reason != "": Text {
                                text: root.net-health-reason;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                overflow: elide;
                            }
                            if root.net-health-tone == 2: Text {
                                text: Strings.banner-gap-note;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                        if root.net-health-tone == 2: VerticalLayout {
                            alignment: center;
                            AppButton {
                                label: Strings.banner-repair;
                                primary: true;
                                tooltip: Strings.banner-repair-tip;
                                tooltip-left: true;
                                clicked => {
                                    root.navigate(AppScreen.restore);
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    for s in root.surfaces: Rectangle {
                    width: 100%;
                    height: 100%;
                    visible: s.key == root.selected-surface;
                    VerticalLayout {
                        // tight to the edges — chat real estate over chrome
                        padding: 8px;
                        spacing: 8px;

                        // chat — konkinwallet-style: the members strip (who
                        // is online right now), zebra-striped messages with
                        // emoji reactions, and a compose box that grows on
                        // Alt+Enter line breaks. One pane for both sub-views:
                        // the engine's ReadState{view} filter decides what
                        // the log holds (General = the younger half of the
                        // retention window, Archive = the older half); the
                        // compose row collapses in the read-only Archive.
                        if s.key == "chat": VerticalLayout {
                            spacing: 8px;

                            // presence strip: fixed-width pills wrapping into
                            // as many rows as needed (index-computed grid —
                            // Slint has no flow layout); a click on a member
                            // jumps to Organization → Members
                            if root.active-members.length > 0: Rectangle {
                                height: pgrid.height + 16px;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                pgrid := Rectangle {
                                    x: 8px;
                                    y: 8px;
                                    width: parent.width - 16px;
                                    property <length> chip-h: 28px;
                                    property <length> gap: 6px;
                                    // as many 150px-minimum columns as fit, then the
                                    // pills stretch to fill the row exactly
                                    property <int> cols: max(1, Math.floor(self.width / (150px + self.gap)));
                                    property <length> chip-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
                                    property <int> rows: Math.ceil(root.active-members.length / self.cols);
                                    height: self.rows * self.chip-h + max(0, self.rows - 1) * self.gap;
                                    for m[i] in root.active-members: MemberPill {
                                        x: Math.mod(i, pgrid.cols) * (pgrid.chip-w + pgrid.gap);
                                        y: Math.floor(i / pgrid.cols) * (pgrid.chip-h + pgrid.gap);
                                        width: pgrid.chip-w;
                                        m: m;
                                        clicked => {
                                            root.select-view("organization", "members");
                                        }
                                    }
                                }
                            }

                            // A DECISION's discussion is headed by the decision
                            // itself: the same card the Organization pane
                            // shows, compact. Opening a decision's chat then
                            // always says which decision, and what it is
                            // waiting for, without scrolling anywhere.
                            // id > 0 = the card is real: a default row (id 0)
                            // must never render — an empty card here was the
                            // reported half-page "Proposal:" wreck
                            if root.selected-channel-org && root.selected-decision.id > 0: ProposalCard {
                                p: root.selected-decision;
                                compact: true;
                                org-img: root.org-img;
                                org-img-set: root.org-img-set;
                                // a decided vote's card loses its buttons for
                                // the same reason its compose row collapses
                                read-only: root.selected-channel-closed;
                                approve => {
                                    root.approve(root.selected-decision.id);
                                }
                                decline => {
                                    root.decline(root.selected-decision.id);
                                }
                            }

                            // A free topic names itself HERE, under the member
                            // pills — the user must see which channel they are
                            // in BEFORE reading a message, not after. This
                            // replaces the "# name" line that used to sit down
                            // by the compose row, below the whole log.
                            //
                            // Topics only: a decision's discussion gets its
                            // detail panel in this slot instead, and the group
                            // chat needs no heading at all.
                            if root.selected-channel != "group" && !root.selected-channel-votable: Rectangle {
                                height: 36px;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 7px;
                                    Text {
                                        text: "#";
                                        color: Theme.accent;
                                        font-size: Theme.fs-h2;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.selected-channel-label;
                                        color: Theme.text;
                                        font-size: Theme.fs-h2;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }

                            // the message list sits on a real panel — writing
                            // straight onto the desktop background read badly,
                            // especially in the brutalism theme
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                clip: true;
                                chfl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: chlist.preferred-height + 8px;
                                    // Pinned to the newest message. The binding
                                    // alone dies on the first manual drag, so
                                    // every content growth re-pins imperatively:
                                    // a new message (own or incoming) always
                                    // scrolls the box to the bottom.
                                    viewport-y: min(0px, self.height - self.viewport-height);
                                    changed viewport-height => {
                                        self.viewport-y = min(0px, self.height - self.viewport-height);
                                    }
                                    // …and on the BOX's height too, which is
                                    // what made a freshly opened workspace
                                    // show an empty chat: the content arrives
                                    // while this Flickable is still 0 high, the
                                    // re-pin above computes 0 - content and
                                    // scrolls the whole log out of sight — and
                                    // an imperative write has by then replaced
                                    // the binding, so nothing corrects it when
                                    // the real height arrives. Leaving the
                                    // surface and coming back rebuilt the box
                                    // with its height already known, which is
                                    // why it looked like the data was missing.
                                    changed height => {
                                        self.viewport-y = min(0px, self.height - self.viewport-height);
                                    }
                                    chlist := VerticalLayout {
                                        // indented message cards with a small
                                        // gap between them
                                        padding: 8px;
                                        padding-left: 16px;
                                        spacing: 4px;
                                        alignment: start;
                                        if s.applied-count == 0: Text {
                                            text: Strings.mv-empty-chat;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        for l[i] in s.log: ChatRow {
                                                line: l;
                                                index: i;
                                                // the local read-receipts switch gates the
                                                // per-member dot row (symmetric hide)
                                                receipts-on: root.cfg-read-receipts;
                                                // replies indent behind their quote;
                                                // neighboring reply groups of
                                                // different targets alternate depth
                                                // (Rust-side annotate_chat_log)
                                                indent-level: l.quote-indent;
                                                scroll-request: root.chat-scroll-to;
                                                // feedback honesty: rows without a
                                                // real id (legacy entries, system
                                                // lines) must never trigger
                                                // success-shaped UI — the buttons
                                                // are hidden in ChatRow, and these
                                                // guards keep the handlers honest
                                                toggle-reaction(emoji) => {
                                                    if (l.id != "") {
                                                        root.toggle-reaction(l.id, emoji);
                                                    }
                                                }
                                                copy-requested => {
                                                    root.copy-text(l.text);
                                                    root.show-toast(Strings.toast-copied);
                                                }
                                                delete-requested => {
                                                    // own rows only: the engine
                                                    // rejects a foreign delete,
                                                    // so the modal must never
                                                    // open for one (the icon is
                                                    // gated the same way)
                                                    if (l.id != "" && l.own) {
                                                        root.delmsg-id = l.id;
                                                        root.confirm-delmsg-open = true;
                                                    }
                                                }
                                                quote-requested => {
                                                    if (l.id != "") {
                                                        root.mv-quote-id = l.id;
                                                        root.mv-quote-label = l.lead + ": " + l.text;
                                                        chat-in.focus();
                                                    }
                                                }
                                                quote-jump => {
                                                    root.chat-scroll-to = l.quote;
                                                }
                                                file-clicked => {
                                                    if (!l.file-available) {
                                                        root.show-toast-error(Strings.mv-file-gone);
                                                    } else if (l.id != "") {
                                                        // opens the save dialog;
                                                        // the outcome toasts via
                                                        // the transfer events
                                                        root.download-file(l.id);
                                                    }
                                                }
                                                file-remove-requested => {
                                                    if (l.id != "") {
                                                        // the confirmation
                                                        // rides the OUTCOME
                                                        // (molt-ui), never
                                                        // the click
                                                        root.remove-file(l.id);
                                                    }
                                                }
                                                bring-into-view => {
                                                    chfl.viewport-y = clamp(
                                                        chfl.viewport-y - (self.absolute-position.y - chfl.absolute-position.y) + 8px,
                                                        min(0px, chfl.height - chfl.viewport-height), 0px);
                                                    root.chat-scroll-to = -1;
                                                }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: chfl.height;
                                    content-h: chfl.viewport-height;
                                    scroll-y: chfl.viewport-y;
                                }
                            }

                            // A DECISION's discussion keeps its compose-side
                            // banner, because it carries the jump back to the
                            // ballot and the read-only note. A free topic does
                            // not: its name is a heading at the top of the pane
                            // now, and repeating it here was the second label
                            // for the same fact.
                            if root.selected-channel-votable: Rectangle {
                                height: 26px;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 6px;
                                border-width: 1px;
                                border-color: Theme.line;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: "#";
                                        color: Theme.accent;
                                        font-size: Theme.fs-cap;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.selected-channel-label;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    // a decided vote's discussion: quiet
                                    // read-only note (the compose row below
                                    // is collapsed)
                                    if root.selected-channel-closed: Text {
                                        text: "🔒 " + Strings.ch-readonly;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                    }
                                    // a discussion is vote-bound: jump back
                                    // to the ballot this channel belongs to
                                    if root.selected-channel-votable: Rectangle {
                                        width: jv-t.width + 14px;
                                        height: 20px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.win95 ? 0px : 5px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: jv-ta.has-hover ? Theme.raised : transparent;
                                        jv-t := Text {
                                            text: "🗳 \{Strings.ch-to-vote}";
                                            color: Theme.dim;
                                            font-size: Theme.fs-cap;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        jv-ta := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.jump-to-vote();
                                            }
                                        }
                                    }
                                }
                            }

                            // replying? a quiet banner names the quoted
                            // message; × drops the quote again
                            if root.mv-quote-id != "": Rectangle {
                                height: 26px;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 6px;
                                border-width: 1px;
                                border-color: Theme.line;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: "↳";
                                        color: Theme.accent;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.mv-quote-label;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.win95 ? 0px : 5px;
                                        background: qx-ta.has-hover ? Theme.raised : transparent;
                                        Text {
                                            text: "×";
                                            color: Theme.dim;
                                            font-size: 13px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        qx-ta := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.mv-quote-id = "";
                                            }
                                        }
                                    }
                                }
                            }

                            // compose: Enter sends; Alt+Enter breaks the line
                            // and the box grows to show the extra text.
                            // (visible + height instead of `if`: chat-in is
                            // focused from outside this row, so it must
                            // always exist.)
                            HorizontalLayout {
                                // ONE reason to collapse: the selected
                                // channel is a decided vote's read-only
                                // discussion. It used to also require the
                                // view to be "today", which silently took
                                // the compose box away on any other chat
                                // view - and made one of them unusable.
                                visible: !root.selected-channel-closed;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: min(122px, max(38px, chat-in.preferred-height + 16px));
                                    background: Theme.panel;
                                    border-radius: Theme.radius;
                                    border-width: Theme.border-w;
                                    border-color: chat-in.has-focus ? Theme.accent : Theme.line;
                                    clip: true;
                                    if root.mv-draft == "": Text {
                                        x: 12px;
                                        y: 10px;
                                        text: Strings.mv-chat-ph;
                                        color: Theme.faint;
                                        font-size: Theme.fs-body;
                                    }
                                    chat-in := TextInput {
                                        x: 12px;
                                        y: 9px;
                                        width: parent.width - 24px;
                                        height: parent.height - 18px;
                                        text <=> root.mv-draft;
                                        color: Theme.text;
                                        font-size: Theme.fs-body;
                                        font-family: "Twemoji Mozilla";
                                        single-line: false;
                                        wrap: word-wrap;
                                        // this whole branch only exists while
                                        // chat/Today is the open view — so the
                                        // keyboard focus lands here the moment
                                        // it opens and you can just type
                                        init => {
                                            self.focus();
                                        }
                                        key-pressed(event) => {
                                            // plain Enter sends; Alt+Enter (and
                                            // Shift+Enter) fall through to the
                                            // TextInput, which inserts the break
                                            if (event.text == Key.Return && !event.modifiers.alt && !event.modifiers.shift) {
                                                root.send-chat(root.mv-draft, root.mv-quote-id);
                                                root.mv-draft = "";
                                                root.mv-quote-id = "";
                                                // keep typing: the focus stays here
                                                self.focus();
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                }
                                // send-to-new-topic: opens the name dialog (a
                                // channel exists because a message exists — no
                                // create ritual); only in the general chat,
                                // since a specific discussion already has its
                                // topic
                                if root.selected-channel == "group": VerticalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        background: root.nt-open ? Theme.accent-soft : (nt-ta.has-hover ? Theme.raised : Theme.panel);
                                        border-radius: Theme.radius;
                                        border-width: Theme.border-w;
                                        border-color: root.nt-open ? Theme.accent : Theme.line;
                                        Text {
                                            text: "#";
                                            color: root.nt-open ? Theme.accent : Theme.dim;
                                            font-size: 19px;
                                            font-weight: 700;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        nt-ta := TouchArea {
                                            clicked => {
                                                root.nt-open = !root.nt-open;
                                            }
                                        }
                                        HoverTip {
                                            label: Strings.ch-new-topic;
                                            shown: nt-ta.has-hover;
                                            x: (parent.width - self.width) / 2;
                                            y: -(self.height + 7px);
                                        }
                                    }
                                }
                                // share a file: opens the native picker —
                                // only the metadata will enter the chat
                                VerticalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        background: at-ta.has-hover ? Theme.raised : Theme.panel;
                                        border-radius: Theme.radius;
                                        border-width: Theme.border-w;
                                        border-color: Theme.line;
                                        Text {
                                            text: "📤";
                                            font-family: "Twemoji Mozilla";
                                            font-size: 19px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        // §10.7 re-decided 2026-08-09: the
                                        // relay file plane shipped — sharing
                                        // works on every transport
                                        at-ta := TouchArea {
                                            clicked => {
                                                root.share-pick();
                                            }
                                        }
                                    }
                                }
                                // emoji palette appends to the draft
                                VerticalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        background: em-ta.has-hover ? Theme.raised : Theme.panel;
                                        border-radius: Theme.radius;
                                        border-width: Theme.border-w;
                                        border-color: Theme.line;
                                        Text {
                                            text: "🙂";
                                            font-family: "Twemoji Mozilla";
                                            font-size: 19px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        em-ta := TouchArea {
                                            clicked => {
                                                compose-emoji.show();
                                            }
                                        }
                                        compose-emoji := PopupWindow {
                                            // anchor the grid's RIGHT edge to the
                                            // button (38px wide): otherwise the
                                            // palette runs off the window edge and
                                            // only its first cells stay visible
                                            x: 38px - (8 * 34px + 7 * 4px + 16px);
                                            y: -54px;
                                            EmojiGrid {
                                                emoji-picked(emoji) => {
                                                    root.mv-draft += emoji;
                                                    compose-emoji.close();
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: end;
                                    AppButton {
                                        height: 38px;
                                        label: Strings.mv-send;
                                        primary: true;
                                        clicked => {
                                            root.send-chat(root.mv-draft, root.mv-quote-id);
                                            root.mv-draft = "";
                                            root.mv-quote-id = "";
                                            // keep typing: focus returns to the box
                                            chat-in.focus();
                                        }
                                    }
                                }
                            }
                        }

                        // Organization → Status: the republic's identity, the
                        // ratified charter, and the live per-surface counts
                        if s.key == "organization" && root.selected-view == "status": Flickable {
                            viewport-width: self.width;
                            viewport-height: os-col.preferred-height;
                            os-col := VerticalLayout {
                                width: 100%;
                                padding: 8px;
                                spacing: 10px;
                                alignment: start;
                                Rectangle {
                                    background: Theme.panel;
                                    border-radius: Theme.win95 ? 0px : 8px;
                                    border-width: Theme.border-w;
                                    border-color: Theme.line;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        // the republic's image stretches to
                                        // ALL surplus width (a banner) once
                                        // one is set — the name keeps its
                                        // preferred width first (a layout
                                        // hands non-stretch children their
                                        // preferred size before surplus, so
                                        // the name always has room)
                                        Rectangle {
                                            min-width: 56px;
                                            preferred-width: 56px;
                                            horizontal-stretch: root.org-img-set ? 1 : 0;
                                            height: 56px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: Theme.win95 ? 0px : 8px;
                                            background: Theme.accent-soft;
                                            border-width: 1px;
                                            border-color: Theme.accent;
                                            // the clip lives on an INNER rect
                                            // so the corner-edit button's
                                            // hover tooltip can spill past
                                            // the image bounds
                                            Rectangle {
                                                width: 100%;
                                                height: 100%;
                                                border-radius: parent.border-radius;
                                                clip: true;
                                                // the ratified image once one is
                                                // set (and locally loadable) —
                                                // the placeholder mark otherwise
                                                if !root.org-img-set: Image {
                                                    source: @image-url("assets/republic.svg");
                                                    colorize: Theme.accent;
                                                    width: 30px;
                                                    height: 30px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                if root.org-img-set: Image {
                                                    source: root.org-img;
                                                    width: 100%;
                                                    height: 100%;
                                                    image-fit: cover;
                                                }
                                            }
                                            // avatar-style corner edit: opens
                                            // the image picker modal
                                            AppButton {
                                                width: 22px;
                                                height: 22px;
                                                pad: 0px;
                                                x: parent.width - self.width + 6px;
                                                y: parent.height - self.height + 6px;
                                                label: "✎";
                                                tooltip: Strings.org-edit;
                                                clicked => {
                                                    root.org-logo-draft = "";
                                                    root.org-logo-modal-open = true;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            alignment: center;
                                            Text {
                                                text: root.active-workspace == "" ? "Republic" : root.active-workspace;
                                                color: Theme.text;
                                                font-size: Theme.fs-h1;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                            }
                                        }
                                        // without an image the spacer pushes
                                        // the rename control to the right
                                        // edge; with the stretching banner
                                        // the image itself is the filler
                                        if !root.org-img-set: Rectangle { horizontal-stretch: 1; }
                                        // renaming the republic is a gated
                                        // change — the edit opens a proposal
                                        // draft, top-right like an app bar
                                        VerticalLayout {
                                            alignment: start;
                                            AppButton {
                                                width: 26px;
                                                height: 26px;
                                                pad: 0px;
                                                label: "✎";
                                                tooltip: Strings.org-edit;
                                                tooltip-left: true;
                                                clicked => {
                                                    root.org-name-draft = root.active-workspace;
                                                    root.org-name-modal-open = true;
                                                }
                                            }
                                        }
                                    }
                                }
                                // untitled info strip: founding date, the
                                // consensus rule, and the member count —
                                // the gated-settings card sits beside it
                                // when the pane is wide enough (its content
                                // is one line; full-width it looked lost)
                                os-row := HorizontalLayout {
                                    spacing: 8px;
                                    property <bool> side-settings: self.width > 680px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.panel-2;
                                        border-radius: Theme.win95 ? 0px : 8px;
                                        border-width: Theme.border-w;
                                        border-color: Theme.line;
                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 22px;
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: Strings.os-founded;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                }
                                                Text {
                                                    text: root.org-founded;
                                                    color: Theme.text;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 700;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: Strings.os-consensus;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                }
                                                Text {
                                                    text: root.threshold-badge;
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 700;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: Strings.ow-members;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                }
                                                Text {
                                                    text: "\{root.org-total}";
                                                    color: Theme.text;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 700;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    if os-row.side-settings: OrgSettingsCard {
                                        width: 300px;
                                        retention: root.org-chat-retention;
                                        relays: root.org-relays;
                                        edit => {
                                            root.org-retention-draft = root.org-chat-retention;
                                            root.org-retention-modal-open = true;
                                        }
                                        edit-relays => {
                                            root.relays-draft-seed();
                                            root.org-relays-modal-open = true;
                                        }
                                    }
                                }
                                DetailGroup {
                                    title: Strings.const-charter-title;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        // up to three balanced display
                                        // columns; a click opens the full,
                                        // scrollable charter reader
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: charter-cols-l.preferred-height;
                                            charter-cols-l := HorizontalLayout {
                                                spacing: 16px;
                                                if root.charter-cols.length == 0: Text {
                                                    text: Strings.const-no-agenda;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-body;
                                                }
                                                for col in root.charter-cols: Text {
                                                    text: col;
                                                    color: Theme.text;
                                                    font-size: Theme.fs-body;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            TouchArea {
                                                enabled: root.charter-cols.length > 0;
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.charter-view-open = true;
                                                }
                                            }
                                        }
                                        // charter changes are gated — the
                                        // edit opens a (mock) proposal draft
                                        AppButton {
                                            width: 26px;
                                            height: 26px;
                                            pad: 0px;
                                            label: "✎";
                                            tooltip: Strings.org-edit;
                                            tooltip-left: true;
                                            clicked => {
                                                root.org-charter-draft = root.active-agenda;
                                                root.org-charter-modal-open = true;
                                            }
                                        }
                                    }
                                }
                                // the charter's feature selection: the same
                                // checkbox language as the wizard, read-only;
                                // the pencil proposes an enable (m-of-n vote,
                                // enable-only - the engine refuses removals)
                                DetailGroup {
                                    title: Strings.cw-features;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        GridLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Row {
                                                AppCheck { label: Strings.feat-chat; checked: true; enabled: false; }
                                                AppCheck { label: Strings.feat-memory; checked: root.org-feat-memory; enabled: false; }
                                            }
                                            Row {
                                                AppCheck { label: Strings.feat-quests; checked: root.org-feat-quests; enabled: false; }
                                                AppCheck { label: Strings.feat-vault; checked: root.org-feat-vault; enabled: false; }
                                            }
                                            Row {
                                                AppCheck { label: Strings.feat-wallet; checked: root.org-feat-wallet; enabled: false; }
                                            }
                                        }
                                        AppButton {
                                            width: 26px;
                                            height: 26px;
                                            pad: 0px;
                                            label: "✎";
                                            tooltip: Strings.org-edit;
                                            tooltip-left: true;
                                            clicked => {
                                                root.of-memory-draft = root.org-feat-memory;
                                                root.of-quests-draft = root.org-feat-quests;
                                                root.of-vault-draft = root.org-feat-vault;
                                                root.of-wallet-draft = root.org-feat-wallet;
                                                root.org-features-modal-open = true;
                                            }
                                        }
                                    }
                                }
                                // settings that are themselves gated changes:
                                // editing one proposes it to the members —
                                // shown down here only when the pane is too
                                // narrow to seat the card beside the strip
                                if !os-row.side-settings: OrgSettingsCard {
                                    retention: root.org-chat-retention;
                                    relays: root.org-relays;
                                    edit => {
                                        root.org-retention-draft = root.org-chat-retention;
                                        root.org-retention-modal-open = true;
                                    }
                                    edit-relays => {
                                        root.relays-draft-seed();
                                        root.org-relays-modal-open = true;
                                    }
                                }
                                // WP4b: chain compaction (checkpoints) runs
                                // AUTOMATICALLY in the engine — no operator
                                // verb here; the sealed toast is the only
                                // surface (MCP keeps propose_checkpoint)
                                // the approvals table shrink-wraps: its
                                // content is a handful of counts — spread
                                // over the full pane it read as empty
                                HorizontalLayout {
                                    alignment: start;
                                    DetailGroup {
                                        title: Strings.org-approvals;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: Strings.oa-col-surface;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 120px;
                                                vertical-alignment: bottom;
                                            }
                                            Text {
                                                text: Strings.mv-applied;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: bottom;
                                            }
                                            Text {
                                                text: Strings.oa-denied;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: bottom;
                                            }
                                            Text {
                                                text: Strings.oa-pending;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: bottom;
                                            }
                                            // the jump-to-vote column carries
                                            // no header
                                            Rectangle { width: 130px; }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                        for st in root.surfaces: HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: st.name;
                                                color: st.gated ? Theme.accent : Theme.text;
                                                font-size: Theme.fs-body;
                                                width: 120px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "\{st.applied-count}";
                                                color: Theme.text;
                                                font-size: Theme.fs-body;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "\{st.denied-count}";
                                                color: st.denied-count > 0 ? Theme.bad : Theme.dim;
                                                font-size: Theme.fs-body;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "\{st.pending-count}";
                                                color: st.pending-count > 0 ? Theme.text : Theme.dim;
                                                font-size: Theme.fs-body;
                                                width: 82px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            // headerless: only when this
                                            // node's own vote is missing, the
                                            // jump straight into the vote
                                            HorizontalLayout {
                                                width: 130px;
                                                alignment: center;
                                                if st.pending-my-vote-count > 0: AppButton {
                                                    height: 26px;
                                                    pad: 8px;
                                                    label: Strings.oa-list-pending;
                                                    clicked => {
                                                        root.mv-draft = "";
                                                        if (st.key == "organization") {
                                                            root.select-view("organization", "pending");
                                                        } else {
                                                            root.select-surface(st.key);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Organization → Members: the live roster with presence
                        if s.key == "organization" && root.selected-view == "members": VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                StatusPill {
                                    label: "\{root.org-online} / \{root.org-total} \{Strings.org-reachable}";
                                    tone: root.org-online == root.org-total ? Theme.good : (root.org-online == 0 ? Theme.faint : Theme.warn);
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                clip: true;
                                om-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: om-list.preferred-height + 8px;
                                    om-list := VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        alignment: start;
                                        // table header
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            Rectangle { width: 9px; }
                                            // Name outweighs the identity
                                            // columns: when space gets tight
                                            // ID and key give way first.
                                            // Every data column sorts on
                                            // click (the ▲/▼ marks the
                                            // active one); only the
                                            // recovery action column stays
                                            // a plain label.
                                            SortHeader {
                                                label: Strings.ow-col-name;
                                                active: root.om-sort-column == "name";
                                                desc: !root.om-sort-ascending;
                                                horizontal-stretch: 3;
                                                min-width: 100px;
                                                clicked => {
                                                    root.sort-members("name");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.om-col-id;
                                                active: root.om-sort-column == "id";
                                                desc: !root.om-sort-ascending;
                                                horizontal-stretch: 1;
                                                min-width: 40px;
                                                max-width: 130px;
                                                clicked => {
                                                    root.sort-members("id");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.om-col-pk;
                                                active: root.om-sort-column == "pk";
                                                desc: !root.om-sort-ascending;
                                                horizontal-stretch: 1;
                                                min-width: 40px;
                                                max-width: 130px;
                                                clicked => {
                                                    root.sort-members("pk");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.om-col-last;
                                                active: root.om-sort-column == "last";
                                                desc: !root.om-sort-ascending;
                                                width: 100px;
                                                clicked => {
                                                    root.sort-members("last");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.om-col-uploads;
                                                active: root.om-sort-column == "uploads";
                                                desc: !root.om-sort-ascending;
                                                width: 70px;
                                                align: end;
                                                clicked => {
                                                    root.sort-members("uploads");
                                                }
                                            }
                                            Text {
                                                text: Strings.om-col-recovery;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 180px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                        for m in root.org-members: Rectangle {
                                            height: 40px;
                                            border-radius: Theme.win95 ? 0px : 6px;
                                            // the own seat stands out: accent
                                            // border and a "(das bin ich)"
                                            // tag behind the name — no tinted
                                            // fill, the border is enough
                                            background: Theme.panel-2;
                                            border-width: 1px;
                                            border-color: m.name == root.node-member ? Theme.accent : Theme.line;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 10px;
                                                Rectangle {
                                                    width: 9px;
                                                    height: 9px;
                                                    border-radius: 4.5px;
                                                    y: (parent.height - self.height) / 2;
                                                    background: m.state == 0 ? Theme.good : (m.state == 1 ? Theme.warn : Theme.faint);
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 3;
                                                    min-width: 100px;
                                                    Text {
                                                        text: m.name == root.node-member ? "\{m.name} \{Strings.om-me}" : m.name;
                                                        color: m.name == root.node-member ? Theme.accent : Theme.text;
                                                        font-size: Theme.fs-body;
                                                        font-weight: 700;
                                                        overflow: elide;
                                                    }
                                                    // R4: the relay-split marker — one compact
                                                    // engine-built line, warn tone
                                                    if m.split != "": Text {
                                                        text: m.split;
                                                        color: Theme.warn;
                                                        font-size: Theme.fs-cap;
                                                        overflow: elide;
                                                    }
                                                }
                                                // identity anchor: fingerprint +
                                                // full key ("—" on a workspace
                                                // without anchored identities),
                                                // each with a copy-to-clipboard
                                                HorizontalLayout {
                                                    horizontal-stretch: 1;
                                                    min-width: 40px;
                                                    max-width: 130px;
                                                    spacing: 4px;
                                                    Text {
                                                        text: m.id == "" ? "-" : m.id;
                                                        color: Theme.dim;
                                                        font-size: Theme.fs-cap;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    if m.id != "": AppButton {
                                                        width: 24px;
                                                        height: 22px;
                                                        pad: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon: @image-url("assets/copy.svg");
                                                        icon-set: true;
                                                        tooltip: Strings.ow-copy;
                                                        clicked => {
                                                            root.copy-text(m.id);
                                                            root.show-toast(Strings.toast-copied);
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    horizontal-stretch: 1;
                                                    min-width: 40px;
                                                    max-width: 130px;
                                                    spacing: 4px;
                                                    Text {
                                                        text: m.pk == "" ? "-" : m.pk;
                                                        color: Theme.faint;
                                                        font-size: Theme.fs-cap;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    if m.pk != "": AppButton {
                                                        width: 24px;
                                                        height: 22px;
                                                        pad: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon: @image-url("assets/copy.svg");
                                                        icon-set: true;
                                                        tooltip: Strings.ow-copy;
                                                        clicked => {
                                                            root.copy-text(m.pk);
                                                            root.show-toast(Strings.toast-copied);
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: m.last;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 100px;
                                                    overflow: elide;
                                                }
                                                // only a button when the member
                                                // shared files — it jumps into
                                                // the uploads table with the
                                                // filter pre-filled to this
                                                // member (view switch + filter
                                                // both run through Rust)
                                                HorizontalLayout {
                                                    width: 70px;
                                                    alignment: end;
                                                    if m.uploads > 0: AppButton {
                                                        height: 28px;
                                                        pad: 10px;
                                                        y: (parent.height - self.height) / 2;
                                                        label: "📎 \{m.uploads}";
                                                        clicked => {
                                                            root.jump-member-uploads(m.name);
                                                        }
                                                    }
                                                }
                                                // mint a single-use recovery
                                                // link for a member who lost
                                                // their device (never for the
                                                // own seat — this node IS its
                                                // device, and only where
                                                // recovery exists: a
                                                // chain-governed republic).
                                                // The member's presence is
                                                // irrelevant — the link is FOR
                                                // an unreachable member. The
                                                // engine's notices drive the
                                                // dialog: pending → link or a
                                                // calm failed state
                                                HorizontalLayout {
                                                    width: 180px;
                                                    alignment: end;
                                                    if root.org-chain-governed && m.name != root.node-member: AppButton {
                                                        height: 28px;
                                                        pad: 10px;
                                                        y: (parent.height - self.height) / 2;
                                                        label: Strings.om-recover-link;
                                                        clicked => {
                                                            root.recover-link-member = m.name;
                                                            root.recover-invite(m.name);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: om-fl.height;
                                    content-h: om-fl.viewport-height;
                                    scroll-y: om-fl.viewport-y;
                                }
                            }
                            // §6.5: presence over relays is traffic-derived
                            // and COARSE — say so, once, under the table
                            if root.session-transport == "nostr": Text {
                                text: Strings.om-coarse;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }

                        // Organization → Uploads: every file shared into the
                        // chat. Only metadata lives here — the bytes move
                        // user-to-user via the share link (mock transfer).
                        if s.key == "organization" && root.selected-view == "uploads": VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            // one filter needle across user, filename and
                            // checksum — the matching runs in Rust (empty =
                            // all rows); the members table's uploads-jump
                            // pre-fills it with a member name
                            Rectangle {
                                height: 34px;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: ou-filter-in.has-focus ? Theme.accent : Theme.line;
                                clip: true;
                                if root.ou-filter == "": Text {
                                    x: 10px;
                                    y: 8px;
                                    text: Strings.ou-filter-ph;
                                    color: Theme.faint;
                                    font-size: Theme.fs-body;
                                }
                                ou-filter-in := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 44px;
                                    text <=> root.ou-filter;
                                    color: Theme.text;
                                    font-size: Theme.fs-body;
                                    single-line: true;
                                    edited => {
                                        root.filter-uploads(self.text);
                                    }
                                }
                                // × clears the needle again (only shown
                                // while one is set)
                                if root.ou-filter != "": Rectangle {
                                    x: parent.width - 30px;
                                    width: 24px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.win95 ? 0px : 5px;
                                    background: oux-ta.has-hover ? Theme.raised : transparent;
                                    Text {
                                        text: "×";
                                        color: Theme.dim;
                                        font-size: 13px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    oux-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.ou-filter = "";
                                            root.filter-uploads("");
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.panel;
                                border-radius: Theme.win95 ? 0px : 8px;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                clip: true;
                                ou-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: ou-list.preferred-height + 8px;
                                    ou-list := VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        alignment: start;
                                        // table header — every column sorts
                                        // on click (toggle asc/desc; the
                                        // ▲/▼ marks the active one). Date,
                                        // size and expiry order by their
                                        // underlying numeric values in
                                        // Rust, never the rendered labels.
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            SortHeader {
                                                label: Strings.ou-col-user;
                                                active: root.ou-sort-column == "user";
                                                desc: !root.ou-sort-ascending;
                                                width: 110px;
                                                clicked => {
                                                    root.sort-uploads("user");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-date;
                                                active: root.ou-sort-column == "date";
                                                desc: !root.ou-sort-ascending;
                                                width: 90px;
                                                clicked => {
                                                    root.sort-uploads("date");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-file;
                                                active: root.ou-sort-column == "file";
                                                desc: !root.ou-sort-ascending;
                                                horizontal-stretch: 1;
                                                clicked => {
                                                    root.sort-uploads("file");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-type;
                                                active: root.ou-sort-column == "type";
                                                desc: !root.ou-sort-ascending;
                                                width: 60px;
                                                clicked => {
                                                    root.sort-uploads("type");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-size;
                                                active: root.ou-sort-column == "size";
                                                desc: !root.ou-sort-ascending;
                                                width: 70px;
                                                align: end;
                                                clicked => {
                                                    root.sort-uploads("size");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-checksum;
                                                active: root.ou-sort-column == "checksum";
                                                desc: !root.ou-sort-ascending;
                                                width: 100px;
                                                align: end;
                                                clicked => {
                                                    root.sort-uploads("checksum");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-download;
                                                active: root.ou-sort-column == "download";
                                                desc: !root.ou-sort-ascending;
                                                width: 110px;
                                                align: center;
                                                clicked => {
                                                    root.sort-uploads("download");
                                                }
                                            }
                                            SortHeader {
                                                label: Strings.ou-col-expires;
                                                active: root.ou-sort-column == "expires";
                                                desc: !root.ou-sort-ascending;
                                                width: 90px;
                                                align: end;
                                                clicked => {
                                                    root.sort-uploads("expires");
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                        if root.org-uploads.length == 0: Text {
                                            // an active filter that matches
                                            // nothing says so, honestly —
                                            // never "no files shared yet"
                                            text: root.ou-filter == "" ? Strings.ou-empty : Strings.ou-no-match;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        for u in root.org-uploads: Rectangle {
                                            height: 40px;
                                            border-radius: Theme.win95 ? 0px : 6px;
                                            background: Theme.panel-2;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            opacity: u.available ? 1.0 : 0.55;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 10px;
                                                Text {
                                                    text: u.user;
                                                    color: u.user == root.node-member ? Theme.accent : Theme.text;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    width: 110px;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: u.date;
                                                    color: Theme.dim;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 90px;
                                                }
                                                Text {
                                                    text: u.name;
                                                    color: Theme.text;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: u.kind;
                                                    color: Theme.dim;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 60px;
                                                }
                                                Text {
                                                    text: u.size;
                                                    color: Theme.dim;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 70px;
                                                    horizontal-alignment: right;
                                                }
                                                Text {
                                                    text: u.checksum;
                                                    color: Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 100px;
                                                    horizontal-alignment: right;
                                                    overflow: elide;
                                                }
                                                // user-to-user transfer: the
                                                // button needs the sharer
                                                // reachable — offline shows
                                                // the hint instead
                                                HorizontalLayout {
                                                    width: 110px;
                                                    alignment: center;
                                                    spacing: 6px;
                                                    // live download status: the
                                                    // percent while moving, a
                                                    // check/warn mark after
                                                    if u.status != "": Text {
                                                        text: u.status;
                                                        color: u.status-kind == 3 ? Theme.bad
                                                            : u.status-kind == 2 ? Theme.accent
                                                            : Theme.dim;
                                                        font-size: Theme.fs-cap;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                    }
                                                    if u.online && u.status-kind != 1: AppButton {
                                                        height: 28px;
                                                        pad: 10px;
                                                        y: (parent.height - self.height) / 2;
                                                        label: Strings.ou-download;
                                                        enabled: u.available && u.id != "";
                                                        clicked => {
                                                            root.download-file(u.id);
                                                        }
                                                    }
                                                    if !u.online && u.status-kind != 1: Text {
                                                        text: Strings.ou-offline;
                                                        color: Theme.faint;
                                                        font-size: Theme.fs-cap;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: u.expires;
                                                    color: u.available ? Theme.dim : Theme.faint;
                                                    font-size: Theme.fs-cap;
                                                    vertical-alignment: center;
                                                    width: 90px;
                                                    horizontal-alignment: right;
                                                }
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: ou-fl.height;
                                    content-h: ou-fl.viewport-height;
                                    scroll-y: ou-fl.viewport-y;
                                }
                            }
                            Text {
                                text: Strings.ou-note;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }

                        // Organization → Pending: charter / name / image /
                        // retention changes in voting — the same proposal cards
                        // (and the same approve/decline commands) as every
                        // other gated surface
                        if s.key == "organization" && root.selected-view == "pending": VerticalLayout {
                            padding: 8px;
                            spacing: 12px;
                            // a heading that owns the pane, not a shy caption
                            Text {
                                text: Strings.mv-pending;
                                color: Theme.text;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                op-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: op-list.preferred-height + 8px;
                                    op-list := VerticalLayout {
                                        padding: 4px;
                                        padding-right: 14px;
                                        spacing: 16px;
                                        alignment: start;
                                        if s.pending-count == 0: Text {
                                            text: Strings.mv-empty-pending;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        for p in s.pending: ProposalCard {
                                            p: p;
                                            org-img: root.org-img;
                                            org-img-set: root.org-img-set;
                                            approve => {
                                                root.approve(p.id);
                                            }
                                            decline => {
                                                root.decline(p.id);
                                            }
                                            discuss => {
                                                // the proposal's discussion is
                                                // its patch channel on the chat
                                                // bus — engine-side filter, like
                                                // the sidebar channel rows
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{p.id}");
                                            }
                                            inline-open: root.img-inline-id == p.id;
                                            inline-img: root.img-inline-src;
                                            view-image => {
                                                root.view-proposal-image(p.id, p.img-b64);
                                            }
                                            save-image => {
                                                root.save-proposal-image(p.img-b64, p.proposed);
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: op-fl.height;
                                    content-h: op-fl.viewport-height;
                                    scroll-y: op-fl.viewport-y;
                                }
                            }
                        }

                        // Organization → Declined: proposals a member vetoed,
                        // read-only cards (the decision fell); the list keeps
                        // only declines inside the retention window, so the
                        // pane empties on the same rhythm as the group chat
                        if s.key == "organization" && root.selected-view == "declined": VerticalLayout {
                            padding: 8px;
                            spacing: 12px;
                            Text {
                                text: Strings.mv-declined;
                                color: Theme.text;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                od-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: od-list.preferred-height + 8px;
                                    od-list := VerticalLayout {
                                        padding: 4px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        alignment: start;
                                        if s.declined-count == 0: Text {
                                            text: Strings.mv-empty-declined;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        // the decided-votes table (story
                                        // 2026-08-09) — the full card detail
                                        // stays one 💬 away: the discussion
                                        // reopens read-only with the card as
                                        // its header. The jump lands on the
                                        // "today" sub-view; an old
                                        // discussion's messages may sit in
                                        // Archive (acceptable — the second
                                        // filter axis is a click away)
                                        if s.declined-count > 0: DecisionTable {
                                            rows: s.declined;
                                            with-when: true;
                                            discuss(id) => {
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{id}");
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: od-fl.height;
                                    content-h: od-fl.viewport-height;
                                    scroll-y: od-fl.viewport-y;
                                }
                            }
                            // more than one page of retained declines (page
                            // size 15, Rust-side): the cards above hold only
                            // the current page, this row steps through them
                            if s.declined-pages > 1: PagerRow {
                                page: s.declined-page;
                                pages: s.declined-pages;
                                paged(delta) => {
                                    root.page-list(s.key, "declined", delta);
                                }
                            }
                        }

                        // Organization → Accepted: the applied organization
                        // changes (the surface's applied log, newest last).
                        // Every row of known origin keeps the 💬 back-link
                        // into its vote's discussion — read-only once
                        // decided, the engine refuses new writes there.
                        // Rows without a proposal id (legacy dumps) offer
                        // no jump: the UI must not fake an address.
                        if s.key == "organization" && root.selected-view == "accepted": VerticalLayout {
                            padding: 8px;
                            spacing: 12px;
                            Text {
                                text: Strings.mv-accepted;
                                color: Theme.text;
                                font-size: Theme.fs-h2;
                                font-weight: 700;
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                oa-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: oa-list.preferred-height + 8px;
                                    oa-list := VerticalLayout {
                                        padding: 4px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        alignment: start;
                                        if s.applied-count == 0: Text {
                                            text: Strings.mv-empty-applied;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        // the decided-votes table (story
                                        // 2026-08-09): newest first, each
                                        // proposal-backed row with the voters
                                        // its sealed block proves; the vote's
                                        // discussion is its patch channel on
                                        // the chat bus — same jump as
                                        // ProposalCard
                                        if s.applied-count > 0: DecisionTable {
                                            rows: s.accepted;
                                            discuss(id) => {
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{id}");
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: oa-fl.height;
                                    content-h: oa-fl.viewport-height;
                                    scroll-y: oa-fl.viewport-y;
                                }
                            }
                            // beyond one page (size 15, Rust-side) this row
                            // steps through the accepted history
                            if s.applied-pages > 1: PagerRow {
                                page: s.applied-page;
                                pages: s.applied-pages;
                                paged(delta) => {
                                    root.page-list(s.key, "applied", delta);
                                }
                            }
                        }

                        // the four staged surfaces: badged DESIGN-MOCK panes
                        // (surfaces.slint) for every sub-view that is not yet
                        // real — sample data lives .slint-side only, actions
                        // that would change shared state render disabled
                        if s.key == "memory" && root.selected-view != "proposals"
                            && root.selected-view != "accepted"
                            && root.selected-view != "denied": MemoryPane {
                            view: root.selected-view;
                            copy-link(uri) => {
                                root.copy-text(uri);
                                root.show-toast(Strings.mem-toast-link);
                            }
                        }
                        if s.key == "quests" && root.selected-view != "proposals": QuestsPane {
                            view: root.selected-view;
                        }
                        if s.key == "vault" && root.selected-view != "proposals": VaultPane {
                            view: root.selected-view;
                        }
                        if s.key == "wallet" && root.selected-view != "status": WalletPane {
                            view: root.selected-view;
                        }

                        // …and their REAL threshold governance (gated: memory
                        // / quests / vault / wallet — the gated organization
                        // has its own views above), routed to the governance
                        // sub-views: "proposals" (memory splits its outcomes
                        // into Accepted/Denied like the organization does),
                        // wallet's "status"
                        if s.gated && s.key != "organization"
                            && (((s.key == "memory" || s.key == "quests" || s.key == "vault")
                                    && (root.selected-view == "proposals"
                                        || root.selected-view == "accepted"
                                        || root.selected-view == "denied"))
                                || (s.key == "wallet" && root.selected-view == "status")): VerticalLayout {
                            spacing: 8px;
                            if root.selected-view != "accepted" && root.selected-view != "denied": Text {
                                text: Strings.mv-pending;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            if root.selected-view != "accepted" && root.selected-view != "denied": Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 8px;
                                    alignment: start;
                                    if s.pending-count == 0: Text {
                                        text: Strings.mv-empty-pending;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                    }
                                    for p in s.pending: ProposalCard {
                                        p: p;
                                        approve => {
                                            root.approve(p.id);
                                        }
                                        decline => {
                                            root.decline(p.id);
                                        }
                                        discuss => {
                                            // the proposal's discussion is
                                            // its patch channel on the chat
                                            // bus — engine-side filter, like
                                            // the sidebar channel rows
                                            root.select-view("chat", "today");
                                            root.select-channel("patch:\{p.id}");
                                        }
                                        inline-open: root.img-inline-id == p.id;
                                        inline-img: root.img-inline-src;
                                        view-image => {
                                            root.view-proposal-image(p.id, p.img-b64);
                                        }
                                        save-image => {
                                            root.save-proposal-image(p.img-b64, p.proposed);
                                        }
                                    }
                                }
                            }
                            // the applied log: memory shows it under its own
                            // Accepted sub-view (as the decided-votes table);
                            // the other surfaces keep the inline prose list
                            // under Proposals (resp. wallet Status)
                            if s.key != "memory" || root.selected-view == "accepted": Text {
                                text: Strings.mv-applied;
                                color: Theme.dim;
                                font-size: Theme.fs-cap;
                                font-weight: 600;
                            }
                            if s.key == "memory" && root.selected-view == "accepted": Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                ma-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: ma-list.preferred-height + 8px;
                                    ma-list := VerticalLayout {
                                        padding: 4px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        alignment: start;
                                        if s.applied-count == 0: Text {
                                            text: Strings.mv-empty-applied;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        if s.applied-count > 0: DecisionTable {
                                            rows: s.accepted;
                                            discuss(id) => {
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{id}");
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: ma-fl.height;
                                    content-h: ma-fl.viewport-height;
                                    scroll-y: ma-fl.viewport-y;
                                }
                            }
                            if s.key != "memory": Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 4px;
                                    alignment: start;
                                    if s.applied-count == 0: Text {
                                        text: Strings.mv-empty-applied;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                    }
                                    // an accepted vote's row keeps the 💬
                                    // back-link into its (read-only)
                                    // discussion; rows of unknown origin
                                    // (legacy dumps) offer none
                                    for l in s.log: HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: l.text;
                                            color: Theme.dim;
                                            font-size: Theme.fs-body;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        if l.patch-id >= 0: AppButton {
                                            height: 26px;
                                            pad: 8px;
                                            emoji: "💬";
                                            clicked => {
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{l.patch-id}");
                                            }
                                        }
                                    }
                                }
                            }
                            // the applied history holds the ACCEPTED votes —
                            // beyond one page (page size 15, Rust-side) the
                            // log above shows only the current page and this
                            // row steps through them
                            if s.applied-pages > 1 && (s.key != "memory" || root.selected-view == "accepted"): PagerRow {
                                page: s.applied-page;
                                pages: s.applied-pages;
                                paged(delta) => {
                                    root.page-list(s.key, "applied", delta);
                                }
                            }
                            // Memory → Denied: the retained declines, the
                            // same read-only cards as Organization → Declined
                            if s.key == "memory" && root.selected-view == "denied": Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                md-fl := Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: md-list.preferred-height + 8px;
                                    md-list := VerticalLayout {
                                        padding: 4px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        alignment: start;
                                        if s.declined-count == 0: Text {
                                            text: Strings.mv-empty-declined;
                                            color: Theme.faint;
                                            font-size: Theme.fs-cap;
                                        }
                                        // the decided-votes table — the
                                        // vote's discussion reopens
                                        // read-only, like the organization
                                        // outcomes
                                        if s.declined-count > 0: DecisionTable {
                                            rows: s.declined;
                                            with-when: true;
                                            discuss(id) => {
                                                root.select-view("chat", "today");
                                                root.select-channel("patch:\{id}");
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: md-fl.height;
                                    content-h: md-fl.viewport-height;
                                    scroll-y: md-fl.viewport-y;
                                }
                            }
                            if s.declined-pages > 1 && s.key == "memory" && root.selected-view == "denied": PagerRow {
                                page: s.declined-page;
                                pages: s.declined-pages;
                                paged(delta) => {
                                    root.page-list(s.key, "declined", delta);
                                }
                            }
                            if root.selected-view != "accepted" && root.selected-view != "denied": HorizontalLayout {
                                spacing: 8px;
                                AppField {
                                    horizontal-stretch: 1;
                                    placeholder: Strings.mv-propose-ph;
                                    text <=> root.mv-draft;
                                    accepted => {
                                        root.propose(s.key, root.mv-draft);
                                        root.mv-draft = "";
                                    }
                                }
                                AppButton {
                                    label: Strings.mv-propose;
                                    primary: true;
                                    clicked => {
                                        root.propose(s.key, root.mv-draft);
                                        root.mv-draft = "";
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            // ---- settings (in-memory config editor — MOCK, no disk write) ----
            if root.screen == AppScreen.settings: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Strings.set-title;
                        color: Theme.text;
                        font-size: Theme.fs-h1;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    AppButton {
                        label: "×";
                        clicked => {
                            root.close-settings();
                        }
                    }
                }
                // The eight tabs, in ONE row. A tab whose title does not fit
                // wraps THAT title onto a second line (SettingsTab: word-wrap
                // plus a per-tab minimum width taken from its longest
                // unbreakable chunk) — the bar itself never breaks into a
                // second row any more. Slint spreads a shortfall evenly over
                // the tabs that still have slack, so a narrow pane may wrap
                // several titles at once; a title with no break opportunity
                // ("MCP") is never shrunk and therefore never clipped.
                HorizontalLayout {
                    spacing: 6px;
                    SettingsTab {
                        label: Strings.set-tab-general;
                        floor: Strings.set-tab-general-floor;
                        index: 0;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-workspace;
                        floor: Strings.set-tab-workspace-floor;
                        index: 1;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-backup;
                        floor: Strings.set-tab-backup-floor;
                        index: 2;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-anon;
                        floor: Strings.set-tab-anon-floor;
                        index: 3;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-relays;
                        floor: Strings.set-tab-relays-floor;
                        index: 4;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-mcp;
                        floor: Strings.set-tab-mcp-floor;
                        index: 5;
                        current <=> root.set-tab;
                    }
                    SettingsTab {
                        label: Strings.set-tab-node;
                        floor: Strings.set-tab-node-floor;
                        index: 6;
                        current <=> root.set-tab;
                    }
                    // only WITH an open workspace: the chain history is that
                    // workspace's — without one the tab is pure confusion
                    if root.active-workspace != "": SettingsTab {
                        label: Strings.set-tab-chain;
                        floor: Strings.set-tab-chain-floor;
                        index: 7;
                        current <=> root.set-tab;
                    }
                    // the tabs keep their own width (stretch 0); everything
                    // left over collects here, so the row stays left-aligned
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                set-pane := Rectangle {
                    // Settings → General: from this pane width the two form
                    // groups sit side by side; below it they stack. ONE
                    // predicate, so the two arrangements stay complementary.
                    property <bool> side-groups: self.width >= 560px;
                    vertical-stretch: 1;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: Theme.border-w;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        if root.set-tab == 0: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            // side by side the two groups SHARE the width and
                            // the row height (no alignment:start): equal
                            // panels with one right edge, instead of two
                            // ragged preferred-width boxes
                            if set-pane.side-groups: HorizontalLayout {
                                spacing: 14px;
                                // pack: the equal ROW height comes from the
                                // layout; inside, content hugs the top so the
                                // shorter panel never sprays leftover height
                                // between its rows (DetailGroup's own advice)
                                LanguageAppearanceGroup {
                                    horizontal-stretch: 1;
                                    pack: true;
                                    lang-index: root.lang-index;
                                    set-language(i) => {
                                        root.set-language(i);
                                    }
                                }
                                SoundAlertsGroup {
                                    horizontal-stretch: 1;
                                    pack: true;
                                    message-index <=> root.cfg-sound-message-index;
                                    vote-index <=> root.cfg-sound-vote-index;
                                    test-sound(s) => {
                                        root.test-sound(s);
                                    }
                                }
                            }
                            if !set-pane.side-groups: VerticalLayout {
                                spacing: 14px;
                                LanguageAppearanceGroup {
                                    lang-index: root.lang-index;
                                    set-language(i) => {
                                        root.set-language(i);
                                    }
                                }
                                SoundAlertsGroup {
                                    message-index <=> root.cfg-sound-message-index;
                                    vote-index <=> root.cfg-sound-vote-index;
                                    test-sound(s) => {
                                        root.test-sound(s);
                                    }
                                }
                            }
                            // chat privacy: send/show per-message read receipts
                            // (local switch; symmetric — off hides others' too).
                            // Panelled like its neighbours, so the tab reads as
                            // one grid instead of groups plus a loose row.
                            DetailGroup {
                                pack: true;
                                title: Strings.field-read-receipts;
                                AppCheck {
                                    label: Strings.set-read-receipts;
                                    checked <=> root.cfg-read-receipts;
                                }
                            }
                        }
                        if root.set-tab == 1: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            FieldLabel {
                                label: Strings.field-workspace-dir;
                                // read-only here: the folder is only changed
                                // in the picker modal (browse or type there)
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: ws-dir-ta.has-hover ? Theme.raised : Theme.panel;
                                        border-radius: Theme.radius;
                                        border-width: Theme.border-w;
                                        border-color: Theme.line;
                                        height: max(38px, ws-dir-text.preferred-height + 20px);
                                        ws-dir-text := Text {
                                            x: 12px;
                                            y: 10px;
                                            width: parent.width - 24px;
                                            text: root.cfg-workspace-dir == "" ? "-" : root.cfg-workspace-dir;
                                            color: Theme.text;
                                            font-size: Theme.fs-cap;
                                            wrap: char-wrap;
                                        }
                                        // clicking the path opens the same
                                        // folder picker as the button next
                                        // to it
                                        ws-dir-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.ws-dir-draft = root.cfg-workspace-dir;
                                                root.ws-dir-modal-open = true;
                                            }
                                        }
                                    }
                                    AppButton {
                                        height: 38px;
                                        icon: @image-url("assets/folder.svg");
                                        icon-set: true;
                                        label: Strings.set-ws-choose;
                                        clicked => {
                                            root.ws-dir-draft = root.cfg-workspace-dir;
                                            root.ws-dir-modal-open = true;
                                        }
                                    }
                                }
                                Text {
                                    text: root.ws-list.length == 1
                                        ? "1 \{Strings.set-ws-found-one}"
                                        : "\{root.ws-list.length} \{Strings.set-ws-found-many}";
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                }
                            }
                        }
                        if root.set-tab == 2: bk-tab := VerticalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;
                            // opening the tab refreshes the bucket side of
                            // the table from a real listing (a no-op note
                            // when no backup target is configured); never
                            // stack a second request on one in flight
                            init => {
                                if root.cfg-bk-list != "listing" {
                                    root.list-backups();
                                }
                            }
                            // both name columns get the SAME fixed share of
                            // the width — a stretch would distribute by each
                            // row's preferred size and the column edges would
                            // wander per row. 24 = side paddings, 40 = 4 gaps.
                            property <length> name-w: (self.width - 24px - 44px - 72px - 108px - 40px) / 2;
                            // section head: plain title, the on/off switch and
                            // the interval sit to its right. The whole form
                            // half is stretch-0: extra window height belongs
                            // to the mapping table below, the field spacing
                            // must not widen with the window.
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 18px;
                                alignment: start;
                                Text {
                                    text: Strings.field-s3-backup;
                                    color: Theme.text;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                AppCheck {
                                    label: Strings.set-s3-active;
                                    checked <=> root.cfg-s3-backup;
                                    y: (parent.height - self.height) / 2;
                                }
                                if root.cfg-s3-backup: HorizontalLayout {
                                    spacing: 8px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: Strings.set-s3-every;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                    AppStepper {
                                        width: 130px;
                                        height: 30px;
                                        y: (parent.height - self.height) / 2;
                                        value <=> root.cfg-s3-interval;
                                        minimum: 1;
                                        maximum: 1440;
                                    }
                                    Text {
                                        text: Strings.set-s3-unit-min;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                    // retention sits right-aligned, visually
                                    // apart from the interval group
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: Strings.set-s3-keep;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                    AppStepper {
                                        width: 110px;
                                        height: 30px;
                                        y: (parent.height - self.height) / 2;
                                        value <=> root.cfg-s3-copies;
                                        minimum: 1;
                                        maximum: 999;
                                    }
                                    Text {
                                        text: Strings.set-s3-unit-copies;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }
                            // compact two-row credential block: endpoint with
                            // the test button beside it, then the three keys
                            // sharing one row — the mapping table below keeps
                            // the height this saves
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 12px;
                                FieldLabel {
                                    horizontal-stretch: 1;
                                    label: Strings.field-s3-endpoint;
                                    AppField {
                                        text <=> root.cfg-s3-endpoint;
                                        placeholder: "https://s3.example.org · http://….onion";
                                    }
                                }
                                // bottom-aligned so the button lines up with
                                // the endpoint field, not its label
                                VerticalLayout {
                                    alignment: end;
                                    AppButton {
                                        height: 38px;
                                        icon: @image-url("assets/cloud.svg");
                                        icon-set: true;
                                        label: Strings.set-s3-test;
                                        // honest copy: the probe is a real
                                        // signed HEAD over the configured
                                        // transport (Tor when enabled)
                                        tooltip: Strings.s3-test-tip;
                                        tooltip-below: true;
                                        enabled: root.cfg-s3-endpoint != "" && root.cfg-s3-access != "";
                                        clicked => {
                                            root.test-s3();
                                        }
                                    }
                                }
                            }
                            // the streamed probe verdict (hidden until a
                            // test ran); errors carry their honest class
                            if root.cfg-s3-test != "": Text {
                                vertical-stretch: 0;
                                text: root.cfg-s3-test == "testing" ? Strings.smp-testing
                                    : root.cfg-s3-test == "ok" ? Strings.s3-ok
                                    : root.cfg-s3-test;
                                color: root.cfg-s3-test == "ok" ? Theme.good
                                    : root.cfg-s3-test == "testing" ? Theme.faint
                                    : Theme.bad;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                                preferred-width: 0px;
                            }
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 12px;
                                FieldLabel {
                                    label: Strings.field-s3-access;
                                    horizontal-stretch: 1;
                                    AppField {
                                        text <=> root.cfg-s3-access;
                                        placeholder: "AKIA…";
                                    }
                                }
                                FieldLabel {
                                    label: Strings.field-s3-secret;
                                    horizontal-stretch: 1;
                                    AppField {
                                        secret: true;
                                        text <=> root.cfg-s3-secret;
                                    }
                                }
                                FieldLabel {
                                    label: Strings.field-s3-bucket;
                                    horizontal-stretch: 1;
                                    AppField {
                                        text <=> root.cfg-s3-bucket;
                                        placeholder: "media-archive";
                                    }
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }
                            // local ↔ bucket mapping: every row has at least
                            // one side; auto-backup toggles per workspace.
                            // The bucket side comes from a REAL listing —
                            // refreshed on opening the tab and on demand;
                            // the status line says honestly what happened.
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 12px;
                                AppButton {
                                    height: 30px;
                                    emoji: "🔄";
                                    label: Strings.bk-refresh;
                                    tooltip: Strings.bk-refresh-tip;
                                    tooltip-below: true;
                                    enabled: root.cfg-bk-list != "listing";
                                    clicked => {
                                        root.list-backups();
                                    }
                                }
                                if root.cfg-bk-list != "": Text {
                                    horizontal-stretch: 1;
                                    text: root.cfg-bk-list == "listing" ? Strings.bk-listing
                                        : root.cfg-bk-list == "ok" ? Strings.bk-list-ok
                                        : root.cfg-bk-list;
                                    color: root.cfg-bk-list == "ok" ? Theme.good
                                        : root.cfg-bk-list == "listing" ? Theme.faint
                                        : Theme.bad;
                                    font-size: Theme.fs-cap;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    preferred-width: 0px;
                                }
                            }
                            HorizontalLayout {
                                vertical-stretch: 0;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                SortHeader {
                                    width: bk-tab.name-w;
                                    label: Strings.bk-col-local;
                                    active: root.bk-sort-key == "local";
                                    desc: root.bk-sort-desc;
                                    clicked => {
                                        root.bk-sort-by("local");
                                    }
                                }
                                SortHeader {
                                    width: bk-tab.name-w;
                                    label: Strings.bk-col-remote;
                                    active: root.bk-sort-key == "remote";
                                    desc: root.bk-sort-desc;
                                    clicked => {
                                        root.bk-sort-by("remote");
                                    }
                                }
                                SortHeader {
                                    width: 44px;
                                    label: Strings.bk-col-auto;
                                    active: root.bk-sort-key == "auto";
                                    desc: root.bk-sort-desc;
                                    align: center;
                                    clicked => {
                                        root.bk-sort-by("auto");
                                    }
                                }
                                SortHeader {
                                    width: 72px;
                                    label: Strings.bk-col-size;
                                    active: root.bk-sort-key == "size";
                                    desc: root.bk-sort-desc;
                                    align: end;
                                    clicked => {
                                        root.bk-sort-by("size");
                                    }
                                }
                                SortHeader {
                                    width: 108px;
                                    label: Strings.bk-col-last;
                                    active: root.bk-sort-key == "last";
                                    desc: root.bk-sort-desc;
                                    align: end;
                                    clicked => {
                                        root.bk-sort-by("last");
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.panel-2;
                                border-radius: Theme.radius;
                                border-width: Theme.border-w;
                                border-color: Theme.line;
                                clip: true;
                                bkfl := Flickable {
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;
                                        alignment: start;
                                        for r in root.bk-rows: Rectangle {
                                            height: 34px;
                                            border-radius: Theme.win95 ? 0px : 4px;
                                            background: bkr-ta.has-hover ? Theme.raised : transparent;
                                            bkr-ta := TouchArea { }
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 10px;
                                                Text {
                                                    width: bk-tab.name-w;
                                                    text: r.local == "" ? "-" : r.local;
                                                    color: r.local == "" ? Theme.faint : Theme.text;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    width: bk-tab.name-w;
                                                    text: r.remote == "" ? "-" : r.remote;
                                                    color: r.remote == "" ? Theme.faint : Theme.text;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                                // auto-backup toggle: renders the
                                                // mirrored state only — the click
                                                // goes through the engine
                                                Rectangle {
                                                    width: 44px;
                                                    if r.has-local: Rectangle {
                                                        width: 20px;
                                                        height: 20px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - 20px) / 2;
                                                        border-radius: Theme.win95 ? 0px : 4px;
                                                        border-width: Theme.border-w;
                                                        border-color: r.auto ? Theme.accent : Theme.line;
                                                        background: r.auto ? Theme.accent : Theme.panel;
                                                        if r.auto: Text {
                                                            text: "✓";
                                                            color: Theme.accent-ink;
                                                            font-size: 14px;
                                                            font-weight: 700;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                        TouchArea {
                                                            clicked => {
                                                                root.set-ws-backup(r.id, !r.auto);
                                                            }
                                                        }
                                                    }
                                                    if !r.has-local: Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: "-";
                                                        color: Theme.faint;
                                                        font-size: Theme.fs-body;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    width: 72px;
                                                    text: r.size;
                                                    color: Theme.dim;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                }
                                                Text {
                                                    width: 108px;
                                                    text: r.last;
                                                    color: r.last == "never" ? Theme.faint : Theme.dim;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                }
                                                // S7: a bucket-only workspace can come HOME —
                                                // fetched sealed, opened from the workspace
                                                // list with its phrase
                                                if !r.has-local: AppButton {
                                                    height: 26px;
                                                    pad: 9px;
                                                    y: (parent.height - self.height) / 2;
                                                    label: Strings.bk-restore;
                                                    clicked => {
                                                        root.backup-fetch(r.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: bkfl.height;
                                    content-h: bkfl.viewport-height;
                                    scroll-y: bkfl.viewport-y;
                                }
                            }
                            // the fetched artifact is IN the workspace list now —
                            // one line + the jump there (it opens with the phrase)
                            if root.bk-fetched != "": HorizontalLayout {
                                spacing: 8px;
                                DotLabel {
                                    tone: Theme.good;
                                    label: Strings.bk-fetched-note;
                                    label-color: Theme.text;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                AppButton {
                                    height: 28px;
                                    pad: 10px;
                                    primary: true;
                                    label: Strings.bk-goto-open;
                                    clicked => {
                                        root.navigate(AppScreen.open);
                                    }
                                }
                            }
                            if root.bk-fetch-error != "": Text {
                                text: root.bk-fetch-error;
                                color: Theme.bad;
                                font-size: Theme.fs-cap;
                                wrap: word-wrap;
                            }
                        }
                        // Anonymity network: a compact form panel like the
                        // other small form tabs — the fields hug the top and
                        // the shared spacer below pushes them up
                        if root.set-tab == 3: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            AnonNetworkGroup {
                                vertical-stretch: 0;
                                network-index <=> root.cfg-network-index;
                                tor-mode-index <=> root.cfg-tor-mode-index;
                                tor-port <=> root.cfg-tor-port;
                                tor-modes-enabled: root.tor-mode-enabled;
                            }
                            // Under the panel, only while Tor is the chosen
                            // network: the real two-rung probe of the DRAFT
                            // above (same idiom as the S3 test button and its
                            // streamed verdict). The copy always names the rung
                            // that was reached — a SOCKS port that answers is
                            // amber and says outright that no circuit is
                            // proven; only an end-to-end circuit reads green.
                            if root.cfg-network-index == 0: VerticalLayout {
                                vertical-stretch: 0;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: start;
                                    AppButton {
                                        height: 34px;
                                        emoji: "🧅";
                                        label: Strings.set-tor-test;
                                        tooltip: Strings.tor-test-tip;
                                        tooltip-below: true;
                                        enabled: root.cfg-tor-test != "testing";
                                        clicked => {
                                            root.test-tor();
                                        }
                                    }
                                }
                                if root.cfg-tor-test != "" && root.cfg-tor-test != "idle": VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: root.cfg-tor-test-text;
                                        color: root.cfg-tor-test-tone == 1 ? Theme.good
                                            : (root.cfg-tor-test-tone == 2 ? Theme.warn
                                            : (root.cfg-tor-test-tone == 3 ? Theme.bad : Theme.faint));
                                        font-size: Theme.fs-cap;
                                        wrap: word-wrap;
                                        preferred-width: 0px;
                                    }
                                    // the engine's own specifics (what was
                                    // probed, what failed) — technical English,
                                    // deliberately untranslated
                                    if root.cfg-tor-test-detail != "": Text {
                                        text: root.cfg-tor-test-detail;
                                        color: Theme.faint;
                                        font-size: Theme.fs-cap;
                                        // char-wrap: this line carries relay
                                        // URLs, and a .onion address offers no
                                        // word boundary to break at
                                        wrap: char-wrap;
                                        preferred-width: 0px;
                                    }
                                }
                            }
                        }
                        // Nostr relays: its own tab because the pool needs the
                        // full pane width for the URLs and the leftover height
                        // for the list (same idiom as the backup table)
                        if root.set-tab == 4: VerticalLayout {
                            spacing: 14px;
                            // only the LIST wants the leftover height. With an
                            // empty pool `pack` merely hugs the content inside
                            // the panel — the panel frame itself would still
                            // stretch, leaving a big empty box under the
                            // first-run message. So the empty pool hugs the top
                            // and the shared spacer below pushes it up.
                            vertical-stretch: root.relay-rows.length == 0 ? 0 : 1;
                            RelayPoolGroup {
                                vertical-stretch: root.relay-rows.length == 0 ? 0 : 1;
                                rows: root.relay-rows;
                                dialable: root.relay-dialable;
                                clearnet-confirmed: root.relay-clearnet-confirmed;
                                clearnet-session: root.cfg-clearnet-session;
                                draft <=> root.relay-draft;
                                error: root.relay-error;
                                add(url) => {
                                    root.relay-add(url);
                                }
                                edited => {
                                    root.relay-error = "";
                                }
                                moved(url, up) => {
                                    root.relay-move(url, up);
                                }
                                // an onion relay confirms straight through; a
                                // clearnet or local one only after the warning
                                // tailored to its kind (and the engine refuses
                                // it without the acknowledgement anyway)
                                confirm(url, kind) => {
                                    if (kind == 0) {
                                        root.relay-confirm(url, false);
                                    } else {
                                        root.open-clearnet-warning(url, kind);
                                    }
                                }
                                revoke(url) => {
                                    root.relay-revoke(url);
                                }
                                removed(url) => {
                                    root.relay-remove(url);
                                }
                                copied(url) => {
                                    root.copy-text(url);
                                    root.show-toast(Strings.toast-copied);
                                }
                                session(unlock) => {
                                    root.relay-clearnet-session(unlock);
                                }
                            }
                        }
                        if root.set-tab == 5: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            FieldLabel {
                                label: Strings.field-mcp-port;
                                AppStepper {
                                    width: 200px;
                                    value <=> root.cfg-mcp-port;
                                    minimum: 1;
                                    maximum: 65535;
                                }
                            }
                            FieldLabel {
                                label: Strings.field-mcp-allow;
                                AppField {
                                    text <=> root.cfg-mcp-allow;
                                    placeholder: "127.0.0.1";
                                }
                            }
                            FieldLabel {
                                label: Strings.field-mcp-token;
                                tok-row := HorizontalLayout {
                                    spacing: 10px;
                                    // masked by default; the eye toggles the peek.
                                    // leaving the tab drops this branch, so the
                                    // token re-masks on its own
                                    property <bool> token-shown: false;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.panel;
                                        border-radius: Theme.radius;
                                        border-width: Theme.border-w;
                                        border-color: Theme.line;
                                        height: max(38px, token-text.preferred-height + 20px);
                                        token-text := Text {
                                            x: 12px;
                                            y: 10px;
                                            width: parent.width - 24px;
                                            text: root.cfg-mcp-token == "" ? "-"
                                                : (tok-row.token-shown ? root.cfg-mcp-token : "****************");
                                            color: Theme.text;
                                            font-size: Theme.fs-cap;
                                            wrap: char-wrap;
                                        }
                                    }
                                    AppButton {
                                        pad: 10px;
                                        icon: @image-url("assets/eye.svg");
                                        icon-set: true;
                                        primary: tok-row.token-shown;
                                        enabled: root.cfg-mcp-token != "";
                                        tooltip: tok-row.token-shown ? Strings.set-token-hide : Strings.set-token-show;
                                        clicked => {
                                            tok-row.token-shown = !tok-row.token-shown;
                                        }
                                    }
                                    AppButton {
                                        pad: 10px;
                                        icon: @image-url("assets/copy.svg");
                                        icon-set: true;
                                        label: Strings.ow-copy;
                                        enabled: root.cfg-mcp-token != "";
                                        clicked => {
                                            root.copy-text(root.cfg-mcp-token);
                                            root.show-toast(Strings.toast-copied);
                                        }
                                    }
                                    AppButton {
                                        label: Strings.set-rotate;
                                        clicked => {
                                            root.rotate-token();
                                        }
                                    }
                                }
                                Text {
                                    text: Strings.set-token-note;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.set-tab == 6: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            // panelled like every other tab's content — no
                            // loose checkbox floating in the pane
                            DetailGroup {
                                pack: true;
                                title: Strings.set-tab-node;
                                AppCheck {
                                    label: Strings.field-headless;
                                    checked <=> root.cfg-headless;
                                }
                            }
                        }
                        // Chain-History: every committed block of the open
                        // republic, newest first, paged at 20 — checkpoints
                        // (compacted cuts) included; pre-cut entries a pruned
                        // holder rebuilds from its blob show without height
                        // and signatures (dropped with the history)
                        if root.set-tab == 7: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;
                            if root.chain-rows.length == 0: Text {
                                text: Strings.chain-empty;
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                            }
                            if root.chain-rows.length > 0: HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                Text {
                                    text: Strings.chain-col-height;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    width: 130px;
                                }
                                Text {
                                    text: Strings.chain-col-what;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: Strings.chain-col-signers;
                                    color: Theme.faint;
                                    font-size: Theme.fs-cap;
                                    width: 200px;
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                ch-fl := Flickable {
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: start;
                                        for r in root.chain-rows: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;
                                            Text {
                                                text: r.height;
                                                color: Theme.dim;
                                                font-size: Theme.fs-body;
                                                width: 130px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: r.kind != "" ? "\{r.kind}: \{r.title}"
                                                    : (r.surface != "" ? "\{r.surface} · \{r.title}" : r.title);
                                                color: Theme.text;
                                                font-size: Theme.fs-body;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: r.signers;
                                                color: Theme.faint;
                                                font-size: Theme.fs-cap;
                                                width: 200px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                ScrollHint {
                                    x: parent.width - 7px;
                                    view-h: ch-fl.height;
                                    content-h: ch-fl.viewport-height;
                                    scroll-y: ch-fl.viewport-y;
                                }
                            }
                            if root.chain-pages > 1: PagerRow {
                                page: root.chain-page;
                                pages: root.chain-pages;
                                paged(delta) => {
                                    root.page-list("chain", "history", delta);
                                }
                            }
                        }
                        // list tabs claim the leftover height themselves — the
                        // backup table (2), the chain history (7) and the relay
                        // pool (4) but only while it HAS rows; every other tab
                        // (and the empty pool) pushes its fields up. Leaving 7
                        // out of this list split the height 50/50 between the
                        // chain list and this spacer.
                        if root.set-tab != 2 && root.set-tab != 7
                            && !(root.set-tab == 4 && root.relay-rows.length > 0): Rectangle {
                            vertical-stretch: 1;
                        }
                        // persistent (not a toast): these values only take
                        // effect on the next start of the node
                        if root.restart-keys != "": Text {
                            text: "\{Strings.set-restart-note}  \{root.restart-keys}";
                            color: Theme.warn;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                        if root.notice == "saved": Text {
                            text: Strings.set-save-note;
                            color: Theme.accent;
                            font-size: Theme.fs-cap;
                        }
                        if root.notice == "config-reloaded": Text {
                            text: Strings.set-reloaded-note;
                            color: Theme.accent;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                        if root.notice == "config-conflict": Text {
                            text: Strings.set-conflict-note;
                            color: Theme.bad;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                        if root.notice-failed != "": Text {
                            text: root.notice-failed;
                            color: Theme.bad;
                            font-size: Theme.fs-cap;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    AppButton {
                        label: Strings.set-close;
                        clicked => {
                            root.close-settings();
                        }
                    }
                    // the config.toml path rides the button row (it stole a
                    // whole panel row from every tab): directory greyed, the
                    // file name in text color
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.zebra;
                        border-radius: Theme.win95 ? 0px : 6px;
                        border-width: Theme.border-w;
                        border-color: Theme.line;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 0;
                            alignment: start;
                            Text {
                                text: "\{Strings.set-path-label}:  \{root.config-dir}";
                                color: Theme.faint;
                                font-size: Theme.fs-cap;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.config-file;
                                color: Theme.text;
                                font-size: Theme.fs-cap;
                                vertical-alignment: center;
                            }
                        }
                    }
                    AppButton {
                        label: Strings.set-save;
                        primary: true;
                        clicked => {
                            root.save-settings();
                        }
                    }
                }
            }
        }

    }

    // Modal: confirm closing the workspace (raised by either close control).
    if root.confirm-close-open: ConfirmModal {
        title: Strings.close-ws-title;
        body: Strings.close-ws-body;
        confirm-label: Strings.close-ws-confirm;
        dismissed => {
            root.confirm-close-open = false;
        }
        confirmed => {
            root.confirm-close-open = false;
            root.reset-open-workspace();
            root.close-workspace();
        }
    }

    // Modal: the outside-Tor relay warning — the one place the GUI may reach
    // RelayConfirm with the acknowledgement set. It names the CONCRETE
    // exposure (local box vs. clearnet operator, and whether Tor fronts the
    // clearnet), the acknowledgement starts unchecked on every open, and
    // cancelling does nothing at all.
    if root.relay-clearnet-modal-open: ConfirmModal {
        dialog-width: 520px;
        title: root.relay-clearnet-kind == 2 ? Strings.rp-cn-title-local : Strings.rp-cn-title;
        body: root.relay-clearnet-kind == 2 ? Strings.rp-cn-body-local
            : (root.net-tor-active ? Strings.rp-cn-body-tor : Strings.rp-cn-body-plain);
        confirm-label: Strings.rp-cn-confirm;
        confirm-enabled: root.relay-clearnet-ack;
        dismissed => {
            root.close-clearnet-warning();
        }
        confirmed => {
            root.relay-clearnet-modal-open = false;
            root.relay-clearnet-ack = false;
            root.relay-confirm(root.relay-clearnet-url, true);
        }
        Text {
            text: root.relay-clearnet-url;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-weight: 700;
            wrap: word-wrap;
        }
        AppCheck {
            label: Strings.rp-cn-ack;
            checked <=> root.relay-clearnet-ack;
        }
        Text {
            text: Strings.rp-cn-note;
            color: Theme.faint;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
    }

    // Modal: confirm quitting the program while a workspace is open
    // (raised from Rust's window close-requested handler).
    // Modal: leaving the settings screen with unsaved draft edits. Three ways
    // out: save to config.toml and leave, discard the draft and leave, or
    // stay (cancel / Escape / scrim click).
    // Modal: abort a RUNNING founding ritual — every distributed invite
    // link becomes invalid and each participant's join ends; the founding
    // can be started fresh afterwards.
    if root.confirm-abort-ritual-open: ConfirmModal {
        title: Strings.cw-abort-title;
        body: Strings.cw-abort-body;
        confirm-label: Strings.cw-abort-confirm;
        dismissed => {
            root.confirm-abort-ritual-open = false;
        }
        confirmed => {
            root.confirm-abort-ritual-open = false;
            root.create-cancel();
        }
    }

    if root.confirm-leave-open: ConfirmModal {
        title: Strings.unsaved-title;
        body: Strings.unsaved-body;
        // three buttons in the row (cancel / discard / save) need more width
        // than the two-button default
        dialog-width: 520px;
        confirm-label: Strings.unsaved-save;
        alt-label: Strings.unsaved-discard;
        cancel-label: Strings.unsaved-cancel;
        confirmed => {
            root.confirm-leave-open = false;
            root.save-and-leave();
        }
        alted => {
            root.confirm-leave-open = false;
            root.discard-and-leave();
        }
        dismissed => {
            root.confirm-leave-open = false;
        }
    }

    if root.confirm-quit-open: ConfirmModal {
        title: Strings.quit-title;
        body: Strings.quit-body;
        confirm-label: Strings.quit-confirm;
        dismissed => {
            root.confirm-quit-open = false;
        }
        confirmed => {
            root.confirm-quit-open = false;
            root.quit();
        }
    }

    // Modal: confirm deleting a workspace from the Open list — the delete
    // button stays disabled until the user types the exact name.
    if root.confirm-delete-open: del-dlg := ConfirmModal {
        dialog-width: 420px;
        title: Strings.del-ws-title;
        body: Strings.del-ws-body;
        confirm-label: Strings.del-ws-confirm;
        confirm-enabled: root.delete-typed == root.delete-name;
        dismissed => {
            root.confirm-delete-open = false;
        }
        confirmed => {
            root.confirm-delete-open = false;
            root.deselect-workspace();
            root.delete-workspace(root.delete-id);
        }
        Text {
            text: root.delete-name;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-weight: 700;
        }
        AppField {
            text <=> root.delete-typed;
            placeholder: root.delete-name;
            invalid: root.delete-typed != "" && root.delete-typed != root.delete-name;
            // Enter inside the field = the (gated) action button
            accepted => {
                if (del-dlg.confirm-enabled) {
                    del-dlg.confirmed();
                }
            }
        }
    }

    // Modal: name a new chat topic. One input, two buttons, nothing else on
    // screen competing for them.
    if root.nt-open: nt-dlg := ConfirmModal {
        dialog-width: 420px;
        title: Strings.ch-new-topic;
        confirm-label: Strings.ch-topic-open;
        // the engine trims and caps the name (`ChannelRef::normalized`), so
        // the button is gated on the same rule rather than letting the send
        // fail later
        confirm-enabled: root.nt-draft != "" && root.nt-draft.character-count <= root.nt-max;
        dismissed => {
            root.nt-open = false;
            root.nt-draft = "";
        }
        confirmed => {
            root.select-channel("topic:" + root.nt-draft);
            root.nt-open = false;
            root.nt-draft = "";
        }
        AppField {
            text <=> root.nt-draft;
            placeholder: Strings.ch-topic-ph;
            invalid: root.nt-draft.character-count > root.nt-max;
            accepted => {
                if (nt-dlg.confirm-enabled) {
                    nt-dlg.confirmed();
                }
            }
        }
        if root.nt-draft.character-count > root.nt-max: Text {
            text: "\{root.nt-draft.character-count} / \{root.nt-max}";
            color: Theme.bad;
            font-size: Theme.fs-cap;
        }
    }

    // Modal: confirm deleting a chat message — the text is wiped for
    // everyone, only the deletion notice remains.
    if root.confirm-delmsg-open: ConfirmModal {
        title: Strings.dm-title;
        body: Strings.dm-body;
        confirm-label: Strings.dm-confirm;
        dismissed => {
            root.confirm-delmsg-open = false;
        }
        confirmed => {
            root.confirm-delmsg-open = false;
            root.delete-chat(root.delmsg-id);
            root.delmsg-id = "";
        }
    }

    // Modal: manual backup — target path + export passphrase; confirming
    // drives the real export command (the engine streams the honest
    // outcome back into the panel note). The passphrase is cleared on
    // every way out of the modal.
    if root.backup-modal-open: bk-dlg := ConfirmModal {
        dialog-width: 440px;
        title: Strings.bk-title;
        body: Strings.bk-body;
        confirm-label: Strings.bk-confirm;
        confirm-enabled: root.backup-path != "" && root.backup-pass.character-count >= 10;
        dismissed => {
            root.backup-modal-open = false;
            root.backup-pass = "";
        }
        confirmed => {
            root.backup-modal-open = false;
            root.export-workspace(root.open-id, root.backup-path, root.backup-pass);
            root.backup-pass = "";
        }
        Text {
            text: Strings.bk-path;
            color: Theme.text;
            font-size: Theme.fs-body;
        }
        AppField {
            text <=> root.backup-path;
            placeholder: "~/Backups/republic.molt.enc";
            accepted => {
                if (bk-dlg.confirm-enabled) {
                    bk-dlg.confirmed();
                }
            }
        }
        Text {
            text: Strings.bk-pass;
            color: Theme.text;
            font-size: Theme.fs-body;
        }
        AppField {
            text <=> root.backup-pass;
            secret: true;
            accepted => {
                if (bk-dlg.confirm-enabled) {
                    bk-dlg.confirmed();
                }
            }
        }
    }

    // =================================================================
    // Modal: the republic's image (Organization → Status). Shows the
    // CURRENT image; a new one comes in via the real file dialog. Select /
    // Remove create REAL gated proposals on the Organization surface —
    // only the file reference travels with the proposal (chat file-share
    // mechanism: the bytes stay on this device until the transfer story).
    // =================================================================
    if root.org-logo-modal-open: ol-dlg := ConfirmModal {
        dialog-width: 460px;
        title: Strings.ol-title;
        body: Strings.ol-body;
        confirm-label: Strings.oc-propose;
        confirm-enabled: root.org-logo-draft != "";
        alt-label: root.org-img-path == "" ? "" : Strings.ol-remove;
        dismissed => {
            root.org-logo-modal-open = false;
        }
        confirmed => {
            root.org-logo-modal-open = false;
            // the "Proposed" confirmation rides the OUTCOME (molt-ui's
            // on_org_propose), because set_image can still fail on the
            // decode or the payload cap after this click
            root.org-propose("set_image", root.org-logo-draft);
        }
        alted => {
            root.org-logo-modal-open = false;
            root.org-propose("remove_image", "");
        }
        VerticalLayout {
            spacing: 12px;
            // the current image — what the proposal would change
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: Theme.win95 ? 0px : 8px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent;
                    clip: true;
                    if !root.org-img-set: Image {
                        source: @image-url("assets/republic.svg");
                        colorize: Theme.accent;
                        width: 32px;
                        height: 32px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.org-img-set: Image {
                        source: root.org-img;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text {
                        text: Strings.ol-current;
                        color: Theme.faint;
                        font-size: Theme.fs-cap;
                        font-weight: 600;
                    }
                    Text {
                        text: root.org-img-path == "" ? Strings.ol-none : root.org-img-path;
                        color: Theme.dim;
                        font-size: Theme.fs-cap;
                        overflow: elide;
                    }
                }
            }
            // the proposed replacement, via the real file dialog
            HorizontalLayout {
                spacing: 8px;
                AppField {
                    text <=> root.org-logo-draft;
                    placeholder: "~/Pictures/republic.png";
                    horizontal-stretch: 1;
                    accepted => {
                        if (ol-dlg.confirm-enabled) {
                            ol-dlg.confirmed();
                        }
                    }
                }
                AppButton {
                    height: 38px;
                    pad: 10px;
                    icon: @image-url("assets/folder.svg");
                    icon-set: true;
                    label: Strings.ol-pick;
                    clicked => {
                        root.org-logo-pick();
                    }
                }
            }
        }
    }

    // =================================================================
    // Modal: seal / unseal a workspace at rest (Open screen). Both
    // directions take the recovery phrase; the engine verifies it for
    // real (sealing proves the credential BEFORE removing the keys).
    // =================================================================
    if root.decrypt-modal-open: dec-dlg := ConfirmModal {
        dialog-width: 480px;
        title: root.decrypt-seal
            ? "\{Strings.ew-title} - \{root.decrypt-name}"
            : "\{Strings.dw-title} - \{root.decrypt-name}";
        body: root.decrypt-seal ? Strings.ew-body : Strings.dw-body;
        confirm-label: root.decrypt-seal ? Strings.ow-encrypt : Strings.ow-decrypt;
        confirm-enabled: root.decrypt-phrase != "";
        dismissed => {
            root.decrypt-modal-open = false;
        }
        confirmed => {
            root.decrypt-modal-open = false;
            if (root.decrypt-seal) {
                root.encrypt-workspace(root.decrypt-id, root.decrypt-phrase);
            } else {
                root.decrypt-workspace(root.decrypt-id, root.decrypt-phrase);
            }
        }
        HorizontalLayout {
            spacing: 8px;
            AppField {
                text <=> root.decrypt-phrase;
                placeholder: Strings.ph-seed;
                secret: true;
                horizontal-stretch: 1;
                accepted => {
                    if (dec-dlg.confirm-enabled) {
                        dec-dlg.confirmed();
                    }
                }
            }
            AppButton {
                height: 38px;
                pad: 10px;
                icon: @image-url("assets/paste.svg");
                icon-set: true;
                label: Strings.rw-paste;
                clicked => {
                    root.decrypt-phrase = root.paste-clipboard();
                }
            }
        }
    }

    // =================================================================
    // Modal: rename the republic (Organization → Status). The name was
    // ratified at the founding, so a rename is a GATED change: the draft
    // becomes a real proposal the members approve by threshold. Applying
    // it does not yet rename the shown republic (mock effect).
    // =================================================================
    // A join in flight blocks the screen: the work is remote and can take a
    // while, so the operator gets a spinner (something IS happening, even
    // before the bar moves), the bar, and a way out that really aborts —
    // `JoinCancel` bumps the generation and aborts the task.
    // …but NOT while the charter awaits ratification: that step is still
    // "running" and needs the joiner's decision, so blocking the screen there
    // would hang the join on a panel the operator cannot reach.
    if root.jw-running && !root.jw-awaiting-ratify && !root.jw-sealed: BusyModal {
        title: root.jw-republic == "" ? Strings.jw-busy-title : root.jw-republic;
        detail: root.jw-progress < 0.3 ? Strings.jw-ph1
            : (root.jw-progress < 0.5 ? Strings.jw-ph-founder
            : (root.jw-progress < 0.75 ? Strings.jw-ph2 : Strings.jw-ph3));
        progress: root.jw-progress;
        cancel-label: Strings.jw-busy-cancel;
        cancelled => {
            root.join-cancel();
        }
    }

    if root.org-name-modal-open: orn-dlg := ConfirmModal {
        dialog-width: 440px;
        title: Strings.orn-title;
        body: Strings.orn-body;
        confirm-label: Strings.oc-propose;
        confirm-enabled: root.org-name-draft != "" && root.org-name-draft != root.active-workspace;
        dismissed => {
            root.org-name-modal-open = false;
        }
        confirmed => {
            root.org-name-modal-open = false;
            root.org-propose("set_name", root.org-name-draft);
        }
        AppField {
            text <=> root.org-name-draft;
            placeholder: Strings.ph-ws-name;
            accepted => {
                if (orn-dlg.confirm-enabled) {
                    orn-dlg.confirmed();
                }
            }
        }
    }

    // =================================================================
    // Modal: edit the charter (Organization → Status). The charter was
    // ratified at the founding, so an edit is a GATED change: the draft
    // becomes a real proposal the members approve by threshold. Applying
    // it does not yet rewrite the shown charter (mock effect).
    // =================================================================
    if root.org-charter-modal-open: ConfirmModal {
        dialog-width: 720px;
        title: Strings.oc-title;
        body: Strings.oc-body;
        confirm-label: Strings.oc-propose;
        confirm-enabled: root.org-charter-draft != root.active-agenda;
        dismissed => {
            root.org-charter-modal-open = false;
        }
        confirmed => {
            root.org-charter-modal-open = false;
            root.org-propose("set_charter", root.org-charter-draft);
        }
        // the whole charter stays readable while editing: a big, scrolling
        // multi-line editor instead of a one-line field
        AppArea {
            height: 300px;
            text <=> root.org-charter-draft;
            placeholder: Strings.cw-charter-agenda-ph;
        }
    }

    // =================================================================
    // Modal: enable charter features — the wizard's checkbox language;
    // chat and everything already enabled are locked (enable-only, the
    // engine refuses removals). Confirm proposes the full target set.
    // =================================================================
    if root.org-features-modal-open: ConfirmModal {
        title: Strings.cw-features;
        body: "";
        confirm-label: Strings.oc-propose;
        confirm-enabled: (root.of-memory-draft && !root.org-feat-memory)
            || (root.of-quests-draft && !root.org-feat-quests)
            || (root.of-vault-draft && !root.org-feat-vault)
            || (root.of-wallet-draft && !root.org-feat-wallet);
        dismissed => {
            root.org-features-modal-open = false;
        }
        confirmed => {
            root.org-features-modal-open = false;
            root.org-propose("set_features",
                (root.of-memory-draft ? " memory" : "")
                + (root.of-quests-draft ? " quests" : "")
                + (root.of-vault-draft ? " vault" : "")
                + (root.of-wallet-draft ? " wallet" : ""));
        }
        VerticalLayout {
            spacing: 4px;
            AppCheck { label: Strings.feat-chat; checked: true; enabled: false; }
            AppCheck {
                label: Strings.feat-memory;
                checked <=> root.of-memory-draft;
                enabled: !root.org-feat-memory;
            }
            AppCheck {
                label: Strings.feat-quests;
                checked <=> root.of-quests-draft;
                enabled: !root.org-feat-quests;
            }
            AppCheck {
                label: Strings.feat-vault;
                checked <=> root.of-vault-draft;
                enabled: !root.org-feat-vault;
            }
            AppCheck {
                label: Strings.feat-wallet;
                checked <=> root.of-wallet-draft;
                enabled: !root.org-feat-wallet;
            }
        }
    }

    // =================================================================
    // Modal: the charter reader (click on the charter text) — the full
    // ratified text, scrollable, with a single shrink-back action.
    // =================================================================
    if root.charter-view-open: ConfirmModal {
        dialog-width: 760px;
        title: Strings.const-charter-title;
        body: "";
        cancel-label: "";
        confirm-label: Strings.cv-shrink;
        dismissed => {
            root.charter-view-open = false;
        }
        confirmed => {
            root.charter-view-open = false;
        }
        Rectangle {
            height: 420px;
            background: Theme.panel-2;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            clip: true;
            cv-fl := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: max(self.height, cv-text.preferred-height + 24px);
                cv-text := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: root.active-agenda == "" ? Strings.const-no-agenda : root.active-agenda;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                }
            }
            ScrollHint {
                x: parent.width - 7px;
                view-h: cv-fl.height;
                content-h: cv-fl.viewport-height;
                scroll-y: cv-fl.viewport-y;
            }
        }
    }

    // =================================================================
    // Modal: change the chat deletion period (Organization → Status →
    // Settings). A gated change like the other organization edits: the
    // drafted period becomes a real proposal.
    // =================================================================
    // R6: the pool edit — a gated proposal like the retention next to it.
    // The draft is a ROW TABLE (delete per row, add below); the rows and
    // the space-joined payload string are kept in step Rust-side.
    if root.org-relays-modal-open: ConfirmModal {
        dialog-width: 560px;
        title: Strings.ocr2-title;
        body: Strings.ocr2-body;
        confirm-label: Strings.oc-propose;
        // a URL still sitting in the add field blocks Propose (it would be
        // silently dropped otherwise); overlap mirrors the engine gate
        confirm-enabled: root.org-relays-draft-rows.length > 0
            && root.org-relays-draft != root.org-relays-joined
            && root.org-relay-add-draft == ""
            && root.org-relays-draft-overlap;
        dismissed => {
            root.org-relays-modal-open = false;
        }
        confirmed => {
            root.org-relays-modal-open = false;
            root.org-propose("set_relays", root.org-relays-draft);
        }
        VerticalLayout {
            spacing: 5px;
            // capped + scrollable so a long pool can never push the modal's
            // buttons off-window (the dialog centers on preferred height)
            Flickable {
                height: min(260px, root.org-relays-draft-rows.length * 37px);
                viewport-height: root.org-relays-draft-rows.length * 37px;
                VerticalLayout {
                    spacing: 5px;
                    for r[i] in root.org-relays-draft-rows: Rectangle {
                        height: 32px;
                        border-radius: Theme.win95 ? 0px : 6px;
                        background: Theme.panel-2;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 3px;
                            spacing: 8px;
                            Text {
                                text: r;
                                color: Theme.text;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            AppButton {
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                pad: 0px;
                                label: "✕";
                                tooltip: Strings.ocr2-remove;
                                tooltip-left: true;
                                clicked => {
                                    root.relays-draft-remove(i);
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                add-field := AppField {
                    text <=> root.org-relay-add-draft;
                    placeholder: "wss://relay.example";
                    accepted => {
                        if (root.org-relay-add-draft != "") {
                            root.relays-draft-add(root.org-relay-add-draft);
                        }
                    }
                }
                AppButton {
                    label: "+";
                    tooltip: Strings.ocr2-add;
                    enabled: root.org-relay-add-draft != "";
                    clicked => {
                        root.relays-draft-add(root.org-relay-add-draft);
                    }
                }
            }
            if root.org-relay-add-error != "": Text {
                text: root.org-relay-add-error;
                color: Theme.bad;
                font-size: Theme.fs-cap;
                wrap: word-wrap;
            }
        }
    }

    if root.org-retention-modal-open: ConfirmModal {
        dialog-width: 460px;
        title: Strings.ocr-title;
        body: Strings.ocr-body;
        confirm-label: Strings.oc-propose;
        confirm-enabled: root.org-retention-draft != root.org-chat-retention;
        dismissed => {
            root.org-retention-modal-open = false;
        }
        confirmed => {
            root.org-retention-modal-open = false;
            root.org-propose("set_chat_retention", "\{root.org-retention-draft} days");
        }
        HorizontalLayout {
            spacing: 8px;
            AppStepper {
                value <=> root.org-retention-draft;
                minimum: 1;
                maximum: 365;
            }
            Text {
                text: Strings.ocs-days;
                color: Theme.dim;
                font-size: Theme.fs-body;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // =================================================================
    // Folder picker for the settings workspace tab: browse via the real
    // (rfd) dialog or edit the path by hand; Select commits the draft
    // into the workspace-dir config field.
    // =================================================================
    if root.ws-dir-modal-open: wsd-dlg := ConfirmModal {
        dialog-width: 440px;
        title: Strings.set-ws-dir-title;
        body: Strings.set-ws-dir-body;
        confirm-label: Strings.rw-file-pick;
        confirm-enabled: root.ws-dir-draft != "";
        dismissed => {
            root.ws-dir-modal-open = false;
        }
        confirmed => {
            root.ws-dir-modal-open = false;
            root.cfg-workspace-dir = root.ws-dir-draft;
        }
        HorizontalLayout {
            spacing: 8px;
            AppField {
                text <=> root.ws-dir-draft;
                placeholder: "~/.moltrepublic/workspaces";
                horizontal-stretch: 1;
                accepted => {
                    if (wsd-dlg.confirm-enabled) {
                        wsd-dlg.confirmed();
                    }
                }
            }
            AppButton {
                height: 38px;
                pad: 10px;
                icon: @image-url("assets/folder.svg");
                icon-set: true;
                label: Strings.set-ws-dir-browse;
                clicked => {
                    root.ws-dir-pick();
                }
            }
        }
    }

    // =================================================================
    // Modal: a coordinator-minted recovery link (opened from Rust when the
    // engine's mint notices arrive). Three calm states: pending (the mint
    // runs), the link (monospace + copy; the caution stays visible:
    // off-band, single-use, dies with this session), or a localized
    // failed explanation — never an error toast.
    // =================================================================
    if root.recover-link-open: ConfirmModal {
        dialog-width: 460px;
        title: root.recover-link-member == "" ? Strings.rlk-title
            : "\{Strings.rlk-title} · \{root.recover-link-member}";
        body: root.recovery-link-error != "" ? ""
            : (root.recovery-link == "" ? Strings.rlk-pending-hint : Strings.rlk-body);
        cancel-label: Strings.set-close;
        confirm-label: Strings.ow-copy;
        // copy only exists once there is a link to copy
        confirm-enabled: root.recovery-link != "";
        dismissed => {
            root.recover-link-open = false;
        }
        confirmed => {
            // copy, but keep the dialog open — the link stays readable
            // until the coordinator explicitly closes it
            root.copy-text(root.recovery-link);
            root.show-toast(Strings.toast-copied);
        }
        // the failed state: a calm, localized explanation of THIS node's
        // condition (the known mesh reason gets its full text; anything
        // else is wrapped generically)
        if root.recovery-link-error != "": Text {
            text: root.recovery-link-error == "mesh-not-running"
                ? Strings.rlk-failed-mesh
                : "\{Strings.rlk-failed-prefix}\{root.recovery-link-error}";
            color: Theme.dim;
            font-size: Theme.fs-body;
            wrap: word-wrap;
        }
        // the pending state: quiet progress line where the link will appear
        if root.recovery-link-error == "" && root.recovery-link == "": Text {
            text: Strings.rlk-pending;
            color: Theme.faint;
            font-size: Theme.fs-body;
        }
        if root.recovery-link != "": Rectangle {
            background: Theme.panel-2;
            border-radius: Theme.win95 ? 0px : 8px;
            border-width: Theme.border-w;
            border-color: Theme.line;
            height: rlk-text.preferred-height + 20px;
            rlk-text := Text {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                text: root.recovery-link;
                color: Theme.text;
                font-family: "monospace";
                font-size: Theme.fs-cap;
                // one long unbreakable token — break anywhere, lose nothing
                wrap: char-wrap;
            }
        }
        if root.recovery-link != "": Text {
            text: Strings.rlk-caution;
            color: Theme.warn;
            font-size: Theme.fs-cap;
            wrap: word-wrap;
        }
    }

    // =================================================================
    // HintTip overlay: THE tooltip bubble for controls that write the
    // HintTip global (wiki toolbar buttons, the mock badge). Drawn last
    // at the window root — above everything, outside every clipped
    // panel — and without a TouchArea, so it never grabs the pointer
    // (the PopupWindow tooltips it replaces strobed the hover).
    // =================================================================
    // main-screen only: every HintTip writer lives there, and a view
    // switch can unmount a hovered control without a hover-out event —
    // the guard keeps such an orphaned hint off other screens
    if HintTip.label != "" && root.screen == AppScreen.main: Rectangle {
        x: max(4px, min(HintTip.ax, root.width - self.width - 4px));
        y: HintTip.ay;
        width: hint-tt.preferred-width + 16px;
        height: 23px;
        background: Theme.text;
        border-radius: 5px;
        hint-tt := Text {
            x: 8px;
            height: 100%;
            text: HintTip.label;
            color: Theme.bg;
            font-size: Theme.fs-cap;
            vertical-alignment: center;
        }
    }

    // =================================================================
    // Toast: brief bottom-center feedback bubble (e.g. "copied"), auto-
    // dismissed by toast-timer; drawn above everything.
    // =================================================================
    if root.toast-open: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 30px;
            // Short toasts ("copied") keep the one-line pill. A long one — an
            // engine error surfaced by `issue()`, e.g. the founding's relay
            // prerequisite, which runs past 200 characters — wraps inside a
            // capped bubble instead of growing wider than the window and
            // clipping its own tail (2026-08-01: the tail is the part that
            // says what to do). preferred-width is the unwrapped natural
            // width, so it does not depend on the width assigned back to the
            // label — no layout cycle.
            width: min(toast-label.preferred-width + 28px + 36px, parent.width - 80px);
            height: max(38px, toast-label.preferred-height + 20px);
            border-radius: Theme.win95 ? 0px : 19px;
            background: Theme.raised;
            border-width: Theme.border-w;
            border-color: Theme.line;
            // clicking anywhere on the bubble dismisses it right away
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.hide-toast();
                }
            }
            // tone dot (green = ok, red = error), then the message — all in
            // palette colours so the toast follows the active theme
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                x: 14px;
                y: (parent.height - self.height) / 2;
                background: root.toast-bad ? Theme.bad : Theme.good;
            }
            toast-label := Text {
                x: 28px;
                width: parent.width - 28px - 36px;
                height: 100%;
                text: root.toast-text;
                color: Theme.text;
                font-size: Theme.fs-body;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            // explicit close: a small × so dismissing is discoverable
            toast-x := TouchArea {
                x: parent.width - 31px;
                y: (parent.height - 24px) / 2;
                width: 24px;
                height: 24px;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.hide-toast();
                }
            }
            Rectangle {
                x: toast-x.x;
                y: toast-x.y;
                width: 24px;
                height: 24px;
                border-radius: Theme.win95 ? 0px : 12px;
                background: toast-x.has-hover ? Theme.panel-2 : transparent;
                Text {
                    text: "×";
                    color: Theme.dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

    } // end esc FocusScope
}
